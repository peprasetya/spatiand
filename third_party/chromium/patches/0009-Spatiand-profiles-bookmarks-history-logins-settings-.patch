+
+#ifndef CHROME_BROWSER_SPATIAND_EXTENSION_SYNC_H_
+#define CHROME_BROWSER_SPATIAND_EXTENSION_SYNC_H_
+
+#include <map>
+#include <set>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_registry_observer.h"
+
+class Profile;
+
+namespace spatiand {
+
+// A profile's Chrome extensions on every machine: `apps/spatimesh/profiles/<id>/extensions/<ext>.json`
+// says what is installed and whether it is on. An extension from a store is installed on the next
+// machine as Chrome Sync would install it, from its update address. One loaded from a folder comes
+// along with its files (`extension-files/<ext>/`) if its manifest has a `key`, which is what keeps
+// its id the same wherever it is loaded from; without one its id is made from where it is, and it
+// stays on the machine it was loaded on.
+class ExtensionSync : public extensions::ExtensionRegistryObserver {
+ public:
+  ExtensionSync(Profile* profile,
+                const std::string& id,
+                scoped_refptr<base::SequencedTaskRunner> files);
+  ExtensionSync(const ExtensionSync&) = delete;
+  ExtensionSync& operator=(const ExtensionSync&) = delete;
+  ~ExtensionSync() override;
+
+  void Poll();
+
+  using Records = std::map<std::string, base::DictValue>;
+
+ private:
+  struct Read;
+  void OnReady();
+  void OnRead(int changes_when_asked, Records records);
+  void Reconcile(Records records);
+  void WriteLocal(const extensions::Extension* extension);
+  void Install(const std::string& extension_id, const base::DictValue& record);
+  void SaveKnown();
+
+  // extensions::ExtensionRegistryObserver:
+  void OnExtensionLoaded(content::BrowserContext* browser_context,
+                         const extensions::Extension* extension) override;
+  void OnExtensionUnloaded(content::BrowserContext* browser_context,
+                           const extensions::Extension* extension,
+                           extensions::UnloadedExtensionReason reason) override;
+  void OnExtensionInstalled(content::BrowserContext* browser_context,
+                            const extensions::Extension* extension,
+                            bool is_update) override;
+  void OnExtensionUninstalled(content::BrowserContext* browser_context,
+                              const extensions::Extension* extension,
+                              extensions::UninstallReason reason) override;
+
+  const raw_ptr<Profile> profile_;
+  const base::FilePath dir_;
+  const base::FilePath files_dir_;
+  const base::FilePath known_file_;
+  scoped_refptr<base::SequencedTaskRunner> files_;
+  raw_ptr<extensions::ExtensionRegistry> registry_;
+
+  Records records_;
+  // Those seen in the list: one installed here and gone from the list was removed on another
+  // machine; one not known yet was installed here.
+  std::set<std::string> known_;
+  // Being installed here because the list says so.
+  std::set<std::string> installing_;
+  base::Time last_changed_;
+  bool ready_ = false;
+  bool reading_ = false;
+  bool applying_ = false;
+  int changes_ = 0;
+
+  base::ScopedObservation<extensions::ExtensionRegistry, extensions::ExtensionRegistryObserver>
+      observation_{this};
+  base::WeakPtrFactory<ExtensionSync> weak_factory_{this};
+};
+
+}  // namespace spatiand
+
+#endif  // CHROME_BROWSER_SPATIAND_EXTENSION_SYNC_H_
