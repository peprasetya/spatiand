+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SPATIAND_HISTORY_SYNC_H_
+#define CHROME_BROWSER_SPATIAND_HISTORY_SYNC_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/task/cancelable_task_tracker.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/threading/sequence_bound.h"
+#include "base/timer/timer.h"
+#include "components/history/core/browser/history_service.h"
+#include "components/history/core/browser/history_service_observer.h"
+
+class Profile;
+
+namespace spatiand {
+
+// A profile's history on every machine: `apps/spatimesh/profiles/<id>/history/`. Each machine
+// writes only its own files, a month to a file (`<machine>-<YYYY-MM>.json`), and says what was
+// taken out in `forgotten-<machine>.json`; every machine reads all of them. A visit made elsewhere
+// is put into Chromium's own history as a synced one, so that the address bar, the history page
+// and visited links all know it.
+class HistorySync : public history::HistoryServiceObserver {
+ public:
+  HistorySync(Profile* profile,
+              const std::string& id,
+              scoped_refptr<base::SequencedTaskRunner> files);
+  HistorySync(const HistorySync&) = delete;
+  HistorySync& operator=(const HistorySync&) = delete;
+  ~HistorySync() override;
+
+  void Poll();
+
+  struct Visit {
+    std::u16string title;
+    std::string url;
+    double at = 0;
+  };
+  struct Forgotten {
+    std::optional<std::string> url;
+    double from = 0;
+    double until = 0;
+  };
+  struct News {
+    News();
+    News(News&&);
+    News& operator=(News&&);
+    ~News();
+    base::Time changed;
+    bool unchanged = false;
+    std::vector<Visit> visits;
+    std::vector<Forgotten> forgotten;
+  };
+
+  class Files;
+
+ private:
+  void OnNews(News news);
+  void SaveSoon();
+
+  // history::HistoryServiceObserver:
+  void OnURLVisited(history::HistoryService* history_service,
+                    const history::VisitedURLInfo& visited_url_info) override;
+  void OnURLsModified(history::HistoryService* history_service,
+                      const history::URLRows& changed_urls) override;
+  void OnHistoryDeletions(history::HistoryService* history_service,
+                          const history::DeletionInfo& deletion_info) override;
+
+  const raw_ptr<history::HistoryService> history_;
+  base::SequenceBound<Files> files_;
+  base::OneShotTimer save_timer_;
+  std::optional<Visit> last_;
+  std::vector<Visit> unsaved_;
+  bool reading_ = false;
+  base::Time last_read_;
+  // Taking out what another machine took out is not this machine taking it out.
+  int applying_forgotten_ = 0;
+  base::CancelableTaskTracker tracker_;
+
+  base::ScopedObservation<history::HistoryService, history::HistoryServiceObserver>
+      observation_{this};
+  base::WeakPtrFactory<HistorySync> weak_factory_{this};
+};
+
+}  // namespace spatiand
+
+#endif  // CHROME_BROWSER_SPATIAND_HISTORY_SYNC_H_
