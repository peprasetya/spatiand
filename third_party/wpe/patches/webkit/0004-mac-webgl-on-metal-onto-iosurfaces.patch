+#include "GraphicsContextGLTextureMapperANGLE.h"
+#include <array>
+
+namespace WebCore {
+
+class IOSurfaceDrawingBuffer;
+
+// WPE on a Mac (Spatiand): WebGL on ANGLE's own Metal back end, drawing straight onto
+// IOSurfaces, which the compositor (Skia and the texture mapper, on the ANGLE the rest of WPE
+// draws with) takes as they are, a texture of the same memory. Without it WebGL runs on ANGLE's
+// GL back end over that other ANGLE: two translations of every call and shader between a page
+// and Metal.
+//
+// As GraphicsContextGLTextureMapperGBM does with DMA-BUFs: each frame is drawn into one of three
+// IOSurfaces in turn, and handed to the compositor with a fence it waits on before it draws it.
+class GraphicsContextGLTextureMapperIOSurface final : public GraphicsContextGLTextureMapperANGLE {
+public:
+    static RefPtr<GraphicsContextGLTextureMapperIOSurface> create(GraphicsContextGLAttributes&&);
+    virtual ~GraphicsContextGLTextureMapperIOSurface();
+
+    // ANGLE's Metal display, and both ANGLEs able to take IOSurfaces: WebGL can be drawn so.
+    // WEBKIT_WEBGL_DISABLE_IOSURFACE=1 says not to.
+    static bool checkRequirements();
+
+private:
+    explicit GraphicsContextGLTextureMapperIOSurface(GraphicsContextGLAttributes&&);
+
+    bool platformInitialize() override;
+    bool reshapeDrawingBuffer() override;
+    void prepareForDisplay() override;
+
+    RefPtr<IOSurfaceDrawingBuffer> createDrawingBuffer() const;
+    bool bindNextDrawingBuffer();
+    void freeDrawingBuffers();
+
+    GCGLConfig m_pbufferConfig { nullptr };
+    std::array<RefPtr<IOSurfaceDrawingBuffer>, 3> m_drawingBuffers;
+    unsigned m_current { 0 };
+    // The one bound to m_texture, drawn into now.
+    RefPtr<IOSurfaceDrawingBuffer> m_bound;
+};
+
+// The compositor's half (GraphicsContextGLTextureMapperIOSurfaceImport.cpp, on libepoxy's EGL,
+// which cannot share a file with ANGLE's): an IOSurface as a texture of the compositor's GL,
+// made in the context it shares textures with, and let go of.
+unsigned importIOSurfaceForCompositor(void* ioSurface, int width, int height, bool hasAlpha, void** pbuffer);
+void releaseIOSurfaceForCompositor(unsigned texture, void* pbuffer);
+
+} // namespace WebCore
