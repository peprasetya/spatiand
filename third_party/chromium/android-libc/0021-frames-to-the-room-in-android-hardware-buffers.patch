@@ -49,11 +110,19 @@ bool GLSurfaceEglReadbackWayland::Resize(const gfx::Size& size,
                                          bool has_alpha) {
   DestroyBuffers();
   surface_scale_factor_ = scale_factor;
+#if !defined(__TERMUX__)
