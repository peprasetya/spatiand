@@ -82,6 +102,34 @@ class GLSurfaceEglReadbackWayland : public GLSurfaceEglReadback,
 
   void DestroyBuffers();
 
+#if defined(__TERMUX__)
+  // Android's GPU cannot hand Wayland a dmabuf, and reading each frame back
+  // into shared memory costs two copies a frame (here and in the room), so
+  // where Spatiand's room takes them the frames go to it in Android hardware
+  // buffers: each copied into one on the GPU, the buffer passed through a
+  // socket that stands as the dmabuf's file (android/eglshim in Spatiand).
+  // False where they cannot be had; the frames are then read back as before.
+  bool CreateHardwareBuffers(const gfx::Size& size);
+  // Copies the frame into the buffer on the GPU; returns the fence that says
+  // when it is done.
+  void* CopyIntoHardwareBuffer(PixelBuffer* buffer);
+  void DestroyHardwareBuffer(PixelBuffer* buffer);
+  // A frame copied into its hardware buffer goes to the room once the GPU has
+  // done so (the room's GPU is told nothing to wait for), without holding up
+  // this thread meanwhile: its fence is looked at every millisecond.
+  void CommitWhenDrawn();
+  // At once, waiting for the GPU if need be: before buffers go (a resize),
+  // and before another frame.
+  void CommitNow();
+  struct PendingCommit {
+    uint32_t buffer_id = 0;
+    gfx::FrameData data;
+    gfx::Rect bounds;
+    RAW_PTR_EXCLUSION void* fence = nullptr;
+  };
+  std::optional<PendingCommit> pending_commit_;
+#endif
+
   // Widget of the window that this readback writes pixels to.
   const gfx::AcceleratedWidget widget_;
 
