+angle::Result ContextVk::drawWholeRenderAreaBeforeSecondDraw()
+{
+    // Only for a draw that goes on in the render pass already open on this framebuffer, when that
+    // render pass holds exactly one draw so far.
+    FramebufferVk *framebufferVk = getDrawFramebuffer();
+    if (!hasActiveRenderPass() || mGraphicsDirtyBits[DIRTY_BIT_RENDER_PASS] ||
+        !hasStartedRenderPassWithQueueSerial(framebufferVk->getLastRenderPassQueueSerial()) ||
+        mRenderPassCommands->getRenderPassWriteCommandCount() != 1 ||
+        mState.isTransformFeedbackActiveUnpaused())
+    {
+        return angle::Result::Continue;
+    }
+
+    // A colour attachment that can be blended: the draw writes it with blending that keeps the
+    // destination (src * 0 + dst * 1), so it is a real draw over every bin and changes nothing.
+    // A draw that writes nothing is dropped by the driver and does not help.
+    const gl::FramebufferState &fbState = framebufferVk->getState();
+    for (size_t colorIndexGL :
+         fbState.getColorAttachmentsMask() & fbState.getEnabledDrawBuffers())
+    {
+        RenderTargetVk *renderTarget = framebufferVk->getColorDrawRenderTarget(colorIndexGL);
+        if (renderTarget == nullptr || renderTarget->isYuvResolve() ||
+            renderTarget->getLayerCount() != 1)
+        {
+            continue;
+        }
+        const angle::Format &format = renderTarget->getImageForRenderPass().getActualFormat();
+        if (format.isInt() ||
+            !mRenderer->hasImageFormatFeatureBits(format.id,
+                                                  VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BLEND_BIT))
+        {
+            continue;
+        }
+
+        UtilsVk::ClearFramebufferParameters params;
+        params.clearArea              = mRenderPassCommands->getRenderArea();
+        params.clearColor             = true;
+        params.colorMaskFlags         = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT |
+                                VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT;
+        params.colorAttachmentIndexGL = static_cast<uint32_t>(colorIndexGL);
+        params.colorFormat            = &format;
+        params.preserveContents       = true;
+        return mUtils.clearFramebuffer(this, framebufferVk, params);
+    }
+    return angle::Result::Continue;
+}
