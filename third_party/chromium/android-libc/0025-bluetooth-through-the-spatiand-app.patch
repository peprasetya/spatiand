+constexpr char kSocket[] = "spatiand-bluetooth";
+
+// android.bluetooth.BluetoothGatt's.
+constexpr int kGattSuccess = 0;
+constexpr int kGattFailure = 0x101;
+
+BluetoothGattService::GattErrorCode ErrorOf(int status) {
+  switch (status) {
+    case 0x0d:  // GATT_INVALID_ATTRIBUTE_LENGTH
+      return BluetoothGattService::GattErrorCode::kInvalidLength;
+    case 0x02:  // GATT_READ_NOT_PERMITTED
+    case 0x03:  // GATT_WRITE_NOT_PERMITTED
+      return BluetoothGattService::GattErrorCode::kNotPermitted;
+    case 0x05:  // GATT_INSUFFICIENT_AUTHENTICATION
+    case 0x0f:  // GATT_INSUFFICIENT_ENCRYPTION
+      return BluetoothGattService::GattErrorCode::kNotAuthorized;
+    case 0x06:  // GATT_REQUEST_NOT_SUPPORTED
+      return BluetoothGattService::GattErrorCode::kNotSupported;
+    case kGattFailure:
+      return BluetoothGattService::GattErrorCode::kFailed;
+    default:
+      return BluetoothGattService::GattErrorCode::kUnknown;
+  }
+}
+
+std::vector<uint8_t> Unhex(const std::string* hex) {
+  std::vector<uint8_t> bytes;
+  if (hex) {
+    base::HexStringToBytes(*hex, &bytes);
+  }
+  return bytes;
+}
+
+int8_t ClampToByte(int value) {
+  return static_cast<int8_t>(std::clamp(value, -128, 127));
+}
