From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Spatiand build <claude@prasetya.id>
Date: Thu, 29 Oct 2026 23:52:33 +0000
Subject: [PATCH 283/310] Spatiand: media on Spatiand's FFmpeg

Chromium links Spatiand's FFmpeg 9.0.2 (build/linux/unbundle/ffmpeg.gn, staged by Spatiand's
build.sh, its linker flags given to every program that depends on it), which decodes HEVC in
software where there is no GPU decoder for it, and Dolby Digital (Plus).
---
 build/linux/unbundle/ffmpeg.gn        | 29 +++++++++++++++++++++------
 media/base/supported_types.cc         | 11 +---------
 media/ffmpeg/ffmpeg_common.cc         | 14 +++++++++++--
 media/filters/ffmpeg_demuxer.cc       | 24 ++++++++++++----------
 media/filters/ffmpeg_glue.cc          |  2 ++
 media/filters/ffmpeg_video_decoder.cc |  8 ++++----
 6 files changed, 55 insertions(+), 33 deletions(-)

diff --git a/build/linux/unbundle/ffmpeg.gn b/build/linux/unbundle/ffmpeg.gn
index c0f0e21620..e29b9a7e37 100644
--- a/build/linux/unbundle/ffmpeg.gn
+++ b/build/linux/unbundle/ffmpeg.gn
@@ -2,15 +2,30 @@
 # Use of this source code is governed by a BSD-style license that can be
 # found in the LICENSE file.
 
+# Spatiand: Spatiand's own FFmpeg (third_party/ffmpeg in Spatiand, one copy for every program of
+# it), its headers and libraries staged at //third_party/spatiand_ffmpeg by Spatiand's build.sh.
+# Found at run time beside Spatiand's, where the Deck keeps it; libraries built against a newer
+# glibc than Chromium's sysroot are allowed their own undefined symbols.
+
 import("//build/buildflag_header.gni")
-import("//build/config/linux/pkg_config.gni")
 import("//build/shim_headers.gni")
 
-pkg_config("system_ffmpeg") {
-  packages = [
-    "libavcodec",
-    "libavformat",
-    "libavutil",
+config("system_ffmpeg") {
+  include_dirs = [ "//third_party/spatiand_ffmpeg/include" ]
+  lib_dirs = [ "//third_party/spatiand_ffmpeg/lib" ]
+  libs = [
+    "avcodec",
+    "avformat",
+    "avutil",
+  ]
+}
+
+# Linker flags count only where a program is linked, and a source set's public_configs never
+# reach one: these go to everything that depends on FFmpeg, however far up.
+config("system_ffmpeg_link") {
+  ldflags = [
+    "-Wl,--allow-shlib-undefined",
+    "-Wl,-rpath=\$ORIGIN/../spatiand/third_party/ffmpeg/out/linux/lib:\$ORIGIN/ffmpeg",
   ]
 }
 
@@ -25,6 +40,7 @@ shim_headers("ffmpeg_shim") {
     "libavcodec/avcodec.h",
     "libavcodec/packet.h",
     "libavformat/avformat.h",
+    "libavutil/avutil.h",
     "libavutil/imgutils.h",
     "libavutil/rational.h",
   ]
@@ -36,4 +52,5 @@ source_set("ffmpeg") {
     ":ffmpeg_shim",
   ]
   public_configs = [ ":system_ffmpeg" ]
+  all_dependent_configs = [ ":system_ffmpeg_link" ]
 }
diff --git a/media/base/supported_types.cc b/media/base/supported_types.cc
index efc7246c8c..f78f093796 100644
--- a/media/base/supported_types.cc
+++ b/media/base/supported_types.cc
@@ -234,17 +234,8 @@ bool IsDecoderHevcProfileSupported(const VideoType& type) {
   }
 
 #if BUILDFLAG(ENABLE_PLATFORM_HEVC)
-#if BUILDFLAG(PLATFORM_HAS_OPTIONAL_HEVC_DECODE_SUPPORT)
-#if BUILDFLAG(IS_CHROMEOS)
-  if (!base::FeatureList::IsEnabled(kPlatformHEVCDecoderSupport)) {
-    return false;
-  }
-#endif  // BUILDFLAG(IS_CHROMEOS)
-  return GetSupplementalDecoderVideoProfileCache()->IsProfileSupported(
-      type.profile);
-#else
+  // Spatiand: Spatiand's FFmpeg decodes every HEVC profile in software, hardware or not.
   return true;
-#endif  // BUIDFLAG(PLATFORM_HAS_OPTIONAL_HEVC_DECODE_SUPPORT)
 #else
   return false;
 #endif  // BUILDFLAG(ENABLE_PLATFORM_HEVC)
diff --git a/media/ffmpeg/ffmpeg_common.cc b/media/ffmpeg/ffmpeg_common.cc
index e4c443001d..b05f744b7a 100644
--- a/media/ffmpeg/ffmpeg_common.cc
+++ b/media/ffmpeg/ffmpeg_common.cc
@@ -65,7 +65,8 @@ VideoColorSpace GetGuessedColorSpace(const VideoColorSpace& color_space) {
 const char* GetAllowedVideoDecoders() {
   // This should match the configured lists in //third_party/ffmpeg.
 #if BUILDFLAG(USE_PROPRIETARY_CODECS) && BUILDFLAG(ENABLE_FFMPEG_VIDEO_DECODERS)
-  return "h264";
+  // Spatiand: HEVC too, decoded by Spatiand's FFmpeg in software.
+  return "h264,hevc";
 #else
   return "";
 #endif
@@ -216,6 +217,13 @@ AVCodecID AudioCodecToCodecID(AudioCodec audio_codec,
 #if BUILDFLAG(ENABLE_PLATFORM_MPEG_H_AUDIO)
     case AudioCodec::kMpegHAudio:
       return AV_CODEC_ID_MPEGH_3D_AUDIO;
+#endif
+#if BUILDFLAG(ENABLE_PLATFORM_AC3_EAC3_AUDIO)
+    // Spatiand: Dolby Digital (Plus) is decoded by Spatiand's FFmpeg, like everything else.
+    case AudioCodec::kAC3:
+      return AV_CODEC_ID_AC3;
+    case AudioCodec::kEAC3:
+      return AV_CODEC_ID_EAC3;
 #endif
     default:
       DVLOG(1) << "Unknown AudioCodec: " << audio_codec;
@@ -1119,7 +1127,9 @@ const char* GetAllowedAudioDecoders() {
   // This should match the configured lists in //third_party/ffmpeg.
   static constexpr std::string_view kAllowedAudioCodecs =
       "vorbis,libopus,flac,pcm_u8,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le,"
-      "mp3,pcm_s16be,pcm_s24be,pcm_mulaw,pcm_alaw" EXTRA_CODECS;
+      "mp3,pcm_s16be,pcm_s24be,pcm_mulaw,pcm_alaw"
+      // Spatiand: Dolby Digital and Dolby Digital Plus, by Spatiand's FFmpeg.
+      ",ac3,eac3" EXTRA_CODECS;
 #undef EXTRA_CODECS
 
   return kAllowedAudioCodecs.data();
diff --git a/media/filters/ffmpeg_demuxer.cc b/media/filters/ffmpeg_demuxer.cc
index 1f4bdee44d..31c116111d 100644
--- a/media/filters/ffmpeg_demuxer.cc
+++ b/media/filters/ffmpeg_demuxer.cc
@@ -56,6 +56,11 @@
 #include "media/filters/ffmpeg_h265_to_annex_b_bitstream_converter.h"
 #endif
 
+// Spatiand: AV_CODEC_ID_ITUT_T35 is in Chromium's FFmpeg (libavcodec 63.16) but
+// not in the FFmpeg release Spatiand links (libavcodec 63.1, FFmpeg 9.0.2).
+#define SPATIAND_FFMPEG_HAS_ITUT_T35 \
+  (LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(63, 16, 100))
+
 namespace media {
 
 namespace {
@@ -119,17 +124,8 @@ static base::TimeDelta ExtractStartTime(AVStream* stream) {
   if (stream->start_time != kNoFFmpegTimestamp)
     start_time = ConvertFromTimeBase(stream->time_base, stream->start_time);
 
-  // Next try to use the first DTS value, for codecs where we know PTS == DTS
-  // (excludes all H26x codecs). The start time must be returned in PTS.
-  if (av_stream_get_first_dts(stream) != kNoFFmpegTimestamp &&
-      stream->codecpar->codec_id != AV_CODEC_ID_HEVC &&
-      stream->codecpar->codec_id != AV_CODEC_ID_H264 &&
-      stream->codecpar->codec_id != AV_CODEC_ID_MPEG4) {
-    const base::TimeDelta first_pts =
-        ConvertFromTimeBase(stream->time_base, av_stream_get_first_dts(stream));
-    if (first_pts < start_time)
-      start_time = first_pts;
-  }
+  // Spatiand: no first-DTS refinement -- av_stream_get_first_dts() is the Chromium fork's own,
+  // not FFmpeg's, and Spatiand's FFmpeg is FFmpeg's.
 
   return start_time;
 }
@@ -1298,6 +1294,9 @@ FFmpegDemuxer::MetadataTrackMap FFmpegDemuxer::BuildMetadataTracks(
     return result;
   }
 
+  // Spatiand: without AV_CODEC_ID_ITUT_T35 in the linked FFmpeg no stream can
+  // be an IT35 metadata track.
+#if SPATIAND_FFMPEG_HAS_ITUT_T35
   for (const AVStreamGroup* stream_group :
        AVFormatContextStreamGroupsToSpan(format_context)) {
     if (stream_group->type != AV_STREAM_GROUP_PARAMS_TREF) {
@@ -1326,6 +1325,7 @@ FFmpegDemuxer::MetadataTrackMap FFmpegDemuxer::BuildMetadataTracks(
       entry.render_stream_indices.insert(stream->index);
     }
   }
+#endif  // SPATIAND_FFMPEG_HAS_ITUT_T35
   return result;
 }
 
@@ -1443,11 +1443,13 @@ void FFmpegDemuxer::OnFindStreamInfoDone(int result) {
     } else if (codec_type == AVMEDIA_TYPE_SUBTITLE) {
       stream->discard = AVDISCARD_ALL;
       continue;
+#if SPATIAND_FFMPEG_HAS_ITUT_T35
     } else if (codec_id == AV_CODEC_ID_ITUT_T35) {
       if (!metadata_tracks_.contains(stream->index)) {
         stream->discard = AVDISCARD_ALL;
       }
       continue;
+#endif
     } else {
       stream->discard = AVDISCARD_ALL;
       continue;
diff --git a/media/filters/ffmpeg_glue.cc b/media/filters/ffmpeg_glue.cc
index fcacae3add..73aeffcacd 100644
--- a/media/filters/ffmpeg_glue.cc
+++ b/media/filters/ffmpeg_glue.cc
@@ -122,7 +122,9 @@ FFmpegGlue::FFmpegGlue(FFmpegURLProtocol* protocol) {
 
   // We don't allow H.264 parsing during demuxing since we have our own parser
   // and the ffmpeg one increases memory usage unnecessarily.
+#if defined(AVFMT_FLAG_NOH264PARSE)  // Spatiand: the Chromium fork's own; FFmpeg has no such flag.
   format_context_->flags |= AVFMT_FLAG_NOH264PARSE;
+#endif
 
   // Ensures format parsing errors will bail out. From an audit on 11/2017, all
   // instances were real failures. Solves bugs like http://crbug.com/710791.
diff --git a/media/filters/ffmpeg_video_decoder.cc b/media/filters/ffmpeg_video_decoder.cc
index b13e1aabd6..f754854f55 100644
--- a/media/filters/ffmpeg_video_decoder.cc
+++ b/media/filters/ffmpeg_video_decoder.cc
@@ -74,7 +74,6 @@ static int GetFFmpegVideoDecoderThreadCount(const VideoDecoderConfig& config) {
     case VideoCodec::kUnknown:
     case VideoCodec::kVC1:
     case VideoCodec::kMPEG2:
-    case VideoCodec::kHEVC:
     case VideoCodec::kVP9:
     case VideoCodec::kAV1:
     case VideoCodec::kDolbyVision:
@@ -84,6 +83,7 @@ static int GetFFmpegVideoDecoderThreadCount(const VideoDecoderConfig& config) {
       // We do not compile ffmpeg with support for any of these codecs.
       NOTREACHED();
 
+    case VideoCodec::kHEVC:
     case VideoCodec::kH264:
       // Normalize to three threads for 1080p content, then scale linearly
       // with number of pixels.
@@ -123,11 +123,11 @@ bool FFmpegVideoDecoder::IsCodecSupported(VideoCodec codec) {
     return false;
   }
 #endif
-#if BUILDFLAG(ENABLE_PLATFORM_HEVC)
+  // Spatiand: HEVC in software too, by Spatiand's FFmpeg, where the GPU does not decode it
+  // (SpatiandVideoDecoder does, where it does).
   if (codec == VideoCodec::kHEVC) {
-    return false;
+    return true;
   }
-#endif
   // We only build support for H.264.
   return codec == VideoCodec::kH264 && IsDecoderBuiltInVideoCodec(codec);
 }
