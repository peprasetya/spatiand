 const unsigned kVibrationPatternLengthMax = 99;
@@ -117,6 +118,9 @@ bool VibrationController::vibrate(Navigator& navigator,
     return false;
   }
 
+  if (!RuntimeEnabledFeatures::VibrationEnabled())
+    return false;
+
   return From(navigator).Vibrate(pattern);
 }
 
