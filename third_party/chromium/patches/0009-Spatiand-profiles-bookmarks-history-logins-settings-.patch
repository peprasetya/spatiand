+ProfilesSync*& Instance() {
+  static ProfilesSync* instance = nullptr;
+  return instance;
+}
+
+base::FilePath RecordFile(const std::string& id) {
+  return SharedProfileDir(id).Append("profile.json");
+}
+
+base::FilePath DirsFile() {
+  return LocalDir().Append("profile-dirs.json");
+}
+
+base::FilePath KnownFile() {
+  return LocalDir().Append("profiles-known.json");
+}
+
+SkColor ColourOf(const base::DictValue& file) {
+  const base::ListValue* colour = file.FindList("colour");
+  if (!colour || colour->size() != 3 || !(*colour)[0].is_int() || !(*colour)[1].is_int() ||
+      !(*colour)[2].is_int()) {
+    return SK_ColorTRANSPARENT;
+  }
+  return SkColorSetRGB((*colour)[0].GetInt(), (*colour)[1].GetInt(), (*colour)[2].GetInt());
+}
+
+std::map<std::string, ProfileRecord> ReadRecords() {
+  std::map<std::string, ProfileRecord> records;
+  base::FileEnumerator folders(SharedDir().Append("profiles"), /*recursive=*/false,
+                               base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath folder = folders.Next(); !folder.empty(); folder = folders.Next()) {
+    const std::string id = folder.BaseName().value();
+    if (id.starts_with('.') || id == "private") {
+      continue;
+    }
+    std::optional<base::Value> file = ReadJson(folder.Append("profile.json"));
+    if (!file || !file->is_dict()) {
+      continue;
+    }
+    const base::DictValue& dict = file->GetDict();
+    ProfileRecord record;
+    if (const std::string* name = dict.FindString("name")) {
+      record.name = *name;
+    }
+    record.colour = ColourOf(dict);
+    record.created = dict.FindDouble("created").value_or(0);
+    record.position = dict.FindInt("position");
+    if (const base::DictValue* lock = dict.FindDict("lock")) {
+      const std::string* kind = lock->FindString("kind");
+      const std::string* salt = lock->FindString("salt");
+      const std::string* hash = lock->FindString("hash");
+      if (kind && salt && hash) {
+        record.lock_kind = *kind;
+        record.lock_salt = *salt;
+        record.lock_hash = *hash;
+      }
+    }
+    records.emplace(id, std::move(record));
+  }
+  return records;
+}
+
+std::map<std::string, std::string> ReadStringMap(const base::FilePath& file) {
+  std::map<std::string, std::string> map;
+  if (std::optional<base::Value> value = ReadJson(file); value && value->is_dict()) {
+    for (const auto [key, item] : value->GetDict()) {
+      if (item.is_string()) {
+        map.emplace(key, item.GetString());
+      }
+    }
+  }
+  return map;
+}
+
+std::set<std::string> ReadStringSet(const base::FilePath& file) {
+  std::set<std::string> set;
+  if (std::optional<base::Value> value = ReadJson(file); value && value->is_list()) {
+    for (const base::Value& item : value->GetList()) {
+      if (item.is_string()) {
+        set.insert(item.GetString());
+      }
+    }
+  }
+  return set;
+}
+
+// Changes what this browser has a say in and keeps the rest of the file (a lock, a place in the
+// list) as it is.
+void UpdateRecordFile(const std::string& id, const ProfileRecord& record) {
+  base::DictValue dict;
+  if (std::optional<base::Value> old = ReadJson(RecordFile(id)); old && old->is_dict()) {
+    dict = std::move(*old).TakeDict();
+  } else {
+    dict.Set("created", record.created);
+  }
+  dict.Set("name", record.name);
+  dict.Set("colour", base::ListValue()
+                         .Append(static_cast<int>(SkColorGetR(record.colour)))
+                         .Append(static_cast<int>(SkColorGetG(record.colour)))
+                         .Append(static_cast<int>(SkColorGetB(record.colour))));
+  WriteJson(RecordFile(id), base::Value(std::move(dict)));
+}
+
+void WriteFirstRecord(const std::string& name, SkColor colour) {
+  base::DictValue dict;
+  dict.Set("name", name);
+  dict.Set("colour", base::ListValue()
+                         .Append(static_cast<int>(SkColorGetR(colour)))
+                         .Append(static_cast<int>(SkColorGetG(colour)))
+                         .Append(static_cast<int>(SkColorGetB(colour))));
+  dict.Set("created", 0);
+  WriteJsonAsIfLongAgo(RecordFile(kFirstId), base::Value(std::move(dict)));
+}
+
+}  // namespace
+
+ProfileRecord::ProfileRecord() = default;
+ProfileRecord::ProfileRecord(const ProfileRecord&) = default;
+ProfileRecord& ProfileRecord::operator=(const ProfileRecord&) = default;
+ProfileRecord::~ProfileRecord() = default;
+bool ProfileRecord::operator==(const ProfileRecord&) const = default;
+
+std::string LockHash(const std::string& salt, const std::string& secret) {
+  std::array<uint8_t, crypto::hash::kSha256Size> digest =
+      crypto::hash::Sha256(salt + std::string(1, '\0') + secret);
+  for (int i = 0; i < 100000; ++i) {
+    digest = crypto::hash::Sha256(digest);
+  }
+  return base::ToLowerASCII(base::HexEncode(digest));
+}
+
+// static
+void ProfilesSync::Start() {
+  DCHECK(!Instance());
+  Instance() = new ProfilesSync();
+}
+
+// static
+ProfilesSync* ProfilesSync::Get() {
+  return Instance();
+}
+
+ProfilesSync::ProfilesSync()
+    : files_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN})) {
+  ProfileManager* manager = g_browser_process->profile_manager();
+  // The first read is made here and now, before any window: a locked profile's window must not
+  // be shown for a moment because the list had not been read yet. This is startup, before the
+  // main loop runs, and a handful of small files.
+  {
+    base::ScopedAllowBlockingForTesting allowed;
+    dirs_ = ReadStringMap(DirsFile());
+    known_ = ReadStringSet(KnownFile());
+    OnRead(ReadRecords());
+  }
+  storage_observation_.Observe(&manager->GetProfileAttributesStorage());
+  manager->AddObserver(this);
+  browsers_observation_.Observe(GlobalBrowserCollection::GetInstance());
+  // Opens the last profile used, as SpatiMesh does, rather than asking whose each time; the
+  // picker's own checkbox still turns that on.
+  g_browser_process->local_state()->SetDefaultPrefValue(prefs::kBrowserShowProfilePickerOnStartup,
+                                                        base::Value(false));
+  timer_.Start(FROM_HERE, kEvery, base::BindRepeating(&ProfilesSync::Poll, base::Unretained(this)));
+}
+
+ProfilesSync::~ProfilesSync() = default;
+
+void ProfilesSync::Poll() {
+  if (reading_) {
+    return;
+  }
+  reading_ = true;
+  files_->PostTaskAndReplyWithResult(FROM_HERE, base::BindOnce(&ReadRecords),
+                                     base::BindOnce(&ProfilesSync::OnRead,
+                                                    weak_factory_.GetWeakPtr()));
+}
+
+void ProfilesSync::OnRead(std::map<std::string, ProfileRecord> records) {
+  reading_ = false;
+  ProfileManager* manager = g_browser_process->profile_manager();
+  ProfileAttributesStorage& storage = manager->GetProfileAttributesStorage();
+  base::AutoReset<bool> applying(&applying_, true);
+
+  if (records.empty()) {
+    // Nothing shared yet: the first profile, which every machine makes for itself.
+    ProfileAttributesEntry* entry =
+        storage.GetProfileAttributesWithPath(PathOf(kFirstId));
+    const std::string name = entry && !entry->IsUsingDefaultName()
+                                 ? base::UTF16ToUTF8(entry->GetLocalProfileName())
+                                 : "Personal";
+    const std::array<uint8_t, 3>& colour = kColours[0];
+    files_->PostTask(FROM_HERE, base::BindOnce(&WriteFirstRecord, name,
+                                               SkColorSetRGB(colour[0], colour[1], colour[2])));
+    return;
+  }
+
+  bool known_changed = false;
+  for (const auto& [id, record] : records) {
+    const auto old = records_.find(id);
+    Apply(id, record, old == records_.end() || !(old->second == record));
+    known_changed |= known_.insert(id).second;
+  }
+  // Gone from the list: removed on another machine.
+  std::vector<std::string> gone;
+  for (const std::string& id : known_) {
+    if (!records.contains(id)) {
+      gone.push_back(id);
+    }
+  }
+  for (const std::string& id : gone) {
+    removing_.insert(id);
+    Remove(id);
+    known_.erase(id);
+    known_changed = true;
+  }
+  if (records != records_) {
+    ApplyOrder(records);
+  }
+  records_ = std::move(records);
+
+  // A profile this browser has that the list does not: one it made before it was told of the
+  // list, or Chromium's own first run.
+  for (ProfileAttributesEntry* entry : storage.GetAllProfilesAttributes()) {
+    const base::FilePath path = entry->GetPath();
+    const std::string id = IdOf(path);
+    if (!records_.contains(id) && !removing_.contains(id)) {
+      ProfileRecord record;
+      record.name = base::UTF16ToUTF8(entry->GetLocalProfileName());
+      const std::array<uint8_t, 3>& colour = kColours[records_.size() % kColours.size()];
+      record.colour = SkColorSetRGB(colour[0], colour[1], colour[2]);
+      record.created = static_cast<double>(NowMs());
+      WriteRecord(id, record);
+      records_.emplace(id, record);
+      known_changed |= known_.insert(id).second;
+    }
+  }
+
+  if (known_changed) {
+    base::ListValue list;
+    for (const std::string& id : known_) {
+      list.Append(id);
+    }
+    files_->PostTask(FROM_HERE, base::BindOnce(
+                                    [](base::ListValue known) {
+                                      WriteJson(KnownFile(), base::Value(std::move(known)));
+                                    },
+                                    std::move(list)));
+  }
+}
+
+void ProfilesSync::Apply(const std::string& id, const ProfileRecord& record, bool changed) {
+  ProfileManager* manager = g_browser_process->profile_manager();
+  ProfileAttributesStorage& storage = manager->GetProfileAttributesStorage();
+  const base::FilePath path = PathOf(id);
+  ProfileAttributesEntry* entry = storage.GetProfileAttributesWithPath(path);
+  if (!entry) {
+    // Only listed: the profile itself is made when it is first opened.
+    ProfileAttributesInitParams params;
+    params.profile_path = path;
+    params.profile_name = base::UTF8ToUTF16(record.name);
+    storage.AddProfile(std::move(params));
+    entry = storage.GetProfileAttributesWithPath(path);
+    changed = true;
+  }
+  if (!entry || !changed) {
+    return;
+  }
+  const std::u16string name = base::UTF8ToUTF16(record.name);
+  if (!name.empty() && (entry->GetLocalProfileName() != name || entry->IsUsingDefaultName())) {
+    entry->SetLocalProfileName(name, /*is_default_name=*/false);
+  }
+  if (record.colour != SK_ColorTRANSPARENT) {
+    entry->SetProfileThemeColors(GetProfileThemeColorsForAutogeneratedColor(record.colour));
+    if (Profile* profile = manager->GetProfileByPath(path)) {
+      ApplyTheme(profile, record);
+    }
+  }
+}
+
+void ProfilesSync::ApplyTheme(Profile* profile, const ProfileRecord& record) {
+  if (record.colour == SK_ColorTRANSPARENT) {
+    return;
+  }
+  ThemeService* theme = ThemeServiceFactory::GetForProfile(profile);
+  if (theme && theme->GetUserColor() != record.colour) {
+    theme->SetUserColorAndBrowserColorVariant(record.colour,
+                                              ui::mojom::BrowserColorVariant::kTonalSpot);
+  }
+}
+
+void ProfilesSync::Remove(const std::string& id) {
+  ProfileManager* manager = g_browser_process->profile_manager();
+  const base::FilePath path = PathOf(id);
+  if (!manager->GetProfileAttributesStorage().GetProfileAttributesWithPath(path)) {
+    return;
+  }
+  LOG(WARNING) << "SpatiMesh: the profile " << id << " was removed on another machine";
+  manager->GetDeleteProfileHelper().MaybeScheduleProfileForDeletion(
+      path, base::DoNothing(), ProfileMetrics::DELETE_PROFILE_SETTINGS);
+}
+
+void ProfilesSync::ApplyOrder(const std::map<std::string, ProfileRecord>& records) {
+  // As SpatiMesh's other builds list them: by the place given, then as they were made.
+  std::vector<std::string> ids;
+  for (const auto& [id, record] : records) {
+    ids.push_back(id);
+  }
+  std::ranges::sort(ids, [&records](const std::string& a, const std::string& b) {
+    const ProfileRecord& x = records.at(a);
+    const ProfileRecord& y = records.at(b);
+    return std::tuple(x.position.value_or(INT_MAX), x.created, a) <
+           std::tuple(y.position.value_or(INT_MAX), y.created, b);
+  });
+  ProfileAttributesStorage& storage =
+      g_browser_process->profile_manager()->GetProfileAttributesStorage();
+  size_t place = 0;
+  for (const std::string& id : ids) {
+    const base::FilePath path = PathOf(id);
+    const std::vector<ProfileAttributesEntry*> shown =
+        storage.GetAllProfilesAttributesSortedForDisplay();
+    const auto it = std::ranges::find_if(
+        shown, [&path](ProfileAttributesEntry* entry) { return entry->GetPath() == path; });
+    if (it == shown.end()) {
+      continue;
+    }
+    const size_t from = static_cast<size_t>(it - shown.begin());
+    if (from != place) {
+      storage.UpdateProfilesOrderPref(from, place);
+    }
+    ++place;
+  }
+}
+
+base::FilePath ProfilesSync::PathOf(const std::string& id) const {
+  const base::FilePath root = g_browser_process->profile_manager()->user_data_dir();
+  if (id == kFirstId) {
+    return root.Append(kFirstDir);
+  }
+  for (const auto& [dir, known_id] : dirs_) {
+    if (known_id == id) {
+      return root.Append(dir);
+    }
+  }
+  return root.Append(kDirPrefix + id);
+}
+
+std::string ProfilesSync::KnownIdOf(const base::FilePath& profile_path) const {
+  const std::string dir = profile_path.BaseName().value();
+  if (dir == kFirstDir) {
+    return kFirstId;
+  }
+  if (const auto it = dirs_.find(dir); it != dirs_.end()) {
+    return it->second;
+  }
+  if (dir.starts_with(kDirPrefix)) {
+    return dir.substr(std::string_view(kDirPrefix).size());
+  }
+  return std::string();
+}
+
+std::string ProfilesSync::IdOf(const base::FilePath& profile_path) {
+  std::string id = KnownIdOf(profile_path);
+  if (id.empty()) {
+    id = NewId();
+    dirs_.emplace(profile_path.BaseName().value(), id);
+    SaveDirs();
+  }
+  return id;
+}
+
+void ProfilesSync::SaveDirs() {
+  base::DictValue dict;
+  for (const auto& [dir, id] : dirs_) {
+    dict.Set(dir, id);
+  }
+  files_->PostTask(FROM_HERE, base::BindOnce(
+                                  [](base::DictValue dirs) {
+                                    WriteJson(DirsFile(), base::Value(std::move(dirs)));
+                                  },
+                                  std::move(dict)));
+}
+
+void ProfilesSync::WriteRecord(const std::string& id, const ProfileRecord& record) {
+  files_->PostTask(FROM_HERE, base::BindOnce(&UpdateRecordFile, id, record));
+}
+
+void ProfilesSync::LocalColourChanged(const base::FilePath& profile_path, SkColor colour) {
+  if (applying_) {
+    return;
+  }
+  const std::string id = IdOf(profile_path);
+  const auto it = records_.find(id);
+  if (it == records_.end() || it->second.colour == colour) {
+    return;
+  }
+  it->second.colour = colour;
+  WriteRecord(id, it->second);
+  if (ProfileAttributesEntry* entry = g_browser_process->profile_manager()
+                                          ->GetProfileAttributesStorage()
+                                          .GetProfileAttributesWithPath(profile_path)) {
+    entry->SetProfileThemeColors(GetProfileThemeColorsForAutogeneratedColor(colour));
+  }
+}
+
+void ProfilesSync::OnProfileAdded(const base::FilePath& profile_path) {
+  if (applying_) {
+    return;
+  }
+  // Made here, in Chromium's own way: a new profile on every machine.
+  const std::string id = IdOf(profile_path);
+  if (records_.contains(id)) {
+    return;
+  }
+  ProfileAttributesEntry* entry = g_browser_process->profile_manager()
+                                      ->GetProfileAttributesStorage()
+                                      .GetProfileAttributesWithPath(profile_path);
+  ProfileRecord record;
+  record.name = entry ? base::UTF16ToUTF8(entry->GetLocalProfileName()) : std::string("Profile");
+  const std::array<uint8_t, 3>& colour = kColours[records_.size() % kColours.size()];
+  record.colour = SkColorSetRGB(colour[0], colour[1], colour[2]);
+  record.created = static_cast<double>(NowMs());
+  WriteRecord(id, record);
+  records_.emplace(id, record);
+  known_.insert(id);
+}
+
+void ProfilesSync::OnProfileWasRemoved(const base::FilePath& profile_path,
+                                       const std::u16string& profile_name) {
+  const std::string id = KnownIdOf(profile_path);
+  if (id.empty() || !records_.contains(id)) {
+    return;
+  }
+  // Removed here: with its bookmarks, on every machine, as removing a profile is everywhere.
+  records_.erase(id);
+  known_.erase(id);
+  files_->PostTask(FROM_HERE, base::BindOnce(&RemovePath, SharedProfileDir(id)));
+  files_->PostTask(FROM_HERE, base::BindOnce(&RemovePath, LocalProfileDir(id)));
+}
+
+void ProfilesSync::OnProfileNameChanged(const base::FilePath& profile_path,
+                                        const std::u16string& old_profile_name) {
+  if (applying_) {
+    return;
+  }
+  const std::string id = IdOf(profile_path);
+  const auto it = records_.find(id);
+  ProfileAttributesEntry* entry = g_browser_process->profile_manager()
+                                      ->GetProfileAttributesStorage()
+                                      .GetProfileAttributesWithPath(profile_path);
+  if (it == records_.end() || !entry || entry->IsUsingDefaultName()) {
+    return;
+  }
+  const std::string name = base::UTF16ToUTF8(entry->GetLocalProfileName());
+  if (it->second.name != name) {
+    it->second.name = name;
+    WriteRecord(id, it->second);
+  }
+}
+
+void ProfilesSync::OnProfileAdded(Profile* profile) {
+  // A profile's colour is its theme once it is open.
+  if (!profile->IsRegularProfile()) {
+    return;
+  }
+  const auto it = records_.find(KnownIdOf(profile->GetPath()));
+  if (it != records_.end()) {
+    base::AutoReset<bool> applying(&applying_, true);
+    ApplyTheme(profile, it->second);
+  }
+}
+
+bool ProfilesSync::DeferShow(Profile* profile, base::OnceClosure show) {
+  const std::string id = KnownIdOf(profile->GetOriginalProfile()->GetPath());
+  const auto it = records_.find(id);
+  if (it == records_.end() || it->second.lock_hash.empty() || unlocked_.contains(id)) {
+    return false;
+  }
+  std::vector<base::OnceClosure>& waiting = waiting_[id];
+  waiting.push_back(std::move(show));
+  if (waiting.size() == 1) {
+    AskToUnlock(id, base::UTF8ToUTF16(it->second.name), it->second);
+  }
+  return true;
+}
+
+void ProfilesSync::AskToUnlock(const std::string& id,
+                               const std::u16string& name,
+                               const ProfileRecord& record) {
+  ShowProfileLockDialog(name, record.lock_kind == "pin", record.lock_salt, record.lock_hash,
+                        base::BindOnce(&ProfilesSync::Unlocked, weak_factory_.GetWeakPtr(), id));
+}
+
+void ProfilesSync::Unlocked(const std::string& id, bool opened) {
+  std::vector<base::OnceClosure> waiting = std::move(waiting_[id]);
+  waiting_.erase(id);
+  if (opened) {
+    unlocked_.insert(id);
+    for (base::OnceClosure& show : waiting) {
+      std::move(show).Run();
+    }
+    return;
+  }
+  // Not opened: its waiting windows go, never having been seen.
+  std::vector<BrowserWindowInterface*> windows;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [this, &id, &windows](BrowserWindowInterface* browser) {
+        if (KnownIdOf(browser->GetProfile()->GetOriginalProfile()->GetPath()) == id) {
+          windows.push_back(browser);
+        }
+        return true;
+      });
+  for (BrowserWindowInterface* browser : windows) {
+    browser->GetWindow()->Close();
+  }
+}
+
+void ProfilesSync::OnBrowserClosed(BrowserWindowInterface* closed) {
+  // The last of a profile's windows closing locks it again.
+  const std::string id = KnownIdOf(closed->GetProfile()->GetOriginalProfile()->GetPath());
+  if (!unlocked_.contains(id)) {
+    return;
+  }
+  bool another = false;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [this, closed, &id, &another](BrowserWindowInterface* browser) {
+        if (browser != closed &&
+            KnownIdOf(browser->GetProfile()->GetOriginalProfile()->GetPath()) == id) {
+          another = true;
+          return false;
+        }
+        return true;
+      });
+  if (!another) {
+    unlocked_.erase(id);
+  }
+}
+
