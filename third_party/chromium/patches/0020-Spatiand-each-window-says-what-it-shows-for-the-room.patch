+
+#ifndef UI_OZONE_PLATFORM_WAYLAND_HOST_SPATIAND_XR_H_
+#define UI_OZONE_PLATFORM_WAYLAND_HOST_SPATIAND_XR_H_
+
+#include <cstdint>
+#include <string>
+
+#include "ui/ozone/platform/wayland/common/wayland_object.h"
+
+namespace ui {
+
+class WaylandConnection;
+class WaylandWindow;
+
+// Spatiand's room's own protocol, spatiand_xr_v1 (crates/spatiand-proto in Spatiand), as far as
+// SpatiMesh needs it: each toplevel's object, which the room asks what the window shows
+// (`describe`, since 9) for its dictation and its assistant. The answer is the browser's
+// (ui::RunSpatiandDescribe); asked of a window no one answers for, it is closed at once. Nothing
+// else of the protocol is asked for, so the room treats the window as before.
+class SpatiandXr : public wl::GlobalObjectRegistrar<SpatiandXr> {
+ public:
+  static constexpr char kInterfaceName[] = "spatiand_xr_v1";
+
+  static void Instantiate(WaylandConnection* connection,
+                          wl_registry* registry,
+                          uint32_t name,
+                          const std::string& interface,
+                          uint32_t version);
+
+  // A toplevel's object, made once per window (again after a Hide, it is kept), and let go of
+  // before the window's surface is.
+  static void Attach(WaylandWindow* window);
+  static void Detach(WaylandWindow* window);
+};
+
+}  // namespace ui
+
+#endif  // UI_OZONE_PLATFORM_WAYLAND_HOST_SPATIAND_XR_H_
