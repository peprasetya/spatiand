+namespace gpu {
+
+// Spatiand, for Chromium's Linux build on Android's libc (SpatiMesh on the Beam Pro,
+// android-libc/0028): an Android hardware buffer that a video decoder wrote a picture into, as a
+// shared image the compositor samples without a copy. On the Deck a picture is a dmabuf and an
+// OzoneImageBacking; Android's decoders give hardware buffers instead, in the GPU's own YUV layout,
+// which ANGLE imports as an EGLImage (EGL_NATIVE_BUFFER_ANDROID, its
+// AHardwareBufferImageSiblingVkSpatiand) and samples as a GL_TEXTURE_EXTERNAL_OES through Vulkan's
+// Y'CbCr conversion, the external sampler a multiplanar format that prefers one asks for.
+//
+// Read only: the GPU waits for the decoder to have finished the picture (its fence) before it
+// first reads it, and the picture goes back to the decoder when the video frame holding it is let
+// go, which the compositor does only once its reads are done (read lock fences).
+class GPU_GLES2_EXPORT SpatiandHardwareBufferImageBacking
+    : public ClearTrackingSharedImageBacking {
+ public:
+  // Takes a reference to `buffer` for its life. `decoded` signals once the decoder has finished
+  // the picture (none: finished).
+  SpatiandHardwareBufferImageBacking(const Mailbox& mailbox,
+                                     const SharedImageInfo& si_info,
+                                     AHardwareBuffer* buffer,
+                                     base::ScopedFD decoded);
+  ~SpatiandHardwareBufferImageBacking() override;
+
+  SpatiandHardwareBufferImageBacking(const SpatiandHardwareBufferImageBacking&) = delete;
+  SpatiandHardwareBufferImageBacking& operator=(const SpatiandHardwareBufferImageBacking&) =
+      delete;
+
+  // Whether this process can make such backings (Android's buffer calls found).
+  static bool IsSupported();
+
+  // SharedImageBacking:
+  SharedImageBackingType GetType() const override;
+
+ protected:
+  std::unique_ptr<GLTexturePassthroughImageRepresentation> ProduceGLTexturePassthrough(
+      SharedImageManager* manager,
+      MemoryTypeTracker* tracker) override;
+  std::unique_ptr<SkiaGaneshImageRepresentation> ProduceSkiaGanesh(
+      SharedImageManager* manager,
+      MemoryTypeTracker* tracker,
+      scoped_refptr<SharedContextState> context_state) override;
+
+ private:
+  class GLTexturePassthroughRepresentation;
+
+  // Has the GPU wait for the decoder before its first read (later reads, in the same context,
+  // come after it).
+  void WaitForDecoder();
+
+  // Not a raw_ptr: an opaque type of Android's, referenced (AHardwareBuffer_acquire) for life.
+  AHardwareBuffer* const buffer_;
+  base::ScopedFD decoded_;
+};
+
+}  // namespace gpu
+
+#endif  // GPU_COMMAND_BUFFER_SERVICE_SHARED_IMAGE_SPATIAND_HARDWARE_BUFFER_IMAGE_BACKING_H_
