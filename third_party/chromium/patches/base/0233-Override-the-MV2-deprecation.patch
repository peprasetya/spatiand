From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: uazo <uazo@users.noreply.github.com>
Date: Mon, 2 Sep 2024 07:04:11 +0000
Subject: [PATCH 233/310] Override the MV2 deprecation

Uses the flag used in tests to forcibly enable MV2

License: GPL-2.0-or-later - https://spdx.org/licenses/GPL-2.0-or-later.html
FILE:Override-the-MV2-deprecation.patch
---
 extensions/browser/manifest_v2_handler.cc |  2 +-
 extensions/common/extension.cc            | 35 +++++++++++++++++++----
 2 files changed, 30 insertions(+), 7 deletions(-)

diff --git a/extensions/browser/manifest_v2_handler.cc b/extensions/browser/manifest_v2_handler.cc
index 5841d3dfbc..5e6b5c88e2 100644
--- a/extensions/browser/manifest_v2_handler.cc
+++ b/extensions/browser/manifest_v2_handler.cc
@@ -32,7 +32,7 @@ namespace extensions {
 namespace {
 
 // Whether to override the MV2 deprecation for testing purposes.
-bool g_allow_mv2_for_testing = false;
+bool g_allow_mv2_for_testing = true;
 
 // Returns the suffix to use for histograms related to the manifest location
 // grouping.
diff --git a/extensions/common/extension.cc b/extensions/common/extension.cc
index 28a3cac375..8f0fbaaaef 100644
--- a/extensions/common/extension.cc
+++ b/extensions/common/extension.cc
@@ -97,12 +97,6 @@ bool IsManifestSupported(int manifest_version,
   // Supported versions are always safe.
   if (manifest_version >= kMinimumSupportedManifestVersion &&
       manifest_version <= kMaximumSupportedManifestVersion) {
-    // Emit a warning for unpacked extensions on Manifest V2 warning that
-    // MV2 is deprecated.
-    if (type == Manifest::Type::kExtension && manifest_version == 2 &&
-        Manifest::IsUnpackedLocation(location)) {
-      *warning = errors::kManifestV2IsDeprecatedWarning;
-    }
     return true;
   }
 
@@ -183,6 +177,32 @@ bool ComputeExtensionID(const base::DictValue& manifest,
   return true;
 }
 
+// Spatiand: an unpacked extension in SpatiMesh's shared folder, at
+// apps/spatimesh/profiles/<profile>/extension-files/<id>, is the copy of one
+// loaded from a folder on another machine, and keeps the id it has there,
+// which is the copy's folder's name: one with no "key" has an id made from its
+// path on that machine, which no path here would give
+// (chrome/browser/spatiand/extension_sync.cc). A "key" says the same id, and
+// is taken as it would be anywhere.
+ExtensionId SpatiandSharedId(const base::FilePath& path,
+                             mojom::ManifestLocation location,
+                             const base::DictValue& manifest) {
+  if (!Manifest::IsUnpackedLocation(location) ||
+      manifest.Find(keys::kPublicKey)) {
+    return ExtensionId();
+  }
+  const std::string id = path.BaseName().MaybeAsASCII();
+  const base::FilePath copies = path.DirName();
+  const base::FilePath profiles = copies.DirName().DirName();
+  if (!crx_file::id_util::IdIsValid(id) ||
+      copies.BaseName().value() != FILE_PATH_LITERAL("extension-files") ||
+      profiles.BaseName().value() != FILE_PATH_LITERAL("profiles") ||
+      profiles.DirName().BaseName().value() != FILE_PATH_LITERAL("spatimesh")) {
+    return ExtensionId();
+  }
+  return id;
+}
+
 std::u16string InvalidManifestVersionError(const char* manifest_version_error,
                                            bool is_platform_app) {
   std::string valid_version;
@@ -246,6 +266,9 @@ scoped_refptr<Extension> Extension::Create(const base::FilePath& path,
   ExtensionId extension_id;
   if (!explicit_id.empty()) {
     extension_id = explicit_id;
+  } else if (ExtensionId shared = SpatiandSharedId(path, location, value);
+             !shared.empty()) {
+    extension_id = std::move(shared);
   } else if (!ComputeExtensionID(value, path, flags, error, &extension_id)) {
     return nullptr;
   }
