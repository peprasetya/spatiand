+std::unique_ptr<AcceleratedSurface::RenderTarget> AcceleratedSurface::RenderTargetIOSurface::create(AcceleratedSurface& surface, const IntSize& size)
+{
+    // Not global (which any process could open by its ID): the UI process is handed it in
+    // private, as its ID (WPESurfaces.h).
+    int width = size.width(), height = size.height(), bytesPerElement = 4;
+    uint32_t format = 'BGRA';
+    CFNumberRef w = CFNumberCreate(nullptr, kCFNumberIntType, &width);
+    CFNumberRef h = CFNumberCreate(nullptr, kCFNumberIntType, &height);
+    CFNumberRef bpe = CFNumberCreate(nullptr, kCFNumberIntType, &bytesPerElement);
+    CFNumberRef pf = CFNumberCreate(nullptr, kCFNumberSInt32Type, &format);
+    const void* keys[] = { kIOSurfaceWidth, kIOSurfaceHeight, kIOSurfaceBytesPerElement, kIOSurfacePixelFormat };
+    const void* values[] = { w, h, bpe, pf };
+    CFDictionaryRef properties = CFDictionaryCreate(nullptr, keys, values, 4, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    IOSurfaceRef ioSurface = IOSurfaceCreate(properties);
+    CFRelease(properties);
+    CFRelease(w);
+    CFRelease(h);
+    CFRelease(bpe);
+    CFRelease(pf);
+    if (!ioSurface) {
+        WTFLogAlways("Failed to create an IOSurface of size %dx%d", width, height);
+        return nullptr;
+    }
+
+    // A pbuffer of it, and a texture bound to that. The rendering context's own config is made
+    // for no surface at all (WebKit renders surfaceless) and makes no pbuffer -- ANGLE said
+    // EGL_BAD_ATTRIBUTE -- so one that makes pbuffers is chosen (ANGLE says which texture target
+    // it binds to in an attribute of its own, not EGL_BIND_TO_TEXTURE_RGBA).
+    EGLDisplay display = eglGetCurrentDisplay();
+    const EGLint configAttributes[] = {
+        EGL_SURFACE_TYPE, EGL_PBUFFER_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+        EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8,
+        EGL_NONE
+    };
+    EGLConfig config = nullptr;
+    EGLint found = 0;
+    if (!eglChooseConfig(display, configAttributes, &config, 1, &found) || !found) {
+        WTFLogAlways("No EGL config makes a pbuffer of an IOSurface (EGL error %#x)", eglGetError());
+        CFRelease(ioSurface);
+        return nullptr;
+    }
+    // A rectangle texture where ANGLE runs on OpenGL, a 2D one on Metal: ANGLE says which.
+    EGLint target = EGL_TEXTURE_2D;
+    eglGetConfigAttrib(display, config, eglBindToTextureTargetANGLE, &target);
+    unsigned glTarget = target == eglTextureRectangleANGLE ? glTextureRectangleANGLE : GL_TEXTURE_2D;
+    const EGLint attributes[] = {
+        EGL_WIDTH, width,
+        EGL_HEIGHT, height,
+        eglIOSurfacePlaneANGLE, 0,
+        EGL_TEXTURE_TARGET, target,
+        eglTextureInternalFormatANGLE, GL_BGRA_EXT,
+        EGL_TEXTURE_FORMAT, EGL_TEXTURE_RGBA,
+        eglTextureTypeANGLE, GL_UNSIGNED_BYTE,
+        EGL_NONE
+    };
+    EGLSurface pbuffer = eglCreatePbufferFromClientBuffer(display, eglIOSurfaceANGLE, ioSurface, config, attributes);
+    if (pbuffer == EGL_NO_SURFACE) {
+        WTFLogAlways("Failed to make a pbuffer of an IOSurface (EGL error %#x)", eglGetError());
+        CFRelease(ioSurface);
+        return nullptr;
+    }
+    unsigned texture = 0;
+    glGenTextures(1, &texture);
+    glBindTexture(glTarget, texture);
+    if (!eglBindTexImage(display, pbuffer, EGL_BACK_BUFFER)) {
+        WTFLogAlways("Failed to bind an IOSurface to a texture (EGL error %#x)", eglGetError());
+        glDeleteTextures(1, &texture);
+        eglDestroySurface(display, pbuffer);
+        CFRelease(ioSurface);
+        return nullptr;
+    }
+    return makeUnique<RenderTargetIOSurface>(surface, size, ioSurface, pbuffer, texture, glTarget);
+}
+
+AcceleratedSurface::RenderTargetIOSurface::RenderTargetIOSurface(AcceleratedSurface& surface, const IntSize& size, void* ioSurface, void* pbuffer, unsigned texture, unsigned target)
+    : RenderTargetShareableBuffer(surface, size)
+    , m_ioSurface(ioSurface)
+    , m_pbuffer(pbuffer)
+    , m_texture(texture)
+{
+    glBindFramebuffer(GL_FRAMEBUFFER, m_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, target, m_texture, 0);
+    if (m_surface->useSkia())
+        createSkiaSurfaceForFramebuffer(m_fbo);
+
+    uint32_t surfaceID = IOSurfaceGetID(static_cast<IOSurfaceRef>(m_ioSurface));
+    if (!wpe_surfaces_post(static_cast<IOSurfaceRef>(m_ioSurface), surfaceID))
+        WTFLogAlways("The UI process could not be handed a picture (IOSurface %u)", surfaceID);
+    WebProcess::singleton().parentProcessConnection()->send(Messages::AcceleratedBackingStore::DidCreateIOSurfaceBuffer(m_id, surfaceID, size), m_surface->surfaceID());
+}
+
+// The frame is in the IOSurface before anyone is told of it: Skia's work submitted and the GPU
+// waited for. (The shared-memory target gets this from reading its pixels back; without it the
+// embedder saw an IOSurface still empty.)
+void AcceleratedSurface::RenderTargetIOSurface::didRenderFrame()
+{
+    if (m_surface->useSkia()) {
+        auto& display = PlatformDisplay::sharedDisplay();
+        GLContext::ScopedGLContextCurrent scopedCurrent(*display.skiaGLContext());
+        display.skiaGrContext()->flushAndSubmit(GrSyncCpu::kYes);
+        glFinish();
+        return;
+    }
+    glFinish();
+}
+
+AcceleratedSurface::RenderTargetIOSurface::~RenderTargetIOSurface()
+{
+    m_skiaSurface = nullptr;
+    EGLDisplay display = eglGetCurrentDisplay();
+    if (m_texture) {
+        eglReleaseTexImage(display, m_pbuffer, EGL_BACK_BUFFER);
+        glDeleteTextures(1, &m_texture);
+    }
+    if (m_pbuffer)
+        eglDestroySurface(display, m_pbuffer);
+    if (m_ioSurface)
+        CFRelease(static_cast<IOSurfaceRef>(m_ioSurface));
+}
