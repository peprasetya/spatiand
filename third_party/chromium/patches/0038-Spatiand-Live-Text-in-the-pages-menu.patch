+#if BUILDFLAG(ENABLE_PDF)
+// A full-page PDF -- a PDF opened as it is, or SpatiLoupe's in its place: the page most on show,
+// by the PDF's own text (a scan's too, once the room's reader has read it), where a web page's is
+// its body's; the page's script cannot reach a PDF's text. False when it is not one.
+bool DescribePdf(content::WebContents* contents, scoped_refptr<Asked> asked) {
+  pdf::PDFDocumentHelper* pdf = pdf::PDFDocumentHelper::MaybeGetForFullPagePdf(*contents);
+  if (!pdf || !pdf->IsDocumentLoadComplete()) {
+    return false;
+  }
+  pdf->GetMostVisiblePageIndex(base::BindOnce(
+      [](base::WeakPtr<content::WebContents> contents, scoped_refptr<Asked> asked,
+         std::optional<uint32_t> index) {
+        pdf::PDFDocumentHelper* pdf =
+            contents ? pdf::PDFDocumentHelper::MaybeGetForFullPagePdf(*contents) : nullptr;
+        if (!pdf || !index) {
+          asked->Answer(std::string());
+          return;
+        }
+        pdf->GetPageText(
+            static_cast<int32_t>(*index),
+            base::BindOnce(
+                [](scoped_refptr<Asked> asked, uint32_t index, const std::u16string& page_text) {
+                  // PDFium ends a line with a carriage return as well.
+                  std::u16string text = page_text;
+                  base::ReplaceSubstringsAfterOffset(&text, 0, u"\r\n", u"\n");
+                  base::DictValue said;
+                  said.Set("text", "Page " + base::NumberToString(index + 1) + "\n" +
+                                       base::UTF16ToUTF8(text));
+                  asked->Answer(base::WriteJson(said).value_or(std::string()));
+                },
+                asked, *index));
+      },
+      contents->GetWeakPtr(), asked));
+  return true;
+}
+#endif
