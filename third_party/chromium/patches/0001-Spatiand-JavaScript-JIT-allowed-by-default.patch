From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Spatiand build <claude@prasetya.id>
Date: Thu, 29 Oct 2026 18:39:03 +0000
Subject: [PATCH 281/310] Spatiand: JavaScript JIT allowed by default

Cromite blocks the JIT for every site unless allowed one by one, which leaves heavy pages
(YouTube, Google Sheets, Inoreader) crawling on the Deck; upstream Chromium allows it. The
per-site setting stays, to block it where wanted.
---
 .../content_settings/core/browser/content_settings_registry.cc  | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/components/content_settings/core/browser/content_settings_registry.cc b/components/content_settings/core/browser/content_settings_registry.cc
index f9799b561b..401c6f3c01 100644
--- a/components/content_settings/core/browser/content_settings_registry.cc
+++ b/components/content_settings/core/browser/content_settings_registry.cc
@@ -564,7 +564,7 @@ void ContentSettingsRegistry::Init() {
            PermissionSettingsInfo::EXCEPTIONS_ON_SECURE_ORIGINS_ONLY);
 
   Register(ContentSettingsType::JAVASCRIPT_JIT, "javascript-jit",
-           CONTENT_SETTING_BLOCK, WebsiteSettingsInfo::UNSYNCABLE,
+           CONTENT_SETTING_ALLOW, WebsiteSettingsInfo::UNSYNCABLE,
            /*allowlisted_primary_schemes=*/{},
            /*valid_settings=*/{CONTENT_SETTING_ALLOW, CONTENT_SETTING_BLOCK},
            WebsiteSettingsInfo::TOP_ORIGIN_ONLY_SCOPE,
