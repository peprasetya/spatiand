+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_SPATIKEY_FILLED_H_
+#define COMPONENTS_SPATIKEY_FILLED_H_
+
+#include <string>
+
+#include "url/origin.h"
+
+namespace spatikey {
+
+// Written where a password would be, in the credentials Chromium's password manager is given in
+// place of the real ones: it says "there may be a login here, ask SpatiKey" and nothing about it.
+// Should it ever be shown it explains itself.
+inline constexpr char16_t kPlaceholder[] = u"(in SpatiKey)";
+
+// Chromium's name for a login not yet known: the one line SpatiKey shows in a login field.
+inline constexpr char16_t kAnyLogin[] = u"SpatiKey";
+
+// A login filled from SpatiKey is one the vault already has: when the page then submits it, nothing
+// needs saving. Remembered as a salted hash, for as long as a login takes, and in memory only.
+void RememberFilled(const url::Origin& origin, const std::u16string& password);
+bool WasFilled(const url::Origin& origin, const std::u16string& password);
+
+}  // namespace spatikey
+
+#endif  // COMPONENTS_SPATIKEY_FILLED_H_
