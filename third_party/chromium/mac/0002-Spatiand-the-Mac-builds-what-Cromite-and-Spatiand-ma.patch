+#if BUILDFLAG(IS_LINUX)
   if (spatiand::ProfilesSync* profiles = spatiand::ProfilesSync::Get();
       profiles && profiles->AnyLock()) {
     AddProfileManagementFeatureButton(
@@ -1411,4 +1417,5 @@ void ProfileMenuView::BuildProfileManagementFeatureButtons() {
