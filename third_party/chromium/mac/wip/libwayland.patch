diff -ru a/src/wayland-client.c b/src/wayland-client.c
--- a/src/wayland-client.c	2026-11-13 08:27:51.580671402 +0700
+++ b/src/wayland-client.c	2026-11-13 08:27:51.847161731 +0700
@@ -2056,7 +2056,16 @@
 			timespec_sub_saturate(&result, &deadline, &now);
 			remaining_timeout = &result;
 		}
+#ifdef __APPLE__
+		/* macOS has no ppoll(): poll() with the remaining time in
+		 * milliseconds, rounded up so that it never wakes early. */
+		ret = poll(pfd, 1, remaining_timeout ?
+			   (int)(remaining_timeout->tv_sec * 1000 +
+				 (remaining_timeout->tv_nsec + 999999) / 1000000) :
+			   -1);
+#else
 		ret = ppoll(pfd, 1, remaining_timeout, NULL);
+#endif
 	} while (ret == -1 && errno == EINTR);
 
 	return ret;
