+  --spatiand-separator: rgba(255, 255, 255, 0.10);
+  --spatiand-field: rgba(255, 255, 255, 0.08);
+  --spatiand-font: Roboto, 'Noto Sans', sans-serif;
+
   --iron-icon-height: 20px;
   --iron-icon-width: 20px;
-  --viewer-border-color: rgb(94, 94, 94);
-  --viewer-icon-focus-outline-color: var(--google-grey-500);
+  --viewer-border-color: var(--spatiand-separator);
+  --viewer-icon-focus-outline-color: var(--spatiand-mark);
 <if expr="enable_pdf_ink2">
-  --viewer-icon-ink-background-color: rgb(143, 143, 143);
-  --viewer-icon-ink-fill-color: rgb(199, 199, 199);
-  --viewer-icon-ink-selected-fill-color: rgb(168, 199, 250);
-  --viewer-icon-ink-selected-background-color: rgba(76, 141, 246, 0.32);
+  --viewer-icon-ink-background-color: var(--spatiand-ink-hint);
+  --viewer-icon-ink-fill-color: var(--spatiand-ink-row);
+  --viewer-icon-ink-selected-fill-color: var(--spatiand-mark);
+  --viewer-icon-ink-selected-background-color: var(--spatiand-selected);
   /* Always use light mode version of cr-fallback-color-primary. */
   --viewer-text-annotation-active-color: rgb(11, 87, 208);
 
@@ -52,7 +67,22 @@ html {
   --viewer-text-annotation-padding-y-rotated:
       calc(2 * var(--viewer-text-annotation-offset-y-rotated));
 </if>
-  --viewer-pdf-toolbar-background-color: rgb(60, 60, 60);
-  --viewer-side-background-color: rgb(40, 41, 42);
-  --viewer-text-input-selection-color: rgba(255, 255, 255, 0.3);
+  --viewer-pdf-toolbar-background-color: var(--spatiand-panel);
+  --viewer-side-background-color: var(--spatiand-panel);
+  --viewer-text-input-selection-color: var(--spatiand-selected);
+}
+
+@media (prefers-color-scheme: light) {
+  html {
+    --spatiand-ground: rgb(244, 245, 248);
+    --spatiand-panel: rgb(232, 233, 236);
+    --spatiand-hover: rgba(0, 0, 0, 0.04);
+    --spatiand-selected: rgba(41, 112, 242, 0.16);
+    --spatiand-mark: rgb(26, 102, 224);
+    --spatiand-ink: rgb(15, 18, 26);
+    --spatiand-ink-row: rgb(41, 46, 61);
+    --spatiand-ink-hint: rgb(112, 122, 143);
+    --spatiand-separator: rgba(0, 0, 0, 0.075);
+    --spatiand-field: rgba(0, 0, 0, 0.06);
+  }
 }
