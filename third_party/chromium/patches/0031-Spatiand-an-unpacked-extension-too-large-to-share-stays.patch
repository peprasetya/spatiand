+// The extension in `from`, to where every machine can load it from: only the files that changed
+// are written (each a change every machine syncs), and what is gone from `from` goes from the copy,
+// so that the deletion travels too. Refused, with the copy left as it was, if a file is more than
+// the synchroniser sends or the whole more than an extension is worth sharing.
+std::optional<Copy> CopyFiles(const base::FilePath& from, const base::FilePath& to) {
+  const std::optional<std::map<base::FilePath, int64_t>> found = ListShared(from);
+  if (!found) {
+    LOG(WARNING) << "SpatiMesh: the extension in " << from << " is too large to go to other "
+                 << "machines (a file over " << (kLargestFile >> 20) << " MB, or "
+                 << (kLargestExtension >> 20) << " MB in all); it stays where it was loaded";
+    return std::nullopt;
