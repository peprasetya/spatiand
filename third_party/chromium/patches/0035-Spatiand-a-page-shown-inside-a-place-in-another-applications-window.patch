 #if BUILDFLAG(IS_OZONE)
diff --git a/chrome/browser/ui/extensions/application_launch.cc b/chrome/browser/ui/extensions/application_launch.cc
index 05e5e01115..7fbff8f2c5 100644
--- a/chrome/browser/ui/extensions/application_launch.cc
+++ b/chrome/browser/ui/extensions/application_launch.cc
@@ -523,6 +523,9 @@ BrowserWindowInterface* CreateApplicationWindow(
 
   browser_params.initial_show_state =
       DetermineWindowShowState(profile, params.container, extension);
+  // Spatiand: started as the inside of a place in another application's window.
+  browser_params.spatiand_embed_token =
+      params.command_line.GetSwitchValueASCII("spatiand-embed");
 
   return CreateBrowserWindow(std::move(browser_params));
 }
@@ -601,12 +604,19 @@ void OpenApplicationWithReenablePrompt(Profile* profile,
   OpenEnabledApplication(profile, std::move(params));
 }
 
-WebContents* OpenAppShortcutWindow(Profile* profile, const GURL& url) {
+WebContents* OpenAppShortcutWindow(Profile* profile,
+                                   const GURL& url,
+                                   const base::CommandLine* command_line) {
   apps::AppLaunchParams launch_params(
       std::string(),  // this is a URL app. No app id.
       apps::LaunchContainer::kLaunchContainerWindow,
       WindowOpenDisposition::NEW_WINDOW, apps::LaunchSource::kFromCommandLine);
   launch_params.override_url = url;
+  // Spatiand: the start's own command line, which says a place to be the inside of
+  // (--spatiand-embed) -- the forwarded one, when SpatiMesh was running already.
+  if (command_line) {
+    launch_params.command_line = *command_line;
+  }
 
   return OpenApplicationWindow(profile, launch_params, url);
 }
diff --git a/chrome/browser/ui/extensions/application_launch.h b/chrome/browser/ui/extensions/application_launch.h
