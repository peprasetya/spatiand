+void PasswordAutofillManager::AskSpatiKey() {
+  // Where this frame is, as the browser knows it: never as the page says.
+  const url::Origin origin = password_manager_driver_->GetLastCommittedOrigin();
+  base::DictValue fields;
+  fields.Set("origin", origin.Serialize());
+  spatikey::Ask("fill", std::move(fields),
+                base::BindOnce(&PasswordAutofillManager::OnSpatiKeyAnswer,
+                               weak_ptr_factory_.GetWeakPtr(), origin));
+}
+
+void PasswordAutofillManager::OnSpatiKeyAnswer(url::Origin origin,
+                                               spatikey::Answer answer) {
+  if (!answer.has_value()) {
+    // Saying no, or not answering, needs no explaining to whoever did it.
+    if (answer.error().code != "denied" && answer.error().code != "timeout") {
+      spatikey::ReportProblem(base::UTF8ToUTF16(answer.error().message));
+    }
+    return;
+  }
+  // The page may have moved on while the touch was waited for.
+  if (!fill_data_ || password_manager_driver_->GetLastCommittedOrigin() != origin) {
+    return;
+  }
+  std::vector<autofill::PasswordAndMetadata> logins;
+  if (const base::ListValue* listed = answer->FindList("logins")) {
+    for (const base::Value& one : *listed) {
+      const std::string* username = one.is_dict() ? one.GetDict().FindString("username") : nullptr;
+      const std::string* password = one.is_dict() ? one.GetDict().FindString("password") : nullptr;
+      if (!username || !password) {
+        continue;
+      }
+      autofill::PasswordAndMetadata login;
+      login.username_value = base::UTF8ToUTF16(*username);
+      login.password_value = base::UTF8ToUTF16(*password);
+      spatikey::RememberFilled(origin, login.password_value);
+      logins.push_back(std::move(login));
+    }
+  }
+  if (logins.empty()) {
+    return;
+  }
+  if (logins.size() == 1) {
+    FillSuggestion(logins.front());
+    return;
+  }
+  // Several: chosen from as any two saved logins are, and let go of when the popup closes.
+  std::vector<Suggestion> suggestions;
+  for (const autofill::PasswordAndMetadata& login : logins) {
+    Suggestion suggestion(
+        login.username_value.empty()
+            ? l10n_util::GetStringUTF16(IDS_PASSWORD_MANAGER_EMPTY_LOGIN)
+            : login.username_value,
+        autofill::SuggestionType::kPasswordEntry);
+    suggestion.labels = {{Suggestion::Text(std::u16string(
+        login.password_value.size(), constants::kPasswordReplacementChar))}};
+    suggestion.icon = Suggestion::Icon::kGlobe;
+    suggestions.push_back(std::move(suggestion));
+  }
+  const gfx::RectF bounds = last_popup_open_args_.element_bounds;
+  const base::i18n::TextDirection direction = last_popup_open_args_.text_direction;
+  if (ShowPopup(last_field_id_, bounds, direction, suggestions,
+                /*is_for_webauthn_request=*/false)) {
+    spatikey_logins_ = std::move(logins);
+  }
+}
