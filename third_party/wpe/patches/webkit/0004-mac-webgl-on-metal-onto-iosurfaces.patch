+#include <wtf/StdLibExtras.h>
+#include <wtf/TZoneMallocInlines.h>
+#include <wtf/ThreadSafeRefCounted.h>
+
+namespace WebCore {
+
+// One IOSurface WebGL draws into: its pbuffer on WebGL's ANGLE (Metal), and the same memory as a
+// texture of the compositor's GL. Kept by the context while it is one of its three, and by each
+// frame of it the compositor has, so that it outlives both.
+class IOSurfaceDrawingBuffer final : public ThreadSafeRefCounted<IOSurfaceDrawingBuffer> {
+public:
+    static RefPtr<IOSurfaceDrawingBuffer> create(GCGLDisplay display, GCGLConfig config, const IntSize& size, bool hasAlpha)
+    {
+        auto* surface = createIOSurface(size);
+        if (!surface)
+            return nullptr;
+        RefPtr<IOSurfaceDrawingBuffer> buffer = adoptRef(*new IOSurfaceDrawingBuffer(display, surface, size));
+        CFRelease(surface);
+
+        const EGLint attributes[] = {
+            EGL_WIDTH, size.width(),
+            EGL_HEIGHT, size.height(),
+            EGL_IOSURFACE_PLANE_ANGLE, 0,
+            EGL_TEXTURE_TARGET, EGL_TEXTURE_2D,
+            EGL_TEXTURE_INTERNAL_FORMAT_ANGLE, hasAlpha ? GL_BGRA_EXT : GL_RGB,
+            EGL_TEXTURE_FORMAT, EGL_TEXTURE_RGBA,
+            EGL_TEXTURE_TYPE_ANGLE, GL_UNSIGNED_BYTE,
+            EGL_NONE
+        };
+        buffer->m_pbuffer = EGL_CreatePbufferFromClientBuffer(display, EGL_IOSURFACE_ANGLE, buffer->m_surface, config, attributes);
+        if (buffer->m_pbuffer == EGL_NO_SURFACE) {
+            buffer->m_pbuffer = nullptr;
+            LOG(WebGL, "IOSurface pbuffer on Metal failed: %x", EGL_GetError());
+            return nullptr;
+        }
+        buffer->m_compositorTexture = importIOSurfaceForCompositor(buffer->m_surface, size.width(), size.height(), hasAlpha, &buffer->m_compositorPbuffer);
+        if (!buffer->m_compositorTexture)
+            return nullptr;
+        return buffer;
+    }
+
+    ~IOSurfaceDrawingBuffer()
+    {
+        if (m_pbuffer)
+            EGL_DestroySurface(m_display, m_pbuffer);
+        if (m_compositorTexture)
+            releaseIOSurfaceForCompositor(m_compositorTexture, m_compositorPbuffer);
+        CFRelease(m_surface);
+    }
+
+    GCEGLSurface pbuffer() const { return m_pbuffer; }
+    unsigned compositorTexture() const { return m_compositorTexture; }
+    const IntSize& size() const LIFETIME_BOUND { return m_size; }
+
+private:
+    IOSurfaceDrawingBuffer(GCGLDisplay display, IOSurfaceRef surface, const IntSize& size)
+        : m_display(display)
+        , m_surface(static_cast<IOSurfaceRef>(const_cast<void*>(CFRetain(surface))))
+        , m_size(size)
+    {
+    }
+
+    // BGRA, as Metal and the compositor's textures both take it.
+    static IOSurfaceRef createIOSurface(const IntSize& size)
+    {
+        int32_t width = size.width(), height = size.height(), bytesPerElement = 4, pixelFormat = 0x42475241 /* 'BGRA' */;
+        int32_t bytesPerRow = static_cast<int32_t>(IOSurfaceAlignProperty(kIOSurfaceBytesPerRow, width * bytesPerElement));
+        int32_t allocSize = static_cast<int32_t>(IOSurfaceAlignProperty(kIOSurfaceAllocSize, bytesPerRow * height));
+        std::array<const void*, 6> keys { kIOSurfaceWidth, kIOSurfaceHeight, kIOSurfaceBytesPerElement, kIOSurfacePixelFormat, kIOSurfaceBytesPerRow, kIOSurfaceAllocSize };
+        std::array<int32_t, 6> numbers { width, height, bytesPerElement, pixelFormat, bytesPerRow, allocSize };
+        std::array<const void*, 6> values { };
+        for (size_t i = 0; i < keys.size(); ++i)
+            values[i] = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type, &numbers[i]);
+        auto properties = CFDictionaryCreate(kCFAllocatorDefault, keys.data(), values.data(), keys.size(), &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        for (auto* value : values)
+            CFRelease(value);
+        auto* surface = IOSurfaceCreate(properties);
+        CFRelease(properties);
+        return surface;
+    }
+
+    GCGLDisplay m_display;
+    IOSurfaceRef m_surface;
+    IntSize m_size;
+    GCEGLSurface m_pbuffer { nullptr };
+    unsigned m_compositorTexture { 0 };
+    void* m_compositorPbuffer { nullptr };
+};
+
+// The end of a frame's drawing on Metal, which the compositor waits for before drawing it -- on
+// its own thread, so that WebGL does not wait for the GPU -- and the frame's IOSurface, kept
+// while the compositor has the frame.
+class IOSurfaceFrameFence final : public GLFence {
+    WTF_MAKE_TZONE_ALLOCATED(IOSurfaceFrameFence);
+public:
+    IOSurfaceFrameFence(GCGLDisplay display, EGLSyncKHR sync, RefPtr<IOSurfaceDrawingBuffer>&& buffer)
+        : m_display(display)
+        , m_sync(sync)
+        , m_buffer(WTF::move(buffer))
+    {
+    }
+
+    ~IOSurfaceFrameFence()
+    {
+        if (m_sync)
+            EGL_DestroySyncKHR(m_display, m_sync);
+    }
+
+    void clientWait() final { wait(); }
+    void serverWait() final { wait(); }
+
+private:
+    void wait()
+    {
+        if (!m_sync)
+            return;
+        EGL_ClientWaitSyncKHR(m_display, m_sync, 0, EGL_FOREVER_KHR);
+        EGL_DestroySyncKHR(m_display, m_sync);
+        m_sync = nullptr;
+    }
+
+    GCGLDisplay m_display;
+    EGLSyncKHR m_sync;
+    RefPtr<IOSurfaceDrawingBuffer> m_buffer;
+};
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(IOSurfaceFrameFence);
+
+// WebGL's own ANGLE on Metal: a display of its own, made once.
+static GCGLDisplay metalDisplay()
+{
+    static GCGLDisplay display = [] () -> GCGLDisplay {
+        const EGLint attributes[] = { EGL_PLATFORM_ANGLE_TYPE_ANGLE, EGL_PLATFORM_ANGLE_TYPE_METAL_ANGLE, EGL_NONE };
+        auto display = EGL_GetPlatformDisplayEXT(EGL_PLATFORM_ANGLE_ANGLE, EGL_DEFAULT_DISPLAY, attributes);
+        if (display == EGL_NO_DISPLAY)
+            return nullptr;
+        EGLint major, minor;
+        if (!EGL_Initialize(display, &major, &minor)) {
+            LOG(WebGL, "ANGLE on Metal: EGL_Initialize failed");
+            return nullptr;
+        }
+        return display;
+    }();
+    return display;
+}
+
+bool GraphicsContextGLTextureMapperIOSurface::checkRequirements()
+{
+    static const char* disabled = getenv("WEBKIT_WEBGL_DISABLE_IOSURFACE");
+    if (disabled && *disabled != '0')
+        return false;
+    if (!PlatformDisplay::sharedDisplay().eglExtensions().ANGLE_iosurface_client_buffer)
+        return false;
+    auto display = metalDisplay();
+    if (!display)
+        return false;
+    const char* extensions = EGL_QueryString(display, EGL_EXTENSIONS);
+    return extensions && WTF::contains(unsafeSpan(extensions), "EGL_ANGLE_iosurface_client_buffer"_span);
+}
+
+RefPtr<GraphicsContextGLTextureMapperIOSurface> GraphicsContextGLTextureMapperIOSurface::create(GraphicsContextGLAttributes&& attributes)
+{
+    auto context = adoptRef(new GraphicsContextGLTextureMapperIOSurface(WTF::move(attributes)));
+    if (!context->initialize())
+        return nullptr;
+    return context;
+}
+
+GraphicsContextGLTextureMapperIOSurface::GraphicsContextGLTextureMapperIOSurface(GraphicsContextGLAttributes&& attributes)
+    : GraphicsContextGLTextureMapperANGLE(WTF::move(attributes))
+{
+    m_ownDisplay = metalDisplay();
+}
+
+GraphicsContextGLTextureMapperIOSurface::~GraphicsContextGLTextureMapperIOSurface()
+{
+    if (makeContextCurrent())
+        freeDrawingBuffers();
+}
+
+bool GraphicsContextGLTextureMapperIOSurface::platformInitialize()
+{
+    m_layerContentsDisplayDelegate = GraphicsLayerContentsDisplayDelegateCoordinated::create();
+
+    // IOSurfaces are taken as pbuffers, bound to WebGL's texture as Metal textures of the same
+    // memory: 2D ones on Metal (on macOS's OpenGL they would be rectangles).
+    const EGLint attributes[] = {
+        EGL_SURFACE_TYPE, EGL_PBUFFER_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+        EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8,
+        EGL_NONE
+    };
+    EGLint found = 0;
+    if (!EGL_ChooseConfig(m_displayObj, attributes, &m_pbufferConfig, 1, &found) || found != 1)
+        return false;
+    EGLint target = 0;
+    EGL_GetConfigAttrib(m_displayObj, m_pbufferConfig, EGL_BIND_TO_TEXTURE_TARGET_ANGLE, &target);
+    if (target != EGL_TEXTURE_2D) {
+        LOG(WebGL, "ANGLE on Metal binds IOSurfaces to %x, not 2D textures", target);
+        return false;
+    }
+    return true;
+}
+
+RefPtr<IOSurfaceDrawingBuffer> GraphicsContextGLTextureMapperIOSurface::createDrawingBuffer() const
+{
+    return IOSurfaceDrawingBuffer::create(m_displayObj, m_pbufferConfig, getInternalFramebufferSize(), contextAttributes().alpha);
+}
+
+void GraphicsContextGLTextureMapperIOSurface::freeDrawingBuffers()
+{
+    if (m_bound) {
+        EGL_ReleaseTexImage(m_displayObj, m_bound->pbuffer(), EGL_BACK_BUFFER);
+        m_bound = nullptr;
+    }
+    // Those the compositor still shows are let go of when it is done with them.
+    for (auto& buffer : m_drawingBuffers)
+        buffer = nullptr;
+}
+
+bool GraphicsContextGLTextureMapperIOSurface::bindNextDrawingBuffer()
+{
+    m_current = (m_current + 1) % m_drawingBuffers.size();
+    auto& next = m_drawingBuffers[m_current];
+    if (!next || next->size() != getInternalFramebufferSize()) {
+        next = createDrawingBuffer();
+        if (!next)
+            return false;
+    }
+
+    ScopedRestoreTextureBinding restoreBinding(TEXTURE_BINDING_2D, TEXTURE_2D);
+    GL_BindTexture(GL_TEXTURE_2D, m_texture);
+    if (m_bound)
+        EGL_ReleaseTexImage(m_displayObj, m_bound->pbuffer(), EGL_BACK_BUFFER);
+    m_bound = next;
+    if (!EGL_BindTexImage(m_displayObj, m_bound->pbuffer(), EGL_BACK_BUFFER)) {
+        m_bound = nullptr;
+        return false;
+    }
+    return true;
+}
+
+bool GraphicsContextGLTextureMapperIOSurface::reshapeDrawingBuffer()
+{
+    freeDrawingBuffers();
+    return bindNextDrawingBuffer();
+}
+
+void GraphicsContextGLTextureMapperIOSurface::prepareForDisplay()
+{
+    if (!makeContextCurrent() || !m_bound)
+        return;
+
+    prepareTexture();
+    // The frame is done when Metal has drawn it: said by a fence, flushed so that it comes.
+    auto sync = EGL_CreateSyncKHR(m_displayObj, EGL_SYNC_FENCE_KHR, nullptr);
+    GL_Flush();
+    RefPtr<IOSurfaceDrawingBuffer> shown = m_bound;
+
+    if (!bindNextDrawingBuffer()) {
+        if (sync != EGL_NO_SYNC_KHR)
+            EGL_DestroySyncKHR(m_displayObj, sync);
+        forceContextLost();
+        return;
+    }
+
+    OptionSet<TextureMapperFlags> flags = TextureMapperFlags::ShouldFlipTexture;
+    if (contextAttributes().alpha)
+        flags.add(TextureMapperFlags::ShouldBlend);
+    auto texture = shown->compositorTexture();
+    auto size = shown->size();
+    std::unique_ptr<GLFence> fence;
+    if (sync != EGL_NO_SYNC_KHR)
+        fence = makeUnique<IOSurfaceFrameFence>(m_displayObj, sync, WTF::move(shown));
+    else {
+        // No fence: the frame is waited for here.
+        GL_Finish();
+    }
+    m_layerContentsDisplayDelegate->setDisplayBuffer(CoordinatedPlatformLayerBufferRGB::create(texture, size, flags, WTF::move(fence)));
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(WEBGL) && USE(COORDINATED_GRAPHICS) && OS(DARWIN) && PLATFORM(WPE)
