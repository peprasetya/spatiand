+#include "config.h"
+#include "GraphicsContextGLTextureMapperIOSurface.h"
+
+#if ENABLE(WEBGL) && USE(COORDINATED_GRAPHICS) && OS(DARWIN) && PLATFORM(WPE)
+#include "GLContext.h"
+#include "PlatformDisplay.h"
+#include <epoxy/egl.h>
+#include <epoxy/gl.h>
+
+namespace WebCore {
+
+// EGL_ANGLE_iosurface_client_buffer's, which libepoxy's headers have not got.
+static constexpr EGLenum eglIOSurfaceANGLE = 0x3454;
+static constexpr EGLint eglIOSurfacePlaneANGLE = 0x345A;
+static constexpr EGLint eglTextureTypeANGLE = 0x345C;
+static constexpr EGLint eglTextureInternalFormatANGLE = 0x345D;
+static constexpr GLenum glBGRAExt = 0x80E1;
+
+// Made in the context the compositor shares textures with (PlatformDisplay's sharing context),
+// where WebGL's own textures were shared before: the compositor draws it as any of them.
+unsigned importIOSurfaceForCompositor(void* ioSurface, int width, int height, bool hasAlpha, void** pbuffer)
+{
+    auto& platformDisplay = PlatformDisplay::sharedDisplay();
+    auto* sharingContext = platformDisplay.sharingGLContext();
+    if (!sharingContext)
+        return 0;
+    GLContext::ScopedGLContextCurrent scopedCurrent(*sharingContext);
+
+    EGLDisplay display = platformDisplay.eglDisplay();
+    const EGLint configAttributes[] = {
+        EGL_SURFACE_TYPE, EGL_PBUFFER_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+        EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8,
+        EGL_NONE
+    };
+    EGLConfig config = nullptr;
+    EGLint found = 0;
+    if (!eglChooseConfig(display, configAttributes, &config, 1, &found) || !found)
+        return 0;
+    const EGLint attributes[] = {
+        EGL_WIDTH, width,
+        EGL_HEIGHT, height,
+        eglIOSurfacePlaneANGLE, 0,
+        EGL_TEXTURE_TARGET, EGL_TEXTURE_2D,
+        eglTextureInternalFormatANGLE, static_cast<EGLint>(hasAlpha ? glBGRAExt : GL_RGB),
+        EGL_TEXTURE_FORMAT, EGL_TEXTURE_RGBA,
+        eglTextureTypeANGLE, GL_UNSIGNED_BYTE,
+        EGL_NONE
+    };
+    EGLSurface surface = eglCreatePbufferFromClientBuffer(display, eglIOSurfaceANGLE, ioSurface, config, attributes);
+    if (surface == EGL_NO_SURFACE)
+        return 0;
+
+    GLint previous = 0;
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &previous);
+    GLuint texture = 0;
+    glGenTextures(1, &texture);
+    glBindTexture(GL_TEXTURE_2D, texture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    bool bound = eglBindTexImage(display, surface, EGL_BACK_BUFFER);
+    glBindTexture(GL_TEXTURE_2D, previous);
+    if (!bound) {
+        glDeleteTextures(1, &texture);
+        eglDestroySurface(display, surface);
+        return 0;
+    }
+    *pbuffer = surface;
+    return texture;
+}
+
+// Where the frame was let go of: the compositor's thread, its context current (of the same
+// share group), or WebGL's, where the sharing context is made current for it.
+void releaseIOSurfaceForCompositor(unsigned texture, void* pbuffer)
+{
+    auto& platformDisplay = PlatformDisplay::sharedDisplay();
+    EGLDisplay display = platformDisplay.eglDisplay();
+    auto release = [&] {
+        eglReleaseTexImage(display, pbuffer, EGL_BACK_BUFFER);
+        eglDestroySurface(display, pbuffer);
+        GLuint name = texture;
+        glDeleteTextures(1, &name);
+    };
+    if (eglGetCurrentContext() != EGL_NO_CONTEXT) {
+        release();
+        return;
+    }
+    if (auto* sharingContext = platformDisplay.sharingGLContext()) {
+        GLContext::ScopedGLContextCurrent scopedCurrent(*sharingContext);
+        release();
+    }
+}
