 namespace ui {
 
 namespace {
@@ -17,6 +36,48 @@ constexpr size_t kMaxBuffers = 2;
 
 constexpr size_t kBytesPerPixelBGRA = 4;
 
+#if defined(__TERMUX__)
+// Spatiand's own modifier: the plane's file is a socket an Android hardware
+// buffer was sent through (AHardwareBuffer_sendHandleToUnixSocket), not a
+// dmabuf. Spatiand's room offers it for RGBA when its EGL takes such buffers
+// (android/eglshim/eglshim.c, which has the same number).
+constexpr uint64_t kSpatiandHardwareBufferModifier = 0xf500000000000001ull;
+
+// Frames in flight in hardware buffers: one the room shows, one it is given,
+// one being drawn.
+constexpr size_t kMaxHardwareBuffers = 3;
+
+// Android's buffer calls, from libnativewindow, which Chromium is not linked
+// with.
+struct HardwareBufferCalls {
+  int (*allocate)(const AHardwareBuffer_Desc*, AHardwareBuffer**) = nullptr;
+  void (*describe)(const AHardwareBuffer*, AHardwareBuffer_Desc*) = nullptr;
+  void (*release)(AHardwareBuffer*) = nullptr;
+  int (*send)(const AHardwareBuffer*, int) = nullptr;
+
+  bool valid() const { return allocate && describe && release && send; }
+};
+
+const HardwareBufferCalls& Calls() {
+  static const HardwareBufferCalls calls = [] {
+    HardwareBufferCalls found;
+    void* library = dlopen("libnativewindow.so", RTLD_NOW);
+    if (library) {
+      found.allocate = reinterpret_cast<decltype(found.allocate)>(
+          dlsym(library, "AHardwareBuffer_allocate"));
+      found.describe = reinterpret_cast<decltype(found.describe)>(
+          dlsym(library, "AHardwareBuffer_describe"));
+      found.release = reinterpret_cast<decltype(found.release)>(
+          dlsym(library, "AHardwareBuffer_release"));
+      found.send = reinterpret_cast<decltype(found.send)>(
+          dlsym(library, "AHardwareBuffer_sendHandleToUnixSocket"));
+    }
+    return found;
+  }();
+  return calls;
+}
+#endif
+
 }  // namespace
 
