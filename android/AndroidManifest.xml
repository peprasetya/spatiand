<?xml version="1.0" encoding="utf-8"?>
<!-- Spatiand on the Beam Pro: the glasses' shell in place of XREAL's Nebula. docs/beam-pro.md -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="id.prasetya.spatiand">
    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="34" />
    <uses-feature android:name="android.hardware.usb.host" />
    <!-- "Display over other apps", allowed once in Settings: the glasses' picture is an
         overlay, which sits above XREAL's NebulaOS placeholder where a Presentation does not. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Remote applications: the hosts are reached over QUIC. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:glEsVersion="0x00030000" />
    <application
        android:label="Spatiand"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:debuggable="true">
        <!-- The phone's screen: the controller and the status. The glasses are a Presentation
             this activity puts on their display. Opened by plugging the glasses in, once it is
             the app chosen for them. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/glasses" />
        </activity>
        <!-- Opens the activity on plugging in: the attach *intent* goes to Nebula, fixed by
             XREAL's framework, but the attach *broadcast* goes to everyone. -->
        <receiver android:name=".Plugged" android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
