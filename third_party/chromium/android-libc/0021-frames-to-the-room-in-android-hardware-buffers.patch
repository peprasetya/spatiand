+++ b/third_party/angle/src/libANGLE/renderer/vulkan/linux/AHardwareBufferImageSiblingVkSpatiand.cpp
@@ -0,0 +1,305 @@
+//
+// Copyright 2026 The ANGLE Project Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// AHardwareBufferImageSiblingVkSpatiand.cpp:
+//    An Android hardware buffer as an EGLImage, for ANGLE built for Linux on Android's libc. See
+//    the header. Made as HardwareBufferImageSiblingVkAndroid makes its images, less what only
+//    Android's own build has (external formats, YUV, ANativeWindowBuffer): the buffer is imported
+//    into a Vulkan image owned by the foreign queue, so that ANGLE gives it back to the foreign
+//    queue after every submission that drew into it, and another process (Spatiand's room) can
+//    read what was drawn.
+//
+
+#include "libANGLE/renderer/vulkan/linux/AHardwareBufferImageSiblingVkSpatiand.h"
+
+#if defined(__TERMUX__)
+
+#    include <android/hardware_buffer.h>
+#    include <dlfcn.h>
+#    include <vulkan/vulkan_android.h>
+
+#    include "libANGLE/Display.h"
+#    include "libANGLE/renderer/vulkan/DisplayVk.h"
+#    include "libANGLE/renderer/vulkan/vk_renderer.h"
+
+namespace rx
+{
+
+namespace
+{
+// Android's buffer calls, from libnativewindow, which this program is not linked with.
+struct HardwareBufferCalls
+{
+    void (*describe)(const AHardwareBuffer *, AHardwareBuffer_Desc *) = nullptr;
+    void (*acquire)(AHardwareBuffer *)                                = nullptr;
+    void (*release)(AHardwareBuffer *)                                = nullptr;
+
+    bool valid() const { return describe != nullptr && acquire != nullptr && release != nullptr; }
+};
+
+const HardwareBufferCalls &Calls()
+{
+    static const HardwareBufferCalls calls = [] {
+        HardwareBufferCalls found;
+        void *library = dlopen("libnativewindow.so", RTLD_NOW);
+        if (library != nullptr)
+        {
+            found.describe = reinterpret_cast<decltype(found.describe)>(
+                dlsym(library, "AHardwareBuffer_describe"));
+            found.acquire = reinterpret_cast<decltype(found.acquire)>(
+                dlsym(library, "AHardwareBuffer_acquire"));
+            found.release = reinterpret_cast<decltype(found.release)>(
+                dlsym(library, "AHardwareBuffer_release"));
+        }
+        return found;
+    }();
+    return calls;
+}
+
+PFN_vkGetAndroidHardwareBufferPropertiesANDROID GetProperties(VkDevice device)
+{
+    return reinterpret_cast<PFN_vkGetAndroidHardwareBufferPropertiesANDROID>(
+        VK_CALL(vkGetDeviceProcAddr, device, "vkGetAndroidHardwareBufferPropertiesANDROID"));
+}
+
+AHardwareBuffer *HardwareBufferOf(EGLClientBuffer buffer)
+{
+    return reinterpret_cast<AHardwareBuffer *>(buffer);
+}
+}  // anonymous namespace
+
+AHardwareBufferImageSiblingVkSpatiand::AHardwareBufferImageSiblingVkSpatiand(EGLClientBuffer buffer)
+    : mBuffer(buffer),
+      mSize(0, 0, 0),
+      mFormat(GL_NONE),
+      mAcquired(false),
+      mRenderable(false),
+      mTextureable(false),
+      mImage(nullptr)
+{}
+
+AHardwareBufferImageSiblingVkSpatiand::~AHardwareBufferImageSiblingVkSpatiand() {}
+
+// Static
+egl::Error AHardwareBufferImageSiblingVkSpatiand::ValidateHardwareBuffer(
+    vk::Renderer *renderer,
+    EGLClientBuffer buffer,
+    const egl::AttributeMap &attribs)
+{
+    if (buffer == nullptr || !Calls().valid())
+    {
+        return egl::Error(EGL_BAD_PARAMETER, "No hardware buffer, or no libnativewindow.");
+    }
+    if (!renderer->getFeatures().supportsAndroidHardwareBuffer.enabled ||
+        GetProperties(renderer->getDevice()) == nullptr)
+    {
+        return egl::Error(EGL_BAD_PARAMETER, "Vulkan cannot import Android hardware buffers.");
+    }
+    AHardwareBuffer_Desc description = {};
+    Calls().describe(HardwareBufferOf(buffer), &description);
+    if (description.format != AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM &&
+        description.format != AHARDWAREBUFFER_FORMAT_R8G8B8X8_UNORM)
+    {
+        return egl::Error(EGL_BAD_PARAMETER, "Only RGBA and RGBX hardware buffers.");
+    }
+    if (description.layers != 1 ||
+        (description.usage & (AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE |
+                              AHARDWAREBUFFER_USAGE_GPU_FRAMEBUFFER)) == 0)
+    {
+        return egl::Error(EGL_BAD_PARAMETER,
+                          "The hardware buffer is not one layer the GPU draws or samples.");
+    }
+    if (attribs.get(EGL_PROTECTED_CONTENT_EXT, EGL_FALSE) == EGL_TRUE)
+    {
+        return egl::Error(EGL_BAD_PARAMETER, "No protected content.");
+    }
+    return egl::NoError();
+}
+
+egl::Error AHardwareBufferImageSiblingVkSpatiand::initialize(const egl::Display *display)
+{
+    DisplayVk *displayVk = vk::GetImpl(display);
+    return angle::ToEGL(initImpl(displayVk), EGL_BAD_PARAMETER);
+}
+
+angle::Result AHardwareBufferImageSiblingVkSpatiand::initImpl(DisplayVk *displayVk)
+{
+    vk::Renderer *renderer = displayVk->getRenderer();
+    ANGLE_VK_CHECK(displayVk, Calls().valid(), VK_ERROR_INITIALIZATION_FAILED);
+    PFN_vkGetAndroidHardwareBufferPropertiesANDROID getProperties =
+        GetProperties(renderer->getDevice());
+    ANGLE_VK_CHECK(displayVk, getProperties != nullptr, VK_ERROR_EXTENSION_NOT_PRESENT);
+
+    AHardwareBuffer *hardwareBuffer = HardwareBufferOf(mBuffer);
+    AHardwareBuffer_Desc description = {};
+    Calls().describe(hardwareBuffer, &description);
+    mSize = gl::Extents(static_cast<int>(description.width),
+                        static_cast<int>(description.height), 1);
+    Calls().acquire(hardwareBuffer);
+    mAcquired = true;
+
+    VkAndroidHardwareBufferFormatPropertiesANDROID formatProperties = {};
+    formatProperties.sType = VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_FORMAT_PROPERTIES_ANDROID;
+    VkAndroidHardwareBufferPropertiesANDROID bufferProperties = {};
+    bufferProperties.sType = VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_PROPERTIES_ANDROID;
+    bufferProperties.pNext = &formatProperties;
+    ANGLE_VK_TRY(displayVk,
+                 getProperties(renderer->getDevice(), hardwareBuffer, &bufferProperties));
+
+    const vk::Format &vkFormat =
+        renderer->getFormat(description.format == AHARDWAREBUFFER_FORMAT_R8G8B8X8_UNORM
+                                ? GL_RGBX8_ANGLE
+                                : GL_RGBA8);
+    mFormat = gl::Format(vkFormat.getIntendedGLFormat());
+    const angle::FormatID intendedFormatID = vkFormat.getIntendedFormatID();
+    const angle::FormatID actualFormatID =
+        vkFormat.getActualImageFormatID(vk::ImageFormatSupport::SampleOnly);
+
+    // The usages Android's buffer usages allow (the Vulkan spec's table, as ANGLE's own import).
+    VkImageUsageFlags usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    if ((description.usage & AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE) != 0)
+    {
+        usage |= VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT;
+    }
+    if ((description.usage & AHARDWAREBUFFER_USAGE_GPU_FRAMEBUFFER) != 0)
+    {
+        usage |= VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+    }
+
+    VkExternalMemoryImageCreateInfo externalMemoryImageCreateInfo = {};
+    externalMemoryImageCreateInfo.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO;
+    externalMemoryImageCreateInfo.handleTypes =
+        VK_EXTERNAL_MEMORY_HANDLE_TYPE_ANDROID_HARDWARE_BUFFER_BIT_ANDROID;
+
+    VkExtent3D vkExtents;
+    gl_vk::GetExtent(mSize, &vkExtents);
+    vkExtents.depth = 1;
+
+    mImage = new vk::ImageHelper();
+    mImage->setTilingMode(VK_IMAGE_TILING_OPTIMAL);
+
+    VkImageCreateFlags imageCreateFlags = 0;
+    const vk::ImageFormatReinterpretability formatReinterpretability =
+        vk::ImageFormatReinterpretability::ColorspaceOverrides;
+    VkImageFormatListCreateInfoKHR imageFormatListInfoStorage;
+    vk::ImageHelper::ImageFormats imageFormats;
+    const void *imageCreateInfoPNext = vk::ImageHelper::DeriveCreateInfoPNext(
+        displayVk, actualFormatID, &externalMemoryImageCreateInfo, &imageFormatListInfoStorage,
+        &imageFormats, formatReinterpretability, &imageCreateFlags);
+
+    vk::YcbcrConversionDesc conversionDesc{};
+    ANGLE_TRY(mImage->initExternal(
+        displayVk, gl::TextureType::_2D, vkExtents, intendedFormatID, actualFormatID, 1, usage,
+        imageCreateFlags, vk::ImageAccess::ExternalPreInitialized, imageCreateInfoPNext,
+        gl::OwnerLevel(0), 1, 1, false, false, vk::TileMemory::Prohibited, conversionDesc,
+        nullptr, formatReinterpretability));
+
+    VkImportAndroidHardwareBufferInfoANDROID importHardwareBufferInfo = {};
+    importHardwareBufferInfo.sType  = VK_STRUCTURE_TYPE_IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID;
+    importHardwareBufferInfo.buffer = hardwareBuffer;
+
+    VkMemoryDedicatedAllocateInfo dedicatedAllocInfo = {};
+    dedicatedAllocInfo.sType          = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO;
+    dedicatedAllocInfo.pNext          = &importHardwareBufferInfo;
+    dedicatedAllocInfo.image          = mImage->getImage().getHandle();
+    dedicatedAllocInfo.buffer         = VK_NULL_HANDLE;
+    const void *dedicatedAllocInfoPtr = &dedicatedAllocInfo;
+
+    VkMemoryRequirements externalMemoryRequirements = {};
+    externalMemoryRequirements.size                 = bufferProperties.allocationSize;
+    externalMemoryRequirements.alignment            = 0;
+    externalMemoryRequirements.memoryTypeBits       = bufferProperties.memoryTypeBits;
+
+    ANGLE_TRY(mImage->initExternalMemory(displayVk, renderer->getMemoryProperties(),
+                                         externalMemoryRequirements, 1, &dedicatedAllocInfoPtr,
+                                         vk::kForeignDeviceQueueIndex,
+                                         VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT));
+
+    mRenderable  = renderer->hasImageFormatFeatureBits(actualFormatID,
+                                                       VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT);
+    mTextureable = renderer->hasImageFormatFeatureBits(
+        actualFormatID,
+        VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT);
+    return angle::Result::Continue;
+}
+
+void AHardwareBufferImageSiblingVkSpatiand::onDestroy(const egl::Display *display)
+{
+    if (mAcquired)
+    {
+        Calls().release(HardwareBufferOf(mBuffer));
+        mAcquired = false;
+    }
+    ASSERT(mImage == nullptr);
+}
