+    RXKB_LOG_LEVEL_ERROR = 20,    /**< Log all errors. */
+    RXKB_LOG_LEVEL_WARNING = 30,  /**< Log warnings and errors. */
+    RXKB_LOG_LEVEL_INFO = 40,     /**< Log information, warnings, and errors. */
+    RXKB_LOG_LEVEL_DEBUG = 50     /**< Log everything. */
+};
