diff --git a/build/BUILD.gn b/build/BUILD.gn
index 3fa5cae7e11..b9efb135871 100644
--- a/build/BUILD.gn
+++ b/build/BUILD.gn
@@ -56,6 +56,14 @@ buildflag_header("branding_buildflags") {
   flags += [ "ENABLE_BUILTIN_SEARCH_PROVIDER_ASSETS=$enable_builtin_search_provider_assets" ]
 }
 
+buildflag_header("cromite_buildflags") {
+  header = "cromite_flags.h"
+
+  flags = [
+    "CROMITE_PREF_HASH_SEED_BIN=\"$cromite_pref_hash_seed_bin\"",
