diff --git a/third_party/spatiand_mac/linux-input/linux/input.h b/third_party/spatiand_mac/linux-input/linux/input.h
new file mode 100644
index 0000000000..bcef715092
--- /dev/null
+++ b/third_party/spatiand_mac/linux-input/linux/input.h
@@ -0,0 +1,10 @@
+/* Spatiand: <linux/input.h> for the Linux UI on macOS. Wayland's key and
+ * button numbers are the Linux kernel's evdev codes on every platform; macOS
+ * has no kernel headers to name them, so this is the event codes alone
+ * (input-event-codes.h, from the Debian bullseye sysroot Chromium's Linux
+ * build compiles against). The kernel's input structures and ioctls, for
+ * reading devices, are not here: nothing on macOS reads evdev devices. */
+#ifndef SPATIAND_MAC_LINUX_INPUT_H
+#define SPATIAND_MAC_LINUX_INPUT_H
+#include <linux/input-event-codes.h>
+#endif
