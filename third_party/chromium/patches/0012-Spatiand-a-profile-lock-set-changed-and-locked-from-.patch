+
+void ProfilesSync::LockChanged(const std::string& id,
+                               const std::string& kind,
+                               const std::string& salt,
+                               const std::string& hash) {
+  if (const auto it = records_.find(id); it != records_.end()) {
+    it->second.lock_kind = kind;
+    it->second.lock_salt = salt;
+    it->second.lock_hash = hash;
+  }
+  // Whoever just said this is looking at it: its windows stay open, until the last of them closes.
+  unlocked_.insert(id);
+  files_->PostTask(FROM_HERE, base::BindOnce(&UpdateLockFile, id, kind, salt, hash));
+}
+
+void ProfilesSync::LockNow() {
+  // Not from inside the menu that asked, which goes with its window.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ProfilesSync::LockAll, weak_factory_.GetWeakPtr()));
+}
+
+void ProfilesSync::LockAll() {
+  std::set<std::string> with_windows;
+  std::vector<BrowserWindowInterface*> windows;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [this, &with_windows, &windows](BrowserWindowInterface* browser) {
+        const std::string id = KnownIdOf(browser->GetProfile()->GetOriginalProfile()->GetPath());
+        const auto it = records_.find(id);
+        if (it != records_.end() && !it->second.lock_hash.empty()) {
+          with_windows.insert(id);
+          windows.push_back(browser);
+        }
+        return true;
+      });
+  for (const auto& [id, record] : records_) {
+    if (!record.lock_hash.empty()) {
+      unlocked_.erase(id);
+    }
+  }
+  for (BrowserWindowInterface* browser : windows) {
+    const std::string id = KnownIdOf(browser->GetProfile()->GetOriginalProfile()->GetPath());
+    TabStripModel* tabs = browser->GetTabStripModel();
+    for (int i = 0; tabs && i < tabs->count(); ++i) {
+      content::WebContents* contents = tabs->GetWebContentsAt(i);
+      if (!contents->IsAudioMuted()) {
+        contents->SetAudioMuted(true);
+        hushed_[id].push_back(contents->GetWeakPtr());
+      }
+    }
+    browser->GetWindow()->Hide();
+  }
+  for (const std::string& id : with_windows) {
+    if (!asking_.contains(id)) {
+      const ProfileRecord& record = records_.at(id);
+      AskToUnlock(id, base::UTF8ToUTF16(record.name), record);
+    }
+  }
+}
+
 void ProfilesSync::AskToUnlock(const std::string& id,
                                const std::u16string& name,
                                const ProfileRecord& record) {
+  asking_.insert(id);
+  bool windows_waiting = false;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [this, &id, &windows_waiting](BrowserWindowInterface* browser) {
+        windows_waiting |= KnownIdOf(browser->GetProfile()->GetOriginalProfile()->GetPath()) == id &&
+                           !waiting_.contains(id);
+        return !windows_waiting;
+      });
   ShowProfileLockDialog(name, record.lock_kind == "pin", record.lock_salt, record.lock_hash,
+                        windows_waiting,
                         base::BindOnce(&ProfilesSync::Unlocked, weak_factory_.GetWeakPtr(), id));
 }
 
 void ProfilesSync::Unlocked(const std::string& id, bool opened) {
   std::vector<base::OnceClosure> waiting = std::move(waiting_[id]);
   waiting_.erase(id);
+  asking_.erase(id);
+  std::vector<base::WeakPtr<content::WebContents>> hushed = std::move(hushed_[id]);
+  hushed_.erase(id);
   if (opened) {
     unlocked_.insert(id);
     for (base::OnceClosure& show : waiting) {
       std::move(show).Run();
     }
+    // And those Lock profiles now put out of sight.
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [this, &id](BrowserWindowInterface* browser) {
+          if (KnownIdOf(browser->GetProfile()->GetOriginalProfile()->GetPath()) == id &&
+              !browser->GetWindow()->IsVisible()) {
+            browser->GetWindow()->Show();
+          }
+          return true;
+        });
+    for (const base::WeakPtr<content::WebContents>& contents : hushed) {
+      if (contents) {
+        contents->SetAudioMuted(false);
+      }
+    }
     return;
   }
   // Not opened: its waiting windows go, never having been seen.
