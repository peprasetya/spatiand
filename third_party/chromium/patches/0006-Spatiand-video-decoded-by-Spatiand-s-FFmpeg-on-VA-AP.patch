+namespace media {
+
+namespace {
+
+// Frames the codec keeps for reference beyond what is on the screen: the most H.264 and HEVC
+// may hold, plus the one being decoded and one FFmpeg holds back for reordering.
+constexpr size_t kReferenceFrames = 18;
+
+const char* DecoderName(VideoCodec codec) {
+  switch (codec) {
+    case VideoCodec::kH264:
+      return "h264";
+    case VideoCodec::kHEVC:
+      return "hevc";
+    case VideoCodec::kVP8:
+      return "vp8";
+    case VideoCodec::kVP9:
+      return "vp9";
+    // FFmpeg's own AV1 decoder decodes only through a hardware accelerator, which is the point.
+    case VideoCodec::kAV1:
+      return "av1";
+    default:
+      return nullptr;
+  }
+}
+
+// What FFmpeg decodes into, as the pool and VA-API know it.
+std::optional<VideoPixelFormat> PoolFormat(AVPixelFormat sw_format) {
+  switch (sw_format) {
+    case AV_PIX_FMT_NV12:
+      return PIXEL_FORMAT_NV12;
+    case AV_PIX_FMT_P010:
+      return PIXEL_FORMAT_P010LE;
+    default:
+      return std::nullopt;
+  }
+}
+
+// A pool buffer while FFmpeg holds it: released when FFmpeg is done with the picture, for output
+// and for reference. The frame goes back to the pool once the screen is done with it too.
+struct Held {
+  scoped_refptr<FrameResource> frame;
+  VASurfaceID surface;
+};
+
+void ReleaseHeld(void* opaque, uint8_t* /*data*/) {
+  delete static_cast<Held*>(opaque);
+}
+
+}  // namespace
