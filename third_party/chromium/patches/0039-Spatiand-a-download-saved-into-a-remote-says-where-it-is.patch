diff --git a/chrome/browser/spatiand/saved_in.cc b/chrome/browser/spatiand/saved_in.cc
new file mode 100644
index 0000000000..2422002476
--- /dev/null
+++ b/chrome/browser/spatiand/saved_in.cc
@@ -0,0 +1,139 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/spatiand/saved_in.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/supports_user_data.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "components/download/public/common/download_item.h"
+
+namespace spatiand {
+
+namespace {
+
+const char kKey[] = "spatiand-saved-in";
+
+// A download still being sent is looked for again this often, this many times (half an hour,
+// as long as the chooser's sender waits for a file to be written).
+constexpr base::TimeDelta kAgain = base::Seconds(5);
+constexpr int kTries = 360;
+
+// The record of a download in the chooser's outbox -- .../spatiand-choose/sent/<folder>.json --
+// or none, for a path anywhere else.
+std::optional<base::FilePath> RecordOf(const base::FilePath& target) {
+  const base::FilePath folder = target.DirName();
+  const base::FilePath outbox = folder.DirName();
+  const base::FilePath base = outbox.DirName();
+  if (target.empty() || outbox.BaseName().value() != "outbox" ||
+      base.BaseName().value() != "spatiand-choose") {
+    return std::nullopt;
+  }
+  return base.Append("sent").Append(folder.BaseName().value() + ".json");
+}
+
+// Off the UI thread: the remote's folder the record names, if it is there yet.
+std::optional<std::u16string> ReadRecord(const base::FilePath& record) {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(record, &text, 64 * 1024)) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> dict = base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+  const std::string* place = dict ? dict->FindString("in") : nullptr;
+  if (!place || place->empty()) {
+    return std::nullopt;
+  }
+  return base::UTF8ToUTF16(*place);
+}
+
+// Kept on the download: where it went, once known, and the looking for it meanwhile.
+class Lookup : public base::SupportsUserData::Data {
+ public:
+  explicit Lookup(download::DownloadItem* item) : item_(item) {}
+  Lookup(const Lookup&) = delete;
+  Lookup& operator=(const Lookup&) = delete;
+  ~Lookup() override = default;
+
+  const std::optional<std::u16string>& place() const { return place_; }
+
+  void Start(base::FilePath record) {
+    if (busy_ || place_) {
+      return;
+    }
+    busy_ = true;
+    Ask(std::move(record));
+  }
+
+ private:
+  void Ask(base::FilePath record) {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+        base::BindOnce(&ReadRecord, record),
+        base::BindOnce(&Lookup::Read, weak_factory_.GetWeakPtr(), record));
+  }
+
+  void Read(base::FilePath record, std::optional<std::u16string> found) {
+    if (found) {
+      busy_ = false;
+      place_ = std::move(found);
+      item_->UpdateObservers();
+      return;
+    }
+    // Not sent yet -- still being written, or on its way -- or never to be.
+    if (++tries_ >= kTries) {
+      busy_ = false;
+      return;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce(&Lookup::Ask, weak_factory_.GetWeakPtr(), std::move(record)),
+        kAgain);
+  }
+
+  // The download this is kept on, which outlives it.
+  raw_ptr<download::DownloadItem> item_;
+  std::optional<std::u16string> place_;
+  bool busy_ = false;
+  int tries_ = 0;
+  base::WeakPtrFactory<Lookup> weak_factory_{this};
+};
+
+}  // namespace
+
+std::optional<std::u16string> SavedIn(const download::DownloadItem* item) {
+  if (!item) {
+    return std::nullopt;
+  }
+  const auto* lookup = static_cast<const Lookup*>(item->GetUserData(&kKey));
+  return lookup ? lookup->place() : std::nullopt;
+}
+
+void LookUpSavedIn(download::DownloadItem* item) {
+  if (!item || item->GetState() != download::DownloadItem::COMPLETE) {
+    return;
+  }
+  std::optional<base::FilePath> record = RecordOf(item->GetTargetFilePath());
+  if (!record) {
+    return;
+  }
+  auto* lookup = static_cast<Lookup*>(item->GetUserData(&kKey));
+  if (!lookup) {
+    auto made = std::make_unique<Lookup>(item);
+    lookup = made.get();
+    item->SetUserData(&kKey, std::move(made));
+  }
+  lookup->Start(*std::move(record));
+}
+
+}  // namespace spatiand
