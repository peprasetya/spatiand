+#ifndef MEDIA_AUDIO_SPATIAND_SPATIAND_OUTPUT_H_
+#define MEDIA_AUDIO_SPATIAND_SPATIAND_OUTPUT_H_
+
+#include <stdint.h>
+
+#include <atomic>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/scoped_file.h"
