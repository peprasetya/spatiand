 ...sktop_site_web_contents_observer_android.cc | 12 ++++++++++++
 chrome/common/pref_names.h                     |  8 ++++++++
 .../request_desktop_site.grdp                  | 18 ++++++++++++++++++
 .../navigation_controller_android.h            |  1 +
