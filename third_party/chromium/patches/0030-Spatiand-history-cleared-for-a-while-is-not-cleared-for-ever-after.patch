+      const history::URLID id = db->GetRowForURL(url, &row);
+      if (id) {
+        history::VisitVector in_history;
+        db->GetVisitsForURL(id, &in_history);
+        std::map<int64_t, size_t> kept;
+        for (size_t i = 0; i < in_history.size(); ++i) {
+          const auto [it, first] = kept.emplace(MsOf(in_history[i].visit_time), i);
+          if (first) {
+            continue;
+          }
+          if (TakenIn(in_history[i])) {
+            doubles.push_back(in_history[i]);
+          } else if (TakenIn(in_history[it->second])) {
+            doubles.push_back(in_history[it->second]);
