+// Spatiand: video decoded by Android's own hardware decoders (MediaCodec, through the NDK), in the
+// GPU process, for SpatiMesh on Android's libc: Chromium's Linux GPU process decodes only with
+// VA-API and V4L2, which Android has not got (android-libc/0015). Each picture the decoder gives
+// is copied into a frame of memory, which goes to the page as shared memory: a copy or two more
+// than the Deck's dmabufs, the decoding itself done by the hardware.
+class SpatiandMediaCodecVideoDecoder : public VideoDecoder {
+ public:
+  // What the hardware decoders here take. Android's own software decoders are left out:
+  // Chromium's are as good, and run in the page's sandbox.
+  static SupportedVideoDecoderConfigs GetSupportedConfigs();
+
+  SpatiandMediaCodecVideoDecoder(scoped_refptr<base::SequencedTaskRunner> task_runner,
+                                 std::unique_ptr<MediaLog> media_log);
+  SpatiandMediaCodecVideoDecoder(const SpatiandMediaCodecVideoDecoder&) = delete;
+  SpatiandMediaCodecVideoDecoder& operator=(const SpatiandMediaCodecVideoDecoder&) = delete;
+  ~SpatiandMediaCodecVideoDecoder() override;
+
+  // VideoDecoder:
+  void Initialize(const VideoDecoderConfig& config,
+                  bool low_delay,
+                  CdmContext* cdm_context,
+                  InitCB init_cb,
+                  const OutputCB& output_cb,
+                  const WaitingCB& waiting_cb) override;
+  void Decode(scoped_refptr<DecoderBuffer> buffer, DecodeCB decode_cb) override;
+  void Reset(base::OnceClosure closure) override;
+  bool NeedsBitstreamConversion() const override;
+  bool CanReadWithoutStalling() const override;
+  int GetMaxDecodeRequests() const override;
+  VideoDecoderType GetDecoderType() const override;
+  bool IsPlatformDecoder() const override;
+
+ private:
+  struct Pending {
+    Pending(scoped_refptr<DecoderBuffer> buffer, DecodeCB decode_cb);
+    Pending(Pending&&);
+    Pending& operator=(Pending&&);
+    ~Pending();
+    scoped_refptr<DecoderBuffer> buffer;
+    DecodeCB decode_cb;
+  };
+
+  // Hands the codec what it will take and the page what it has given; again shortly while it
+  // holds anything (the NDK's API of this Android level has no callbacks).
+  void Pump();
+  bool FeedInput();
+  bool DrainOutput();
+  void ReadOutputFormat();
+  bool DeliverFrame(size_t index, const AMediaCodecBufferInfo& info);
+  void Abort(DecoderStatus::Codes code);
+  void CloseCodec();
+
+  scoped_refptr<base::SequencedTaskRunner> task_runner_;
+  std::unique_ptr<MediaLog> media_log_;
+  VideoDecoderConfig config_;
+  OutputCB output_cb_;
+  AMediaCodec* codec_ = nullptr;
+  std::deque<Pending> pending_;
+  // The end of the stream's callback, run once the codec has given its last picture.
+  DecodeCB eos_cb_;
+  // Pumps since the codec was last given or gave anything: after a while it is let be.
+  int idle_pumps_ = 0;
+  // The pictures the codec gives: their colour format, size, rows' stride, planes' height, crop.
+  int32_t color_format_ = 0;
+  int32_t width_ = 0;
+  int32_t height_ = 0;
+  int32_t stride_ = 0;
+  int32_t slice_height_ = 0;
+  gfx::Rect crop_;
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<SpatiandMediaCodecVideoDecoder> weak_factory_{this};
+};
