diff --git a/ui/ozone/platform/wayland/common/wayland_shm_mapping.cc b/ui/ozone/platform/wayland/common/wayland_shm_mapping.cc
new file mode 100644
index 0000000000..0c65ace6ac
--- /dev/null
+++ b/ui/ozone/platform/wayland/common/wayland_shm_mapping.cc
@@ -0,0 +1,120 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/wayland/common/wayland_shm_mapping.h"
+
+#include <errno.h>
+
+#include <string>
+#include <utility>
+
+#include "base/compiler_specific.h"
+#include "base/logging.h"
+
+#if BUILDFLAG(IS_APPLE)
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <atomic>
+
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/stringprintf.h"
+#else
+#include "base/memory/platform_shared_memory_region.h"
+#include "base/memory/unsafe_shared_memory_region.h"
+#endif
+
+namespace wl {
+
+ShmMapping::ShmMapping() = default;
+
+ShmMapping::ShmMapping(ShmMapping&& other) {
+  *this = std::move(other);
+}
+
+ShmMapping& ShmMapping::operator=(ShmMapping&& other) {
+  if (this != &other) {
+    Reset();
+    span_ = std::exchange(other.span_, base::span<uint8_t>());
+#if !BUILDFLAG(IS_APPLE)
+    mapping_ = std::move(other.mapping_);
+#endif
+  }
+  return *this;
+}
+
+ShmMapping::~ShmMapping() {
+  Reset();
+}
+
+void ShmMapping::Reset() {
+#if BUILDFLAG(IS_APPLE)
+  if (!span_.empty()) {
+    munmap(span_.data(), span_.size());
+  }
+#else
+  mapping_ = base::WritableSharedMemoryMapping();
+#endif
+  span_ = base::span<uint8_t>();
+}
+
+// static
+ShmMapping ShmMapping::Create(size_t size, base::ScopedFD* fd) {
+  ShmMapping shm;
+  if (!size) {
+    return shm;
+  }
+#if BUILDFLAG(IS_APPLE)
+  // A name only for as long as it takes to open it: macOS has no memfd. Its
+  // names are at most 31 bytes (PSHMNAMLEN).
+  static std::atomic<uint32_t> counter{0};
+  for (int attempt = 0; attempt < 16 && !fd->is_valid(); ++attempt) {
+    std::string name = base::StringPrintf(
+        "/cr-wl-%d-%u", getpid(), counter.fetch_add(1) & 0xffffff);
+    fd->reset(shm_open(name.c_str(), O_RDWR | O_CREAT | O_EXCL, 0600));
+    if (fd->is_valid()) {
+      shm_unlink(name.c_str());
+    } else if (errno != EEXIST) {
+      PLOG(ERROR) << "shm_open";
+      return shm;
+    }
+  }
+  if (!fd->is_valid()) {
+    return shm;
+  }
+  if (HANDLE_EINTR(ftruncate(fd->get(), static_cast<off_t>(size))) != 0) {
+    PLOG(ERROR) << "ftruncate";
+    fd->reset();
+    return shm;
+  }
+  void* memory =
+      mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd->get(), 0);
+  if (memory == MAP_FAILED) {
+    PLOG(ERROR) << "mmap";
+    fd->reset();
+    return shm;
+  }
+  // SAFETY: mmap mapped |size| bytes at |memory|.
+  shm.span_ = UNSAFE_BUFFERS(base::span(static_cast<uint8_t*>(memory), size));
+#else
+  base::UnsafeSharedMemoryRegion region =
+      base::UnsafeSharedMemoryRegion::Create(size);
+  if (!region.IsValid()) {
+    return shm;
+  }
+  shm.mapping_ = region.Map();
+  if (!shm.mapping_.IsValid()) {
+    return shm;
+  }
+  base::subtle::PlatformSharedMemoryRegion platform_region =
+      base::UnsafeSharedMemoryRegion::TakeHandleForSerialization(
+          std::move(region));
+  *fd = std::move(platform_region.PassPlatformHandle().fd);
+  shm.span_ = base::span(shm.mapping_);
+#endif
+  return shm;
+}
+
+}  // namespace wl
diff --git a/ui/ozone/platform/wayland/common/wayland_shm_mapping.h b/ui/ozone/platform/wayland/common/wayland_shm_mapping.h
new file mode 100644
index 0000000000..6648ae42cd
--- /dev/null
+++ b/ui/ozone/platform/wayland/common/wayland_shm_mapping.h
@@ -0,0 +1,61 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_OZONE_PLATFORM_WAYLAND_COMMON_WAYLAND_SHM_MAPPING_H_
+#define UI_OZONE_PLATFORM_WAYLAND_COMMON_WAYLAND_SHM_MAPPING_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "base/containers/span.h"
+#include "base/files/scoped_file.h"
+#include "base/memory/raw_ptr_exclusion.h"
+#include "build/build_config.h"
+
+#if !BUILDFLAG(IS_APPLE)
+#include "base/memory/shared_memory_mapping.h"
+#endif
+
+namespace wl {
+
+// Spatiand: writable shared memory with an fd that a Wayland compositor maps
+// (wl_shm). On Linux it is base's shared memory, as Chromium has always made
+// it here; on macOS, whose base shared memory is a Mach memory object with no
+// fd, it is POSIX shared memory (shm_open, unlinked at once) mapped here.
+class ShmMapping {
+ public:
+  ShmMapping();
+  ShmMapping(ShmMapping&& other);
+  ShmMapping& operator=(ShmMapping&& other);
+  ShmMapping(const ShmMapping&) = delete;
+  ShmMapping& operator=(const ShmMapping&) = delete;
+  ~ShmMapping();
+
+  // |size| bytes, and the fd of them in |fd|. Not valid if that failed.
+  static ShmMapping Create(size_t size, base::ScopedFD* fd);
+
+  bool IsValid() const { return !span_.empty(); }
+  void* memory() const { return span_.data(); }
+  uint8_t* data() const { return span_.data(); }
+  size_t size() const { return span_.size(); }
+  base::span<uint8_t>::iterator begin() const { return span_.begin(); }
+  base::span<uint8_t>::iterator end() const { return span_.end(); }
+  template <typename T>
+  T* GetMemoryAs() const {
+    return reinterpret_cast<T*>(span_.data());
+  }
+
+ private:
+  void Reset();
+
+  // The mapping's memory: owned by |mapping_| on Linux, by this on macOS.
+  RAW_PTR_EXCLUSION base::span<uint8_t> span_;
+#if !BUILDFLAG(IS_APPLE)
+  base::WritableSharedMemoryMapping mapping_;
+#endif
+};
+
+}  // namespace wl
+
+#endif  // UI_OZONE_PLATFORM_WAYLAND_COMMON_WAYLAND_SHM_MAPPING_H_
