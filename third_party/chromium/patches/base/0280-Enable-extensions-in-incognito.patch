@@ -1226,7 +1226,7 @@ bool ExtensionTabUtil::OpenOptionsPageFromWebContents(
   if (!url) {
     return false;
   }
-  const bool open_in_tab = ShouldOpenInTab(extension);
+  const bool open_in_tab = false; //ShouldOpenInTab(extension);
   BrowserWindowInterface* browser =
       browser_window_util::GetBrowserForTabContents(*web_contents);
   if (!browser) {
diff --git a/chrome/browser/performance_manager/decorators/helpers/page_live_state_decorator_helper.cc b/chrome/browser/performance_manager/decorators/helpers/page_live_state_decorator_helper.cc
index 6f5e06eb84a..6de52b63d00 100644
--- a/chrome/browser/performance_manager/decorators/helpers/page_live_state_decorator_helper.cc
+++ b/chrome/browser/performance_manager/decorators/helpers/page_live_state_decorator_helper.cc
@@ -83,6 +83,14 @@ class ActiveTabTracker : public TabModelObserver {
       }
       active_tab_ = nullptr;
     }
+    else if (!tab) {
+      active_tab_ = nullptr;
+    }
+  }
+
+  void Clear() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    active_tab_ = nullptr;
   }
 
  private:
@@ -122,6 +130,15 @@ class ActiveTabObserver : public TabModelListObserver {
     tracker_map_.erase(tab_model);
   }
 
+  void OnFinishingTabClosure() override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    for (const auto& [tab_model, tracker] : tracker_map_) {
+      if (tracker) {
+        tracker->Clear();
+      }
+    }
+  }
+
   absl::flat_hash_map<const TabModel*, std::unique_ptr<ActiveTabTracker>>
       tracker_map_ GUARDED_BY_CONTEXT(sequence_checker_);
 
diff --git a/chrome/browser/ui/extensions/extensions_menu_view_model.cc b/chrome/browser/ui/extensions/extensions_menu_view_model.cc
index 07f8519e90a..e828df19eac 100644
--- a/chrome/browser/ui/extensions/extensions_menu_view_model.cc
+++ b/chrome/browser/ui/extensions/extensions_menu_view_model.cc
@@ -981,6 +981,7 @@ ExtensionsMenuViewModel::GetMenuEntryState(
   content::WebContents* web_contents = GetActiveWebContents();
 
   MenuEntryState entry_state;
+  if (!web_contents) return entry_state;
   entry_state.extension_id = extension_id;
   entry_state.action_button =
       GetActionButtonState(extension_id, action_icon_size);
@@ -1496,5 +1497,9 @@ content::WebContents* ExtensionsMenuViewModel::GetActiveWebContents() {
     return nullptr;
   }
   auto* tab = tab_list->GetActiveTab();
-  return tab ? tab->GetContents() : nullptr;
+  auto* web_contents = tab ? tab->GetContents() : nullptr;
+  if (!web_contents || web_contents->IsBeingDestroyed()) {
+    return nullptr;
+  }
+  return web_contents;
 }
