{
  "manifest_version": 3,
  "name": "SpatiKey",
  "version": "@VERSION@",
  "description": "Passwords and passkeys from SpatiKey, Spatiand's own manager, approved with Touch ID on your Mac.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["webauthn.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["forms.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/key-16.png",
    "32": "icons/key-32.png",
    "48": "icons/key-48.png",
    "128": "icons/key-128.png"
  }
}
