+// Where a visit's link counts as visited: under the page it was followed on, when that came with
+// it; else on its own site (top-level site and frame origin the link's own), which is the common
+// case of a page listing pages of its own site, and all that a visit with no page can say.
+std::optional<HistorySync::Link> LinkOf(const HistorySync::Visit& visit) {
+  HistorySync::Link link;
+  link.url = GURL(visit.url);
+  if (!link.url.is_valid() || !link.url.SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+  link.top = GURL(visit.top);
+  link.frame = GURL(visit.frame);
+  if (!link.top.is_valid() || !link.frame.is_valid()) {
+    link.top = link.url.GetWithEmptyPath();
+    link.frame = link.top;
+  }
+  return link;
+}
+
+// On the history thread: the rows of the VisitedLinkDatabase for links whose addresses are in
+// history already. `everything` is the pass made once for what was in history before this was
+// done (visits taken in from other machines earlier, whose files are not read again): every
+// address there, on its own site.
+class MakeLinks : public history::HistoryDBTask {
+ public:
+  MakeLinks(std::vector<HistorySync::Link> links,
+            base::FilePath everything_marker,
+            base::OnceCallback<void(std::vector<HistorySync::Link>)> done)
+      : links_(std::move(links)), marker_(std::move(everything_marker)), done_(std::move(done)) {}
+
+  bool RunOnDBThread(history::HistoryBackend* backend, history::HistoryDatabase* db) override {
+    if (!db) {
+      links_.clear();
+      return true;
+    }
+    if (!marker_.empty() && !base::PathExists(marker_)) {
+      history::URLDatabase::URLEnumerator all;
+      if (db->InitURLEnumeratorForEverything(&all)) {
+        history::URLRow row;
+        while (all.GetNextURL(&row)) {
+          if (row.visit_count() > 0 && !row.hidden() && row.url().SchemeIsHTTPOrHTTPS()) {
+            HistorySync::Link link;
+            link.url = row.url();
+            link.top = row.url().GetWithEmptyPath();
+            link.frame = link.top;
+            links_.push_back(std::move(link));
+          }
+        }
+      }
+      base::CreateDirectory(marker_.DirName());
+      base::WriteFile(marker_, "1");
+    }
+    std::vector<HistorySync::Link> made;
+    for (HistorySync::Link& link : links_) {
+      const history::URLID id = db->GetRowForURL(link.url, nullptr);
+      if (!id) {
+        continue;
+      }
+      history::VisitedLinkRow row;
+      if (db->GetRowForVisitedLink(id, link.top, link.frame, row) ||
+          db->AddVisitedLink(id, link.top, link.frame, 1)) {
+        made.push_back(std::move(link));
+      }
+    }
+    links_ = std::move(made);
+    return true;
+  }
+
+  void DoneRunOnMainThread() override { std::move(done_).Run(std::move(links_)); }
+
+ private:
+  std::vector<HistorySync::Link> links_;
+  const base::FilePath marker_;
+  base::OnceCallback<void(std::vector<HistorySync::Link>)> done_;
+};
+
+// On the history thread: the page a visit's link was followed on, from the row Chromium made.
+class FindPage : public history::HistoryDBTask {
+ public:
+  FindPage(history::VisitedLinkID id, base::OnceCallback<void(GURL, GURL)> done)
+      : id_(id), done_(std::move(done)) {}
+
+  bool RunOnDBThread(history::HistoryBackend* backend, history::HistoryDatabase* db) override {
+    history::VisitedLinkRow row;
+    if (db && db->GetVisitedLinkRow(id_, row)) {
+      top_ = row.top_level_url;
+      frame_ = row.frame_url;
+    }
+    return true;
+  }
+
+  void DoneRunOnMainThread() override { std::move(done_).Run(std::move(top_), std::move(frame_)); }
+
+ private:
+  const history::VisitedLinkID id_;
+  GURL top_;
+  GURL frame_;
+  base::OnceCallback<void(GURL, GURL)> done_;
+};
