+void BluetoothRemoteGattCharacteristicSpatiand::ReadRemoteCharacteristic(
+    ValueCallback callback) {
+  if (read_callback_) {
+    std::move(callback).Run(BluetoothGattService::GattErrorCode::kInProgress,
+                            {});
+    return;
+  }
+  read_callback_ = std::move(callback);
+  bridge_->Send(base::DictValue()
+                    .Set("op", "read")
+                    .Set("address", address_)
+                    .Set("id", identifier_));
+}
+
+void BluetoothRemoteGattCharacteristicSpatiand::WriteRemoteCharacteristic(
+    base::span<const uint8_t> value,
+    WriteType write_type,
+    base::OnceClosure callback,
+    ErrorCallback error_callback) {
+  Write(value,
+        write_type == WriteType::kWithoutResponse ? "noResponse" : "default",
+        std::move(callback), std::move(error_callback));
+}
+
+void BluetoothRemoteGattCharacteristicSpatiand::
+    DeprecatedWriteRemoteCharacteristic(base::span<const uint8_t> value,
+                                        base::OnceClosure callback,
+                                        ErrorCallback error_callback) {
+  const bool with_response = (properties_ & PROPERTY_WRITE) ||
+                             !(properties_ & PROPERTY_WRITE_WITHOUT_RESPONSE);
+  Write(value, with_response ? "default" : "noResponse", std::move(callback),
+        std::move(error_callback));
+}
+
+void BluetoothRemoteGattCharacteristicSpatiand::Write(
+    base::span<const uint8_t> value,
+    const char* type,
+    base::OnceClosure callback,
+    ErrorCallback error_callback) {
+  if (write_callback_ || write_error_callback_) {
+    std::move(error_callback)
+        .Run(BluetoothGattService::GattErrorCode::kInProgress);
+    return;
+  }
+  write_callback_ = std::move(callback);
+  write_error_callback_ = std::move(error_callback);
+  bridge_->Send(base::DictValue()
+                    .Set("op", "write")
+                    .Set("address", address_)
+                    .Set("id", identifier_)
+                    .Set("value", base::HexEncode(value))
+                    .Set("type", type));
+}
+
+void BluetoothRemoteGattCharacteristicSpatiand::SubscribeToNotifications(
+    BluetoothRemoteGattDescriptor* ccc_descriptor,
+    base::OnceClosure callback,
+    ErrorCallback error_callback) {
+  Notify(true, std::move(callback), std::move(error_callback));
+}
+
+void BluetoothRemoteGattCharacteristicSpatiand::UnsubscribeFromNotifications(
+    BluetoothRemoteGattDescriptor* ccc_descriptor,
+    base::OnceClosure callback,
+    ErrorCallback error_callback) {
+  Notify(false, std::move(callback), std::move(error_callback));
+}
+
+void BluetoothRemoteGattCharacteristicSpatiand::Notify(
+    bool enable,
+    base::OnceClosure callback,
+    ErrorCallback error_callback) {
+  if (notify_callback_ || notify_error_callback_) {
+    std::move(error_callback)
+        .Run(BluetoothGattService::GattErrorCode::kInProgress);
+    return;
+  }
+  notify_callback_ = std::move(callback);
+  notify_error_callback_ = std::move(error_callback);
+  bridge_->Send(base::DictValue()
+                    .Set("op", "notify")
+                    .Set("address", address_)
+                    .Set("id", identifier_)
+                    .Set("enable", enable));
+}
+
+void BluetoothRemoteGattCharacteristicSpatiand::OnRead(
+    int status,
+    std::vector<uint8_t> value) {
+  if (!read_callback_) {
+    return;
+  }
+  if (status != kGattSuccess) {
+    std::move(read_callback_).Run(ErrorOf(status), {});
+    return;
+  }
+  value_ = std::move(value);
+  std::move(read_callback_).Run(std::nullopt, value_);
+}
+
+void BluetoothRemoteGattCharacteristicSpatiand::OnWrote(int status) {
+  base::OnceClosure done = std::move(write_callback_);
+  ErrorCallback failed = std::move(write_error_callback_);
+  if (status == kGattSuccess) {
+    if (done) {
+      std::move(done).Run();
+    }
+  } else if (failed) {
+    std::move(failed).Run(ErrorOf(status));
+  }
+}
+
+void BluetoothRemoteGattCharacteristicSpatiand::OnNotifying(int status) {
+  base::OnceClosure done = std::move(notify_callback_);
+  ErrorCallback failed = std::move(notify_error_callback_);
+  if (status == kGattSuccess) {
+    if (done) {
+      std::move(done).Run();
+    }
+  } else if (failed) {
+    std::move(failed).Run(ErrorOf(status));
+  }
+}
+
+void BluetoothRemoteGattCharacteristicSpatiand::OnChanged(
+    std::vector<uint8_t> value) {
+  value_ = std::move(value);
+  bridge_->NotifyGattCharacteristicValueChanged(this, value_);
+}
+
+void BluetoothRemoteGattCharacteristicSpatiand::FailPending() {
+  if (read_callback_) {
+    std::move(read_callback_)
+        .Run(BluetoothGattService::GattErrorCode::kFailed, {});
+  }
+  OnWrote(kGattFailure);
+  OnNotifying(kGattFailure);
+}
