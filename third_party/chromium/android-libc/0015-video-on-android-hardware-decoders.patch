 media/media_options.gni                       |   4 +-
 media/mojo/services/BUILD.gn                  |   9 +
 .../gpu_mojo_media_client_spatiand_android.cc |  43 ++
 .../spatiand_media_codec_video_decoder.cc     | 449 ++++++++++++++++++
 .../spatiand_media_codec_video_decoder.h      | 104 ++++
 6 files changed, 610 insertions(+), 2 deletions(-)
 create mode 100644 media/mojo/services/gpu_mojo_media_client_spatiand_android.cc
 create mode 100644 media/mojo/services/spatiand_media_codec_video_decoder.cc
 create mode 100644 media/mojo/services/spatiand_media_codec_video_decoder.h

