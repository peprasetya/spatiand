From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Spatiand-build <claude@prasetya.id>
Date: Thu, 12 Nov 2026 22:30:00 +0700
Subject: [PATCH 308/310] Spatiand: no password is kept under the name
 "SpatiKey"

The line that stands for SpatiKey's vault in a login field (patch 0010) is a
stored credential named "SpatiKey" to the password manager. A form sent with
no username in it (the password's page of a two-page sign-in) was taken for a
new password of that credential: the bubble said "SpatiKey" for the username
and the vault was given the password under that name. The line is no longer
among the matches the save logic looks at, and the vault is never sent that
name.
---
 .../browser/password_save_manager_impl.cc     |  8 ++++
 .../spatikey_password_store_backend.cc        | 37 +++++++++++++------
 2 files changed, 34 insertions(+), 11 deletions(-)

diff --git a/components/password_manager/core/browser/password_save_manager_impl.cc b/components/password_manager/core/browser/password_save_manager_impl.cc
index 1ecf8cdf399..434d55b8fdf 100644
--- a/components/password_manager/core/browser/password_save_manager_impl.cc
+++ b/components/password_manager/core/browser/password_save_manager_impl.cc
@@ -35,6 +35,7 @@
 #include "components/password_manager/core/browser/votes_uploader.h"
 #include "components/password_manager/core/common/password_manager_features.h"
 #include "components/signin/public/base/gaia_id_hash.h"
+#include "components/spatikey/filled.h"
 
 using autofill::FieldRendererId;
 using autofill::FormData;
@@ -128,6 +129,13 @@ std::vector<raw_ptr<const StoredCredential, VectorExperimental>> MatchesInStore(
       store_matches;
   for (const StoredCredential& match : matches) {
     CHECK_NE(match.in_store, PasswordForm::Store::kNotSet);
+    // Spatiand: the line that stands for SpatiKey's vault in a login field is
+    // no login of the site's: a form sent with no username in it (the
+    // password's page of a two-page sign-in) was taken for a new password of
+    // "SpatiKey", shown so in the bubble and kept under that name.
+    if (match.password_value == std::u16string(spatikey::kPlaceholder)) {
+      continue;
+    }
     if (static_cast<int>(match.in_store) & static_cast<int>(store)) {
       store_matches.push_back(&match);
     }
diff --git a/components/password_manager/core/browser/password_store/spatikey_password_store_backend.cc b/components/password_manager/core/browser/password_store/spatikey_password_store_backend.cc
index 39d18056dc1..cc13897e987 100644
--- a/components/password_manager/core/browser/password_store/spatikey_password_store_backend.cc
+++ b/components/password_manager/core/browser/password_store/spatikey_password_store_backend.cc
@@ -3,14 +3,17 @@
 
 #include "components/password_manager/core/browser/password_store/spatikey_password_store_backend.h"
 
+#include <optional>
 #include <string>
 #include <utility>
-#include <variant>
+#include <vector>
 
 #include "base/functional/bind.h"
 #include "base/location.h"
 #include "base/strings/utf_string_conversions.h"
 #include "base/time/time.h"
+#include "base/types/expected.h"
+#include "components/affiliations/core/browser/match_type.h"
 #include "components/password_manager/core/browser/password_form.h"
 #include "components/password_manager/core/browser/password_form_digest.h"
 #include "components/password_manager/core/browser/password_store/password_store_change.h"
@@ -24,6 +27,15 @@ namespace password_manager {
 
 namespace {
 
+// What a backend answers a request for logins with.
+using LoginsOrError =
+    base::expected<std::vector<StoredCredential>, PasswordStoreBackendError>;
+
+// "Nothing changed in this store."
+std::optional<PasswordStoreChangeList> NoChanges() {
+  return PasswordStoreChangeList();
+}
+
 // The credential a login form is told about: the one line SpatiKey shows in it.
 StoredCredential AnyLoginFor(const PasswordFormDigest& digest) {
   StoredCredential any;
@@ -32,7 +44,7 @@ StoredCredential AnyLoginFor(const PasswordFormDigest& digest) {
   any.url = digest.url;
   any.username_value = spatikey::kAnyLogin;
   any.password_value = PasswordString(std::u16string(spatikey::kPlaceholder));
-  any.match_type = PasswordForm::MatchType::kExact;
+  any.match_type = affiliations::MatchType::kExact;
   any.in_store = PasswordForm::Store::kProfileStore;
   // Never handed to a page unasked.
   any.skip_zero_click = true;
@@ -53,7 +65,7 @@ void OnSaved(const std::u16string& site, PasswordChangesOrErrorReply callback, s
                             base::UTF8ToUTF16(answer.error().message));
   }
   // Nothing has changed here, either way: the vault is not this store.
-  std::move(callback).Run(PasswordChanges(PasswordStoreChangeList()));
+  std::move(callback).Run(NoChanges());
 }
 
 void Save(const StoredCredential& cred, PasswordChangesOrErrorReply callback) {
@@ -61,7 +73,11 @@ void Save(const StoredCredential& cred, PasswordChangesOrErrorReply callback) {
   base::DictValue fields;
   fields.Set("origin", origin.Serialize());
   fields.Set("title", std::string());
-  fields.Set("username", base::UTF16ToUTF8(cred.username_value));
+  // Never under the name of the line that stands for the vault in a login field: with no
+  // username of its own a password is kept with none.
+  fields.Set("username", cred.username_value == spatikey::kAnyLogin
+                             ? std::string()
+                             : base::UTF16ToUTF8(cred.username_value));
   fields.Set("password", base::UTF16ToUTF8(cred.password_value.value()));
   spatikey::Ask("save", std::move(fields),
                 base::BindOnce(&OnSaved, base::UTF8ToUTF16(origin.host()), std::move(callback)));
@@ -69,18 +85,17 @@ void Save(const StoredCredential& cred, PasswordChangesOrErrorReply callback) {
 
 void OnMatchesAndUsable(PasswordFormDigest digest,
                         BackendLoginsOrErrorReply callback,
-                        BackendLoginsResultOrError result,
+                        LoginsOrError result,
                         bool usable) {
-  if (auto* logins = std::get_if<BackendLoginsResult>(&result);
-      logins && usable && digest.scheme == PasswordForm::Scheme::kHtml) {
-    logins->push_back(AnyLoginFor(digest));
+  if (result.has_value() && usable && digest.scheme == PasswordForm::Scheme::kHtml) {
+    result->push_back(AnyLoginFor(digest));
   }
   std::move(callback).Run(std::move(result));
 }
 
 void OnMatches(PasswordFormDigest digest,
                BackendLoginsOrErrorReply callback,
-               BackendLoginsResultOrError result) {
+               LoginsOrError result) {
   spatikey::WhenUsableKnown(base::BindOnce(&OnMatchesAndUsable, std::move(digest),
                                            std::move(callback), std::move(result)));
 }
@@ -149,13 +164,13 @@ void SpatikeyPasswordStoreBackend::UpdateLoginAsync(StoredCredential cred,
                                                     PasswordChangesOrErrorReply callback) {
   if (cred.password_value == std::u16string(spatikey::kPlaceholder)) {
     // What was last used and when: nothing is kept of a login's use here.
-    std::move(callback).Run(PasswordChanges(PasswordStoreChangeList()));
+    std::move(callback).Run(NoChanges());
     return;
   }
   if (ForTheVault(cred)) {
     // Told again what it just gave: no reason to ask for a touch.
     if (spatikey::WasFilled(url::Origin::Create(cred.url), cred.password_value.value())) {
-      std::move(callback).Run(PasswordChanges(PasswordStoreChangeList()));
+      std::move(callback).Run(NoChanges());
       return;
     }
     Save(cred, std::move(callback));
