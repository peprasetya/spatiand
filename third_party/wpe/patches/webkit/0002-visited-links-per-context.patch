+VisitedLinkStore& webkitWebContextGetVisitedLinkStore(WebKitWebContext* context)
+{
+    return *context->priv->visitedLinkStore;
+}
+
+/**
+ * webkit_web_context_add_visited_links:
+ * @context: a #WebKitWebContext
+ * @uris: (array zero-terminated=1): the addresses visited, %NULL-terminated
+ *
+ * Make links to @uris look visited (`:visited`) in every page of every #WebKitWebView of
+ * @context, as links followed in them do: for pages visited before the context was made, or
+ * somewhere else. Every view of a context shares one set of visited links. Links are added
+ * to pages already shown, which are restyled.
+ *
+ * Since: 2.54 (Spatiand)
+ */
+void webkit_web_context_add_visited_links(WebKitWebContext* context, const gchar* const* uris)
+{
+    g_return_if_fail(WEBKIT_IS_WEB_CONTEXT(context));
+    if (!uris)
+        return;
+
+    for (auto* uri = uris; *uri; ++uri) {
+        // Hashed as the address of a visit is: parsed, in its canonical form.
+        URL url { String::fromUTF8(*uri) };
+        if (!url.isValid())
+            continue;
+        context->priv->visitedLinkStore->addVisitedLinkHash(WebCore::computeSharedStringHash(url.string()));
+    }
+}
+
+/**
+ * webkit_web_context_clear_visited_links:
+ * @context: a #WebKitWebContext
+ *
+ * Make every link in the views of @context look unvisited again: for a history cleared.
+ * Links followed from then on look visited, as before.
+ *
+ * Since: 2.54 (Spatiand)
+ */
+void webkit_web_context_clear_visited_links(WebKitWebContext* context)
+{
+    g_return_if_fail(WEBKIT_IS_WEB_CONTEXT(context));
+
+    context->priv->visitedLinkStore->removeAll();
+}
