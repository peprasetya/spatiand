+#include <android/hardware_buffer.h>
+#endif
 #include <dlfcn.h>
 #include <fcntl.h>
 #include <stddef.h>
@@ -219,6 +222,31 @@ class ContentSandboxHelper : public gpu::GpuSandboxHelper {
         }
       }
     }
+    // And Android's graphics buffers, in which the frames go to the room
+    // (ui/ozone/platform/wayland/gpu/gl_surface_egl_readback_wayland.cc): one
+    // made and let go here loads the buffer mapper, a vendor library the
+    // sandbox keeps out, and reaches the allocator service.
+    if (void* window = dlopen("libnativewindow.so", RTLD_NOW)) {
+      using Allocate = int (*)(const AHardwareBuffer_Desc*, AHardwareBuffer**);
+      using Release = void (*)(AHardwareBuffer*);
+      auto allocate = reinterpret_cast<Allocate>(
+          dlsym(window, "AHardwareBuffer_allocate"));
+      auto release =
+          reinterpret_cast<Release>(dlsym(window, "AHardwareBuffer_release"));
+      if (allocate && release) {
+        AHardwareBuffer_Desc description = {};
+        description.width = 1;
+        description.height = 1;
+        description.layers = 1;
+        description.format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM;
+        description.usage = AHARDWAREBUFFER_USAGE_GPU_FRAMEBUFFER |
+                            AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE;
+        AHardwareBuffer* buffer = nullptr;
+        if (allocate(&description, &buffer) == 0 && buffer) {
+          release(buffer);
+        }
+      }
+    }
 #endif
   }
 
