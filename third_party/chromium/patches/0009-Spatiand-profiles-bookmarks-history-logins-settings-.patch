+++ b/chrome/browser/spatiand/history_sync.cc
@@ -0,0 +1,437 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/spatiand/history_sync.h"
+
+#include <map>
+#include <functional>
+#include <algorithm>
+#include <set>
+#include <utility>
+
+#include "base/auto_reset.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/history/history_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/spatiand/shared_folder.h"
+#include "components/history/core/browser/history_types.h"
+#include "components/history/core/browser/url_row.h"
+#include "url/gurl.h"
+
+namespace spatiand {
+
+namespace {
+
+constexpr base::TimeDelta kSaveAfter = base::Seconds(2);
+// A title that comes later, or the same page again this soon, is the same visit.
+constexpr double kSameVisitMs = 30 * 60 * 1000;
+constexpr double kYearMs = 366.0 * 24 * 60 * 60 * 1000;
+// Chromium's own history keeps no more than this: older visits would only be thrown away again.
+constexpr double kImportMs = 90.0 * 24 * 60 * 60 * 1000;
+
+std::string MonthOf(double at_ms) {
+  base::Time::Exploded exploded;
+  TimeOfMs(at_ms).UTCExplode(&exploded);
+  return base::StringPrintf("%04d-%02d", exploded.year, exploded.month);
+}
+
+bool Remembered(const GURL& url) {
+  return url.SchemeIsHTTPOrHTTPS();
+}
+
+base::ListValue VisitsToList(const std::vector<HistorySync::Visit>& visits) {
+  base::ListValue list;
+  for (const HistorySync::Visit& visit : visits) {
+    base::DictValue dict;
+    dict.Set("url", visit.url);
+    dict.Set("title", visit.title);
+    dict.Set("at", visit.at);
+    list.Append(std::move(dict));
+  }
+  return list;
+}
+
+std::vector<HistorySync::Visit> VisitsFromFile(const base::FilePath& file) {
+  std::vector<HistorySync::Visit> visits;
+  std::optional<base::Value> value = ReadJson(file);
+  if (!value || !value->is_list()) {
+    return visits;
+  }
+  for (const base::Value& item : value->GetList()) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const std::string* url = item.GetDict().FindString("url");
+    const std::string* title = item.GetDict().FindString("title");
+    const std::optional<double> at = item.GetDict().FindDouble("at");
+    if (url && at) {
+      HistorySync::Visit visit;
+      visit.url = *url;
+      if (title) {
+        visit.title = base::UTF8ToUTF16(*title);
+      }
+      visit.at = *at;
+      visits.push_back(std::move(visit));
+    }
+  }
+  return visits;
+}
+
+std::vector<HistorySync::Forgotten> ForgottenFromFile(const base::FilePath& file) {
+  std::vector<HistorySync::Forgotten> forgotten;
+  std::optional<base::Value> value = ReadJson(file);
+  if (!value || !value->is_list()) {
+    return forgotten;
+  }
+  for (const base::Value& item : value->GetList()) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    HistorySync::Forgotten entry;
+    if (const std::string* url = item.GetDict().FindString("url")) {
+      entry.url = *url;
+    }
+    entry.from = item.GetDict().FindDouble("from").value_or(0);
+    entry.until = item.GetDict().FindDouble("until").value_or(0);
+    forgotten.push_back(std::move(entry));
+  }
+  return forgotten;
+}
+
+bool Hides(const HistorySync::Forgotten& forgotten, const HistorySync::Visit& visit) {
+  return visit.at <= forgotten.until && visit.at >= forgotten.from &&
+         (!forgotten.url || *forgotten.url == visit.url);
+}
+
+}  // namespace
+
+HistorySync::News::News() = default;
+HistorySync::News::News(News&&) = default;
+HistorySync::News& HistorySync::News::operator=(News&&) = default;
+HistorySync::News::~News() = default;
+
+// The folder's side, on its own sequence: this machine's month, and how far each other file has
+// been read.
+class HistorySync::Files {
+ public:
+  explicit Files(const std::string& id)
+      : dir_(SharedProfileDir(id).Append("history")),
+        progress_file_(LocalProfileDir(id).Append("history-read.json")) {
+    const base::FilePath machine_file = LocalDir().Append("machine.json");
+    if (std::optional<base::Value> value = ReadJson(machine_file); value && value->is_string()) {
+      machine_ = value->GetString();
+    } else {
+      machine_ = NewId();
+      WriteJson(machine_file, base::Value(machine_));
+    }
+    if (std::optional<base::Value> value = ReadJson(progress_file_); value && value->is_dict()) {
+      for (const auto [name, count] : value->GetDict()) {
+        if (count.is_int()) {
+          read_[name] = count.GetInt();
+        }
+      }
+    }
+    // This machine's files of more than a year ago go.
+    const std::string year_ago = MonthOf(static_cast<double>(NowMs()) - kYearMs);
+    const std::string mine = machine_ + "-";
+    for (const std::string& name : ListJson(dir_)) {
+      if (name.starts_with(mine) && name.substr(mine.size()) < year_ago) {
+        RemovePath(dir_.Append(name + ".json"));
+      }
+    }
+  }
+
+  // Visits made here, written to this month's file.
+  void Save(std::vector<Visit> visits) {
+    for (Visit& visit : visits) {
+      const std::string month = MonthOf(visit.at);
+      if (month != month_) {
+        month_ = month;
+        visits_ = VisitsFromFile(FileOf(month_));
+      }
+      if (!visits_.empty() && visits_.back().url == visit.url &&
+          visit.at - visits_.back().at < kSameVisitMs) {
+        if (!visit.title.empty()) {
+          visits_.back().title = std::move(visit.title);
+        }
+      } else {
+        visits_.push_back(std::move(visit));
+      }
+    }
+    if (!month_.empty()) {
+      WriteJson(FileOf(month_), base::Value(VisitsToList(visits_)));
+    }
+  }
+
+  // What was taken out here, for every machine; this machine's own files, without it.
+  void Forget(Forgotten forgotten) {
+    const base::FilePath list_file = dir_.Append("forgotten-" + machine_ + ".json");
+    std::vector<Forgotten> mine = ForgottenFromFile(list_file);
+    if (!forgotten.url && forgotten.from == 0) {
+      mine.clear();  // Everything makes every earlier entry needless.
+    }
+    mine.push_back(forgotten);
+    base::ListValue list;
+    for (const Forgotten& entry : mine) {
+      base::DictValue dict;
+      if (entry.url) {
+        dict.Set("url", *entry.url);
+      }
+      dict.Set("from", entry.from);
+      dict.Set("until", entry.until);
+      list.Append(std::move(dict));
+    }
+    WriteJson(list_file, base::Value(std::move(list)));
+    read_["forgotten-" + machine_] = static_cast<int>(mine.size());
+    SaveProgress();
+    RemoveFromOwnFiles(forgotten);
+  }
+
+  // What the other machines' files have that was not read yet.
+  News ReadNews(base::Time last) {
+    News news;
+    news.changed = FolderChanged(dir_);
+    if (!last.is_null() && news.changed == last) {
+      news.unchanged = true;
+      return news;
+    }
+    const double oldest = static_cast<double>(NowMs()) - kImportMs;
+    const std::string mine = machine_ + "-";
+    const std::string my_forgotten = "forgotten-" + machine_;
+    bool moved = false;
+    for (const std::string& name : ListJson(dir_)) {
+      if (name.starts_with(mine) || name == my_forgotten) {
+        continue;
+      }
+      int& done = read_[name];
+      if (name.starts_with("forgotten-")) {
+        std::vector<Forgotten> forgotten = ForgottenFromFile(dir_.Append(name + ".json"));
+        for (size_t i = static_cast<size_t>(done) < forgotten.size() ? done : forgotten.size();
+             i < forgotten.size(); ++i) {
+          RemoveFromOwnFiles(forgotten[i]);
+          news.forgotten.push_back(std::move(forgotten[i]));
+        }
+        moved |= done != static_cast<int>(forgotten.size());
+        done = static_cast<int>(forgotten.size());
+        continue;
+      }
+      std::vector<Visit> visits = VisitsFromFile(dir_.Append(name + ".json"));
+      // A file only grows at its end, unless its machine took something out of it.
+      for (size_t i = static_cast<size_t>(done) < visits.size() ? done : visits.size();
+           i < visits.size(); ++i) {
+        if (visits[i].at >= oldest) {
+          news.visits.push_back(std::move(visits[i]));
+        }
+      }
+      moved |= done != static_cast<int>(visits.size());
+      done = static_cast<int>(visits.size());
+    }
+    if (moved) {
+      SaveProgress();
+    }
+    return news;
+  }
+
+ private:
+  base::FilePath FileOf(const std::string& month) const {
+    return dir_.Append(machine_ + "-" + month + ".json");
+  }
+
+  void SaveProgress() {
+    base::DictValue dict;
+    for (const auto& [name, count] : read_) {
+      dict.Set(name, count);
+    }
+    WriteJson(progress_file_, base::Value(std::move(dict)));
+  }
+
+  void RemoveFromOwnFiles(const Forgotten& forgotten) {
+    const std::string mine = machine_ + "-";
+    for (const std::string& name : ListJson(dir_)) {
+      if (!name.starts_with(mine)) {
+        continue;
+      }
+      const base::FilePath file = dir_.Append(name + ".json");
+      std::vector<Visit> visits = VisitsFromFile(file);
+      const size_t before = visits.size();
+      std::erase_if(visits, [&forgotten](const Visit& visit) { return Hides(forgotten, visit); });
+      if (visits.size() == before) {
+        continue;
+      }
+      if (visits.empty()) {
+        RemovePath(file);
+      } else {
+        WriteJson(file, base::Value(VisitsToList(visits)));
+      }
+    }
+    std::erase_if(visits_, [&forgotten](const Visit& visit) { return Hides(forgotten, visit); });
+  }
+
+  const base::FilePath dir_;
+  const base::FilePath progress_file_;
+  std::string machine_;
+  std::string month_;
+  std::vector<Visit> visits_;
+  std::map<std::string, int> read_;
+};
+
+HistorySync::HistorySync(Profile* profile,
+                         const std::string& id,
+                         scoped_refptr<base::SequencedTaskRunner> files)
+    : history_(HistoryServiceFactory::GetForProfile(profile, ServiceAccessType::EXPLICIT_ACCESS)),
+      files_(std::move(files), id) {
+  if (history_) {
+    observation_.Observe(history_);
+    Poll();
+  }
+}
+
+HistorySync::~HistorySync() {
+  if (!unsaved_.empty()) {
+    files_.AsyncCall(&Files::Save).WithArgs(std::move(unsaved_));
+  }
+}
+
+void HistorySync::Poll() {
+  if (reading_ || !history_) {
+    return;
+  }
+  reading_ = true;
+  files_.AsyncCall(&Files::ReadNews)
+      .WithArgs(last_read_)
+      .Then(base::BindOnce(&HistorySync::OnNews, weak_factory_.GetWeakPtr()));
+}
+
+void HistorySync::OnNews(News news) {
+  reading_ = false;
+  if (news.unchanged) {
+    return;
+  }
+  last_read_ = news.changed;
+  if (!news.visits.empty()) {
+    // Newest first, each address's first row counting all its visits here: the first row of an
+    // address is the one its entry is made from. These were browsed, on another machine; Chromium's
+    // own source for that (SOURCE_SYNCED) makes no visit, so the history page would not show them.
+    std::vector<const Visit*> visits;
+    visits.reserve(news.visits.size());
+    std::map<std::string, int> counts;
+    for (const Visit& visit : news.visits) {
+      visits.push_back(&visit);
+      ++counts[visit.url];
+    }
+    std::ranges::stable_sort(visits, std::greater<>(), &Visit::at);
+    history::URLRows rows;
+    rows.reserve(visits.size());
+    for (const Visit* visit : visits) {
+      GURL url(visit->url);
+      if (!url.is_valid()) {
+        continue;
+      }
+      history::URLRow row(url);
+      row.set_title(visit->title);
+      row.set_visit_count(counts[visit->url]);
+      row.set_typed_count(0);
+      row.set_last_visit(TimeOfMs(visit->at));
+      row.set_hidden(false);
+      rows.push_back(std::move(row));
+    }
+    history_->AddPagesWithDetails(rows, history::SOURCE_BROWSED);
+  }
+  for (const Forgotten& forgotten : news.forgotten) {
+    std::set<GURL> urls;
+    if (forgotten.url) {
+      urls.insert(GURL(*forgotten.url));
+    }
+    ++applying_forgotten_;
+    history_->ExpireHistoryBetween(
+        urls, /*restrict_app_id=*/std::nullopt, TimeOfMs(forgotten.from), TimeOfMs(forgotten.until),
+        /*user_initiated=*/false,
+        base::BindOnce([](base::WeakPtr<HistorySync> self) {
+          if (self) {
+            --self->applying_forgotten_;
+          }
+        }, weak_factory_.GetWeakPtr()),
+        &tracker_);
+  }
+}
+
+void HistorySync::SaveSoon() {
+  if (!save_timer_.IsRunning()) {
+    save_timer_.Start(FROM_HERE, kSaveAfter, base::BindOnce(
+                                                 [](HistorySync* self) {
+                                                   self->files_.AsyncCall(&Files::Save)
+                                                       .WithArgs(std::move(self->unsaved_));
+                                                   self->unsaved_.clear();
+                                                 },
+                                                 base::Unretained(this)));
+  }
+}
+
+void HistorySync::OnURLVisited(history::HistoryService* history_service,
+                               const history::VisitedURLInfo& visited_url_info) {
+  const history::URLRow& row = visited_url_info.url_row;
+  if (row.hidden() || !Remembered(row.url())) {
+    return;
+  }
+  Visit visit;
+  visit.url = row.url().spec();
+  visit.title = row.title();
+  visit.at = MsOfTime(visited_url_info.visit_row.visit_time);
+  last_ = visit;
+  unsaved_.push_back(std::move(visit));
+  SaveSoon();
+}
+
+void HistorySync::OnURLsModified(history::HistoryService* history_service,
+                                 const history::URLRows& changed_urls) {
+  // The title of the page just visited, come after it.
+  if (!last_) {
+    return;
+  }
+  for (const history::URLRow& row : changed_urls) {
+    if (row.url().spec() == last_->url && !row.title().empty() && row.title() != last_->title) {
+      last_->title = row.title();
+      unsaved_.push_back(*last_);
+      SaveSoon();
+      return;
+    }
+  }
+}
+
+void HistorySync::OnHistoryDeletions(history::HistoryService* history_service,
+                                     const history::DeletionInfo& deletion_info) {
+  // Chromium's own expiry, and what another machine took out, are not the wearer taking it out.
+  if (applying_forgotten_ > 0 || deletion_info.is_from_expiration()) {
+    return;
+  }
+  const double now = static_cast<double>(NowMs());
+  if (deletion_info.IsAllHistory()) {
+    Forgotten forgotten;
+    forgotten.until = now;
+    files_.AsyncCall(&Files::Forget).WithArgs(std::move(forgotten));
+    return;
+  }
+  const history::DeletionTimeRange& range = deletion_info.time_range();
+  if (range.IsValid() && !deletion_info.restrict_urls().has_value()) {
+    Forgotten forgotten;
+    forgotten.from = range.begin().is_null() ? 0 : MsOfTime(range.begin());
+    forgotten.until = range.end().is_null() ? now : MsOfTime(range.end());
+    files_.AsyncCall(&Files::Forget).WithArgs(std::move(forgotten));
+    return;
+  }
+  for (const history::URLRow& row : deletion_info.deleted_rows()) {
+    if (Remembered(row.url())) {
+      Forgotten forgotten;
+      forgotten.url = row.url().spec();
+      forgotten.until = now;
+      files_.AsyncCall(&Files::Forget).WithArgs(std::move(forgotten));
+    }
+  }
+}
+
+}  // namespace spatiand
