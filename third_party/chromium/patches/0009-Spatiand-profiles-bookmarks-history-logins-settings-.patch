@@ -0,0 +1,132 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/spatiand/profile_lock_dialog.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "chrome/browser/spatiand/profiles_sync.h"
+#include "ui/base/mojom/dialog_button.mojom.h"
+#include "ui/base/mojom/ui_base_types.mojom-shared.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/window/dialog_delegate.h"
+
+namespace spatiand {
+
+namespace {
+
+constexpr int kTriesBeforeWaiting = 5;
+constexpr base::TimeDelta kWait = base::Seconds(30);
+
+class ProfileLockDialog : public views::DialogDelegate {
+ public:
+  ProfileLockDialog(const std::u16string& profile_name,
+                    bool is_pin,
+                    std::string salt,
+                    std::string hash,
+                    base::OnceCallback<void(bool)> done)
+      : salt_(std::move(salt)), hash_(std::move(hash)), done_(std::move(done)) {
+    SetTitle(profile_name + u" is locked");
+    SetModalType(ui::mojom::ModalType::kNone);
+    SetShowCloseButton(true);
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk) |
+               static_cast<int>(ui::mojom::DialogButton::kCancel));
+    SetButtonLabel(ui::mojom::DialogButton::kOk, u"Open");
+    views::View* contents = SetContentsView(std::make_unique<views::View>());
+    contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(16), 10));
+    contents->AddChildView(std::make_unique<views::Label>(is_pin ? u"Its PIN:" : u"Its password:"))
+        ->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    field_ = contents->AddChildView(std::make_unique<views::Textfield>());
+    field_->SetTextInputType(ui::TEXT_INPUT_TYPE_PASSWORD);
+    field_->GetViewAccessibility().SetName(is_pin ? u"PIN" : u"Password");
+    said_ = contents->AddChildView(std::make_unique<views::Label>(std::u16string()));
+    said_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    SetAcceptCallbackWithClose(
+        base::BindRepeating(&ProfileLockDialog::Try, base::Unretained(this)));
+    SetCancelCallback(base::BindOnce(&ProfileLockDialog::Finish, base::Unretained(this), false));
+    SetCloseCallback(base::BindOnce(&ProfileLockDialog::Finish, base::Unretained(this), false));
+    SetInitiallyFocusedView(field_);
+  }
+  ~ProfileLockDialog() override = default;
+
+ private:
+  // Whether the dialog closes now: not until the many rounds of hashing have said.
+  bool Try() {
+    if (checking_) {
+      return false;
+    }
+    if (base::Time::Now() < wait_until_) {
+      said_->SetText(u"Too many wrong tries: wait a moment.");
+      return false;
+    }
+    checking_ = true;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+        base::BindOnce(&LockHash, salt_, base::UTF16ToUTF8(field_->GetText())),
+        base::BindOnce(&ProfileLockDialog::Tried, weak_factory_.GetWeakPtr()));
+    return false;
+  }
+
+  void Tried(std::string hash) {
+    checking_ = false;
+    if (hash == hash_) {
+      Finish(true);
+      GetWidget()->Close();
+      return;
+    }
+    field_->SetText(std::u16string());
+    field_->RequestFocus();
+    if (++wrong_ >= kTriesBeforeWaiting) {
+      wrong_ = 0;
+      wait_until_ = base::Time::Now() + kWait;
+      said_->SetText(u"Too many wrong tries: wait half a minute.");
+    } else {
+      said_->SetText(u"That is not it.");
+    }
+  }
+
+  void Finish(bool opened) {
+    if (done_) {
+      std::move(done_).Run(opened);
+    }
+  }
+
+  const std::string salt_;
+  const std::string hash_;
+  base::OnceCallback<void(bool)> done_;
+  raw_ptr<views::Textfield> field_ = nullptr;
+  raw_ptr<views::Label> said_ = nullptr;
+  bool checking_ = false;
+  int wrong_ = 0;
+  base::Time wait_until_;
+  base::WeakPtrFactory<ProfileLockDialog> weak_factory_{this};
+};
+
+}  // namespace
+
+void ShowProfileLockDialog(const std::u16string& profile_name,
+                           bool is_pin,
+                           const std::string& salt,
+                           const std::string& hash,
+                           base::OnceCallback<void(bool)> done) {
+  views::DialogDelegate::CreateDialogWidget(
+      std::make_unique<ProfileLockDialog>(profile_name, is_pin, salt, hash, std::move(done)),
+      /*context=*/gfx::NativeWindow(), /*parent=*/gfx::NativeView())
+      ->Show();
+}
+
+}  // namespace spatiand
