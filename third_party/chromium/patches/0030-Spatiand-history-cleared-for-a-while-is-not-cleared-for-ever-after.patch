+// A forget-record as its file has it: what tells it from the others there.
+std::string KeyOf(const HistorySync::Forgotten& forgotten) {
+  return base::StringPrintf("%s|%.17g|%.17g|%.17g", forgotten.url ? forgotten.url->c_str() : "",
+                            forgotten.from, forgotten.until, forgotten.at);
+}
+
+// No person's: from the beginning of time itself, every address. Bounce tracking cleared all
+// history so at most hourly until 2026-11-17 (base/0152's DATA_TYPE_SKIP_SSL_HOST_STATE was
+// DATA_TYPE_HISTORY, patch 0016), and builds of before then wrote it for every machine. A person
+// clearing all time, or everything older than 30 days, begins at 0.
+bool NoPersons(const HistorySync::Forgotten& forgotten) {
+  return !forgotten.url && forgotten.from < 0;
+}
+
+std::string HashOf(const std::string& bytes) {
+  return base::HexEncode(crypto::hash::Sha256(bytes));
+}
+
+// What a file is as the folder lists it: a file whose size and time are as they were is as it was.
+struct Stat {
+  double size = -1;
+  // Microseconds since 1970.
+  double modified = 0;
+  bool operator==(const Stat&) const = default;
+};
+
+Stat StatOf(const base::FilePath& file) {
+  Stat stat;
+  base::File::Info info;
+  if (base::GetFileInfo(file, &info)) {
+    stat.size = static_cast<double>(info.size);
+    stat.modified =
+        static_cast<double>((info.last_modified - base::Time::UnixEpoch()).InMicroseconds());
+  }
+  return stat;
+}
+
 bool Hides(const HistorySync::Forgotten& forgotten, const HistorySync::Visit& visit) {
   return visit.at <= forgotten.until && visit.at >= forgotten.from &&
          (!forgotten.url || *forgotten.url == visit.url);
 }
 
+// A forgotten file's records, each with its key, none hiding what was visited after it was
+// written. A build of before 2026-11-13 wrote "the last hour" as from then until the end of time
+// (Chromium gives the end of a cleared range so), and reading it took out every later visit here
+// too, from history and from this machine's shared files. Such a record says not when it was
+// written: no later than its file was last, then.
+std::vector<std::pair<std::string, HistorySync::Forgotten>> RecordsOf(
+    const base::FilePath& file,
+    const std::optional<base::Value>& value) {
+  base::File::Info info;
+  const double written = base::GetFileInfo(file, &info) && !info.last_modified.is_null()
+                             ? MsOfTime(info.last_modified)
+                             : static_cast<double>(NowMs());
+  std::vector<std::pair<std::string, HistorySync::Forgotten>> records;
+  for (HistorySync::Forgotten& entry : ForgottenFromValue(base::OptionalToPtr(value))) {
+    std::string key = KeyOf(entry);
+    entry.until = std::min(entry.until, entry.at > 0 ? entry.at : written);
+    records.emplace_back(std::move(key), std::move(entry));
+  }
+  return records;
+}
+
+// The millisecond of a visit in history, as the files have it.
+int64_t MsOf(base::Time time) {
+  return static_cast<int64_t>(MsOfTime(time));
+}
+
+// A visit put into history from the folder, as AddPagesWithDetails makes it: a link followed from
