-  for (const base::FilePath& relative : found) {
+  Copy copy;
+  Signer signer;
+  for (const auto& [relative, size] : *found) {
     const base::FilePath source = from.Append(relative);
     const base::FilePath target = to.Append(relative);
-    if (base::ContentsEqual(source, target)) {
+    std::optional<std::vector<uint8_t>> contents = base::ReadFileToBytes(source);
+    if (!contents) {
+      LOG(WARNING) << "SpatiMesh: could not read " << source << " to share it";
+      return std::nullopt;
+    }
+    signer.Add(relative, *contents);
+    copy.bytes += static_cast<int64_t>(contents->size());
+    ++copy.count;
+    if (std::optional<std::vector<uint8_t>> there = base::ReadFileToBytes(target);
+        there && *there == *contents) {
       continue;
     }
     base::CreateDirectory(target.DirName());
     const base::FilePath temporary =
         target.DirName().Append("." + target.BaseName().value() + ".new");
-    if (!base::CopyFile(source, temporary) || !base::ReplaceFile(temporary, target, nullptr)) {
+    if (!base::WriteFile(temporary, *contents) ||
+        !base::ReplaceFile(temporary, target, nullptr)) {
       base::DeleteFile(temporary);
+      return std::nullopt;
+    }
+  }
+  copy.signature = signer.Finish();
+  return copy;
+}
+
+// Whether the copy in `dir` is all there, as the record says it is: counted first, read only once
+// its files' number and size are the record's.
+bool CopyComplete(const base::FilePath& dir,
+                  const std::string& signature,
+                  int64_t bytes,
+                  int count) {
+  const std::optional<std::map<base::FilePath, int64_t>> found = ListShared(dir);
+  if (!found || static_cast<int>(found->size()) != count) {
+    return false;
+  }
+  int64_t total = 0;
+  for (const auto& [relative, size] : *found) {
+    total += size;
+  }
+  if (total != bytes) {
+    return false;
+  }
+  Signer signer;
+  for (const auto& [relative, size] : *found) {
+    std::optional<std::vector<uint8_t>> contents = base::ReadFileToBytes(dir.Append(relative));
+    if (!contents) {
       return false;
     }
+    signer.Add(relative, *contents);
   }
-  return true;
+  return signer.Finish() == signature;
