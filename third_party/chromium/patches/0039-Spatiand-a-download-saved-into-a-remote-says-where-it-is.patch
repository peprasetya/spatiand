+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SPATIAND_SAVED_IN_H_
+#define CHROME_BROWSER_SPATIAND_SAVED_IN_H_
+
+#include <optional>
+#include <string>
+
+namespace download {
+class DownloadItem;
+}  // namespace download
+
+namespace spatiand {
+
+// Where a download saved through the room's chooser into a remote is now. The browser wrote it
+// into the chooser's outbox (.../spatiand-choose/outbox/<folder>/<name>), and the chooser's
+// sender moved it from there to the remote, leaving a record of where (.../spatiand-choose/sent/
+// <folder>.json, crates/spatiand-choose): the remote's folder, "Drive:Documents", once known.
+// Without this a download sent on was "Deleted" in the downloads page, the file being gone from
+// where the browser put it.
+std::optional<std::u16string> SavedIn(const download::DownloadItem* item);
+
+// Looks for that record off the UI thread, for a finished download in the chooser's outbox whose
+// record is not known yet; the item's observers are told when it is found (the downloads page
+// and bubble then say "Saved in <folder>"). One still being sent is looked for again, every few
+// seconds, for half an hour.
+void LookUpSavedIn(download::DownloadItem* item);
+
+}  // namespace spatiand
+
+#endif  // CHROME_BROWSER_SPATIAND_SAVED_IN_H_
