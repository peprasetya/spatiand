@@ -0,0 +1,402 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/spatiand/extension_sync.h"
+
+#include <algorithm>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/auto_reset.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/functional/callback_helpers.h"
+#include "base/one_shot_event.h"
+#include "base/version.h"
+#include "chrome/browser/extensions/extension_service.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/spatiand/shared_folder.h"
+#include "extensions/browser/disable_reason.h"
+#include "extensions/browser/extension_registrar.h"
+#include "extensions/browser/extension_system.h"
+#include "extensions/browser/pending_extension_manager.h"
+#include "extensions/browser/uninstall_reason.h"
+#include "extensions/browser/unpacked_installer.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/manifest.h"
+#include "extensions/common/manifest_constants.h"
+#include "extensions/common/manifest_handlers/manifest_url_handlers.h"
+#include "extensions/common/mojom/manifest.mojom-shared.h"
+#include "url/gurl.h"
+
+namespace spatiand {
+
+namespace {
+
+using extensions::Extension;
+using extensions::mojom::ManifestLocation;
+
+// The synchroniser sends nothing larger, and an extension's files are not worth more than this.
+constexpr int64_t kLargestFile = 4 << 20;
+constexpr int64_t kLargestExtension = 64 << 20;
+
+bool ShouldAllowInstall(const Extension* extension, content::BrowserContext* context) {
+  return !extension->is_theme();
+}
+
+bool FromFolder(const Extension* extension) {
+  return (extension->location() == ManifestLocation::kUnpacked ||
+          extension->location() == ManifestLocation::kCommandLine) &&
+         extension->manifest()->FindStringPath(extensions::manifest_keys::kPublicKey);
+}
+
+bool FromStore(const Extension* extension) {
+  return extension->location() == ManifestLocation::kInternal &&
+         (extensions::ManifestURL::UpdatesFromGallery(extension) ||
+          !extensions::ManifestURL::GetUpdateURL(extension).is_empty());
+}
+
+bool Syncs(const Extension* extension) {
+  return extension->is_extension() && (FromFolder(extension) || FromStore(extension));
+}
+
+ExtensionSync::Records ReadRecords(const base::FilePath& dir) {
+  ExtensionSync::Records records;
+  for (const std::string& id : ListJson(dir)) {
+    if (std::optional<base::Value> value = ReadJson(dir.Append(id + ".json"));
+        value && value->is_dict()) {
+      records.emplace(id, std::move(*value).TakeDict());
+    }
+  }
+  return records;
+}
+
+// An extension's files, to where every machine can load it from. Refused, with nothing left half
+// done, if a file is more than the synchroniser sends.
+bool CopyFiles(const base::FilePath& from, const base::FilePath& to) {
+  std::vector<base::FilePath> found;
+  int64_t total = 0;
+  base::FileEnumerator files(from, /*recursive=*/true, base::FileEnumerator::FILES);
+  for (base::FilePath file = files.Next(); !file.empty(); file = files.Next()) {
+    base::FilePath relative;
+    from.AppendRelativePath(file, &relative);
+    bool hidden = false;
+    for (const std::string& part : relative.GetComponents()) {
+      hidden |= part.starts_with('.') || part == "node_modules" || part == "_metadata";
+    }
+    if (hidden) {
+      continue;
+    }
+    const int64_t size = files.GetInfo().GetSize();
+    total += size;
+    if (size > kLargestFile || total > kLargestExtension) {
+      LOG(WARNING) << "SpatiMesh: the extension in " << from << " is too large to go to other "
+                   << "machines";
+      return false;
+    }
+    found.push_back(std::move(relative));
+  }
+  // What is no longer there goes from the copy, so that the deletion travels too.
+  base::FileEnumerator old(to, /*recursive=*/true, base::FileEnumerator::FILES);
+  for (base::FilePath file = old.Next(); !file.empty(); file = old.Next()) {
+    base::FilePath relative;
+    to.AppendRelativePath(file, &relative);
+    if (!std::ranges::contains(found, relative)) {
+      base::DeleteFile(file);
+    }
+  }
+  for (const base::FilePath& relative : found) {
+    const base::FilePath source = from.Append(relative);
+    const base::FilePath target = to.Append(relative);
+    if (base::ContentsEqual(source, target)) {
+      continue;
+    }
+    base::CreateDirectory(target.DirName());
+    const base::FilePath temporary =
+        target.DirName().Append("." + target.BaseName().value() + ".new");
+    if (!base::CopyFile(source, temporary) || !base::ReplaceFile(temporary, target, nullptr)) {
+      base::DeleteFile(temporary);
+      return false;
+    }
+  }
+  return true;
+}
+
+void WriteRecord(const base::FilePath& file,
+                 base::DictValue record,
+                 std::optional<base::FilePath> copy_from,
+                 const base::FilePath& copy_to) {
+  if (copy_from && !CopyFiles(*copy_from, copy_to)) {
+    return;
+  }
+  WriteJson(file, base::Value(std::move(record)));
+}
+
+}  // namespace
+
+ExtensionSync::ExtensionSync(Profile* profile,
+                             const std::string& id,
+                             scoped_refptr<base::SequencedTaskRunner> files)
+    : profile_(profile),
+      dir_(SharedProfileDir(id).Append("extensions")),
+      files_dir_(SharedProfileDir(id).Append("extension-files")),
+      known_file_(LocalProfileDir(id).Append("extensions-known.json")),
+      files_(std::move(files)),
+      registry_(extensions::ExtensionRegistry::Get(profile)) {
+  extensions::ExtensionSystem::Get(profile)->ready().Post(
+      FROM_HERE, base::BindOnce(&ExtensionSync::OnReady, weak_factory_.GetWeakPtr()));
+}
+
+ExtensionSync::~ExtensionSync() = default;
+
+void ExtensionSync::OnReady() {
+  observation_.Observe(registry_);
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](const base::FilePath& file) {
+            std::set<std::string> known;
+            if (std::optional<base::Value> value = ReadJson(file); value && value->is_list()) {
+              for (const base::Value& item : value->GetList()) {
+                if (item.is_string()) {
+                  known.insert(item.GetString());
+                }
+              }
+            }
+            return known;
+          },
+          known_file_),
+      base::BindOnce(
+          [](base::WeakPtr<ExtensionSync> self, std::set<std::string> known) {
+            if (self) {
+              self->known_ = std::move(known);
+              self->ready_ = true;
+              self->Poll();
+            }
+          },
+          weak_factory_.GetWeakPtr()));
+}
+
+void ExtensionSync::Poll() {
+  if (!ready_ || reading_) {
+    return;
+  }
+  reading_ = true;
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&ReadRecords, dir_),
+      base::BindOnce(&ExtensionSync::OnRead, weak_factory_.GetWeakPtr(), changes_));
+}
+
+void ExtensionSync::OnRead(int changes_when_asked, Records records) {
+  reading_ = false;
+  if (changes_when_asked == changes_ && records != records_) {
+    Reconcile(std::move(records));
+  } else if (records_.empty() && changes_when_asked == changes_) {
+    Reconcile(std::move(records));
+  }
+}
+
+void ExtensionSync::Reconcile(Records records) {
+  base::AutoReset<bool> applying(&applying_, true);
+  extensions::ExtensionRegistrar* registrar = extensions::ExtensionRegistrar::Get(profile_);
+  bool known_changed = false;
+
+  for (const auto& [id, record] : records) {
+    known_changed |= known_.insert(id).second;
+    const Extension* installed = registry_->GetInstalledExtension(id);
+    if (!installed) {
+      if (!installing_.contains(id)) {
+        Install(id, record);
+      }
+      continue;
+    }
+    const bool wanted = record.FindBool("enabled").value_or(true);
+    const bool enabled = registry_->enabled_extensions().Contains(id);
+    if (wanted && !enabled) {
+      registrar->EnableExtension(id);
+    } else if (!wanted && enabled) {
+      registrar->DisableExtension(id, {extensions::disable_reason::DISABLE_USER_ACTION});
+    }
+  }
+
+  // Installed here and not in the list.
+  std::vector<scoped_refptr<const Extension>> installed;
+  for (const auto& extension : registry_->GenerateInstalledExtensionsSet()) {
+    installed.push_back(extension);
+  }
+  for (const scoped_refptr<const Extension>& extension : installed) {
+    if (!Syncs(extension.get()) || records.contains(extension->id())) {
+      continue;
+    }
+    if (known_.contains(extension->id())) {
+      // It was in the list, and is gone from it: removed on another machine.
+      known_.erase(extension->id());
+      known_changed = true;
+      std::u16string error;
+      registrar->UninstallExtension(extension->id(), extensions::UNINSTALL_REASON_SYNC, &error);
+    } else {
+      base::AutoReset<bool> not_applying(&applying_, false);
+      WriteLocal(extension.get());
+      known_changed = true;
+    }
+  }
+  for (auto& [id, record] : records) {
+    records_[id] = std::move(record);
+  }
+  std::erase_if(records_, [this](const auto& item) {
+    return !known_.contains(item.first);
+  });
+  if (known_changed) {
+    SaveKnown();
+  }
+}
+
+void ExtensionSync::Install(const std::string& extension_id, const base::DictValue& record) {
+  const std::string* from = record.FindString("from");
+  if (from && *from == "folder") {
+    const base::FilePath path = files_dir_.Append(extension_id);
+    scoped_refptr<extensions::UnpackedInstaller> installer =
+        extensions::UnpackedInstaller::Create(profile_);
+    installer->set_be_noisy_on_failure(false);
+    installer->set_completion_callback(base::BindOnce(
+        [](base::WeakPtr<ExtensionSync> self, std::string id, const Extension* extension,
+           const base::FilePath& path, const std::u16string& error) {
+          if (!extension) {
+            LOG(WARNING) << "SpatiMesh: the extension " << id << " did not load: " << base::UTF16ToUTF8(error);
+          }
+          if (self) {
+            self->installing_.erase(id);
+          }
+        },
+        weak_factory_.GetWeakPtr(), extension_id));
+    installer->Load(path);
+    installing_.insert(extension_id);
+    return;
+  }
+  const std::string* update_url = record.FindString("update_url");
+  if (!update_url || !GURL(*update_url).is_valid()) {
+    return;
+  }
+  if (extensions::PendingExtensionManager::Get(profile_)->AddFromSync(
+          extension_id, GURL(*update_url), base::Version(), &ShouldAllowInstall,
+          /*remote_install=*/false)) {
+    installing_.insert(extension_id);
+    extensions::ExtensionSystem::Get(profile_)->extension_service()->CheckForUpdatesSoon();
+  }
+}
+
+void ExtensionSync::WriteLocal(const Extension* extension) {
+  if (!Syncs(extension)) {
+    return;
+  }
+  base::DictValue record;
+  record.Set("name", extension->name());
+  record.Set("version", extension->VersionString());
+  record.Set("enabled", registry_->enabled_extensions().Contains(extension->id()));
+  std::optional<base::FilePath> copy_from;
+  if (FromFolder(extension)) {
+    record.Set("from", "folder");
+    // One loaded from the shared copy is already there.
+    if (extension->path().DirName() != files_dir_) {
+      copy_from = extension->path();
+    }
+  } else {
+    record.Set("from", "store");
+    const GURL update_url = extensions::ManifestURL::GetUpdateURL(extension);
+    record.Set("update_url", update_url.is_empty()
+                                 ? std::string("https://clients2.google.com/service/update2/crx")
+                                 : update_url.spec());
+  }
+  const std::string& id = extension->id();
+  ++changes_;
+  known_.insert(id);
+  records_[id] = record.Clone();
+  files_->PostTask(FROM_HERE, base::BindOnce(&WriteRecord, dir_.Append(id + ".json"),
+                                             std::move(record), std::move(copy_from),
+                                             files_dir_.Append(id)));
+}
+
+void ExtensionSync::SaveKnown() {
+  base::ListValue list;
+  for (const std::string& id : known_) {
+    list.Append(id);
+  }
+  files_->PostTask(FROM_HERE, base::BindOnce(
+                                  [](const base::FilePath& file, base::ListValue known) {
+                                    WriteJson(file, base::Value(std::move(known)));
+                                  },
+                                  known_file_, std::move(list)));
+}
+
+void ExtensionSync::OnExtensionLoaded(content::BrowserContext* browser_context,
+                                      const Extension* extension) {
+  installing_.erase(extension->id());
+  if (applying_ || !ready_) {
+    return;
+  }
+  const auto it = records_.find(extension->id());
+  if (it != records_.end() && !it->second.FindBool("enabled").value_or(true)) {
+    WriteLocal(extension);
+  }
+}
+
+void ExtensionSync::OnExtensionUnloaded(content::BrowserContext* browser_context,
+                                        const Extension* extension,
+                                        extensions::UnloadedExtensionReason reason) {
+  if (applying_ || !ready_ || reason != extensions::UnloadedExtensionReason::DISABLE) {
+    return;
+  }
+  // The registry says it is off only after this: said as it will be.
+  const auto it = records_.find(extension->id());
+  if (it != records_.end() && it->second.FindBool("enabled").value_or(true)) {
+    base::DictValue record = it->second.Clone();
+    record.Set("enabled", false);
+    ++changes_;
+    records_[extension->id()] = record.Clone();
+    files_->PostTask(FROM_HERE, base::BindOnce(&WriteRecord, dir_.Append(extension->id() + ".json"),
+                                               std::move(record), std::nullopt, base::FilePath()));
+  }
+}
+
+void ExtensionSync::OnExtensionInstalled(content::BrowserContext* browser_context,
+                                         const Extension* extension,
+                                         bool is_update) {
+  // Fetched for this list: wanted on another machine, where its permissions were agreed to. A store
+  // extension arriving from elsewhere is otherwise left off until someone turns it on here.
+  if (installing_.contains(extension->id()) && !registry_->enabled_extensions().Contains(extension->id())) {
+    const auto wanted = records_.find(extension->id());
+    if (wanted != records_.end() && wanted->second.FindBool("enabled").value_or(true)) {
+      base::AutoReset<bool> applying(&applying_, true);
+      extensions::ExtensionRegistrar::Get(profile_)->GrantPermissionsAndEnableExtension(*extension);
+    }
+  }
+  installing_.erase(extension->id());
+  if (applying_ || !ready_) {
+    return;
+  }
+  WriteLocal(extension);
+  SaveKnown();
+}
+
+void ExtensionSync::OnExtensionUninstalled(content::BrowserContext* browser_context,
+                                           const Extension* extension,
+                                           extensions::UninstallReason reason) {
+  if (applying_ || !ready_ || reason == extensions::UNINSTALL_REASON_SYNC) {
+    return;
+  }
+  const std::string& id = extension->id();
+  if (!known_.erase(id)) {
+    return;
+  }
+  ++changes_;
+  records_.erase(id);
+  files_->PostTask(FROM_HERE, base::BindOnce(&RemovePath, dir_.Append(id + ".json")));
+  files_->PostTask(FROM_HERE, base::BindOnce(&RemovePath, files_dir_.Append(id)));
+  SaveKnown();
+}
+
+}  // namespace spatiand
