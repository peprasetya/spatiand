diff --git a/chrome/browser/shell_integration_linux_ui_mac.cc b/chrome/browser/shell_integration_linux_ui_mac.cc
new file mode 100644
index 0000000000..aece21b817
--- /dev/null
+++ b/chrome/browser/shell_integration_linux_ui_mac.cc
@@ -0,0 +1,151 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Spatiand: the Linux UI on macOS (IS_MAC_LINUX_UI) names its Wayland windows
+// as Linux's UI does: the browser's xdg_toplevel app_id and WM class come from
+// `--class` (Spatiand keys each window's sound by it: "spatimesh-chromium"),
+// else from the desktop name, and a web app's from its desktop-file name.
+//
+// Workaround, named: these are Linux's functions from
+// shell_integration_linux.cc (GetWMClassFromAppName, GetXdgAppIdForWebApp,
+// GetProgramClassName, GetProgramClassClass and their helpers), carried here
+// because the rest of that file is Linux's system (desktop files, xdg-settings,
+// GLib), not built on macOS; and its inputs that live in Linux-only places
+// (switches::kWmClass, chrome::GetDesktopName,
+// web_app::GetAppDesktopShortcutFilename) are restated. Proper alternative:
+// split shell_integration_linux.cc so the window-naming part is one file built
+// for `is_linux || is_mac_linux_ui`, and widen those three to the Linux UI.
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/environment.h"
+#include "base/files/file_path.h"
+#include "base/i18n/file_util_icu.h"
+#include "base/strings/string_util.h"
+#include "build/build_config.h"
+#include "chrome/browser/shell_integration_linux.h"
+#include "chrome/browser/web_applications/web_app_helpers.h"
+#include "chrome/common/chrome_constants.h"
+#include "chrome/common/chrome_switches.h"
+#include "ui/ozone/public/ozone_platform.h"
+#include "ui/ozone/public/platform_utils.h"
+
+static_assert(BUILDFLAG(IS_MAC_LINUX_UI));
+
+namespace shell_integration_linux {
+
+namespace {
+
+// Linux's switches::kWmClass ("The same as the --class argument in X
+// applications"), declared there for Linux alone.
+constexpr char kWmClassSwitch[] = "class";
+
+// As shell_integration_linux.cc.
+constexpr char kWebAppDesktopIdPrefixEnvVar[] =
+    "CHROME_WEB_APP_DESKTOP_ID_PREFIX";
+
+// As shell_integration_linux.cc: the desktop file's name without ".desktop".
+std::string GetDesktopBaseName(const std::string& desktop_file_name) {
+  static const char kDesktopExtension[] = ".desktop";
+  auto remainder = base::RemoveSuffix(desktop_file_name, kDesktopExtension);
+  return remainder ? std::string(*remainder) : desktop_file_name;
+}
+
+// As Linux's chrome::GetDesktopName (chrome/common/channel_info_posix.cc) for
+// a Chromium-branded build: $CHROME_DESKTOP, else "chromium-browser.desktop".
+std::string GetDesktopName(base::Environment& env) {
+  std::optional<std::string> name = env.GetVar("CHROME_DESKTOP");
+  if (name.has_value() && !name.value().empty()) {
+    return name.value();
+  }
+  return "chromium-browser.desktop";
+}
+
+// As web_app::GetAppDesktopShortcutFilename
+// (web_app_shortcut_linux.cc): "<executable>-<app id>-<profile>.desktop".
+std::string GetAppDesktopShortcutFilename(const base::FilePath& profile_path,
+                                          const std::string& app_id) {
+  std::string filename(chrome::kBrowserProcessExecutableName);
+  filename.append("-").append(app_id).append("-").append(
+      profile_path.BaseName().value());
+  base::i18n::ReplaceIllegalCharactersInPath(&filename, '_');
+  // Spaces in filenames break xdg-desktop-menu
+  // (see https://bugs.freedesktop.org/show_bug.cgi?id=66605).
+  base::ReplaceChars(filename, " ", "_", &filename);
+  return filename.append(".desktop");
+}
+
+}  // namespace
+
+std::string GetWMClassFromAppName(std::string app_name) {
+  base::i18n::ReplaceIllegalCharactersInPath(&app_name, '_');
+  base::TrimString(app_name, "_", &app_name);
+  return app_name;
+}
+
+std::string GetXdgAppIdForWebApp(std::string app_name,
+                                 const base::FilePath& profile_path) {
+  auto remainder = base::RemovePrefix(app_name, web_app::kCrxAppPrefix);
+  if (remainder) {
+    app_name = std::string(*remainder);
+  }
+  std::string app_id =
+      GetDesktopBaseName(GetAppDesktopShortcutFilename(profile_path, app_name));
+
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> desktop_id_prefix =
+      env->GetVar(kWebAppDesktopIdPrefixEnvVar);
+  if (desktop_id_prefix.has_value()) {
+    app_id.insert(0, desktop_id_prefix.value());
+  }
+
+  return app_id;
+}
+
+namespace internal {
+
+std::string GetProgramClassName(const base::CommandLine& command_line,
+                                const std::string& desktop_file_name) {
+  std::string class_name = GetDesktopBaseName(desktop_file_name);
+  std::string user_data_dir =
+      command_line.GetSwitchValueNative(switches::kUserDataDir);
+  return user_data_dir.empty() ? class_name
+                               : class_name + " (" + user_data_dir + ")";
+}
+
+std::string GetProgramClassClass(const base::CommandLine& command_line,
+                                 const std::string& desktop_file_name) {
+  if (command_line.HasSwitch(kWmClassSwitch)) {
+    return command_line.GetSwitchValueASCII(kWmClassSwitch);
+  }
+  std::string desktop_base_name = GetDesktopBaseName(desktop_file_name);
+  if (auto* platform_utils =
+          ui::OzonePlatform::GetInstance()->GetPlatformUtils()) {
+    return platform_utils->GetWmWindowClass(desktop_base_name);
+  }
+  if (!desktop_base_name.empty()) {
+    // Capitalize the first character like gtk does.
+    desktop_base_name[0] = base::ToUpperASCII(desktop_base_name[0]);
+  }
+  return desktop_base_name;
+}
+
+}  // namespace internal
+
+std::string GetProgramClassName() {
+  std::unique_ptr<base::Environment> env(base::Environment::Create());
+  return internal::GetProgramClassName(*base::CommandLine::ForCurrentProcess(),
+                                       GetDesktopName(*env));
+}
+
+std::string GetProgramClassClass() {
+  std::unique_ptr<base::Environment> env(base::Environment::Create());
+  return internal::GetProgramClassClass(*base::CommandLine::ForCurrentProcess(),
+                                        GetDesktopName(*env));
+}
+
+}  // namespace shell_integration_linux
