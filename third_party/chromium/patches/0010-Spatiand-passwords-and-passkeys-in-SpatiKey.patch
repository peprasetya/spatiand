index 0000000000..fdd8c93292
--- /dev/null
+++ b/device/fido/spatikey/spatikey_discovery.cc
@@ -0,0 +1,40 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "device/fido/spatikey/spatikey_discovery.h"
+
+#include "base/functional/bind.h"
+#include "base/task/sequenced_task_runner.h"
+#include "components/spatikey/client.h"
+#include "device/fido/public/fido_transport_protocol.h"
+#include "device/fido/spatikey/spatikey_authenticator.h"
+
+namespace device {
+
+SpatikeyDiscovery::SpatikeyDiscovery() : FidoDiscoveryBase(FidoTransportProtocol::kInternal) {}
+
+SpatikeyDiscovery::~SpatikeyDiscovery() = default;
+
+void SpatikeyDiscovery::Start() {
+  // Its own task: what is heard of the service may be known already, and the handler starting this
+  // is not ready to be told yet.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&spatikey::WhenUsableKnown,
+                     base::BindOnce(&SpatikeyDiscovery::OnUsableKnown,
+                                    weak_factory_.GetWeakPtr())));
+}
+
+void SpatikeyDiscovery::OnUsableKnown(bool usable) {
+  if (!observer()) {
+    return;
+  }
+  if (!usable) {
+    observer()->DiscoveryStarted(this, /*success=*/false);
+    return;
+  }
+  authenticator_ = std::make_unique<SpatikeyAuthenticator>();
+  observer()->DiscoveryStarted(this, /*success=*/true, {authenticator_.get()});
+}
+
+}  // namespace device
