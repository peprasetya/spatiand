+namespace spatiand {
+
+namespace {
+
+// What the reader is asked for: the address, the model and the languages, from the room's AI
+// settings, as SpatiLoupe's Live Text asks (crates/spatiand-voice/src/hemera/ocr.rs).
+struct Reader {
+  std::string hemera;
+  std::string model;
+  std::vector<std::string> languages;
+  // "Read text in pictures by itself": off, nothing is sent.
+  bool by_itself = true;
+};
+
+// Read off the UI thread: a file.
+std::optional<Reader> LoadReader() {
+  std::optional<base::Value> value = ReadJson(SharedDir().DirName().Append("ai.json"));
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& dict = value->GetDict();
+  Reader reader;
+  if (const std::string* hemera = dict.FindString("hemera")) {
+    reader.hemera = *hemera;
+  }
+  while (!reader.hemera.empty() && reader.hemera.back() == '/') {
+    reader.hemera.pop_back();
+  }
+  if (reader.hemera.empty()) {
+    return std::nullopt;
+  }
+  if (const base::DictValue* models = dict.FindDict("models")) {
+    if (const std::string* reading = models->FindString("reading")) {
+      reader.model = *reading;
+    }
+  }
+  if (const base::DictValue* pictures = dict.FindDict("text_in_pictures")) {
+    reader.by_itself = pictures->FindBool("read_by_itself").value_or(true);
+    for (const char* key : {"first_language", "second_language"}) {
+      const std::string* language = pictures->FindString(key);
+      if (language && !language->empty() &&
+          std::find(reader.languages.begin(), reader.languages.end(), *language) ==
+              reader.languages.end()) {
+        reader.languages.push_back(*language);
+      }
+    }
+  }
+  // Lines in a script neither language is written in are still found.
+  reader.languages.push_back("auto");
+  return reader;
+}
+
+constexpr net::NetworkTrafficAnnotationTag kTraffic =
+    net::DefineNetworkTrafficAnnotation("spatiand_ocr", R"(
+        semantics {
+          sender: "Spatiand"
+          description:
+            "A picture of a PDF page with no text of its own is sent to the room's own reader of "
+            "text in pictures (hemera, on the wearer's own network), so that its words can be "
+            "chosen and found."
+          trigger: "A PDF with a page that is only a picture is opened."
+          data: "The page's picture."
+          destination: OTHER
+          destination_other: "The wearer's own hemera, as Spatiand's AI settings name it."
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Spatiand's AI settings: read text in pictures by itself."
+          policy_exception_justification: "Spatiand's own."
+        })");
+
+gfx::Rect BoundsOf(const base::ListValue* polygon) {
+  if (!polygon || polygon->empty()) {
+    return gfx::Rect();
+  }
+  float left = 1e9f, top = 1e9f, right = -1e9f, bottom = -1e9f;
+  for (const base::Value& point : *polygon) {
+    const base::ListValue* xy = point.GetIfList();
+    if (!xy || xy->size() < 2) {
+      continue;
+    }
+    const float x = static_cast<float>((*xy)[0].GetIfDouble().value_or(0));
+    const float y = static_cast<float>((*xy)[1].GetIfDouble().value_or(0));
+    left = std::min(left, x);
+    top = std::min(top, y);
+    right = std::max(right, x);
+    bottom = std::max(bottom, y);
+  }
+  if (right < left || bottom < top) {
+    return gfx::Rect();
+  }
+  return gfx::Rect(static_cast<int>(std::floor(left)), static_cast<int>(std::floor(top)),
+                   static_cast<int>(std::ceil(right - left)),
+                   static_cast<int>(std::ceil(bottom - top)));
+}
+
+screen_ai::mojom::Direction DirectionOf(const std::string* direction) {
+  if (!direction) {
+    return screen_ai::mojom::Direction::DIRECTION_UNSPECIFIED;
+  }
+  if (*direction == "rtl") {
+    return screen_ai::mojom::Direction::DIRECTION_RIGHT_TO_LEFT;
+  }
+  if (*direction == "ttb") {
+    return screen_ai::mojom::Direction::DIRECTION_TOP_TO_BOTTOM;
+  }
+  return screen_ai::mojom::Direction::DIRECTION_LEFT_TO_RIGHT;
+}
+
+// hemera's answer -- blocks of lines of words, each with its outline in the picture's pixels as
+// it was sent -- as Chromium's OCR service gives it: lines of words, each with its box.
+screen_ai::mojom::VisualAnnotationPtr AnnotationOf(const base::DictValue& answer) {
+  auto annotation = screen_ai::mojom::VisualAnnotation::New();
+  const base::ListValue* blocks = answer.FindList("blocks");
+  if (!blocks) {
+    return annotation;
+  }
+  int block_id = 0;
+  for (const base::Value& block_value : *blocks) {
+    const base::DictValue* block = block_value.GetIfDict();
+    const base::ListValue* lines = block ? block->FindList("lines") : nullptr;
+    if (!lines) {
+      continue;
+    }
+    for (const base::Value& line_value : *lines) {
+      const base::DictValue* line = line_value.GetIfDict();
+      if (!line) {
+        continue;
+      }
+      auto box = screen_ai::mojom::LineBox::New();
+      if (const std::string* text = line->FindString("text")) {
+        box->text_line = *text;
+      }
+      if (const std::string* language = line->FindString("language")) {
+        box->language = *language;
+      }
+      box->block_id = block_id;
+      box->paragraph_id = block_id;
+      box->bounding_box = BoundsOf(line->FindList("polygon"));
+      box->bounding_box_angle = static_cast<float>(line->FindDouble("angle").value_or(0));
+      box->confidence = static_cast<float>(line->FindDouble("confidence").value_or(1));
+      const screen_ai::mojom::Direction direction = DirectionOf(line->FindString("direction"));
+      if (const base::ListValue* words = line->FindList("words")) {
+        for (const base::Value& word_value : *words) {
+          const base::DictValue* word = word_value.GetIfDict();
+          if (!word) {
+            continue;
+          }
+          auto word_box = screen_ai::mojom::WordBox::New();
+          if (const std::string* text = word->FindString("text")) {
+            word_box->word = *text;
+          }
+          word_box->language = box->language;
+          word_box->bounding_box = BoundsOf(word->FindList("polygon"));
+          word_box->bounding_box_angle = box->bounding_box_angle;
+          word_box->direction = direction;
+          word_box->confidence = box->confidence;
+          box->words.push_back(std::move(word_box));
+        }
+      }
+      // A line hemera gave no words for is one word, so that it is there to be chosen.
+      if (box->words.empty() && !box->text_line.empty()) {
+        auto word_box = screen_ai::mojom::WordBox::New();
+        word_box->word = box->text_line;
+        word_box->language = box->language;
+        word_box->bounding_box = box->bounding_box;
+        word_box->bounding_box_angle = box->bounding_box_angle;
+        word_box->direction = direction;
+        word_box->confidence = box->confidence;
+        box->words.push_back(std::move(word_box));
+      }
+      annotation->lines.push_back(std::move(box));
+    }
+    ++block_id;
+  }
+  return annotation;
+}
+
+class Annotator : public screen_ai::mojom::ScreenAIAnnotator {
+ public:
+  explicit Annotator(scoped_refptr<network::SharedURLLoaderFactory> factory)
+      : factory_(std::move(factory)) {}
+  Annotator(const Annotator&) = delete;
+  Annotator& operator=(const Annotator&) = delete;
+  ~Annotator() override = default;
+
+  // screen_ai::mojom::ScreenAIAnnotator:
+  void PerformOcrAndReturnAnnotation(
+      const SkBitmap& image,
+      PerformOcrAndReturnAnnotationCallback callback) override {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&LoadReader),
+        base::BindOnce(&Annotator::Read, weak_factory_.GetWeakPtr(), image,
+                       std::move(callback)));
+  }
+  void SetClientType(screen_ai::mojom::OcrClientType client_type) override {}
+  // A page is drawn for reading no larger than this, on its longer side.
+  void GetMaxImageDimension(GetMaxImageDimensionCallback callback) override {
+    std::move(callback).Run(2048);
+  }
+  void SetOCRLightMode(bool enabled) override {}
+  void IsOCRBusy(IsOCRBusyCallback callback) override {
+    std::move(callback).Run(!loaders_.empty());
+  }
+
+ private:
+  using Loaders = std::list<std::unique_ptr<network::SimpleURLLoader>>;
+
+  void Read(const SkBitmap& image,
+            PerformOcrAndReturnAnnotationCallback callback,
+            std::optional<Reader> reader) {
+    if (!reader || !reader->by_itself) {
+      std::move(callback).Run(screen_ai::mojom::VisualAnnotation::New());
+      return;
+    }
+    std::optional<std::vector<uint8_t>> png =
+        gfx::PNGCodec::EncodeBGRASkBitmap(image, /*discard_transparency=*/true);
+    if (!png) {
+      std::move(callback).Run(screen_ai::mojom::VisualAnnotation::New());
+      return;
+    }
+    // The form hemera takes: its options, then the picture.
+    base::DictValue options;
+    base::ListValue languages;
+    for (const std::string& language : reader->languages) {
+      languages.Append(language);
+    }
+    options.Set("languages", std::move(languages));
+    options.Set("granularity", "words");
+    options.Set("orientation", "auto");
+    if (!reader->model.empty()) {
+      options.Set("model", reader->model);
+    }
+    std::string options_json;
+    base::JSONWriter::Write(options, &options_json);
+    const std::string boundary =
+        base::StringPrintf("spatiand-ocr-%016llx%016llx",
+                           static_cast<unsigned long long>(base::RandUint64()),
+                           static_cast<unsigned long long>(base::RandUint64()));
+    std::string body;
+    body += "--" + boundary +
+            "\r\nContent-Disposition: form-data; name=\"options\"\r\n"
+            "Content-Type: application/json\r\n\r\n";
+    body += options_json;
+    body += "\r\n--" + boundary +
+            "\r\nContent-Disposition: form-data; name=\"image\"; filename=\"page.png\"\r\n"
+            "Content-Type: image/png\r\n\r\n";
+    body.append(png->begin(), png->end());
+    body += "\r\n--" + boundary + "--\r\n";
+    Send(GURL(reader->hemera + "/v1/ocr"), std::move(body),
+         "multipart/form-data; boundary=" + boundary, std::move(callback),
+         /*tries_left=*/4);
+  }
+
+  void Send(GURL url,
+            std::string body,
+            std::string content_type,
+            PerformOcrAndReturnAnnotationCallback callback,
+            int tries_left) {
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = url;
+    request->method = "POST";
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    std::unique_ptr<network::SimpleURLLoader> loader =
+        network::SimpleURLLoader::Create(std::move(request), kTraffic);
+    loader->AttachStringForUpload(body, content_type);
+    loader->SetAllowHttpErrorResults(true);
+    loader->SetTimeoutDuration(base::Seconds(90));
+    loaders_.push_front(std::move(loader));
+    auto it = loaders_.begin();
+    (*it)->DownloadToString(
+        factory_.get(),
+        base::BindOnce(&Annotator::Answered, weak_factory_.GetWeakPtr(), it,
+                       std::move(url), std::move(body), std::move(content_type),
+                       std::move(callback), tries_left),
+        /*max_body_size=*/16 * 1024 * 1024);
+  }
+
+  void Answered(Loaders::iterator it,
+                GURL url,
+                std::string body,
+                std::string content_type,
+                PerformOcrAndReturnAnnotationCallback callback,
+                int tries_left,
+                std::optional<std::string> answer) {
+    std::unique_ptr<network::SimpleURLLoader> loader = std::move(*it);
+    loaders_.erase(it);
+    const int status = loader->ResponseInfo() && loader->ResponseInfo()->headers
+                           ? loader->ResponseInfo()->headers->response_code()
+                           : 0;
+    // hemera's reader starting: once more after the wait it says.
+    if (status == 503 && tries_left > 1) {
+      int wait = 2;
+      if (std::optional<std::string> after =
+              loader->ResponseInfo()->headers->GetNormalizedHeader("retry-after")) {
+        base::StringToInt(*after, &wait);
+      }
+      base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&Annotator::Send, weak_factory_.GetWeakPtr(), std::move(url),
+                         std::move(body), std::move(content_type), std::move(callback),
+                         tries_left - 1),
+          base::Seconds(std::clamp(wait, 1, 30)));
+      return;
+    }
+    if (status != 200 || !answer) {
+      LOG(WARNING) << "Spatiand: hemera did not read the page (status " << status << ", "
+                   << net::ErrorToShortString(loader->NetError()) << ")";
+      std::move(callback).Run(screen_ai::mojom::VisualAnnotation::New());
+      return;
+    }
+    std::optional<base::DictValue> dict =
+        base::JSONReader::ReadDict(*answer, base::JSON_PARSE_RFC);
+    screen_ai::mojom::VisualAnnotationPtr annotation =
+        dict ? AnnotationOf(*dict) : screen_ai::mojom::VisualAnnotation::New();
+    // How much, never what: the page's words are the wearer's.
+    VLOG(1) << "Spatiand: hemera read " << annotation->lines.size() << " lines";
+    std::move(callback).Run(std::move(annotation));
+  }
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  Loaders loaders_;
+  base::WeakPtrFactory<Annotator> weak_factory_{this};
+};
+
+}  // namespace
+
+void BindOcrAnnotator(
+    content::BrowserContext* context,
+    mojo::PendingReceiver<screen_ai::mojom::ScreenAIAnnotator> receiver) {
+  mojo::MakeSelfOwnedReceiver(
+      std::make_unique<Annotator>(
+          context->GetDefaultStoragePartition()->GetURLLoaderFactoryForBrowserProcess()),
+      std::move(receiver));
+}
+
+}  // namespace spatiand
