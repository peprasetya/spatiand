From 8bb5bcd7f8b428d1ced893f738b1c51f5f944483 Mon Sep 17 00:00:00 2001
From: Spatiand-build <claude@prasetya.id>
Date: Wed, 11 Nov 2026 23:40:00 +0700
Subject: [PATCH] Spatiand: a page's popup is anchored where its element is

Cromite's viewport protection keeps screen emulation on for every page (the
view at 0,0, scaled). Blink reverses the emulation for a page popup's own
rect but not for the anchor rect sent with ShowPopup, and Wayland places a
popup by its anchor (xdg_positioner): a <select>'s list, a date or a colour
picker opened at the element's place in the page taken as its place in the
window. Found on the Mac (2026-11-11), seen on the Beam Pro (2026-11-09).
---
 .../renderer/core/exported/web_page_popup_impl.cc  | 24 +++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/third_party/blink/renderer/core/exported/web_page_popup_impl.cc b/third_party/blink/renderer/core/exported/web_page_popup_impl.cc
index d340cb8910..ca54143c36 100644
--- a/third_party/blink/renderer/core/exported/web_page_popup_impl.cc
+++ b/third_party/blink/renderer/core/exported/web_page_popup_impl.cc
@@ -29,6 +29,8 @@
 
 #include "third_party/blink/renderer/core/exported/web_page_popup_impl.h"
 
+#include "base/numerics/safe_conversions.h"
+
 #include <memory>
 
 #include "base/functional/callback_helpers.h"
@@ -987,8 +989,28 @@ gfx::Rect WebPagePopupImpl::GetAnchorRectInScreen() const {
   LocalFrameView* view = popup_client_->OwnerElement().GetDocument().View();
   DCHECK(view);
 
-  return view->GetFrame().GetChromeClient().LocalRootToScreenDIPs(
+  gfx::Rect anchor = view->GetFrame().GetChromeClient().LocalRootToScreenDIPs(
       popup_client_->OwnerElement().VisibleBoundsInLocalRoot(), view);
+  // Spatiand: the opener's screen rects are emulated ones while its screen is
+  // emulated (DevTools' device mode; under Cromite's viewport protection,
+  // always: the view at 0,0 and scaled), and this rect is made from them. The
+  // popup's own rect has the emulation reversed (SetWindowRect); the anchor
+  // had not, and a window system that places a popup by its anchor (Wayland:
+  // xdg_positioner's anchor rect) put a <select>'s list, a date or a colour
+  // picker at the element's place in the page taken as its place in the
+  // window. Reversed here as there.
+  if (opener_emulator_scale_) {
+    anchor = gfx::Rect(
+        opener_original_widget_screen_origin_.x() +
+            base::ClampRound((anchor.x() - opener_widget_screen_origin_.x()) *
+                             opener_emulator_scale_),
+        opener_original_widget_screen_origin_.y() +
+            base::ClampRound((anchor.y() - opener_widget_screen_origin_.y()) *
+                             opener_emulator_scale_),
+        base::ClampRound(anchor.width() * opener_emulator_scale_),
+        base::ClampRound(anchor.height() * opener_emulator_scale_));
+  }
+  return anchor;
 }
 
 WebInputEventResult WebPagePopupImpl::DispatchBufferedTouchEvents() {
-- 
