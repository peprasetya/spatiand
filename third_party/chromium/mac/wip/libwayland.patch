 static int
 set_cloexec_or_close(int fd)
@@ -75,6 +79,16 @@
 {
 	int fd;
 
+#ifdef __APPLE__
+	/* Spatiand: macOS has no SOCK_CLOEXEC, and no MSG_NOSIGNAL: a write to a closed socket
+	 * raises no SIGPIPE by SO_NOSIGPIPE instead (connection.c). */
+	fd = set_cloexec_or_close(wl_socket(domain, type, protocol));
+	if (fd >= 0) {
+		int one = 1;
+		setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+	}
+	return fd;
+#else
 	fd = wl_socket(domain, type | SOCK_CLOEXEC, protocol);
 	if (fd >= 0)
 		return fd;
