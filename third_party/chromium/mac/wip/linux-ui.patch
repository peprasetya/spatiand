@@ -0,0 +1,42 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_EVENTS_PLATFORM_WAYLAND_WAYLAND_EVENT_WATCHER_MAC_H_
+#define UI_EVENTS_PLATFORM_WAYLAND_WAYLAND_EVENT_WATCHER_MAC_H_
+
+#include <CoreFoundation/CoreFoundation.h>
+
+#include "ui/events/platform/wayland/wayland_event_watcher.h"
+
+namespace ui {
+
+// Spatiand: WaylandEventWatcher for macOS, where the UI thread runs a CFRunLoop
+// (MessagePumpNSApplication / MessagePumpNSRunLoop) rather than glib or epoll.
+// The Wayland display's fd is a CFFileDescriptor source on that run loop; it
+// reads and dispatches as WaylandEventWatcherFdWatch does.
+class WaylandEventWatcherMac : public WaylandEventWatcher {
+ public:
+  WaylandEventWatcherMac(wl_display* display,
+                         wl_event_queue* event_queue,
+                         bool use_threaded_polling);
+  WaylandEventWatcherMac(const WaylandEventWatcherMac&) = delete;
+  WaylandEventWatcherMac& operator=(const WaylandEventWatcherMac&) = delete;
+  ~WaylandEventWatcherMac() override;
+
+  // Called by the CFFileDescriptor when the fd is readable.
+  void OnReadable();
+
+ private:
+  // WaylandEventWatcher overrides:
+  bool StartWatchingFD(int fd) override;
+  void StopWatchingFD() override;
+
+  CFFileDescriptorRef fd_ref_ = nullptr;
+  CFRunLoopSourceRef source_ = nullptr;
+  CFRunLoopRef run_loop_ = nullptr;
+};
+
+}  // namespace ui
+
+#endif  // UI_EVENTS_PLATFORM_WAYLAND_WAYLAND_EVENT_WATCHER_MAC_H_
