--- a/chrome/browser/spatiand/profile_lock_dialog.h
+++ b/chrome/browser/spatiand/profile_lock_dialog.h
@@ -11,14 +11,28 @@
 namespace spatiand {
 
 // Asks for a profile's PIN or password, in a window of its own: nothing of the profile is shown
-// until it is given. `done` says whether it was. Five wrong tries in a row and the next waits half
-// a minute, as SpatiMesh's other builds do.
+// until it is given, or a finger is, if there is a SpatiKey to ask. `done` says whether it was.
+// Five wrong tries in a row and the next waits half a minute, as SpatiMesh's other builds do.
+// `windows_waiting`: its windows are there behind the lock, and not opening closes them.
 void ShowProfileLockDialog(const std::u16string& profile_name,
                            bool is_pin,
                            const std::string& salt,
                            const std::string& hash,
+                           bool windows_waiting,
                            base::OnceCallback<void(bool)> done);
 
+// What a profile's windows ask for: nothing, a PIN of 4 to 12 digits or a password of at least 6
+// characters, typed twice, and changed or removed only after the present one. `save` is given the
+// new kind ("pin", "password"; empty for nothing), salt and hash.
+using SaveLock = base::OnceCallback<void(const std::string& kind,
+                                         const std::string& salt,
+                                         const std::string& hash)>;
+void ShowProfileLockSettings(const std::u16string& profile_name,
+                             const std::string& kind,
+                             const std::string& salt,
+                             const std::string& hash,
+                             SaveLock save);
+
 }  // namespace spatiand
 
 #endif  // CHROME_BROWSER_SPATIAND_PROFILE_LOCK_DIALOG_H_
