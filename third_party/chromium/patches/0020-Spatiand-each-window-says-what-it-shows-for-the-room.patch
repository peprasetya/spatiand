+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/wayland/host/spatiand_xr.h"
+
+#include <spatiand-xr-v1-client-protocol.h>
+#include <unistd.h>
+
+#include <map>
+
+#include "base/files/scoped_file.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/stringprintf.h"
+#include "ui/ozone/platform/wayland/host/wayland_surface.h"
+#include "ui/ozone/platform/wayland/host/wayland_window.h"
+#include "ui/platform_window/platform_window.h"
+
+namespace ui {
+
+namespace {
+
+// `describe` came in version 9.
+constexpr uint32_t kMinVersion = 9;
+
+spatiand_xr_v1* g_xr = nullptr;
+
+std::map<WaylandWindow*, spatiand_xr_surface_v1*>& Objects() {
+  static base::NoDestructor<std::map<WaylandWindow*, spatiand_xr_surface_v1*>> objects;
+  return *objects;
+}
+
+void OnDisplayMode(void*, spatiand_xr_v1*, uint32_t) {}
+void OnHands(void*, spatiand_xr_v1*) {}
+constexpr spatiand_xr_v1_listener kXrListener = {
+    .display_mode = &OnDisplayMode,
+    .hands = &OnHands,
+};
+
+void OnLayerRefused(void*, spatiand_xr_surface_v1*, uint32_t, const char*) {}
+void OnLayerLost(void*, spatiand_xr_surface_v1*, uint32_t) {}
+void OnPinch(void*, spatiand_xr_surface_v1*, int32_t) {}
+void OnDescribe(void* data, spatiand_xr_surface_v1*, int32_t fd) {
+  base::ScopedFD owned(fd);
+  auto* window = static_cast<WaylandWindow*>(data);
+  const uint32_t id = window->root_surface() ? window->root_surface()->get_surface_id() : 0u;
+  // The browser writes and closes it when it has its answer; with no one to answer, closed now,
+  // which the room takes for nothing to say.
+  RunSpatiandDescribe(id, std::move(owned));
+}
+constexpr spatiand_xr_surface_v1_listener kSurfaceListener = {
+    .layer_refused = &OnLayerRefused,
+    .layer_lost = &OnLayerLost,
+    .pinch = &OnPinch,
+    .describe = &OnDescribe,
+};
+
+}  // namespace
+
+// static
+void SpatiandXr::Instantiate(WaylandConnection* connection,
+                             wl_registry* registry,
+                             uint32_t name,
+                             const std::string& interface,
+                             uint32_t version) {
+  CHECK_EQ(interface, kInterfaceName);
+  if (g_xr || version < kMinVersion) {
+    return;
+  }
+  g_xr = static_cast<spatiand_xr_v1*>(
+      wl_registry_bind(registry, name, &spatiand_xr_v1_interface, kMinVersion));
+  if (!g_xr) {
+    LOG(ERROR) << "Failed to bind to spatiand_xr_v1";
+    return;
+  }
+  spatiand_xr_v1_add_listener(g_xr, &kXrListener, nullptr);
+}
+
+// static
+void SpatiandXr::Attach(WaylandWindow* window) {
+  if (!g_xr || !window->root_surface() || Objects().contains(window)) {
+    return;
+  }
+  spatiand_xr_surface_v1* object =
+      spatiand_xr_v1_get_xr_surface(g_xr, window->root_surface()->surface());
+  if (!object) {
+    return;
+  }
+  spatiand_xr_surface_v1_add_listener(object, &kSurfaceListener, window);
+  Objects()[window] = object;
+  // The name this window's sound is handed over with: this process and the
+  // window's surface, the key the room keeps the window's sink under (on the
+  // Deck it can read the process itself; on the Mac it cannot, and goes by
+  // this). Double-buffered: it comes with the window's next commit.
+  if (spatiand_xr_surface_v1_get_version(object) >=
+      SPATIAND_XR_SURFACE_V1_SET_SOUND_KEY_SINCE_VERSION) {
+    spatiand_xr_surface_v1_set_sound_key(
+        object, base::StringPrintf("wl:%d:%u", getpid(),
+                                   window->GetSpatiandSurfaceId())
+                    .c_str());
+  }
+}
+
+// static
+void SpatiandXr::Detach(WaylandWindow* window) {
+  auto it = Objects().find(window);
+  if (it == Objects().end()) {
+    return;
+  }
+  spatiand_xr_surface_v1_destroy(it->second);
+  Objects().erase(it);
+}
+
+}  // namespace ui
