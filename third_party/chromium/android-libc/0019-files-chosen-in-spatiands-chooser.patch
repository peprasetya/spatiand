+
+#ifndef UI_SHELL_DIALOGS_SELECT_FILE_DIALOG_LINUX_SPATIAND_H_
+#define UI_SHELL_DIALOGS_SELECT_FILE_DIALOG_LINUX_SPATIAND_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/memory/weak_ptr.h"
+#include "ui/shell_dialogs/select_file_dialog_linux.h"
+
+namespace ui {
+
+// Spatiand: files chosen in Spatiand's own chooser, a window of the room (crates/spatiand-choose
+// in Spatiand, carried in the APK as libspatiand-choose.so), for SpatiMesh on Android's libc,
+// where there is no desktop portal to ask as there is on the Deck (android-libc/0019). The chooser
+// is run as a program, which writes what was chosen, a path a line.
+class SelectFileDialogLinuxSpatiand : public SelectFileDialogLinux {
+ public:
+  SelectFileDialogLinuxSpatiand(Listener* listener, std::unique_ptr<SelectFilePolicy> policy);
+  SelectFileDialogLinuxSpatiand(const SelectFileDialogLinuxSpatiand&) = delete;
+  SelectFileDialogLinuxSpatiand& operator=(const SelectFileDialogLinuxSpatiand&) = delete;
+
+  // SelectFileDialog:
+  bool IsRunning(gfx::NativeWindow parent_window) const override;
+
+ protected:
+  ~SelectFileDialogLinuxSpatiand() override;
+
+  // SelectFileDialog:
+  void SelectFileImpl(Type type,
+                      const std::u16string& title,
+                      const base::FilePath& default_path,
+                      const FileTypeInfo* file_types,
+                      int file_type_index,
+                      const base::FilePath::StringType& default_extension,
+                      gfx::NativeWindow owning_window,
+                      const GURL* caller) override;
+  bool HasMultipleFileTypeChoicesImpl() override;
+
+ private:
+  void Chosen(Type type, std::optional<std::vector<base::FilePath>> paths);
+
+  bool running_ = false;
+  base::WeakPtrFactory<SelectFileDialogLinuxSpatiand> weak_factory_{this};
+};
+
+}  // namespace ui
+
+#endif  // UI_SHELL_DIALOGS_SELECT_FILE_DIALOG_LINUX_SPATIAND_H_
diff --git a/ui/shell_dialogs/shell_dialog_linux.cc b/ui/shell_dialogs/shell_dialog_linux.cc
index 154651427f..9cfa3db8cd 100644
--- a/ui/shell_dialogs/shell_dialog_linux.cc
+++ b/ui/shell_dialogs/shell_dialog_linux.cc
@@ -12,12 +12,19 @@
 #include "ui/shell_dialogs/select_file_dialog_linux_portal.h"
 #endif
 
+#if defined(__TERMUX__)
+#include "ui/shell_dialogs/select_file_dialog_linux_spatiand.h"
+#endif
+
 namespace ui {
 
 SelectFileDialog* CreateSelectFileDialog(
     SelectFileDialog::Listener* listener,
     std::unique_ptr<SelectFilePolicy> policy) {
-#if BUILDFLAG(USE_DBUS)
+#if defined(__TERMUX__)
