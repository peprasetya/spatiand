    */
   protected showContinueAndOpenSpecific_(): boolean {
+    if ((true)) return true;
     if (!this.restoreOnStartupPref_) {
       return false;
     }
diff --git a/chrome/browser/sessions/session_restore.cc b/chrome/browser/sessions/session_restore.cc
index 816c2a017b..a438c5c95a 100644
--- a/chrome/browser/sessions/session_restore.cc
+++ b/chrome/browser/sessions/session_restore.cc
@@ -1098,6 +1098,13 @@ class SessionRestoreImpl : public BrowserCollectionObserver {
       // be selected as ShowBrowser() will load the selected tab.
       bool is_selected_tab =
           (initial_tab_count == 0) && (i == selected_tab_index);
+      if (is_selected_tab && !startup_tabs_.empty()) {
+        is_selected_tab = false;
+        if (browser != browser_) {
+          BrowserInitState::From(browser)->set_is_session_restore(false);
+          did_show_browser = true;
+        }
+      }
 
       // Convert the last active time because WebContents needs a TimeTicks.
       const base::TimeTicks last_active_time_ticks =
@@ -1460,6 +1467,7 @@ class SessionRestoreImpl : public BrowserCollectionObserver {
     }
     if (last_normal_browser && !normal_startup_tabs.empty()) {
       AppendURLsToBrowser(last_normal_browser, normal_startup_tabs);
+      last_normal_browser->GetWindow()->Show();
     }
     if (!startup_tabs_from_last_and_urls_pref.empty()) {
       BrowserWindowCreateParams params(profile_, /*from_user_gesture=*/false);
diff --git a/chrome/browser/ui/browser_tabrestore.cc b/chrome/browser/ui/browser_tabrestore.cc
index 6aca93a450..d4dc8248a4 100644
--- a/chrome/browser/ui/browser_tabrestore.cc
+++ b/chrome/browser/ui/browser_tabrestore.cc
@@ -244,7 +244,7 @@ WebContents* AddRestoredTabImpl(std::unique_ptr<WebContents> web_contents,
 
   // Immediate load if the browser activeness is true or unknown. That is, do
   // not do immediate load for browsers that are known to be inactive.
-  bool should_load = is_active_browser.value_or(true);
+  bool should_load = false;
 
 // On OS_MAC, `LoadRestoredTabIfVisible` by default so that its tab loading
 // behaves like other platforms to make FirstWebContentsProfiler wor
diff --git a/chrome/browser/ui/startup/startup_browser_creator_impl.cc b/chrome/browser/ui/startup/startup_browser_creator_impl.cc
index 1e34f398af..2541d5f5bd 100644
--- a/chrome/browser/ui/startup/startup_browser_creator_impl.cc
+++ b/chrome/browser/ui/startup/startup_browser_creator_impl.cc
@@ -721,6 +721,14 @@ StartupBrowserCreatorImpl::DetermineStartupTabs(
     if (prefs_tabs_originally_empty) {
       AppendTabs(provider.GetNewTabPageTabs(*command_line_, profile_), &tabs);
     }
+
+    SessionStartupPref session_startup_pref =
+        SessionStartupPref::GetStartupPref(profile_);
+    if (session_startup_pref.type == SessionStartupPref::LAST_AND_URLS) {
+      StartupTabs new_tabs;
+      new_tabs.emplace_back(GURL(chrome::kChromeUINewTabURL));
+      AppendTabs(new_tabs, &tabs);
+    }
   }
 
   // Maybe add any tabs which the user has previously pinned.
diff --git a/chrome/browser/ui/tabs/tab_strip_model.cc b/chrome/browser/ui/tabs/tab_strip_model.cc
index c8c7e12466..0a5c77814e 100644
--- a/chrome/browser/ui/tabs/tab_strip_model.cc
+++ b/chrome/browser/ui/tabs/tab_strip_model.cc
@@ -5915,11 +5915,27 @@ std::optional<int> TabStripModel::DetermineNewSelectedIndex(
 
     // Third preference is the block's opener.
     for (size_t i = block_tabs.start(); i < block_tabs.end(); ++i) {
-      tabs::TabInterface* opener = GetTabModelAtIndex(i)->opener();
+      tabs::TabModel* tab = GetTabModelAtIndex(i);
+      tabs::TabInterface* opener = tab->opener();
       int opener_index = opener ? GetIndexOfTab(opener) : kNoTab;
       if (opener_index != kNoTab &&
           !block_tabs.Contains(gfx::Range(opener_index)) &&
           is_eligible(opener_index)) {
+        tabs::TabInterface* tab_interface = tab;
+        const tabs::TabCollection* parent =
+            tab_interface ? tab_interface->GetParentCollection() : nullptr;
+
+        bool is_detached_root_tab =
+            parent && parent->type() != tabs::TabCollection::Type::GROUP &&
+            parent->type() != tabs::TabCollection::Type::SPLIT;
+
+        if (opener_index == 0 && is_detached_root_tab) {
+          if (block_tabs.start() > 0) {
+            int left_tab_index = static_cast<int>(block_tabs.start()) - 1;
+            return GetTabIndexAfterClosing(left_tab_index, block_tabs);
+          }
+        }
+
         return GetTabIndexAfterClosing(opener_index, block_tabs);
       }
     }
