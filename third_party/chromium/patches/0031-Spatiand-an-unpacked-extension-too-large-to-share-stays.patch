+class Signer {
+ public:
+  void Add(const base::FilePath& relative, base::span<const uint8_t> contents) {
+    text_ += relative.AsUTF8Unsafe();
+    text_ += '\0';
+    text_ += base::HexEncode(crypto::hash::Sha256(contents));
+    text_ += '\n';
+  }
+  std::string Finish() const {
+    return base::ToLowerASCII(base::HexEncode(crypto::hash::Sha256(text_))).substr(0, 32);
+  }
+
+ private:
+  std::string text_;
+};
