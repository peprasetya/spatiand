diff --git a/chrome/browser/spatiand/storage_sync.cc b/chrome/browser/spatiand/storage_sync.cc
new file mode 100644
index 00000000000..bde210ac117
--- /dev/null
+++ b/chrome/browser/spatiand/storage_sync.cc
@@ -0,0 +1,210 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/spatiand/storage_sync.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/spatiand/shared_folder.h"
+#include "extensions/browser/api/storage/storage_area_namespace.h"
+#include "extensions/browser/api/storage/storage_frontend.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/common/extension.h"
+
+namespace spatiand {
+
+namespace {
+
+using extensions::StorageAreaNamespace;
+using extensions::StorageFrontend;
+
+// Every profile's, by its browser context: StorageFrontend tells one function of every change.
+std::map<content::BrowserContext*, StorageSync*>& All() {
+  static base::NoDestructor<std::map<content::BrowserContext*, StorageSync*>> all;
+  return *all;
+}
+
+void Tell(content::BrowserContext* context, const std::string& extension_id, const base::Value& changes) {
+  auto it = All().find(context);
+  if (it != All().end()) {
+    it->second->Changed(extension_id, changes);
+  }
+}
+
+std::string FileName(const std::string& key) {
+  return base::HexEncodeLower(base::as_byte_span(key)) + ".json";
+}
+
+StorageSync::Folders ReadFolders(const base::FilePath& dir, std::map<std::string, base::Time> seen, bool all) {
+  StorageSync::Folders folders;
+  base::FileEnumerator each(dir, false, base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath folder = each.Next(); !folder.empty(); folder = each.Next()) {
+    const std::string id = folder.BaseName().value();
+    if (id.empty() || id[0] == '.') {
+      continue;
+    }
+    const base::Time changed = FolderChanged(folder);
+    const auto it = seen.find(id);
+    if (!all && it != seen.end() && it->second >= changed) {
+      continue;
+    }
+    StorageSync::Folder read;
+    read.changed = changed;
+    for (const std::string& name : ListJson(folder)) {
+      std::optional<base::Value> item = ReadJson(folder.Append(name + ".json"));
+      if (!item || !item->is_dict()) {
+        continue;
+      }
+      const std::string* key = item->GetDict().FindString("key");
+      const base::Value* value = item->GetDict().Find("value");
+      if (key && value) {
+        read.items.Set(*key, value->Clone());
+      }
+    }
+    folders[id] = std::move(read);
+  }
+  return folders;
+}
+
+void WriteItem(const base::FilePath& file, std::string key, base::Value value) {
+  base::DictValue item;
+  item.Set("key", std::move(key));
+  item.Set("value", std::move(value));
+  WriteJson(file, base::Value(std::move(item)));
+}
+
+}  // namespace
+
+StorageSync::StorageSync(Profile* profile,
+                         const std::string& id,
+                         scoped_refptr<base::SequencedTaskRunner> files)
+    : profile_(profile), dir_(SharedProfileDir(id).Append("extension-sync")), files_(std::move(files)) {
+  extensions::SetSpatiandSyncChanged(base::BindRepeating(&Tell));
+  All()[profile] = this;
+}
+
+StorageSync::~StorageSync() {
+  All().erase(profile_);
+}
+
+void StorageSync::Poll() {
+  if (reading_) {
+    return;
+  }
+  reading_ = true;
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&ReadFolders, dir_, seen_, first_),
+      base::BindOnce(&StorageSync::OnRead, weak_factory_.GetWeakPtr()));
+}
+
+void StorageSync::OnRead(Folders folders) {
+  reading_ = false;
+  extensions::ExtensionRegistry* registry = extensions::ExtensionRegistry::Get(profile_);
+  StorageFrontend* frontend = StorageFrontend::Get(profile_);
+  if (!registry || !frontend) {
+    return;
+  }
+  // The first time, the extensions that have no folder yet too: what they kept before this did
+  // goes into one.
+  if (first_) {
+    first_ = false;
+    for (const auto& extension : registry->enabled_extensions()) {
+      if (!folders.contains(extension->id())) {
+        folders[extension->id()] = Folder();
+      }
+    }
+  }
+  for (auto& [id, folder] : folders) {
+    const extensions::Extension* extension = registry->enabled_extensions().GetByID(id);
+    if (!extension) {
+      // Not here, or not on: taken in when it is (its folder is read again until then).
+      continue;
+    }
+    seen_[id] = folder.changed;
+    frontend->GetValues(
+        base::WrapRefCounted(extension), StorageAreaNamespace::kSync, std::nullopt,
+        base::BindOnce(
+            [](base::WeakPtr<StorageSync> self, std::string id, base::DictValue remote,
+               StorageFrontend::GetResult local) {
+              if (self && local.data) {
+                self->Merge(id, std::move(remote), std::move(*local.data));
+              }
+            },
+            weak_factory_.GetWeakPtr(), id, std::move(folder.items)));
+  }
+}
+
+void StorageSync::Merge(const std::string& extension_id, base::DictValue remote, base::DictValue local) {
+  extensions::ExtensionRegistry* registry = extensions::ExtensionRegistry::Get(profile_);
+  const extensions::Extension* extension = registry->enabled_extensions().GetByID(extension_id);
+  if (!extension) {
+    return;
+  }
+  std::set<std::string>& known = known_[extension_id];
+  base::DictValue to_set;
+  for (const auto [key, value] : remote) {
+    const base::Value* here = local.Find(key);
+    if (!here || *here != value) {
+      to_set.Set(key, value.Clone());
+    }
+  }
+  std::vector<std::string> to_remove;
+  for (const auto [key, value] : local) {
+    if (remote.contains(key)) {
+      continue;
+    }
+    if (known.contains(key)) {
+      // In the folder before and gone from it: removed on another machine.
+      to_remove.push_back(key);
+    } else {
+      // Set here before it was in the folder.
+      files_->PostTask(FROM_HERE, base::BindOnce(&WriteItem, dir_.Append(extension_id).Append(FileName(key)),
+                                                 key, value.Clone()));
+      known.insert(key);
+    }
+  }
+  for (const auto [key, value] : remote) {
+    known.insert(key);
+  }
+  for (const std::string& key : to_remove) {
+    known.erase(key);
+  }
+  StorageFrontend* frontend = StorageFrontend::Get(profile_);
+  // As if the extension had done it, so that its pages hear storage.onChanged.
+  if (!to_set.empty()) {
+    frontend->Set(base::WrapRefCounted(extension), StorageAreaNamespace::kSync, std::move(to_set),
+                  base::DoNothing());
+  }
+  if (!to_remove.empty()) {
+    frontend->Remove(base::WrapRefCounted(extension), StorageAreaNamespace::kSync, to_remove,
+                     base::DoNothing());
+  }
+}
+
+void StorageSync::Changed(const std::string& extension_id, const base::Value& changes) {
+  if (!changes.is_dict()) {
+    return;
+  }
+  const base::FilePath folder = dir_.Append(extension_id);
+  std::set<std::string>& known = known_[extension_id];
+  for (const auto [key, change] : changes.GetDict()) {
+    const base::Value* now = change.is_dict() ? change.GetDict().Find("newValue") : nullptr;
+    if (now) {
+      known.insert(key);
+      files_->PostTask(FROM_HERE, base::BindOnce(&WriteItem, folder.Append(FileName(key)), key, now->Clone()));
+    } else {
+      known.erase(key);
+      files_->PostTask(FROM_HERE, base::BindOnce(&RemovePath, folder.Append(FileName(key))));
+    }
+  }
+}
+
+}  // namespace spatiand
