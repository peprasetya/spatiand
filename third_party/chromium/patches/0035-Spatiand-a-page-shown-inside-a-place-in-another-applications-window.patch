   const auto* linux_ui_theme = ui::LinuxUiTheme::GetForProfile(profile);
   properties->prefer_dark_theme =
       linux_ui_theme && linux_ui_theme->PreferDarkTheme();
+  // Spatiand: the place in another application's window this one is the inside of, if any.
+  properties->spatiand_embed_token =
+      BrowserInitState::From(browser_view_->browser())
+          ->create_params()
+          .spatiand_embed_token;
 }
 
 views::DesktopWindowTreeHost*
diff --git a/ui/ozone/platform/wayland/host/spatiand_xr.cc b/ui/ozone/platform/wayland/host/spatiand_xr.cc
index be06dc5f0c..8fcac17e1e 100644
--- a/ui/ozone/platform/wayland/host/spatiand_xr.cc
+++ b/ui/ozone/platform/wayland/host/spatiand_xr.cc
@@ -6,11 +6,13 @@
 #include <spatiand-xr-v1-client-protocol.h>
 #include <unistd.h>
 
+#include <algorithm>
 #include <map>
 
 #include "base/files/scoped_file.h"
 #include "base/logging.h"
 #include "base/no_destructor.h"
+#include "base/strings/string_util.h"
 #include "base/strings/stringprintf.h"
 #include "ui/ozone/platform/wayland/host/wayland_surface.h"
 #include "ui/ozone/platform/wayland/host/wayland_window.h"
@@ -20,8 +22,10 @@ namespace ui {
 
 namespace {
 
-// `describe` came in version 9.
+// `describe` came in version 9; a window inside another's place (`set_embedded`) in 13, which is
+// the newest this side knows: bound at the newest both know, and used by what it has.
 constexpr uint32_t kMinVersion = 9;
+constexpr uint32_t kMaxVersion = 13;
 
 spatiand_xr_v1* g_xr = nullptr;
 
@@ -40,6 +44,8 @@ constexpr spatiand_xr_v1_listener kXrListener = {
 void OnLayerRefused(void*, spatiand_xr_surface_v1*, uint32_t, const char*) {}
 void OnLayerLost(void*, spatiand_xr_surface_v1*, uint32_t) {}
 void OnPinch(void*, spatiand_xr_surface_v1*, int32_t) {}
+void OnMediaKey(void*, spatiand_xr_surface_v1*, uint32_t, uint32_t) {}
+void OnHostMessage(void*, spatiand_xr_surface_v1*, const char*) {}
 void OnDescribe(void* data, spatiand_xr_surface_v1*, int32_t fd) {
   base::ScopedFD owned(fd);
   auto* window = static_cast<WaylandWindow*>(data);
@@ -53,6 +59,8 @@ constexpr spatiand_xr_surface_v1_listener kSurfaceListener = {
     .layer_lost = &OnLayerLost,
     .pinch = &OnPinch,
     .describe = &OnDescribe,
+    .media_key = &OnMediaKey,
+    .host_message = &OnHostMessage,
 };
 
 }  // namespace
@@ -67,8 +75,8 @@ void SpatiandXr::Instantiate(WaylandConnection* connection,
   if (g_xr || version < kMinVersion) {
     return;
   }
-  g_xr = static_cast<spatiand_xr_v1*>(
-      wl_registry_bind(registry, name, &spatiand_xr_v1_interface, kMinVersion));
+  g_xr = static_cast<spatiand_xr_v1*>(wl_registry_bind(
+      registry, name, &spatiand_xr_v1_interface, std::min(version, kMaxVersion)));
   if (!g_xr) {
     LOG(ERROR) << "Failed to bind to spatiand_xr_v1";
     return;
@@ -77,7 +85,7 @@ void SpatiandXr::Instantiate(WaylandConnection* connection,
 }
 
 // static
-void SpatiandXr::Attach(WaylandWindow* window) {
+void SpatiandXr::Attach(WaylandWindow* window, const std::string& embed_token) {
   if (!g_xr || !window->root_surface() || Objects().contains(window)) {
     return;
   }
@@ -99,6 +107,17 @@ void SpatiandXr::Attach(WaylandWindow* window) {
                                    window->GetSpatiandSurfaceId())
                     .c_str());
   }
+  // The inside of a place in another application's window (a viewer's PDF, say): said now, with
+  // the first commit, so that the window is never one of the room's own, and is offered the
+  // place's size from the start. A token is 32 hex digits; anything else is no place.
+  const bool token_ok =
+      embed_token.size() == 32 &&
+      std::all_of(embed_token.begin(), embed_token.end(),
+                  [](char c) { return base::IsHexDigit(c); });
+  if (token_ok && spatiand_xr_surface_v1_get_version(object) >=
+                      SPATIAND_XR_SURFACE_V1_SET_EMBEDDED_SINCE_VERSION) {
+    spatiand_xr_surface_v1_set_embedded(object, embed_token.c_str());
+  }
 }
 
 // static
diff --git a/ui/ozone/platform/wayland/host/spatiand_xr.h b/ui/ozone/platform/wayland/host/spatiand_xr.h
index 34a59a4417..ba1374cb5c 100644
--- a/ui/ozone/platform/wayland/host/spatiand_xr.h
+++ b/ui/ozone/platform/wayland/host/spatiand_xr.h
@@ -31,7 +31,10 @@ class SpatiandXr : public wl::GlobalObjectRegistrar<SpatiandXr> {
 
   // A toplevel's object, made once per window (again after a Hide, it is kept), and let go of
   // before the window's surface is.
-  static void Attach(WaylandWindow* window);
+  // `embed_token`, when not empty, is the place in another client's window this
+  // window is the inside of (spatiand_xr_surface_v1.set_embedded, version 13).
+  static void Attach(WaylandWindow* window,
+                     const std::string& embed_token = std::string());
   static void Detach(WaylandWindow* window);
 };
 
diff --git a/ui/ozone/platform/wayland/host/wayland_toplevel_window.cc b/ui/ozone/platform/wayland/host/wayland_toplevel_window.cc
index c6509735d1..3f69cb755c 100644
--- a/ui/ozone/platform/wayland/host/wayland_toplevel_window.cc
+++ b/ui/ozone/platform/wayland/host/wayland_toplevel_window.cc
@@ -104,7 +104,7 @@ bool WaylandToplevelWindow::CreateXdgToplevel() {
   }
   SetUpShellIntegration();
   // Spatiand: the room may ask this window what it shows (spatiand_xr.h).
-  SpatiandXr::Attach(this);
+  SpatiandXr::Attach(this, spatiand_embed_token_);
   OnDecorationModeChanged();
 
   // If session management is supported and session data was passed in at
@@ -676,6 +676,7 @@ bool WaylandToplevelWindow::OnInitialize(
   state->window_state = PlatformWindowState::kNormal;
 
   app_id_ = properties.wayland_app_id;
+  spatiand_embed_token_ = properties.spatiand_embed_token;
   if (!properties.startup_id.empty()) {
     pending_configure_activation_token_ = properties.startup_id;
   }
diff --git a/ui/ozone/platform/wayland/host/wayland_toplevel_window.h b/ui/ozone/platform/wayland/host/wayland_toplevel_window.h
index 15cc9a2d4a..c2dfc7968c 100644
--- a/ui/ozone/platform/wayland/host/wayland_toplevel_window.h
+++ b/ui/ozone/platform/wayland/host/wayland_toplevel_window.h
@@ -241,6 +241,9 @@ class WaylandToplevelWindow : public WaylandWindow,
   // compositor to identify the app, unite it's windows into the same stack of
   // windows and find *.desktop file to set various preferences including icons.
   std::string app_id_;
+  // Spatiand: the place in another client's window this one is the inside of,
+  // said with the xr object before the first commit (SpatiandXr::Attach).
+  std::string spatiand_embed_token_;
 
   // Title of the ShellToplevel.
   std::u16string window_title_;
diff --git a/ui/platform_window/platform_window_init_properties.h b/ui/platform_window/platform_window_init_properties.h
index 21a542a563..e0c3a8b7b8 100644
--- a/ui/platform_window/platform_window_init_properties.h
+++ b/ui/platform_window/platform_window_init_properties.h
@@ -141,6 +141,11 @@ struct COMPONENT_EXPORT(PLATFORM_WINDOW) PlatformWindowInitProperties {
   // with the launch event that created it. Used for both X11 and Wayland.
   std::string startup_id;
 
+  // Spatiand: the token of a place in another client's window this window is to
+  // be the inside of (spatiand_xr_surface_v1.set_embedded), said before its
+  // first commit. Empty for every other window.
+  std::string spatiand_embed_token;
+
   // Specifies the id of the target display the window will be created on.
   std::optional<int64_t> display_id;
 #endif
