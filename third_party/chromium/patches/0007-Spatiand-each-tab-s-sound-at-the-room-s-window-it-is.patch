@@ -0,0 +1,30 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_MEDIA_SPATIAND_WINDOW_AUDIO_H_
+#define CONTENT_BROWSER_MEDIA_SPATIAND_WINDOW_AUDIO_H_
+
+#include "content/public/browser/global_routing_id.h"
+
+namespace content {
+
+class WebContents;
+
+// Each tab's sound placed at the window it is in, in Spatiand's room: the room gives every
+// SpatiMesh window a sink of its own and says where they are; each tab plays to its window's
+// (the page's preferred output device), and follows it to another window as it is dragged there.
+// Routed only when something changes, never on a timer.
+class SpatiandWindowAudio {
+ public:
+  // Begins watching the room's map of sinks, for the life of the browser. On the UI thread.
+  static void Start();
+  // A page has begun a sound with no output chosen for it (PreferredAudioOutputDeviceManager):
+  // a new page, or one whose output Chromium forgot at a navigation. On the UI thread.
+  static void SoundBegins(GlobalRenderFrameHostToken main_frame);
+  // A tab has moved into another window (WebContentsViewAura). On the UI thread.
+  static void MovedWindow(WebContents* contents);
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_MEDIA_SPATIAND_WINDOW_AUDIO_H_
