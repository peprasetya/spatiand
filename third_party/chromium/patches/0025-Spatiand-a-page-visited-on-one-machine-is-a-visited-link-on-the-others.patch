+void HistoryService::AddPartitionedVisitedLinkForSpatiand(
+    const GURL& link_url,
+    const GURL& top_level_url,
+    const GURL& frame_url) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!visit_delegate_ || !link_url.is_valid() || !top_level_url.is_valid() ||
+      !frame_url.is_valid()) {
+    return;
+  }
+  VisitedLink link = {link_url, net::SchemefulSite(top_level_url),
+                      url::Origin::Create(frame_url)};
+  visit_delegate_->AddVisitedLink(link);
+}
