+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SPATIAND_BOOKMARK_SYNC_H_
+#define CHROME_BROWSER_SPATIAND_BOOKMARK_SYNC_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_model_observer.h"
+
+class Profile;
+
+namespace spatiand {
+
+// A key that sorts after `a` (empty: the lowest there is) and before `b` (none: the highest): how
+// SpatiMesh's bookmarks keep their order, so that putting one between two others writes that one
+// file. The same keys as `crates/spatimesh/src/bookmarks.rs`.
+std::string KeyBetween(std::string_view a, std::optional<std::string_view> b);
+
+// A profile's bookmarks, the same as in `apps/spatimesh/profiles/<id>/bookmarks/<bookmark>.json`,
+// one file per bookmark or folder. Chromium's bookmark bar is the top of that list, as it is in
+// SpatiMesh's other builds; "Other bookmarks" is a folder of it with the id `other`. Each node
+// keeps its file's name in its own meta info.
+class BookmarkSync : public bookmarks::BookmarkModelObserver {
+ public:
+  BookmarkSync(Profile* profile,
+               const std::string& id,
+               scoped_refptr<base::SequencedTaskRunner> files);
+  BookmarkSync(const BookmarkSync&) = delete;
+  BookmarkSync& operator=(const BookmarkSync&) = delete;
+  ~BookmarkSync() override;
+
+  // Looks for what the synchroniser brought.
+  void Poll();
+
+  struct Record {
+    Record();
+    Record(const Record&);
+    Record& operator=(const Record&);
+    ~Record();
+    std::string parent;
+    std::string title;
+    std::optional<std::string> url;
+    std::string order;
+    double added = 0;
+  };
+  using Records = std::map<std::string, Record>;
+
+ private:
+  struct Read {
+    Read();
+    Read(Read&&);
+    Read& operator=(Read&&);
+    ~Read();
+    base::Time changed;
+    bool unchanged = false;
+    Records records;
+  };
+
+  static Read ReadIfChanged(const base::FilePath& dir, base::Time last);
+  void OnRead(int changes_when_asked, Read read);
+  void Reconcile(Records records);
+
+  bool InTree(const bookmarks::BookmarkNode* node) const;
+  std::string IdOf(const bookmarks::BookmarkNode* node) const;
+  const bookmarks::BookmarkNode* ParentFor(
+      const std::string& parent_id,
+      const std::map<std::string, const bookmarks::BookmarkNode*>& nodes) const;
+  std::map<std::string, const bookmarks::BookmarkNode*> CollectNodes(
+      std::vector<const bookmarks::BookmarkNode*>* unnamed) const;
+  std::string OrderAt(const bookmarks::BookmarkNode* parent, size_t index) const;
+  void WriteNode(const bookmarks::BookmarkNode* node);
+  void Write(const std::string& id, const Record& record);
+  void RemoveFile(const std::string& id);
+
+  // bookmarks::BookmarkModelObserver:
+  void BookmarkModelLoaded(bool ids_reassigned) override;
+  void BookmarkNodeMoved(const bookmarks::BookmarkNode* old_parent,
+                         size_t old_index,
+                         const bookmarks::BookmarkNode* new_parent,
+                         size_t new_index) override;
+  void BookmarkNodeAdded(const bookmarks::BookmarkNode* parent,
+                         size_t index,
+                         bool added_by_user) override;
+  void BookmarkNodeRemoved(const bookmarks::BookmarkNode* parent,
+                           size_t old_index,
+                           const bookmarks::BookmarkNode* node,
+                           const std::set<GURL>& no_longer_bookmarked,
+                           const base::Location& location) override;
+  void BookmarkNodeChanged(const bookmarks::BookmarkNode* node) override;
+  void BookmarkNodeFaviconChanged(const bookmarks::BookmarkNode* node) override {}
+  void BookmarkNodeChildrenReordered(const bookmarks::BookmarkNode* node) override;
+  void BookmarkAllUserNodesRemoved(const std::set<GURL>& removed_urls,
+                                   const base::Location& location) override;
+
+  const raw_ptr<bookmarks::BookmarkModel> model_;
+  const base::FilePath dir_;
+  scoped_refptr<base::SequencedTaskRunner> files_;
+
+  // The files as last read or written.
+  Records records_;
+  base::Time last_changed_;
+  bool reading_ = false;
+  bool applying_ = false;
+  // Counts what was changed here, so that a read begun before a change is not taken for news.
+  int changes_ = 0;
+
+  base::ScopedObservation<bookmarks::BookmarkModel, bookmarks::BookmarkModelObserver>
+      observation_{this};
+  base::WeakPtrFactory<BookmarkSync> weak_factory_{this};
+};
+
+}  // namespace spatiand
+
+#endif  // CHROME_BROWSER_SPATIAND_BOOKMARK_SYNC_H_
