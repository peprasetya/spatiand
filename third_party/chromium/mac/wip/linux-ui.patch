+# found in the LICENSE file.
+
+# Spatiand: what the Linux UI (Ozone/Wayland) needs on macOS that macOS has not.
+
+assert(is_mac)
+
+# The Linux kernel's input event codes, which Wayland's keys and buttons are.
+config("linux_input") {
+  include_dirs = [ "linux-input" ]
+}
