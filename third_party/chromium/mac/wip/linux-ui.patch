diff --git a/tools/grit/grit/node/misc.py b/tools/grit/grit/node/misc.py
index bb5a66ba56..eeda78e1f0 100644
--- a/tools/grit/grit/node/misc.py
+++ b/tools/grit/grit/node/misc.py
@@ -304,14 +304,53 @@ class IfNode(SplicingNode):
         )
       self.if_then_else = True
 
-  def ActiveChildren(self):
-    cond = self.EvaluateCondition(self.attrs['expr'])
+  def _Branch(self, cond):
     if self.if_then_else:
       return self.children[0 if cond else 1].ActiveChildren()
     else:
       # Equivalent to having all children inside <then> with an empty <else>
       return super().ActiveChildren() if cond else []
 
+  def ActiveChildren(self):
+    cond = self.EvaluateCondition(self.attrs['expr'])
+    children = self._Branch(cond)
+    root = self.GetRoot()
+    if base.Node.mac_only_pass or not base.IsMacLinuxUi(
+        getattr(root, 'defines', {})):
+      return children
+    # Spatiand: the Linux UI on macOS takes both readings of the file, as its
+    # C++ takes both the IS_MAC paths and the IS_MAC_LINUX_UI ones: what macOS
+    # alone would take, and what the Linux UI adds. Where both define the same
+    # resource (the same string worded for each system), macOS's stands: below
+    # the UI, the system is macOS's.
+    base.Node.mac_only_pass = True
+    try:
+      mac_cond = self.EvaluateCondition(self.attrs['expr'])
+    finally:
+      base.Node.mac_only_pass = False
+    if mac_cond == cond:
+      return children
+    taken = _MacOnlyIds(root)
+    return self._Branch(mac_cond) + [
+        c for c in children if not set(c.GetTextualIds()) & taken
+    ]
+
+
+def _MacOnlyIds(root):
+  '''Spatiand: the resource names a .grd defines as read for macOS alone.'''
+  key = (getattr(root, 'output_language', ''),
+         getattr(root, 'output_context', ''))
+  cache = root.__dict__.setdefault('_spatiand_mac_ids', {})
+  if key not in cache:
+    base.Node.mac_only_pass = True
+    try:
+      cache[key] = {
+          i for n in root.ActiveDescendants() for i in n.GetTextualIds()
+      }
+    finally:
+      base.Node.mac_only_pass = False
+  return cache[key]
+
 
 class ThenNode(SplicingNode):
   """A <then> node. Can only appear directly inside an <if> node."""
