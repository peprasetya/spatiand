new file mode 100644
index 0000000000..2cf29f8147
--- /dev/null
+++ b/ui/events/platform/wayland/wayland_event_watcher_mac.cc
@@ -0,0 +1,89 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/events/platform/wayland/wayland_event_watcher_mac.h"
+
+#include "base/check.h"
+#include "base/task/current_thread.h"
+
+namespace ui {
+
+namespace {
+
+void OnFileDescriptorEvent(CFFileDescriptorRef fd_ref,
+                           CFOptionFlags callback_types,
+                           void* info) {
+  static_cast<WaylandEventWatcherMac*>(info)->OnReadable();
+}
+
+}  // namespace
+
+WaylandEventWatcherMac::WaylandEventWatcherMac(wl_display* display,
+                                               wl_event_queue* event_queue,
+                                               bool use_threaded_polling)
+    : WaylandEventWatcher(display, event_queue, use_threaded_polling) {}
+
+WaylandEventWatcherMac::~WaylandEventWatcherMac() {
+  StopProcessingEvents();
+}
+
+bool WaylandEventWatcherMac::StartWatchingFD(int fd) {
+  DCHECK(base::CurrentUIThread::IsSet());
+  if (fd_ref_) {
+    return true;
+  }
+  CFFileDescriptorContext context = {0, this, nullptr, nullptr, nullptr};
+  fd_ref_ = CFFileDescriptorCreate(kCFAllocatorDefault, fd,
+                                   /*closeOnInvalidate=*/false,
+                                   OnFileDescriptorEvent, &context);
+  if (!fd_ref_) {
+    return false;
+  }
+  source_ =
+      CFFileDescriptorCreateRunLoopSource(kCFAllocatorDefault, fd_ref_, 0);
+  run_loop_ = CFRunLoopGetCurrent();
+  CFRetain(run_loop_);
+  CFRunLoopAddSource(run_loop_, source_, kCFRunLoopCommonModes);
+  WlDisplayPrepareToRead();
+  CFFileDescriptorEnableCallBacks(fd_ref_, kCFFileDescriptorReadCallBack);
+  return true;
+}
+
+void WaylandEventWatcherMac::StopWatchingFD() {
+  if (!fd_ref_) {
+    return;
+  }
+  CFRunLoopRemoveSource(run_loop_, source_, kCFRunLoopCommonModes);
+  CFFileDescriptorInvalidate(fd_ref_);
+  CFRelease(source_);
+  CFRelease(fd_ref_);
+  CFRelease(run_loop_);
+  source_ = nullptr;
+  fd_ref_ = nullptr;
+  run_loop_ = nullptr;
+}
+
+void WaylandEventWatcherMac::OnReadable() {
+  // As WaylandEventWatcherFdWatch::OnFileCanReadWithoutBlocking.
+  WlDisplayReadEvents();
+  WlDisplayDispatchPendingQueue();
+  if (!WlDisplayPrepareToRead()) {
+    WlDisplayDispatchPendingQueue();
+  }
+  // A CFFileDescriptor's callbacks fire once each time they are enabled.
+  if (fd_ref_) {
+    CFFileDescriptorEnableCallBacks(fd_ref_, kCFFileDescriptorReadCallBack);
+  }
+}
+
+// static
+std::unique_ptr<WaylandEventWatcher>
+WaylandEventWatcher::CreateWaylandEventWatcher(wl_display* display,
+                                               wl_event_queue* event_queue,
+                                               bool use_threaded_polling) {
+  return std::make_unique<WaylandEventWatcherMac>(display, event_queue,
+                                                  use_threaded_polling);
+}
+
+}  // namespace ui
