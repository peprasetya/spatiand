+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SPATIAND_SETTINGS_SYNC_H_
+#define CHROME_BROWSER_SPATIAND_SETTINGS_SYNC_H_
+
+#include <map>
+#include <optional>
+#include <string>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/values.h"
+#include "chrome/browser/themes/theme_service.h"
+#include "chrome/browser/themes/theme_service_observer.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/search_engines/template_url_service.h"
+#include "components/search_engines/template_url_service_observer.h"
+
+class Profile;
+
+namespace spatiand {
+
+// The settings every machine's SpatiMesh shares, one file each, in Chromium's own settings:
+// `apps/spatimesh/settings/{zoom,restore,bookmarks_bar,developer}.json`, and the search engine,
+// `search.json` and `custom_search.json`, which a profile may have its own of
+// (`profiles/<id>/settings/`). A setting is written only when it changes here, so that one left
+// alone never overrides another machine's. The profile's colour is its Chromium theme.
+class SettingsSync : public TemplateURLServiceObserver, public ThemeServiceObserver {
+ public:
+  SettingsSync(Profile* profile,
+               const std::string& id,
+               scoped_refptr<base::SequencedTaskRunner> files);
+  SettingsSync(const SettingsSync&) = delete;
+  SettingsSync& operator=(const SettingsSync&) = delete;
+  ~SettingsSync() override;
+
+  void Poll();
+
+  using Files = std::map<std::string, base::Value>;
+
+ private:
+  void OnRead(Files files);
+  void ApplySearch();
+  void WriteSetting(const std::string& name, base::Value value);
+  void WriteProfileSetting(const std::string& name, base::Value value);
+  void LocalBool(const std::string& name, const char* pref);
+  void LocalRestore();
+  void LocalZoom();
+  bool Seen(const std::string& key, const base::Value& value);
+
+  // TemplateURLServiceObserver:
+  void OnTemplateURLServiceChanged() override;
+  // ThemeServiceObserver:
+  void OnThemeChanged() override;
+
+  const raw_ptr<Profile> profile_;
+  const std::string id_;
+  scoped_refptr<base::SequencedTaskRunner> files_;
+  // Each setting as the files last had it, or as this browser last wrote it.
+  Files seen_;
+  bool reading_ = false;
+  bool read_once_ = false;
+  // Whether what is shared has been applied to the engines, which load late.
+  bool search_applied_ = false;
+  bool applying_ = false;
+
+  PrefChangeRegistrar prefs_;
+  base::CallbackListSubscription zoom_subscription_;
+  base::ScopedObservation<TemplateURLService, TemplateURLServiceObserver> search_observation_{this};
+  base::ScopedObservation<ThemeService, ThemeServiceObserver> theme_observation_{this};
+  base::WeakPtrFactory<SettingsSync> weak_factory_{this};
+};
+
+}  // namespace spatiand
+
+#endif  // CHROME_BROWSER_SPATIAND_SETTINGS_SYNC_H_
diff --git a/chrome/browser/spatiand/shared_folder.cc b/chrome/browser/spatiand/shared_folder.cc
