+struct NewLock {
+  std::string salt;
+  std::string hash;
+};
+
+NewLock MakeLock(const std::string& secret) {
+  NewLock lock;
+  lock.salt = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  lock.hash = LockHash(lock.salt, secret);
+  return lock;
+}
+
+class ProfileLockSettings : public views::DialogDelegate {
+ public:
+  ProfileLockSettings(const std::u16string& profile_name,
+                      std::string kind,
+                      std::string salt,
+                      std::string hash,
+                      SaveLock save)
+      : kind_(std::move(kind)),
+        salt_(std::move(salt)),
+        hash_(std::move(hash)),
+        save_(std::move(save)) {
+    SetTitle(u"What opens " + profile_name);
+    SetModalType(ui::mojom::ModalType::kNone);
+    SetShowCloseButton(true);
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk) |
+               static_cast<int>(ui::mojom::DialogButton::kCancel));
+    SetButtonLabel(ui::mojom::DialogButton::kOk, u"Save");
+    views::View* contents = SetContentsView(std::make_unique<views::View>());
+    contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(16), 8));
+    if (!hash_.empty()) {
+      AddLabel(contents, kind_ == kPin ? u"Its PIN now:" : u"Its password now:");
+      present_ = AddSecretField(contents, u"The present one");
+    }
+    const int group = 1;
+    const auto add_choice = [&](const std::u16string& label) {
+      auto* radio = contents->AddChildView(std::make_unique<views::RadioButton>(label, group));
+      radio->SetCallback(
+          base::BindRepeating(&ProfileLockSettings::ChoiceChanged, base::Unretained(this)));
+      return radio;
+    };
+    nothing_ = add_choice(u"Nothing: its windows just open");
+    pin_ = add_choice(u"A PIN, of 4 to 12 digits");
+    password_ = add_choice(u"A password, of at least 6 characters");
+    (kind_ == kPin ? pin_ : kind_ == kPassword ? password_ : nothing_)->SetChecked(true);
+    new_label_ = AddLabel(contents, u"The new one:");
+    new_ = AddSecretField(contents, u"The new one");
+    again_label_ = AddLabel(contents, u"Once more:");
+    again_ = AddSecretField(contents, u"Once more");
+    said_ = AddLabel(contents, std::u16string());
+    SetAcceptCallbackWithClose(
+        base::BindRepeating(&ProfileLockSettings::Try, base::Unretained(this)));
+    if (present_) {
+      SetInitiallyFocusedView(present_);
+    } else {
+      SetInitiallyFocusedView(nothing_);
+    }
+    ChoiceChanged();
+  }
+  ~ProfileLockSettings() override = default;
+
+ private:
+  void ChoiceChanged() {
+    const bool secret = !nothing_->GetChecked();
+    new_label_->SetEnabled(secret);
+    new_->SetEnabled(secret);
+    again_label_->SetEnabled(secret);
+    again_->SetEnabled(secret);
+  }
+
+  // Why what was typed will not do, if it will not.
+  std::u16string Refusal() const {
+    if (nothing_->GetChecked()) {
+      return std::u16string();
+    }
+    const std::u16string secret(new_->GetText());
+    if (pin_->GetChecked() &&
+        (secret.size() < 4 || secret.size() > 12 ||
+         !std::ranges::all_of(secret, [](char16_t c) { return base::IsAsciiDigit(c); }))) {
+      return u"A PIN is 4 to 12 digits.";
+    }
+    if (password_->GetChecked() && secret.size() < 6) {
+      return u"A password is at least 6 characters.";
+    }
+    if (secret != again_->GetText()) {
+      return u"The two are not the same.";
+    }
+    return std::u16string();
+  }
+
+  bool Try() {
+    if (working_) {
+      return false;
+    }
+    if (const std::u16string why = Refusal(); !why.empty()) {
+      said_->SetText(why);
+      return false;
+    }
+    if (hash_.empty()) {
+      Save();
+      return false;
+    }
+    if (!tries_.Allowed()) {
+      said_->SetText(u"Too many wrong tries: wait a moment.");
+      return false;
+    }
+    working_ = true;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+        base::BindOnce(&LockHash, salt_, base::UTF16ToUTF8(present_->GetText())),
+        base::BindOnce(&ProfileLockSettings::Checked, weak_factory_.GetWeakPtr()));
+    return false;
+  }
+
+  void Checked(std::string hash) {
+    working_ = false;
+    if (hash != hash_) {
+      present_->SetText(std::u16string());
+      present_->RequestFocus();
+      said_->SetText(tries_.Wrong());
+      return;
+    }
+    Save();
+  }
+
+  void Save() {
+    if (nothing_->GetChecked()) {
+      Saved(std::string(), {});
+      return;
+    }
+    working_ = true;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+        base::BindOnce(&MakeLock, base::UTF16ToUTF8(new_->GetText())),
+        base::BindOnce(&ProfileLockSettings::Saved, weak_factory_.GetWeakPtr(),
+                       std::string(pin_->GetChecked() ? kPin : kPassword)));
+  }
+
+  void Saved(std::string kind, NewLock lock) {
+    working_ = false;
+    std::move(save_).Run(kind, lock.salt, lock.hash);
+    GetWidget()->Close();
+  }
+
+  const std::string kind_;
+  const std::string salt_;
+  const std::string hash_;
+  SaveLock save_;
+  raw_ptr<views::Textfield> present_ = nullptr;
+  raw_ptr<views::RadioButton> nothing_ = nullptr;
+  raw_ptr<views::RadioButton> pin_ = nullptr;
+  raw_ptr<views::RadioButton> password_ = nullptr;
+  raw_ptr<views::Label> new_label_ = nullptr;
+  raw_ptr<views::Textfield> new_ = nullptr;
+  raw_ptr<views::Label> again_label_ = nullptr;
+  raw_ptr<views::Textfield> again_ = nullptr;
+  raw_ptr<views::Label> said_ = nullptr;
+  bool working_ = false;
+  Tries tries_;
+  base::WeakPtrFactory<ProfileLockSettings> weak_factory_{this};
+};
+
 }  // namespace
 
 void ShowProfileLockDialog(const std::u16string& profile_name,
                            bool is_pin,
                            const std::string& salt,
                            const std::string& hash,
+                           bool windows_waiting,
                            base::OnceCallback<void(bool)> done) {
   views::DialogDelegate::CreateDialogWidget(
-      std::make_unique<ProfileLockDialog>(profile_name, is_pin, salt, hash, std::move(done)),
+      std::make_unique<ProfileLockDialog>(profile_name, is_pin, salt, hash, windows_waiting,
+                                          std::move(done)),
+      /*context=*/gfx::NativeWindow(), /*parent=*/gfx::NativeView())
+      ->Show();
+}
+
+void ShowProfileLockSettings(const std::u16string& profile_name,
+                             const std::string& kind,
+                             const std::string& salt,
+                             const std::string& hash,
+                             SaveLock save) {
+  views::DialogDelegate::CreateDialogWidget(
+      std::make_unique<ProfileLockSettings>(profile_name, kind, salt, hash, std::move(save)),
       /*context=*/gfx::NativeWindow(), /*parent=*/gfx::NativeView())
       ->Show();
 }
