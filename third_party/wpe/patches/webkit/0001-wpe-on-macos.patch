     RELEASE_ASSERT(socketpair(AF_UNIX, socketType, 0, sockets.data()) != -1);
 
+#if OS(DARWIN)
+    // A local datagram on macOS is at most the socket's send buffer, 2 KB by default: room for
+    // a whole message (4 KB) and a queue of them, both ways.
+    if (socketType == SOCK_DGRAM) {
+        int size = 256 * 1024;
+        for (int socket : sockets) {
+            setsockopt(socket, SOL_SOCKET, SO_SNDBUF, &size, sizeof(size));
