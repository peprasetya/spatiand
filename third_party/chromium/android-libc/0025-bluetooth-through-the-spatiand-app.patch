+void BluetoothDeviceSpatiand::OnAdvertisement(const base::DictValue& message) {
+  if (const std::string* name = message.FindString("name")) {
+    name_ = *name;
+  }
+  std::optional<int8_t> tx_power;
+  if (std::optional<int> tx = message.FindInt("txPower")) {
+    tx_power = ClampToByte(*tx);
+  }
+  std::optional<uint8_t> flags;
+  if (std::optional<int> f = message.FindInt("flags"); f && *f >= 0) {
+    flags = static_cast<uint8_t>(*f);
+  }
+  UUIDList uuids;
+  if (const base::ListValue* list = message.FindList("uuids")) {
+    for (const base::Value& uuid : *list) {
+      if (uuid.is_string() && BluetoothUUID(uuid.GetString()).IsValid()) {
+        uuids.push_back(BluetoothUUID(uuid.GetString()));
+      }
+    }
+  }
+  ServiceDataMap service_data;
+  if (const base::DictValue* data = message.FindDict("serviceData")) {
+    for (const auto [key, value] : *data) {
+      if (BluetoothUUID(key).IsValid() && value.is_string()) {
+        service_data[BluetoothUUID(key)] = Unhex(&value.GetString());
+      }
+    }
+  }
+  ManufacturerDataMap manufacturer_data;
+  if (const base::DictValue* data = message.FindDict("manufacturerData")) {
+    for (const auto [key, value] : *data) {
+      int id = 0;
+      if (base::StringToInt(key, &id) && value.is_string()) {
+        manufacturer_data[static_cast<ManufacturerId>(id)] =
+            Unhex(&value.GetString());
+      }
+    }
+  }
+  UpdateAdvertisementData(ClampToByte(message.FindInt("rssi").value_or(-127)),
+                          flags, std::move(uuids), tx_power,
+                          std::move(service_data),
+                          std::move(manufacturer_data));
+}
+
+void BluetoothDeviceSpatiand::CreateGattConnectionImpl(
+    std::optional<BluetoothUUID> service_uuid) {
+  connecting_ = true;
+  bridge_->Send(base::DictValue()
+                    .Set("op", "connect")
+                    .Set("address", address_));
+}
+
+void BluetoothDeviceSpatiand::DisconnectGatt() {
+  bridge_->Send(base::DictValue()
+                    .Set("op", "disconnect")
+                    .Set("address", address_));
+}
+
+void BluetoothDeviceSpatiand::OnConnection(bool connected, int status) {
+  const bool was_connecting = connecting_;
+  connecting_ = false;
+  if (connected) {
+    if (!gatt_connected_) {
+      gatt_connected_ = true;
+      DidConnectGatt(std::nullopt);
+    }
+    return;
+  }
+  const bool was_connected = gatt_connected_;
+  gatt_connected_ = false;
+  for (auto& [id, service] : gatt_services_) {
+    for (BluetoothRemoteGattCharacteristic* characteristic :
+         service->GetCharacteristics()) {
+      auto* c =
+          static_cast<BluetoothRemoteGattCharacteristicSpatiand*>(characteristic);
+      for (BluetoothRemoteGattDescriptor* descriptor : c->GetDescriptors()) {
+        static_cast<BluetoothRemoteGattDescriptorSpatiand*>(descriptor)
+            ->FailPending();
+      }
+      c->FailPending();
+    }
+  }
+  gatt_services_.clear();
+  device_uuids_.ClearServiceUUIDs();
+  services_discovered_ = false;
+  if (was_connected) {
+    DidDisconnectGatt();
+  } else if (was_connecting) {
+    DidConnectGatt(ERROR_FAILED);
+  }
+}
+
+void BluetoothDeviceSpatiand::OnServices(const base::ListValue& services) {
+  gatt_services_.clear();
+  for (const base::Value& s : services) {
+    const base::DictValue* sd = s.GetIfDict();
+    const std::string* sid = sd ? sd->FindString("id") : nullptr;
+    const std::string* suuid = sd ? sd->FindString("uuid") : nullptr;
+    if (!sid || !suuid) {
+      continue;
+    }
+    auto service = std::make_unique<BluetoothRemoteGattServiceSpatiand>(
+        this, *sid, BluetoothUUID(*suuid),
+        sd->FindBool("primary").value_or(true));
+    if (const base::ListValue* characteristics =
+            sd->FindList("characteristics")) {
+      for (const base::Value& c : *characteristics) {
+        const base::DictValue* cd = c.GetIfDict();
+        const std::string* cid = cd ? cd->FindString("id") : nullptr;
+        const std::string* cuuid = cd ? cd->FindString("uuid") : nullptr;
+        if (!cid || !cuuid) {
+          continue;
+        }
+        auto characteristic =
+            std::make_unique<BluetoothRemoteGattCharacteristicSpatiand>(
+                service.get(), bridge_, address_, *cid, BluetoothUUID(*cuuid),
+                cd->FindInt("properties").value_or(0));
+        if (const base::ListValue* descriptors =
+                cd->FindList("descriptors")) {
+          for (const base::Value& d : *descriptors) {
+            const base::DictValue* dd = d.GetIfDict();
+            const std::string* did = dd ? dd->FindString("id") : nullptr;
+            const std::string* duuid = dd ? dd->FindString("uuid") : nullptr;
+            if (!did || !duuid) {
+              continue;
+            }
+            characteristic->AddDescriptor(
+                std::make_unique<BluetoothRemoteGattDescriptorSpatiand>(
+                    characteristic.get(), bridge_, address_, *did,
+                    BluetoothUUID(*duuid)));
+          }
+        }
+        service->AddCharacteristic(std::move(characteristic));
+      }
+    }
+    service->SetDiscoveryComplete(true);
+    gatt_services_[*sid] = std::move(service);
+  }
+  device_uuids_.ReplaceServiceUUIDs(gatt_services_);
+  services_discovered_ = true;
+  bridge_->NotifyGattServicesDiscovered(this);
+  bridge_->NotifyDeviceChanged(this);
+}
+
+BluetoothRemoteGattCharacteristicSpatiand*
+BluetoothDeviceSpatiand::CharacteristicOf(const std::string& id) const {
+  const std::string service_id = id.substr(0, id.find("/c"));
+  auto it = gatt_services_.find(service_id);
+  if (it == gatt_services_.end()) {
+    return nullptr;
+  }
+  return static_cast<BluetoothRemoteGattCharacteristicSpatiand*>(
+      it->second->GetCharacteristic(id.substr(0, id.find("/d"))));
+}
+
+BluetoothRemoteGattDescriptorSpatiand* BluetoothDeviceSpatiand::DescriptorOf(
+    const std::string& id) const {
+  BluetoothRemoteGattCharacteristicSpatiand* characteristic =
+      CharacteristicOf(id);
+  return characteristic ? static_cast<BluetoothRemoteGattDescriptorSpatiand*>(
+                              characteristic->GetDescriptor(id))
+                        : nullptr;
+}
