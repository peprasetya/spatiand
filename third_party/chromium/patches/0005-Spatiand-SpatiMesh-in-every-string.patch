From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Spatiand-build <claude@prasetya.id>
Date: Fri, 30 Oct 2026 11:08:47 +0700
Subject: [PATCH 285/310] Spatiand: SpatiMesh in every string

Cromite's grit renames Chrome, Chromium and Bromite at build time; the name is SpatiMesh, Cromite's
own strings included.
---
 tools/grit/grit/grd_reader.py | 31 +++++++++++++++++++++++--------
 1 file changed, 23 insertions(+), 8 deletions(-)

diff --git a/tools/grit/grit/grd_reader.py b/tools/grit/grit/grd_reader.py
index 46b1b31bc8..e4c2542937 100755
--- a/tools/grit/grit/grd_reader.py
+++ b/tools/grit/grit/grd_reader.py
@@ -6,6 +6,7 @@
 '''Class for reading GRD files into memory, without processing them.'''
 
 import os.path
+import re
 import sys
 import xml.sax
 import xml.sax.handler
@@ -151,6 +152,13 @@ class GrdContentHandler(xml.sax.handler.ContentHandler):
     content = content_orig.replace("Chromiumdontreplace", "zzzyyyyxxxx1")
     content = content.replace("Chromedontreplace", "zzzyyyyxxxx2")
     content = content.replace("chromedontreplace", "zzzyyyyxxxx3")
+    # Spatiand: the Chrome Web Store keeps its name, whichever way a string spells it ("Chrome Web
+    # Store", "Chrome web store", "Chrome Webstore", ...): it is Google's store, where its links go.
+    content = re.sub(r"Chrome(?= [Ww]eb ?[Ss]tore)", "zzzyyyyxxxx2", content)
+    content = re.sub(r"chrome(?= [Ww]eb ?[Ss]tore)", "zzzyyyyxxxx3", content)
+    # An element's id inside a string, which the page's script looks for by that name (Customize
+    # Chrome's store link: app.ts checks for 'chromeWebstoreLink').
+    content = content.replace("chromeWebstoreLink", "zzzyyyyxxxx3WebstoreLink")
     content = content.replace("//chrome", "zzzyyyyxxxx4")
     content = content.replace("chrome://", "zzzyyyyxxxx5")
     content = content.replace("/chrome/", "zzzyyyyxxxx6")
@@ -158,14 +166,20 @@ class GrdContentHandler(xml.sax.handler.ContentHandler):
     content = content.replace(".chromium.org", "zzzyyyyxxxx8")
     content = content.replace("chromebook", "zzzyyyyxxxx9")
     content = content.replace("chromeos", "zzzyyyyxxxxA")
-
-    content = content.replace("google chrome", "cromite")
-    content = content.replace("Chrome", "Cromite")
-    content = content.replace("Chromium", "Cromite")
-    content = content.replace("Bromite", "Cromite")
-    content = content.replace("chrome", "cromite")
-    content = content.replace("chromium", "cromite")
-    content = content.replace("bromite", "cromite")
+    # Spatiand: a header path in an <emit> (theme_resources.grd includes
+    # "chrome/grit/webui_theme_resources.h" since 157).
+    content = content.replace('#include "chrome/', "zzzyyyyxxxxB")
+
+    # Spatiand: the browser is SpatiMesh, Cromite's own strings included. Lower case "cromite" is
+    # left alone: in Cromite's strings it is the filter lists' web address.
+    content = content.replace("google chrome", "spatimesh")
+    content = content.replace("Chrome", "SpatiMesh")
+    content = content.replace("Chromium", "SpatiMesh")
+    content = content.replace("Bromite", "SpatiMesh")
+    content = content.replace("Cromite", "SpatiMesh")
+    content = content.replace("chrome", "spatimesh")
+    content = content.replace("chromium", "spatimesh")
+    content = content.replace("bromite", "spatimesh")
 
     content = content.replace("zzzyyyyxxxx1", "Chromium")
     content = content.replace("zzzyyyyxxxx2", "Chrome")
@@ -177,6 +191,7 @@ class GrdContentHandler(xml.sax.handler.ContentHandler):
     content = content.replace("zzzyyyyxxxx8", ".chromium.org")
     content = content.replace("zzzyyyyxxxx9", "chromebook")
     content = content.replace("zzzyyyyxxxxA", "chromeos")
+    content = content.replace("zzzyyyyxxxxB", '#include "chrome/')
     # if "dontreplace" in content_orig:
     #   raise exception.MissingElement("stop")
     #   print(content + " <-- " + content_orig)
