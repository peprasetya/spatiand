+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef DEVICE_FIDO_SPATIKEY_SPATIKEY_AUTHENTICATOR_H_
+#define DEVICE_FIDO_SPATIKEY_SPATIKEY_AUTHENTICATOR_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/memory/weak_ptr.h"
+#include "device/fido/fido_authenticator.h"
+
+namespace device {
+
+// The platform authenticator here: SpatiKey's vault, whose service keeps the keys and signs, and
+// asks for a touch by itself, naming the site (docs/spatikey.md). This only carries a request to it
+// and the answer back.
+//
+// What the vault holds cannot be listed before that touch, so a request with no list of its own is
+// told there is one passkey, standing for all of them (see GetPlatformCredentialInfoForRequest);
+// the real ones come with the answer, and Chromium's account sheet chooses if there are several.
+class SpatikeyAuthenticator : public FidoAuthenticator {
+ public:
+  SpatikeyAuthenticator();
+  SpatikeyAuthenticator(const SpatikeyAuthenticator&) = delete;
+  SpatikeyAuthenticator& operator=(const SpatikeyAuthenticator&) = delete;
+  ~SpatikeyAuthenticator() override;
+
+  // FidoAuthenticator:
+  void InitializeAuthenticator(base::OnceClosure callback) override;
+  void MakeCredential(CtapMakeCredentialRequest request,
+                      MakeCredentialOptions options,
+                      MakeCredentialCallback callback) override;
+  void GetAssertion(CtapGetAssertionRequest request,
+                    CtapGetAssertionOptions options,
+                    GetAssertionCallback callback) override;
+  void GetPlatformCredentialInfoForRequest(
+      const CtapGetAssertionRequest& request,
+      const CtapGetAssertionOptions& options,
+      GetPlatformCredentialInfoForRequestCallback callback) override;
+  void GetTouch(base::OnceClosure callback) override;
+  void Cancel() override;
+  std::string GetId() const override;
+  const AuthenticatorSupportedOptions& Options() const override;
+  std::optional<FidoTransportProtocol> AuthenticatorTransport() const override;
+  base::WeakPtr<FidoAuthenticator> GetWeakPtr() override;
+
+ private:
+  // Drops the answers still to come: a touch already asked for cannot be taken back.
+  base::WeakPtrFactory<SpatikeyAuthenticator> request_factory_{this};
+  base::WeakPtrFactory<SpatikeyAuthenticator> weak_factory_{this};
+};
+
+}  // namespace device
+
+#endif  // DEVICE_FIDO_SPATIKEY_SPATIKEY_AUTHENTICATOR_H_
diff --git a/device/fido/spatikey/spatikey_discovery.cc b/device/fido/spatikey/spatikey_discovery.cc
