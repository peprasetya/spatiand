diff --git a/third_party/spatiand_mac/linux-input/linux/input.h b/third_party/spatiand_mac/linux-input/linux/input.h
new file mode 100644
index 0000000000..bcef715092
--- /dev/null
+++ b/third_party/spatiand_mac/linux-input/linux/input.h
@@ -0,0 +1,10 @@
+/* Spatiand: <linux/input.h> for the Linux UI on macOS. Wayland's key and
+ * button numbers are the Linux kernel's evdev codes on every platform; macOS
+ * has no kernel headers to name them, so this is the event codes alone
+ * (input-event-codes.h, from the Debian bullseye sysroot Chromium's Linux
+ * build compiles against). The kernel's input structures and ioctls, for
+ * reading devices, are not here: nothing on macOS reads evdev devices. */
+#ifndef SPATIAND_MAC_LINUX_INPUT_H
+#define SPATIAND_MAC_LINUX_INPUT_H
+#include <linux/input-event-codes.h>
+#endif
diff --git a/third_party/spatiand_surfaces/BUILD.gn b/third_party/spatiand_surfaces/BUILD.gn
new file mode 100644
index 0000000000..48362bafb2
--- /dev/null
+++ b/third_party/spatiand_surfaces/BUILD.gn
@@ -0,0 +1,24 @@
+# Copyright 2026 Spatiand
+# Spatiand's private hand-over of IOSurfaces from a process to the room that started it
+# (crates/spatiand-surfaces/native in Spatiand, copied as it is): how every Spatiand
+# application on the Mac shows a picture drawn on the GPU.
+
+assert(is_mac)
+
+config("spatiand_surfaces_config") {
+  include_dirs = [ "." ]
+}
+
+static_library("spatiand_surfaces") {
+  sources = [
+    "surfaces.c",
+    "surfaces.h",
+  ]
+  cflags_c = [ "-Wno-deprecated-declarations" ]
+  frameworks = [
+    "CoreFoundation.framework",
+    "IOSurface.framework",
+  ]
+  libs = [ "bsm" ]
+  public_configs = [ ":spatiand_surfaces_config" ]
+}
diff --git a/third_party/spatiand_surfaces/surfaces.c b/third_party/spatiand_surfaces/surfaces.c
new file mode 100644
index 0000000000..92e1f4073e
--- /dev/null
+++ b/third_party/spatiand_surfaces/surfaces.c
@@ -0,0 +1,262 @@
+/* See surfaces.h. */
+
+#include "surfaces.h"
+
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOSurface/IOSurface.h>
+#include <bootstrap.h>
+#include <bsm/libbsm.h>
+#include <libproc.h>
+#include <mach/mach.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/time.h>
+#include <time.h>
+#include <unistd.h>
+
+#ifndef SURFACES_ENV
+#define SURFACES_ENV "SPATIAND_SURFACES"
+#endif
+#define SURFACES_STRING2(x) #x
+#define SURFACES_STRING(x) SURFACES_STRING2(x)
+
+/* How long a picture is kept after it was last handed over or opened. */
+#define KEPT_SECONDS 5.0
+/* How long surfaces_open waits for a picture it has not got: the child sends it before it
+ * names it, but this process's receiving thread may not have taken it in yet. Short, since
+ * the room draws while it waits; and a number waited for in vain is not waited for again. */
+#define OPEN_WAIT_SECONDS 0.004
+#define MOST_MISSED 64
+#define MOST_KEPT 256
+
+typedef struct {
+    mach_msg_header_t header;
+    mach_msg_body_t body;
+    mach_msg_port_descriptor_t surface;
+    uint32_t number;
+} Post;
+
+typedef struct {
+    Post post;
+    mach_msg_audit_trailer_t trailer;
+} Received;
+
+typedef struct {
+    uint32_t number;
+    IOSurfaceRef surface;
+    double when;
+} Kept;
+
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t arrived = PTHREAD_COND_INITIALIZER;
+static int listening;
+static mach_port_t service = MACH_PORT_NULL;
+static Kept kept[MOST_KEPT];
+static int parent_read;
+static char parent_name[128];
+static mach_port_t parent_port = MACH_PORT_NULL;
+
+static double now(void) {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec + t.tv_nsec / 1e9;
+}
+
+/* Where this process's parent takes pictures, as it was told: read once, before this process
+ * names its own place to its children in the same variable. Called with the lock held. */
+static void read_parent(void) {
+    if (parent_read)
+        return;
+    parent_read = 1;
+    const char *name = getenv(SURFACES_ENV);
+    if (name && strlen(name) < sizeof parent_name)
+        strcpy(parent_name, name);
+}
+
+/* Whether `pid` was started by this process, directly or by one it started (an application
+ * another opened: a film SpatiShelf opened in SpatiReel). */
+static int is_child(pid_t pid) {
+    for (int depth = 0; depth < 16 && pid > 1; depth++) {
+        struct proc_bsdinfo info;
+        if (proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, &info, sizeof info) != (int)sizeof info)
+            return 0;
+        if ((pid_t)info.pbi_ppid == getpid())
+            return 1;
+        pid = (pid_t)info.pbi_ppid;
+    }
+    return 0;
+}
+
+static uint32_t missed[MOST_MISSED];
+static int missed_next;
+
+static int was_missed(uint32_t number) {
+    for (int i = 0; i < MOST_MISSED; i++)
+        if (missed[i] == number && number)
+            return 1;
+    return 0;
+}
+
+/* Keep `surface` (adopted) as `number`, in place of what was kept as it, and let go of what
+ * has not been wanted for a while. Called with the lock held. */
+static void keep(uint32_t number, IOSurfaceRef surface) {
+    double t = now();
+    int free_slot = -1, oldest = 0;
+    for (int i = 0; i < MOST_KEPT; i++) {
+        if (kept[i].surface && t - kept[i].when > KEPT_SECONDS) {
+            CFRelease(kept[i].surface);
+            kept[i].surface = NULL;
+        }
+        if (kept[i].surface && kept[i].number == number) {
+            CFRelease(kept[i].surface);
+            kept[i].surface = NULL;
+        }
+        if (!kept[i].surface && free_slot < 0)
+            free_slot = i;
+        if (kept[i].surface && kept[i].when < kept[oldest].when)
+            oldest = i;
+    }
+    if (free_slot < 0) {
+        CFRelease(kept[oldest].surface);
+        free_slot = oldest;
+    }
+    kept[free_slot] = (Kept) { number, surface, t };
+}
+
+static void *receive(void *unused) {
+    (void)unused;
+    for (;;) {
+        Received message;
+        memset(&message, 0, sizeof message);
+        kern_return_t kr = mach_msg(&message.post.header,
+            MACH_RCV_MSG | MACH_RCV_TRAILER_TYPE(MACH_MSG_TRAILER_FORMAT_0) | MACH_RCV_TRAILER_ELEMENTS(MACH_RCV_TRAILER_AUDIT),
+            0, sizeof message, service, MACH_MSG_TIMEOUT_NONE, MACH_PORT_NULL);
+        if (kr == MACH_RCV_TOO_LARGE)
+            continue;
+        if (kr != KERN_SUCCESS)
+            break;
+        int complex = (message.post.header.msgh_bits & MACH_MSGH_BITS_COMPLEX) != 0;
+        mach_port_t port = complex && message.post.body.msgh_descriptor_count >= 1 ? message.post.surface.name : MACH_PORT_NULL;
+        int whole = complex && message.post.header.msgh_size >= sizeof(Post) && message.post.body.msgh_descriptor_count == 1
+            && message.post.surface.type == MACH_MSG_PORT_DESCRIPTOR;
+        /* From one of this process's own children, as the kernel says: no one else's. */
+        if (whole && is_child(audit_token_to_pid(message.trailer.msgh_audit))) {
+            IOSurfaceRef surface = IOSurfaceLookupFromMachPort(port);
+            if (surface) {
+                pthread_mutex_lock(&lock);
+                keep(message.post.number, surface);
+                for (int i = 0; i < MOST_MISSED; i++)
+                    if (missed[i] == message.post.number)
+                        missed[i] = 0;
+                pthread_cond_broadcast(&arrived);
+                pthread_mutex_unlock(&lock);
+            }
+        }
+        /* The rights that came with it (the port, opened above or not) go. */
+        mach_msg_destroy(&message.post.header);
+    }
+    return NULL;
+}
+
+int SURFACES_NAME(surfaces_listen)(void) {
+    pthread_mutex_lock(&lock);
+    read_parent();
+    if (listening) {
+        pthread_mutex_unlock(&lock);
+        return 1;
+    }
+    char name[128];
+    snprintf(name, sizeof name, "id.prasetya.spatiand.surfaces.%d.%s", (int)getpid(), SURFACES_STRING(SURFACES_PREFIX));
+    kern_return_t kr = bootstrap_check_in(bootstrap_port, name, &service);
+    if (kr != KERN_SUCCESS) {
+        pthread_mutex_unlock(&lock);
+        return 0;
+    }
+    /* Room for every picture of a busy child, so that a child never waits on this one. */
+    mach_port_limits_t limits = { MACH_PORT_QLIMIT_LARGE };
+    mach_port_set_attributes(mach_task_self(), service, MACH_PORT_LIMITS_INFO, (mach_port_info_t)&limits, MACH_PORT_LIMITS_INFO_COUNT);
+    /* A process's first use of IOSurface takes about a second (its connection is set up): done
+     * here, so that the first picture a child hands over is not that late. */
+    IOSurfaceGetPropertyMaximum(kIOSurfaceWidth);
+    pthread_t thread;
+    if (pthread_create(&thread, NULL, receive, NULL)) {
+        pthread_mutex_unlock(&lock);
+        return 0;
+    }
+    pthread_detach(thread);
+    listening = 1;
+    setenv(SURFACES_ENV, name, 1);
+    pthread_mutex_unlock(&lock);
+    return 1;
+}
+
+int SURFACES_NAME(surfaces_post)(IOSurfaceRef surface, uint32_t number) {
+    if (!surface)
+        return 0;
+    pthread_mutex_lock(&lock);
+    read_parent();
+    for (int attempt = 0; attempt < 2; attempt++) {
+        if (parent_port == MACH_PORT_NULL) {
+            if (!parent_name[0] || bootstrap_look_up(bootstrap_port, parent_name, &parent_port) != KERN_SUCCESS) {
+                parent_port = MACH_PORT_NULL;
+                break;
+            }
+        }
+        Post post;
+        memset(&post, 0, sizeof post);
+        post.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, 0) | MACH_MSGH_BITS_COMPLEX;
+        post.header.msgh_size = sizeof post;
+        post.header.msgh_remote_port = parent_port;
+        post.body.msgh_descriptor_count = 1;
+        post.surface.name = IOSurfaceCreateMachPort(surface);
+        post.surface.disposition = MACH_MSG_TYPE_MOVE_SEND;
+        post.surface.type = MACH_MSG_PORT_DESCRIPTOR;
+        post.number = number;
+        kern_return_t kr = mach_msg(&post.header, MACH_SEND_MSG | MACH_SEND_TIMEOUT, sizeof post, 0, MACH_PORT_NULL, 100, MACH_PORT_NULL);
+        if (kr == KERN_SUCCESS) {
+            pthread_mutex_unlock(&lock);
+            return 1;
+        }
+        /* Not sent: the port is still ours to let go of. */
+        mach_port_deallocate(mach_task_self(), post.surface.name);
+        if (kr != MACH_SEND_INVALID_DEST)
+            break;
+        /* The parent's service went (and may be back): look it up again, once. */
+        mach_port_deallocate(mach_task_self(), parent_port);
+        parent_port = MACH_PORT_NULL;
+    }
+    pthread_mutex_unlock(&lock);
+    return 0;
+}
+
+IOSurfaceRef SURFACES_NAME(surfaces_open)(uint32_t number) {
+    IOSurfaceRef found = NULL;
+    pthread_mutex_lock(&lock);
+    double until = now() + OPEN_WAIT_SECONDS;
+    while (listening) {
+        for (int i = 0; i < MOST_KEPT; i++) {
+            if (kept[i].surface && kept[i].number == number) {
+                found = (IOSurfaceRef)CFRetain(kept[i].surface);
+                kept[i].when = now();
+                break;
+            }
+        }
+        double left = until - now();
+        if (found || was_missed(number))
+            break;
+        if (left <= 0) {
+            missed[missed_next] = number;
+            missed_next = (missed_next + 1) % MOST_MISSED;
+            break;
+        }
+        struct timeval tv;
+        gettimeofday(&tv, NULL);
+        double at = tv.tv_sec + tv.tv_usec / 1e6 + left;
+        struct timespec deadline = { (time_t)at, (long)((at - (time_t)at) * 1e9) };
+        pthread_cond_timedwait(&arrived, &lock, &deadline);
+    }
+    pthread_mutex_unlock(&lock);
+    return found;
+}
diff --git a/third_party/spatiand_surfaces/surfaces.h b/third_party/spatiand_surfaces/surfaces.h
new file mode 100644
index 0000000000..aad8252e8b
--- /dev/null
+++ b/third_party/spatiand_surfaces/surfaces.h
@@ -0,0 +1,50 @@
+/*
+ * Pictures on the GPU (IOSurfaces) handed from a process to its parent in private, on macOS.
+ *
+ * A global IOSurface can be opened by any process on the Mac that knows or guesses its number,
+ * and read: a page, a password being typed. These are not global. The parent registers a Mach
+ * service of its own (surfaces_listen) and names it to its children in an environment variable;
+ * a child sends each picture's Mach port there with a number of its choosing (surfaces_post),
+ * and the parent opens it by that number (surfaces_open). The parent takes pictures only from
+ * its own children, as the kernel says who sent them.
+ *
+ * The numbers still travel the way they did (a socket, a Wayland buffer's name); they are only
+ * names now, worthless to anyone else.
+ *
+ * It may be built twice into one process (as it was into SpatiMesh's WPE engine program, until
+ * 2026-11-10: Spatiand's own copy, and WebKit's for its processes), so everything is static or
+ * prefixed, and each copy has its own variable: SURFACES_ENV and SURFACES_PREFIX are given at
+ * build time.
+ */
+
+#pragma once
+
+#include <IOSurface/IOSurfaceRef.h>
+#include <stdint.h>
+
+#ifndef SURFACES_PREFIX
+#define SURFACES_PREFIX spatiand_
+#endif
+#define SURFACES_JOIN2(a, b) a##b
+#define SURFACES_JOIN(a, b) SURFACES_JOIN2(a, b)
+#define SURFACES_NAME(name) SURFACES_JOIN(SURFACES_PREFIX, name)
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Take pictures from this process's children from now on: once; later calls do nothing. The
+ * children started after it are told where (the environment variable). The parent's own place,
+ * as this process was told it, is kept first for surfaces_post. 0 if it could not be done. */
+int SURFACES_NAME(surfaces_listen)(void);
+
+/* Hand `surface` to the parent, as `number`. 0 if there is no parent listening, or it failed. */
+int SURFACES_NAME(surfaces_post)(IOSurfaceRef surface, uint32_t number);
+
+/* The picture a child handed over as `number`, retained (CFRelease it), or NULL. A picture is
+ * kept for a few seconds after it was last handed over, so it can be opened more than once. */
+IOSurfaceRef SURFACES_NAME(surfaces_open)(uint32_t number);
+
+#ifdef __cplusplus
+}
+#endif
