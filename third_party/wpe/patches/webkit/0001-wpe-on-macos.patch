 # Update Source/WTF/wtf/Platform.h to match required GLib versions.
+# Spatiand: WPE on a Mac. ICU is the system's own (libicucore, unversioned symbols, as Apple's
+# WebKit has it), and EGL's types are the generic ones WPE is written against (on Apple, EGL's
+# native display is otherwise an int).
+if (APPLE)
+    add_definitions(-DU_DISABLE_RENAMING=1 -DEGL_NO_PLATFORM_SPECIFIC_TYPES)
+    # What glibc has in it and macOS keeps apart: gettext. And Accelerate, which WebKit's own
+    # code on any Darwin uses for image filters (USE(ACCELERATE)).
+    find_package(Intl REQUIRED)
+    link_libraries(${Intl_LIBRARIES} "-framework Accelerate" "-framework IOSurface" "-framework CoreFoundation")
+    # Pictures are IOSurfaces (WPEBufferIOSurface), handed over with nothing copied.
+    set(WPE_PLATFORM_BUFFER_IOSURFACE ON)
+endif ()
+
 find_package(GLib 2.70.0 REQUIRED COMPONENTS GioUnix Thread Module)
 find_package(HarfBuzz 2.7.4 REQUIRED COMPONENTS ICU)
 find_package(ICU 70.1 REQUIRED COMPONENTS data i18n uc)
