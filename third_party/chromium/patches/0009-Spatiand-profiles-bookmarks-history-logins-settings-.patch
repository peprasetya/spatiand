+
+namespace spatiand {
+
+namespace {
+
+using bookmarks::BookmarkNode;
+
+constexpr char kFileName[] = "spatiand_id";
+constexpr char kOtherId[] = "other";
+constexpr std::string_view kDigits = "0123456789abcdefghijklmnopqrstuvwxyz";
+
+size_t DigitOf(char c) {
+  const size_t at = kDigits.find(c);
+  return at == std::string_view::npos ? 0 : at;
+}
+
+std::string Midpoint(std::string_view a, std::optional<std::string_view> b) {
+  if (b) {
+    // The common start, `a` read as if it went on in zeros.
+    size_t n = 0;
+    while (n < b->size() && (n < a.size() ? a[n] : '0') == (*b)[n]) {
+      ++n;
+    }
+    if (n > 0) {
+      const std::string_view rest_a = n < a.size() ? a.substr(n) : std::string_view();
+      return std::string(b->substr(0, n)) + Midpoint(rest_a, b->substr(n));
+    }
+  }
+  if (a.empty() && !b) {
+    // The first: the middle, room either side.
+    return "i";
+  }
+  const size_t da = a.empty() ? 0 : DigitOf(a[0]);
+  const size_t db = !b || b->empty() ? kDigits.size() : DigitOf((*b)[0]);
+  // At the end, the next digit up, and at the start the next one down, rather than half way:
+  // bookmarks are mostly added at the end.
+  if (!b && da + 1 < kDigits.size()) {
+    return std::string(1, kDigits[da + 1]);
+  }
+  if (a.empty() && db >= 2) {
+    return std::string(1, kDigits[db - 1]);
+  }
+  if (db - da > 1) {
+    return std::string(1, kDigits[(da + db + 1) / 2]);
+  }
+  if (b && b->size() > 1) {
+    return std::string(1, (*b)[0]);
+  }
+  const std::string_view rest = a.size() > 1 ? a.substr(1) : std::string_view();
+  return std::string(1, kDigits[da]) + Midpoint(rest, std::nullopt);
+}
+
+std::string_view TrimZeros(std::string_view key) {
+  return base::TrimString(key, "0", base::TRIM_TRAILING);
+}
+
+base::Value RecordValue(const BookmarkSync::Record& record) {
+  base::DictValue dict;
+  dict.Set("parent", record.parent);
+  dict.Set("title", record.title);
+  if (record.url) {
+    dict.Set("url", *record.url);
+  }
+  dict.Set("order", record.order);
+  dict.Set("added", record.added);
+  return base::Value(std::move(dict));
+}
+
+void WriteRecord(const base::FilePath& file, BookmarkSync::Record record) {
+  WriteJson(file, RecordValue(record));
+}
+
+}  // namespace
+
+std::string KeyBetween(std::string_view a, std::optional<std::string_view> b) {
+  // A key from elsewhere with a trailing zero, or out of order, is not trusted.
+  a = TrimZeros(a);
+  if (b) {
+    b = TrimZeros(*b);
+    if (b->empty() || *b <= a) {
+      b = std::nullopt;
+    }
+  }
+  return Midpoint(a, b);
+}
+
+BookmarkSync::Record::Record() = default;
+BookmarkSync::Record::Record(const Record&) = default;
+BookmarkSync::Record& BookmarkSync::Record::operator=(const Record&) = default;
+BookmarkSync::Record::~Record() = default;
+BookmarkSync::Read::Read() = default;
+BookmarkSync::Read::Read(Read&&) = default;
+BookmarkSync::Read& BookmarkSync::Read::operator=(Read&&) = default;
+BookmarkSync::Read::~Read() = default;
+
+BookmarkSync::BookmarkSync(Profile* profile,
+                           const std::string& id,
+                           scoped_refptr<base::SequencedTaskRunner> files)
+    : model_(BookmarkModelFactory::GetForBrowserContext(profile)),
+      dir_(SharedProfileDir(id).Append("bookmarks")),
+      files_(std::move(files)) {
+  observation_.Observe(model_);
+  if (model_->loaded()) {
+    Poll();
+  }
+}
+
+BookmarkSync::~BookmarkSync() = default;
+
+void BookmarkSync::Poll() {
+  if (reading_ || !model_->loaded()) {
+    return;
+  }
+  reading_ = true;
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&BookmarkSync::ReadIfChanged, dir_, last_changed_),
+      base::BindOnce(&BookmarkSync::OnRead, weak_factory_.GetWeakPtr(), changes_));
+}
+
+// static
+BookmarkSync::Read BookmarkSync::ReadIfChanged(const base::FilePath& dir, base::Time last) {
+  Read read;
+  read.changed = FolderChanged(dir);
+  // No folder for this profile at all says nothing about its bookmarks.
+  if (!base::DirectoryExists(dir.DirName())) {
+    read.unchanged = true;
+    return read;
+  }
+  if (!last.is_null() && read.changed == last) {
+    read.unchanged = true;
+    return read;
+  }
+  for (const std::string& id : ListJson(dir)) {
+    std::optional<base::Value> file = ReadJson(dir.Append(id + ".json"));
+    if (!file || !file->is_dict()) {
+      continue;
+    }
+    const base::DictValue& dict = file->GetDict();
+    Record record;
+    if (const std::string* parent = dict.FindString("parent")) {
+      record.parent = *parent;
+    }
+    if (const std::string* title = dict.FindString("title")) {
+      record.title = *title;
+    }
+    if (const std::string* url = dict.FindString("url")) {
+      record.url = *url;
+    }
+    if (const std::string* order = dict.FindString("order")) {
+      record.order = *order;
+    }
+    record.added = dict.FindDouble("added").value_or(0);
+    read.records.emplace(id, std::move(record));
+  }
+  return read;
+}
+
+void BookmarkSync::OnRead(int changes_when_asked, Read read) {
+  reading_ = false;
+  if (read.unchanged) {
+    return;
+  }
+  if (changes_when_asked != changes_) {
+    // Something changed here while that was being read: read again next time.
+    return;
+  }
+  last_changed_ = read.changed;
+  Reconcile(std::move(read.records));
+}
+
+std::map<std::string, const BookmarkNode*> BookmarkSync::CollectNodes(
+    std::vector<const BookmarkNode*>* unnamed) const {
+  std::map<std::string, const BookmarkNode*> nodes;
+  std::vector<const BookmarkNode*> stack = {model_->bookmark_bar_node(), model_->other_node()};
+  while (!stack.empty()) {
+    const BookmarkNode* node = stack.back();
+    stack.pop_back();
+    for (const auto& child : node->children()) {
+      std::string id;
+      // A copy of a bookmark carries its original's name: only the first keeps it.
+      if (child->GetMetaInfo(kFileName, &id) && !id.empty() && !nodes.contains(id)) {
+        nodes.emplace(id, child.get());
+      } else if (unnamed) {
+        unnamed->push_back(child.get());
+      }
+      if (child->is_folder()) {
+        stack.push_back(child.get());
+      }
+    }
+  }
+  return nodes;
+}
+
+bool BookmarkSync::InTree(const BookmarkNode* node) const {
+  for (; node; node = node->parent()) {
+    if (node == model_->bookmark_bar_node() || node == model_->other_node()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::string BookmarkSync::IdOf(const BookmarkNode* node) const {
+  if (node == model_->bookmark_bar_node()) {
+    return std::string();
+  }
+  if (node == model_->other_node()) {
+    return kOtherId;
+  }
+  std::string id;
+  node->GetMetaInfo(kFileName, &id);
+  return id;
+}
+
+const BookmarkNode* BookmarkSync::ParentFor(
+    const std::string& parent_id,
+    const std::map<std::string, const BookmarkNode*>& nodes) const {
+  if (parent_id.empty()) {
+    return model_->bookmark_bar_node();
+  }
+  if (parent_id == kOtherId) {
+    return model_->other_node();
+  }
+  const auto it = nodes.find(parent_id);
+  return it != nodes.end() && it->second->is_folder() ? it->second : nullptr;
+}
+
+void BookmarkSync::Reconcile(Records records) {
+  base::AutoReset<bool> applying(&applying_, true);
+  const auto source = bookmarks::metrics::BookmarkEditSource::kOther;
+
+  std::vector<const BookmarkNode*> unnamed;
+  std::map<std::string, const BookmarkNode*> nodes = CollectNodes(&unnamed);
+
+  // Gone from the files: removed on another machine. Parents after their children would be
+  // removed twice, so what is gone is looked up again each time.
+  std::vector<std::string> gone;
+  for (const auto& [id, node] : nodes) {
+    if (!records.contains(id)) {
+      gone.push_back(id);
+    }
+  }
+  for (const std::string& id : gone) {
+    const auto current = CollectNodes(nullptr);
+    const auto it = current.find(id);
+    if (it != current.end()) {
+      model_->Remove(it->second, source, FROM_HERE);
+    }
+  }
+  nodes = CollectNodes(nullptr);
+
+  // Those with no file yet: the same bookmark as one in the files is that one, as on a machine
+  // joining the list; the rest are this machine's own to add.
+  std::vector<const BookmarkNode*> unnamed_now;
+  CollectNodes(&unnamed_now);
+  for (const BookmarkNode* node : unnamed_now) {
+    const std::string parent_id = IdOf(node->parent());
+    std::string found;
+    for (const auto& [id, record] : records) {
+      if (!nodes.contains(id) && record.parent == parent_id &&
+          record.title == base::UTF16ToUTF8(node->GetTitle()) &&
+          record.url.has_value() == node->is_url() &&
+          (!record.url || GURL(*record.url) == node->url())) {
+        found = id;
+        break;
+      }
+    }
+    if (!found.empty()) {
+      model_->SetNodeMetaInfo(node, kFileName, found);
+      nodes.emplace(found, node);
+    }
+  }
+
+  // New and changed, each after its folder. What is left when nothing more can be placed has lost
+  // its folder (deleted on another machine while it was added here): at the top, rather than lost.
+  std::vector<std::string> waiting;
+  for (const auto& [id, record] : records) {
+    if (id != kOtherId) {
+      waiting.push_back(id);
+    }
+  }
+  while (!waiting.empty()) {
+    std::vector<std::string> later;
+    for (const std::string& id : waiting) {
+      const Record& record = records.at(id);
+      const BookmarkNode* parent = ParentFor(record.parent, nodes);
+      if (!parent) {
+        later.push_back(id);
+        continue;
+      }
+      const auto it = nodes.find(id);
+      if (it == nodes.end()) {
+        const std::u16string title = base::UTF8ToUTF16(record.title);
+        const BookmarkNode::MetaInfoMap meta = {{kFileName, id}};
+        const base::Time added = TimeOfMs(record.added);
+        const BookmarkNode* made = nullptr;
+        if (record.url) {
+          const GURL url(*record.url);
+          if (url.is_valid()) {
+            made = model_->AddURL(parent, parent->children().size(), title, url, &meta, added);
+          }
+        } else {
+          made = model_->AddFolder(parent, parent->children().size(), title, &meta, added);
+        }
+        if (made) {
+          nodes.emplace(id, made);
+        }
+        continue;
+      }
+      const BookmarkNode* node = it->second;
+      const std::u16string title = base::UTF8ToUTF16(record.title);
+      if (node->GetTitle() != title) {
+        model_->SetTitle(node, title, source);
+      }
+      if (record.url && node->is_url() && GURL(*record.url) != node->url() &&
+          GURL(*record.url).is_valid()) {
+        model_->SetURL(node, GURL(*record.url), source);
+      }
+      if (node->parent() != parent && !parent->HasAncestor(node)) {
+        model_->Move(node, parent, parent->children().size());
+      }
+    }
+    if (later.size() == waiting.size()) {
+      for (const std::string& id : later) {
+        records.at(id).parent = std::string();
+      }
+    }
+    waiting = std::move(later);
+  }
+
+  // Those still without a file: named, and written.
+  std::vector<const BookmarkNode*> own;
+  CollectNodes(&own);
+  std::vector<std::pair<std::string, Record>> written;
+  for (const BookmarkNode* node : own) {
+    const std::string id = NewId();
+    model_->SetNodeMetaInfo(node, kFileName, id);
+    written.emplace_back(id, Record());
+  }
+
+  // Each folder's order.
+  std::vector<const BookmarkNode*> folders = {model_->bookmark_bar_node(), model_->other_node()};
+  for (const auto& [id, node] : CollectNodes(nullptr)) {
+    if (node->is_folder()) {
+      folders.push_back(node);
+    }
+  }
+  for (const BookmarkNode* folder : folders) {
+    std::vector<const BookmarkNode*> ordered;
+    for (const auto& child : folder->children()) {
+      ordered.push_back(child.get());
+    }
+    const auto key = [this, &records](const BookmarkNode* node) {
+      const std::string id = IdOf(node);
+      const auto it = records.find(id);
+      // One not in the files yet goes at the end, where it was.
+      return std::tuple(it == records.end(), it == records.end() ? std::string() : it->second.order,
+                        id);
+    };
+    if (!std::ranges::is_sorted(ordered, {}, key)) {
+      std::ranges::stable_sort(ordered, {}, key);
+      model_->ReorderChildren(folder, ordered);
+    }
+  }
+
+  records_ = std::move(records);
+
+  for (const auto& [id, record] : written) {
+    const std::map<std::string, const BookmarkNode*> current = CollectNodes(nullptr);
+    const auto it = current.find(id);
+    if (it != current.end()) {
+      WriteNode(it->second);
+    }
+  }
+
+  // Chromium's "Other bookmarks", as the folder it is on every other machine.
+  if (!model_->other_node()->children().empty() && !records_.contains(kOtherId)) {
+    Record other;
+    other.title = base::UTF16ToUTF8(model_->other_node()->GetTitle());
+    other.order = "zz";
+    other.added = static_cast<double>(NowMs());
+    Write(kOtherId, other);
+  }
+}
+
+std::string BookmarkSync::OrderAt(const BookmarkNode* parent, size_t index) const {
+  const auto order_of = [this, parent](size_t at) -> std::optional<std::string> {
+    const auto it = records_.find(IdOf(parent->children()[at].get()));
+    return it == records_.end() ? std::nullopt : std::optional(it->second.order);
+  };
+  const std::optional<std::string> before =
+      index > 0 ? order_of(index - 1) : std::nullopt;
+  const std::optional<std::string> after =
+      index + 1 < parent->children().size() ? order_of(index + 1) : std::nullopt;
+  // Two that ended up with one key (two machines) have nothing between them; the next one then
+  // goes after both.
+  if (before && after && *before >= *after) {
+    return KeyBetween(*before, std::nullopt);
+  }
+  return KeyBetween(before.value_or(std::string()),
+                    after ? std::optional<std::string_view>(*after) : std::nullopt);
+}
+
+void BookmarkSync::WriteNode(const BookmarkNode* node) {
+  const std::string id = IdOf(node);
+  if (id.empty() || id == kOtherId) {
+    return;
+  }
+  const BookmarkNode* parent = node->parent();
+  Record record;
+  const auto old = records_.find(id);
+  if (old != records_.end()) {
+    record = old->second;
+  } else {
+    record.added = MsOfTime(node->date_added());
+  }
+  const std::string parent_id = IdOf(parent);
+  const size_t index = static_cast<size_t>(parent->GetIndexOf(node).value_or(0));
+  // Where it is now, in a key of its own, only if that is not where the files have it.
+  bool in_place = old != records_.end() && old->second.parent == parent_id;
+  if (in_place) {
+    const auto order_of = [this, parent](size_t at) -> std::string {
+      const auto it = records_.find(IdOf(parent->children()[at].get()));
+      return it == records_.end() ? std::string() : it->second.order;
+    };
+    in_place = (index == 0 || order_of(index - 1) <= record.order) &&
+               (index + 1 >= parent->children().size() || record.order <= order_of(index + 1) ||
+                order_of(index + 1).empty());
+  }
+  if (!in_place) {
+    record.order = OrderAt(parent, index);
+  }
+  record.parent = parent_id;
+  record.title = base::UTF16ToUTF8(node->GetTitle());
+  if (node->is_url()) {
+    record.url = node->url().spec();
+  } else {
+    record.url = std::nullopt;
+  }
+  Write(id, record);
+}
+
+void BookmarkSync::Write(const std::string& id, const Record& record) {
+  ++changes_;
+  records_[id] = record;
+  files_->PostTask(FROM_HERE,
+                   base::BindOnce(&WriteRecord, dir_.Append(id + ".json"), record));
+}
+
+void BookmarkSync::RemoveFile(const std::string& id) {
+  ++changes_;
+  records_.erase(id);
+  files_->PostTask(FROM_HERE, base::BindOnce(&RemovePath, dir_.Append(id + ".json")));
+}
+
+void BookmarkSync::BookmarkModelLoaded(bool ids_reassigned) {
+  Poll();
+}
+
+void BookmarkSync::BookmarkNodeMoved(const BookmarkNode* old_parent,
+                                     size_t old_index,
+                                     const BookmarkNode* new_parent,
+                                     size_t new_index) {
+  if (applying_ || !InTree(new_parent)) {
+    return;
+  }
+  const BookmarkNode* node = new_parent->children()[new_index].get();
+  // Moved within its folder, its neighbours are new ones, whatever its key was.
+  const std::string id = IdOf(node);
+  const auto old = records_.find(id);
+  if (old != records_.end()) {
+    Record record = old->second;
+    record.parent = IdOf(new_parent);
+    record.order = OrderAt(new_parent, new_index);
+    Write(id, record);
+  } else {
+    WriteNode(node);
+  }
+}
+
+void BookmarkSync::BookmarkNodeAdded(const BookmarkNode* parent, size_t index, bool added_by_user) {
+  if (applying_ || !InTree(parent)) {
+    return;
+  }
+  const BookmarkNode* node = parent->children()[index].get();
+  std::string id = IdOf(node);
+  // A copy of one carries its name, and an undone removal rightly has its own again.
+  if (id.empty() || records_.contains(id)) {
+    id = NewId();
+    base::AutoReset<bool> applying(&applying_, true);
+    model_->SetNodeMetaInfo(node, kFileName, id);
+  }
+  WriteNode(node);
+}
+
+void BookmarkSync::BookmarkNodeRemoved(const BookmarkNode* parent,
+                                       size_t old_index,
+                                       const BookmarkNode* node,
+                                       const std::set<GURL>& no_longer_bookmarked,
+                                       const base::Location& location) {
+  if (applying_ || !InTree(parent)) {
+    return;
+  }
+  std::vector<const BookmarkNode*> stack = {node};
+  while (!stack.empty()) {
+    const BookmarkNode* going = stack.back();
+    stack.pop_back();
+    const std::string id = IdOf(going);
+    if (!id.empty()) {
+      RemoveFile(id);
+    }
+    for (const auto& child : going->children()) {
+      stack.push_back(child.get());
+    }
+  }
+}
+
+void BookmarkSync::BookmarkNodeChanged(const BookmarkNode* node) {
+  if (applying_ || !InTree(node) || node->is_permanent_node()) {
+    return;
+  }
+  WriteNode(node);
+}
+
+void BookmarkSync::BookmarkNodeChildrenReordered(const BookmarkNode* node) {
+  if (applying_ || !InTree(node)) {
+    return;
+  }
+  std::string previous;
+  for (const auto& child : node->children()) {
+    const std::string id = IdOf(child.get());
+    const auto it = records_.find(id);
+    if (it == records_.end()) {
+      continue;
+    }
+    Record record = it->second;
+    record.order = KeyBetween(previous, std::nullopt);
+    previous = record.order;
+    Write(id, record);
+  }
+}
+
+void BookmarkSync::BookmarkAllUserNodesRemoved(const std::set<GURL>& removed_urls,
+                                               const base::Location& location) {
+  if (applying_) {
+    return;
+  }
+  std::vector<std::string> ids;
+  for (const auto& [id, record] : records_) {
+    ids.push_back(id);
+  }
+  for (const std::string& id : ids) {
+    RemoveFile(id);
+  }
+}
+
+}  // namespace spatiand
