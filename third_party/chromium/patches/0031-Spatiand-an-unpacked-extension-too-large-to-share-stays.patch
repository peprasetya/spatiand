+
+void ExtensionSync::Await(const std::string& extension_id,
+                          const std::string& signature,
+                          bool reload) {
+  Waiting& waiting = waiting_[extension_id];
+  if (waiting.signature != signature) {
+    waiting.signature = signature;
+    waiting.reload = reload;
+  }
+}
+
+void ExtensionSync::CheckWaiting() {
+  for (auto& [id, waiting] : waiting_) {
+    if (waiting.checking) {
+      continue;
+    }
+    const auto record = records_.find(id);
+    if (record == records_.end()) {
+      continue;
+    }
+    waiting.checking = true;
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(&CopyComplete, files_dir_.Append(id), waiting.signature,
+                       static_cast<int64_t>(record->second.FindDouble("bytes").value_or(-1)),
+                       record->second.FindInt("count").value_or(-1)),
+        base::BindOnce(&ExtensionSync::OnChecked, weak_factory_.GetWeakPtr(), id,
+                       waiting.signature));
+  }
+}
+
+void ExtensionSync::OnChecked(const std::string& extension_id,
+                              const std::string& signature,
+                              bool complete) {
+  const auto it = waiting_.find(extension_id);
+  if (it == waiting_.end()) {
+    return;
+  }
+  it->second.checking = false;
+  if (!complete) {
+    // What is loaded, if anything, is not this copy: loaded again once it is all here.
+    it->second.reload = true;
+    return;
+  }
+  const auto record = records_.find(extension_id);
+  if (it->second.signature != signature || record == records_.end()) {
+    return;
+  }
+  const bool reload = it->second.reload;
+  waiting_.erase(it);
+  loaded_[extension_id] = signature;
+  const Extension* installed = registry_->GetInstalledExtension(extension_id);
+  if (!installed) {
+    if (!installing_.contains(extension_id)) {
+      Install(extension_id, record->second);
+    }
+  } else if (reload && installed->path().DirName() == files_dir_) {
+    LOG(WARNING) << "SpatiMesh: the extension " << extension_id << " was changed on another "
+                 << "machine; loaded again";
+    base::AutoReset<bool> applying(&applying_, true);
+    extensions::ExtensionRegistrar::Get(profile_)->ReloadExtension(extension_id);
+  }
 }
 
