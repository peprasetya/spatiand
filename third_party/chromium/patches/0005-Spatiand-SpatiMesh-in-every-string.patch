From c4cdcef0d9d72aa1a7b394d883fd7370fc8fb988 Mon Sep 17 00:00:00 2001
From: Spatiand-build <claude@prasetya.id>
Date: Fri, 30 Oct 2026 11:08:47 +0700
Subject: [PATCH 5/6] Spatiand: SpatiMesh in every string

Cromite's grit renames Chrome, Chromium and Bromite at build time; the name is SpatiMesh, Cromite's
own strings included.
---
 tools/grit/grit/grd_reader.py | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/tools/grit/grit/grd_reader.py b/tools/grit/grit/grd_reader.py
index 46b1b31bc8..2dc23b4950 100755
--- a/tools/grit/grit/grd_reader.py
+++ b/tools/grit/grit/grd_reader.py
@@ -159,13 +159,16 @@ class GrdContentHandler(xml.sax.handler.ContentHandler):
     content = content.replace("chromebook", "zzzyyyyxxxx9")
     content = content.replace("chromeos", "zzzyyyyxxxxA")
 
-    content = content.replace("google chrome", "cromite")
-    content = content.replace("Chrome", "Cromite")
-    content = content.replace("Chromium", "Cromite")
-    content = content.replace("Bromite", "Cromite")
-    content = content.replace("chrome", "cromite")
-    content = content.replace("chromium", "cromite")
-    content = content.replace("bromite", "cromite")
+    # Spatiand: the browser is SpatiMesh, Cromite's own strings included. Lower case "cromite" is
+    # left alone: in Cromite's strings it is the filter lists' web address.
+    content = content.replace("google chrome", "spatimesh")
+    content = content.replace("Chrome", "SpatiMesh")
+    content = content.replace("Chromium", "SpatiMesh")
+    content = content.replace("Bromite", "SpatiMesh")
+    content = content.replace("Cromite", "SpatiMesh")
+    content = content.replace("chrome", "spatimesh")
+    content = content.replace("chromium", "spatimesh")
+    content = content.replace("bromite", "spatimesh")
 
     content = content.replace("zzzyyyyxxxx1", "Chromium")
     content = content.replace("zzzyyyyxxxx2", "Chrome")
-- 
2.53.0

