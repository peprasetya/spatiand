+
+void BluetoothAdapterSpatiand::StartScanWithFilter(
+    std::unique_ptr<BluetoothDiscoveryFilter> discovery_filter,
+    DiscoverySessionResultCallback callback) {
+  if (!powered_) {
+    std::move(callback).Run(
+        /*is_error=*/true,
+        UMABluetoothDiscoverySessionOutcome::ADAPTER_NOT_PRESENT);
+    return;
+  }
+  // Unfiltered: what a page asked for is picked out of what is seen here.
+  Send(base::DictValue().Set("op", "scan"));
+  discovering_ = true;
+  std::move(callback).Run(/*is_error=*/false,
+                          UMABluetoothDiscoverySessionOutcome::SUCCESS);
+}
