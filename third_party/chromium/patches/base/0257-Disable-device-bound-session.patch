From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: uazo <uazo@users.noreply.github.com>
Date: Mon, 19 Jan 2026 12:00:34 +0000
Subject: [PATCH 257/310] Disable device bound session

Disable DBSC due to potential privacy issues
see https://w3c.github.io/webappsec-dbsc/#privacy-considerations

License: GPL-2.0-or-later - https://spdx.org/licenses/GPL-2.0-or-later.html
FILE:Disable-device-bound-session.patch
---
 .../chrome_browser_main_extra_parts_metrics.cc        | 11 +++++++++--
 net/BUILD.gn                                          |  7 +++++++
 net/base/features.cc                                  |  4 ----
 net/features.gni                                      |  2 +-
 4 files changed, 17 insertions(+), 7 deletions(-)

diff --git a/chrome/browser/metrics/chrome_browser_main_extra_parts_metrics.cc b/chrome/browser/metrics/chrome_browser_main_extra_parts_metrics.cc
index 443ffadf69..fc97d71e89 100644
--- a/chrome/browser/metrics/chrome_browser_main_extra_parts_metrics.cc
+++ b/chrome/browser/metrics/chrome_browser_main_extra_parts_metrics.cc
@@ -135,6 +135,11 @@ BASE_FEATURE(kWindowsIsPinnedToTaskbar3, base::FEATURE_ENABLED_BY_DEFAULT);
 }  // namespace features
 #endif  // BUILDFLAG(IS_WIN)
 
+// Spatiand: on every platform, for the ENABLE_DEVICE_BOUND_SESSIONS guards
+// below (an undefined function-like macro in #if is an error even where the
+// platform part is false).
+#include "net/net_buildflags.h"
+
 namespace {
 
 // The number of restarts to wait until removing the enable-benchmarking flag.
@@ -1011,7 +1016,8 @@ bool IsBundleForMixedDeviceAccordingToVersionCode(
 }
 #endif  // BUILDFLAG(IS_ANDROID)
 
-#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
+#if (BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)) && \
+    BUILDFLAG(ENABLE_DEVICE_BOUND_SESSIONS)
 // The startup TPM benchmark performs synchronous hardware crypto operations
 // that are invariant for a given machine. Subsample heavily on Stable, while
 // leaving pre-Stable channels unsampled for faster regression detection.
@@ -1173,7 +1179,8 @@ void ChromeBrowserMainExtraPartsMetrics::PostBrowserStart() {
   }
 #endif  // BUILDFLAG(IS_WIN)
 
-#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
+#if (BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)) && \
+    BUILDFLAG(ENABLE_DEVICE_BOUND_SESSIONS)
   // Deliberately delayed and sampled to avoid contending with early crypto and
   // DBSC operations right after startup. The measurement runs slow TPM
   // operations, which must not block shutdown.
diff --git a/net/BUILD.gn b/net/BUILD.gn
index b6f72f8beb..31fa067e78 100644
--- a/net/BUILD.gn
+++ b/net/BUILD.gn
@@ -1342,6 +1342,13 @@ component("net") {
     ]
   }
 
+  if (!enable_device_bound_sessions) {
+    sources += [
+      "device_bound_sessions/session_error.cc",
+      "device_bound_sessions/session_error.h",
+    ]
+  }
+
   if (enable_device_bound_sessions) {
     sources += [
       "device_bound_sessions/cookie_access_check_params.h",
diff --git a/net/base/features.cc b/net/base/features.cc
index d1cbab1122..e797553eca 100644
--- a/net/base/features.cc
+++ b/net/base/features.cc
@@ -456,11 +456,7 @@ BASE_FEATURE(kUseNetworkPathMonitorForNetworkChangeNotifier,
 );
 #endif  // BUILDFLAG(IS_APPLE)
 
-#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
-BASE_FEATURE(kDeviceBoundSessions, base::FEATURE_ENABLED_BY_DEFAULT);
-#else
 BASE_FEATURE(kDeviceBoundSessions, base::FEATURE_DISABLED_BY_DEFAULT);
-#endif
 BASE_FEATURE(kDeviceBoundSessionsBypassDeferralsForRefreshRequests,
              base::FEATURE_ENABLED_BY_DEFAULT);
 BASE_FEATURE(kDeviceBoundSessionsRetryTransientRefreshErrors,
diff --git a/net/features.gni b/net/features.gni
index 87e4307828..3d1b273e75 100644
--- a/net/features.gni
+++ b/net/features.gni
@@ -73,7 +73,7 @@ declare_args() {
   chrome_root_store_only = is_win || is_mac || is_linux || is_chromeos
 
   # DBSC is only supported on Windows, Linux and Mac for now.
-  enable_device_bound_sessions = is_win || is_linux || is_mac
+  enable_device_bound_sessions = false
 
   # Bracketed URIs parsing is only available for debug builds.
   # TODO(crbug.com/365771838): Ensure tests are updated if needed if this
