+BluetoothRemoteGattDescriptorSpatiand* BluetoothAdapterSpatiand::DescriptorOf(
+    const std::string& id) const {
+  BluetoothDeviceSpatiand* device = DeviceAt(id.substr(0, id.find('/')));
+  return device ? device->DescriptorOf(id) : nullptr;
+}
