diff --git a/content/browser/media/spatiand_window_audio.cc b/content/browser/media/spatiand_window_audio.cc
new file mode 100644
index 0000000000..9abb7e851c
--- /dev/null
+++ b/content/browser/media/spatiand_window_audio.cc
@@ -0,0 +1,170 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/media/spatiand_window_audio.h"
+
+#include <unistd.h>
+
+#include <map>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/environment.h"
+#include "base/files/file_path.h"
+#include "base/files/file_path_watcher.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_split.h"
+#include "base/strings/stringprintf.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "content/browser/renderer_host/media/media_stream_manager.h"
+#include "content/browser/renderer_host/media/preferred_audio_output_device_manager.h"
+#include "content/browser/web_contents/web_contents_impl.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/global_routing_id.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_tree_host.h"
+
+namespace content {
+
+namespace {
+
+// Nothing here runs on a timer. A tab's sound is routed when something changes it: the room's
+// map of sinks changing (a window appearing, going, or given another sink), a page beginning a
+// sound with no output chosen for it (a new page, or one whose output Chromium forgot at a
+// navigation of its main frame, YouTube opening its next video among them), and a tab moving
+// into another window. With nothing playing and nothing changing, it costs nothing.
+
+using SinkMap = std::map<std::string, std::string>;
+
+// The map as last read. On the UI thread.
+SinkMap& Sinks() {
+  static base::NoDestructor<SinkMap> sinks;
+  return *sinks;
+}
+
+// `$XDG_RUNTIME_DIR/spatiand-sinks`, where the room writes its map; empty when there is no room.
+base::FilePath SinkMapPath() {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> dir = env->GetVar("XDG_RUNTIME_DIR");
+  return dir ? base::FilePath(*dir).Append("spatiand-sinks") : base::FilePath();
+}
+
+// The room's sinks by window key (`key<TAB>sink` lines). May block.
+SinkMap ReadSinkMap(const base::FilePath& path) {
+  SinkMap sinks;
+  std::string text;
+  if (!base::ReadFileToString(path, &text)) {
+    return sinks;
+  }
+  for (std::string_view line :
+       base::SplitStringPiece(text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    std::vector<std::string_view> parts =
+        base::SplitStringPiece(line, "\t", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    if (parts.size() == 2) {
+      sinks.emplace(std::string(parts[0]), std::string(parts[1]));
+    }
+  }
+  return sinks;
+}
+
+// Sets the page's preferred output where Chromium does not already hold it: what Chromium holds
+// is asked each time rather than remembered here, because Chromium forgets a page's preferred
+// output at each navigation of its main frame while the frame stays the same.
+void SetPreferredSinkOnIO(GlobalRenderFrameHostToken frame, std::string sink) {
+  auto* manager = MediaStreamManager::GetPreferredOutputManagerInstance();
+  if (!manager || manager->GetPreferredSinkId(frame) == sink) {
+    return;
+  }
+  manager->SetPreferredSinkId(frame, sink, base::DoNothing());
+}
+
+// One tab to the sink of the window it is in: its window's key is this process and the window's
+// surface, as the room keys the sink it gives every SpatiMesh window. Empty is the default (the
+// sink SpatiMesh was launched with).
+void RouteContents(WebContents* contents) {
+  if (!contents || !contents->GetPrimaryMainFrame()) {
+    return;
+  }
+  std::string sink;
+  gfx::NativeWindow window = contents->GetTopLevelNativeWindow();
+  if (window && window->GetHost()) {
+    if (const uint32_t surface = window->GetHost()->GetSpatiandSurfaceId()) {
+      const auto it = Sinks().find(base::StringPrintf("wl:%d:%u", getpid(), surface));
+      if (it != Sinks().end()) {
+        sink = it->second;
+      }
+    }
+  }
+  const GlobalRenderFrameHostToken frame = contents->GetPrimaryMainFrame()->GetGlobalFrameToken();
+  // Streams already playing switch to it as they play.
+  GetIOThreadTaskRunner({})->PostTask(FROM_HERE,
+                                      base::BindOnce(&SetPreferredSinkOnIO, frame, sink));
+}
+
+// The room's map changed: every tab, against the new one.
+void RouteAll(SinkMap sinks) {
+  Sinks() = std::move(sinks);
+  for (WebContentsImpl* contents : WebContentsImpl::GetAllWebContents()) {
+    RouteContents(contents);
+  }
+}
+
+// On the watcher's sequence, which may block.
+void OnSinkMapChanged(const base::FilePath& path, bool error) {
+  if (error) {
+    return;
+  }
+  GetUIThreadTaskRunner({})->PostTask(FROM_HERE, base::BindOnce(&RouteAll, ReadSinkMap(path)));
+}
+
+// On the watcher's sequence: watch the map for good, and read it once now. The room replaces the
+// file by renaming a new one over it, which a watch of the path sees.
+void Watch(const base::FilePath& path) {
+  static base::NoDestructor<base::FilePathWatcher> watcher;
+  if (!watcher->Watch(path, base::FilePathWatcher::Type::kNonRecursive,
+                      base::BindRepeating(&OnSinkMapChanged))) {
+    LOG(WARNING) << "Spatiand: cannot watch " << path << "; tabs keep the sinks they have";
+  }
+  OnSinkMapChanged(path, false);
+}
+
+}  // namespace
+
+// static
+void SpatiandWindowAudio::Start() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  const base::FilePath path = SinkMapPath();
+  if (path.empty()) {
+    return;
+  }
+  static base::NoDestructor<scoped_refptr<base::SequencedTaskRunner>> runner(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE}));
+  (*runner)->PostTask(FROM_HERE, base::BindOnce(&Watch, path));
+}
+
+// static
+void SpatiandWindowAudio::SoundBegins(GlobalRenderFrameHostToken main_frame) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (RenderFrameHost* frame = RenderFrameHost::FromFrameToken(main_frame)) {
+    RouteContents(WebContents::FromRenderFrameHost(frame));
+  }
+}
+
+// static
+void SpatiandWindowAudio::MovedWindow(WebContents* contents) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  RouteContents(contents);
+}
+
+}  // namespace content
