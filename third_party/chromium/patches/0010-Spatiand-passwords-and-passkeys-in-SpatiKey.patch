diff --git a/device/fido/spatikey/spatikey_authenticator.cc b/device/fido/spatikey/spatikey_authenticator.cc
new file mode 100644
index 0000000000..ec5d57c7c2
--- /dev/null
+++ b/device/fido/spatikey/spatikey_authenticator.cc
@@ -0,0 +1,275 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "device/fido/spatikey/spatikey_authenticator.h"
+
+#include <utility>
+
+#include "base/base64url.h"
+#include "base/containers/flat_set.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/values.h"
+#include "components/cbor/reader.h"
+#include "components/cbor/values.h"
+#include "components/device_event_log/device_event_log.h"
+#include "components/spatikey/client.h"
+#include "device/fido/attestation_object.h"
+#include "device/fido/authenticator_data.h"
+#include "device/fido/authenticator_get_assertion_response.h"
+#include "device/fido/authenticator_make_credential_response.h"
+#include "device/fido/authenticator_supported_options.h"
+#include "device/fido/ctap_get_assertion_request.h"
+#include "device/fido/ctap_make_credential_request.h"
+#include "device/fido/discoverable_credential_metadata.h"
+#include "device/fido/fido_request_handler_base.h"
+#include "device/fido/public/fido_transport_protocol.h"
+#include "device/fido/public/public_key_credential_descriptor.h"
+#include "device/fido/public/public_key_credential_user_entity.h"
+
+namespace device {
+
+namespace {
+
+// The id of the passkey that stands for all of them: no id the service makes is this short.
+const std::vector<uint8_t>& AnyPasskeyId() {
+  static const base::NoDestructor<std::vector<uint8_t>> id({'s', 'k'});
+  return *id;
+}
+
+std::string Encode(base::span<const uint8_t> bytes) {
+  std::string text;
+  base::Base64UrlEncode(bytes, base::Base64UrlEncodePolicy::OMIT_PADDING, &text);
+  return text;
+}
+
+std::optional<std::vector<uint8_t>> DecodeField(const base::DictValue& dict, std::string_view name) {
+  const std::string* text = dict.FindString(name);
+  if (!text) {
+    return std::nullopt;
+  }
+  return base::Base64UrlDecode(*text, base::Base64UrlDecodePolicy::IGNORE_PADDING);
+}
+
+// Where the request came from, as the browser wrote it: never as the page claimed.
+std::string OriginOf(const std::string& client_data_json) {
+  std::optional<base::DictValue> client_data = base::JSONReader::ReadDict(client_data_json, base::JSON_PARSE_RFC);
+  const std::string* origin = client_data ? client_data->FindString("origin") : nullptr;
+  return origin ? *origin : std::string();
+}
+
+void TellProblem(const spatikey::Refusal& refusal) {
+  // Saying no, or not answering, needs no explaining to whoever did it.
+  if (refusal.code != "denied" && refusal.code != "timeout") {
+    spatikey::ReportProblem(base::UTF8ToUTF16(refusal.message));
+  }
+}
+
+void OnCreated(FidoAuthenticator::MakeCredentialCallback callback, spatikey::Answer answer) {
+  if (!answer.has_value()) {
+    if (answer.error().code == "excluded") {
+      std::move(callback).Run(MakeCredentialStatus::kUserConsentButCredentialExcluded,
+                              std::nullopt);
+      return;
+    }
+    TellProblem(answer.error());
+    std::move(callback).Run(MakeCredentialStatus::kUserConsentDenied, std::nullopt);
+    return;
+  }
+  std::optional<std::vector<uint8_t>> bytes = DecodeField(*answer, "attestation_object");
+  std::optional<cbor::Value> value = bytes ? cbor::Reader::Read(*bytes) : std::nullopt;
+  std::optional<AttestationObject> attestation =
+      value ? AttestationObject::Parse(*value) : std::nullopt;
+  if (!attestation) {
+    FIDO_LOG(ERROR) << "SpatiKey's attestation object cannot be read";
+    std::move(callback).Run(MakeCredentialStatus::kAuthenticatorResponseInvalid, std::nullopt);
+    return;
+  }
+  AuthenticatorMakeCredentialResponse response(FidoTransportProtocol::kInternal,
+                                               std::move(*attestation));
+  response.is_resident_key = true;
+  base::flat_set<FidoTransportProtocol> transports = {FidoTransportProtocol::kInternal};
+  if (const base::ListValue* named = answer->FindList("transports")) {
+    for (const base::Value& transport : *named) {
+      if (transport.is_string()) {
+        if (std::optional<FidoTransportProtocol> known =
+                ConvertToFidoTransportProtocol(transport.GetString())) {
+          transports.insert(*known);
+        }
+      }
+    }
+  }
+  response.transports = std::move(transports);
+  std::move(callback).Run(MakeCredentialStatus::kSuccess, std::move(response));
+}
+
+void OnAsserted(FidoAuthenticator::GetAssertionCallback callback, spatikey::Answer answer) {
+  if (!answer.has_value()) {
+    if (answer.error().code == "no_match") {
+      std::move(callback).Run(GetAssertionStatus::kICloudKeychainNoCredentials, {});
+      return;
+    }
+    TellProblem(answer.error());
+    std::move(callback).Run(GetAssertionStatus::kUserConsentDenied, {});
+    return;
+  }
+  std::vector<AuthenticatorGetAssertionResponse> responses;
+  if (const base::ListValue* choices = answer->FindList("choices")) {
+    for (const base::Value& choice_value : *choices) {
+      if (!choice_value.is_dict()) {
+        continue;
+      }
+      const base::DictValue& choice = choice_value.GetDict();
+      std::optional<std::vector<uint8_t>> id = DecodeField(choice, "credential_id");
+      std::optional<std::vector<uint8_t>> data = DecodeField(choice, "authenticator_data");
+      std::optional<std::vector<uint8_t>> signature = DecodeField(choice, "signature");
+      std::optional<std::vector<uint8_t>> user_handle = DecodeField(choice, "user_handle");
+      std::optional<AuthenticatorData> authenticator_data =
+          data ? AuthenticatorData::DecodeAuthenticatorData(*data) : std::nullopt;
+      if (!id || !signature || !user_handle || !authenticator_data) {
+        FIDO_LOG(ERROR) << "SpatiKey's assertion cannot be read";
+        continue;
+      }
+      AuthenticatorGetAssertionResponse response(std::move(*authenticator_data),
+                                                 std::move(*signature),
+                                                 FidoTransportProtocol::kInternal);
+      response.credential =
+          PublicKeyCredentialDescriptor(CredentialType::kPublicKey, std::move(*id));
+      const std::string* name = choice.FindString("user_name");
+      const std::string* display = choice.FindString("user_display");
+      response.user_entity = PublicKeyCredentialUserEntity(
+          std::move(*user_handle), name ? std::optional<std::string>(*name) : std::nullopt,
+          display ? std::optional<std::string>(*display) : std::nullopt);
+      responses.push_back(std::move(response));
+    }
+  }
+  if (responses.empty()) {
+    std::move(callback).Run(GetAssertionStatus::kAuthenticatorResponseInvalid, {});
+    return;
+  }
+  std::move(callback).Run(GetAssertionStatus::kSuccess, std::move(responses));
+}
+
+}  // namespace
+
+SpatikeyAuthenticator::SpatikeyAuthenticator() = default;
+SpatikeyAuthenticator::~SpatikeyAuthenticator() = default;
+
+void SpatikeyAuthenticator::InitializeAuthenticator(base::OnceClosure callback) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, std::move(callback));
+}
+
+void SpatikeyAuthenticator::MakeCredential(CtapMakeCredentialRequest request,
+                                           MakeCredentialOptions options,
+                                           MakeCredentialCallback callback) {
+  base::DictValue fields;
+  fields.Set("origin", OriginOf(request.client_data_json));
+  fields.Set("rp_id", request.rp.id);
+  fields.Set("rp_name", request.rp.name.value_or(std::string()));
+  fields.Set("user_id", Encode(request.user.id));
+  fields.Set("user_name", request.user.name.value_or(std::string()));
+  fields.Set("user_display", request.user.display_name.value_or(std::string()));
+  fields.Set("client_data_hash", Encode(request.client_data_hash));
+  base::ListValue exclude;
+  for (const PublicKeyCredentialDescriptor& credential : request.exclude_list) {
+    exclude.Append(Encode(credential.id));
+  }
+  fields.Set("exclude", std::move(exclude));
+  base::ListValue algs;
+  for (const auto& param : request.public_key_credential_params.public_key_credential_params()) {
+    algs.Append(param.algorithm);
+  }
+  fields.Set("algs", std::move(algs));
+  spatikey::Ask("passkey_create", std::move(fields),
+                base::BindOnce(
+                    [](base::WeakPtr<SpatikeyAuthenticator> self, MakeCredentialCallback callback,
+                       spatikey::Answer answer) {
+                      if (self) {
+                        OnCreated(std::move(callback), std::move(answer));
+                      }
+                    },
+                    request_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void SpatikeyAuthenticator::GetAssertion(CtapGetAssertionRequest request,
+                                         CtapGetAssertionOptions options,
+                                         GetAssertionCallback callback) {
+  base::DictValue fields;
+  fields.Set("origin", OriginOf(request.client_data_json));
+  fields.Set("rp_id", request.rp_id);
+  fields.Set("client_data_hash", Encode(request.client_data_hash));
+  base::ListValue allow;
+  for (const PublicKeyCredentialDescriptor& credential : request.allow_list) {
+    // The one standing for all of them, chosen: the site named none.
+    if (credential.id != AnyPasskeyId()) {
+      allow.Append(Encode(credential.id));
+    }
+  }
+  fields.Set("allow", std::move(allow));
+  spatikey::Ask("passkey_get", std::move(fields),
+                base::BindOnce(
+                    [](base::WeakPtr<SpatikeyAuthenticator> self, GetAssertionCallback callback,
+                       spatikey::Answer answer) {
+                      if (self) {
+                        OnAsserted(std::move(callback), std::move(answer));
+                      }
+                    },
+                    request_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void SpatikeyAuthenticator::GetPlatformCredentialInfoForRequest(
+    const CtapGetAssertionRequest& request,
+    const CtapGetAssertionOptions& options,
+    GetPlatformCredentialInfoForRequestCallback callback) {
+  // Whether the vault has one is known only after a touch, and asking is what that touch is for:
+  // so it may have. A site with its own list is asked about as it is: Chromium would narrow the
+  // request to whatever is listed here, and lose the site's.
+  std::vector<DiscoverableCredentialMetadata> credentials;
+  if (request.allow_list.empty()) {
+    credentials.emplace_back(AuthenticatorType::kOther, request.rp_id, AnyPasskeyId(),
+                             PublicKeyCredentialUserEntity(AnyPasskeyId(), "SpatiKey", "SpatiKey"),
+                             /*provider_name=*/"SpatiKey");
+  }
+  std::move(callback).Run(std::move(credentials),
+                          FidoRequestHandlerBase::RecognizedCredential::kHasRecognizedCredential);
+}
+
+void SpatikeyAuthenticator::GetTouch(base::OnceClosure callback) {
+  // The service asks for its own touch.
+  std::move(callback).Run();
+}
+
+void SpatikeyAuthenticator::Cancel() {
+  request_factory_.InvalidateWeakPtrs();
+}
+
+std::string SpatikeyAuthenticator::GetId() const {
+  return "SpatikeyAuthenticator";
+}
+
+const AuthenticatorSupportedOptions& SpatikeyAuthenticator::Options() const {
+  static const base::NoDestructor<AuthenticatorSupportedOptions> options([] {
+    AuthenticatorSupportedOptions supported;
+    supported.is_platform_device = AuthenticatorSupportedOptions::PlatformDevice::kYes;
+    supported.supports_resident_key = true;
+    supported.user_verification_availability =
+        AuthenticatorSupportedOptions::UserVerificationAvailability::kSupportedAndConfigured;
+    supported.supports_user_presence = true;
+    return supported;
+  }());
+  return *options;
+}
+
+std::optional<FidoTransportProtocol> SpatikeyAuthenticator::AuthenticatorTransport() const {
+  return FidoTransportProtocol::kInternal;
+}
+
+base::WeakPtr<FidoAuthenticator> SpatikeyAuthenticator::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+}  // namespace device
