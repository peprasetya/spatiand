From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Spatiand build <claude@prasetya.id>
Date: Fri, 30 Oct 2026 21:46:23 +0700
Subject: [PATCH 291/310] Spatiand: a fling from the scroll, not from the
 pointer moving between

The time of a scroll frame was measured from the last pointer frame of any kind, so a pointer moving between the frames of a scroll made them look a moment apart, and the end of a gesture look recent however late it came: a fling at a speed worked out from those, thrown long after the finger had stopped. Spatiand moves the pointer under a right thumb resting on its pad as the left one scrolls.
---
 ui/ozone/platform/wayland/host/wayland_event_source.cc | 6 ++++--
 ui/ozone/platform/wayland/host/wayland_event_source.h  | 2 +-
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/ui/ozone/platform/wayland/host/wayland_event_source.cc b/ui/ozone/platform/wayland/host/wayland_event_source.cc
index 5a3773742a..bf83e3b561 100644
--- a/ui/ozone/platform/wayland/host/wayland_event_source.cc
+++ b/ui/ozone/platform/wayland/host/wayland_event_source.cc
@@ -560,12 +560,14 @@ void WaylandEventSource::OnPointerFrameEvent() {
   }
 
   if (pointer_scroll_data_) {
+    // From the last frame with a scroll in it: a frame of the pointer moving between two of a
+    // scroll's would make them look a moment apart, and a fling worked out from those goes
+    // anywhere, however long after the finger has stopped. Spatiand's right thumb does that.
     pointer_scroll_data_->dt = now - last_pointer_frame_time_;
+    last_pointer_frame_time_ = now;
     ProcessPointerScrollData();
   }
 
-  last_pointer_frame_time_ = now;
-
   auto* target_window = window_manager_->GetCurrentPointerFocusedWindow();
   if (!target_window) {
     return;
diff --git a/ui/ozone/platform/wayland/host/wayland_event_source.h b/ui/ozone/platform/wayland/host/wayland_event_source.h
index 04fce49654..40a052a63e 100644
--- a/ui/ozone/platform/wayland/host/wayland_event_source.h
+++ b/ui/ozone/platform/wayland/host/wayland_event_source.h
@@ -282,7 +282,7 @@ class WaylandEventSource : public PlatformEventSource,
   // Front is newer, and back is older.
   std::deque<PointerScrollData> pointer_scroll_data_set_;
 
-  // Time of the last pointer frame event.
+  // Time of the last pointer frame event with a scroll in it.
   base::TimeTicks last_pointer_frame_time_;
 
   // Order set of touch events to be dispatching on the next
