   if (!save_timer_.IsRunning()) {
     save_timer_.Start(FROM_HERE, kSaveAfter, base::BindOnce(
@@ -383,8 +536,28 @@ void HistorySync::OnURLVisited(history::HistoryService* history_service,
   visit.title = row.title();
   visit.at = MsOfTime(visited_url_info.visit_row.visit_time);
   last_ = visit;
-  unsaved_.push_back(std::move(visit));
-  SaveSoon();
+  // The page the link was followed on goes with it, for the other machines to colour it by.
+  const history::VisitedLinkID link = visited_url_info.visit_row.visited_link_id;
+  if (link == history::kInvalidVisitedLinkID) {
+    Record(std::move(visit));
+    return;
+  }
+  history_->ScheduleDBTask(
+      FROM_HERE,
+      std::make_unique<FindPage>(
+          link, base::BindOnce(
+                    [](base::WeakPtr<HistorySync> self, Visit visit, GURL top, GURL frame) {
+                      if (!self) {
+                        return;
+                      }
+                      if (top.is_valid() && frame.is_valid()) {
+                        visit.top = top.spec();
+                        visit.frame = frame.spec();
+                      }
+                      self->Record(std::move(visit));
+                    },
+                    weak_factory_.GetWeakPtr(), std::move(visit))),
+      &tracker_);
 }
 
