@@ -0,0 +1,352 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/spatiand/settings_sync.h"
+
+#include <array>
+#include <memory>
+#include <string_view>
+#include <utility>
+
+#include "base/auto_reset.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/prefs/session_startup_pref.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "chrome/browser/spatiand/profiles_sync.h"
+#include "chrome/browser/spatiand/shared_folder.h"
+#include "chrome/browser/themes/theme_service_factory.h"
+#include "chrome/browser/ui/zoom/chrome_zoom_level_prefs.h"
+#include "chrome/common/pref_names.h"
+#include "components/bookmarks/common/bookmark_pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_data.h"
+#include "third_party/blink/public/common/page/page_zoom.h"
+#include "ui/color/color_provider_key.h"
+#include "url/gurl.h"
+
+namespace spatiand {
+
+namespace {
+
+// The search engines SpatiMesh's other builds know by name.
+struct Engine {
+  const char* name;
+  const char* host;
+  const char* url;
+};
+constexpr std::array<Engine, 7> kEngines = {{
+    {"DuckDuckGo", "duckduckgo.com", "https://duckduckgo.com/?q={searchTerms}"},
+    {"Google", "www.google.com", "https://www.google.com/search?q={searchTerms}"},
+    {"Bing", "www.bing.com", "https://www.bing.com/search?q={searchTerms}"},
+    {"Startpage", "www.startpage.com", "https://www.startpage.com/do/search?q={searchTerms}"},
+    {"Brave Search", "search.brave.com", "https://search.brave.com/search?q={searchTerms}"},
+    {"Ecosia", "www.ecosia.org", "https://www.ecosia.org/search?q={searchTerms}"},
+    {"Kagi", "kagi.com", "https://kagi.com/search?q={searchTerms}"},
+}};
+
+SettingsSync::Files ReadFiles(const std::string& id) {
+  SettingsSync::Files files;
+  const base::FilePath shared = SharedDir().Append("settings");
+  for (const char* name : {"search", "custom_search", "zoom", "restore", "bookmarks_bar",
+                           "developer"}) {
+    if (std::optional<base::Value> value = ReadJson(shared.Append(std::string(name) + ".json"))) {
+      files.emplace(name, std::move(*value));
+    }
+  }
+  const base::FilePath own = SharedProfileDir(id).Append("settings");
+  for (const char* name : {"search", "custom_search"}) {
+    if (std::optional<base::Value> value = ReadJson(own.Append(std::string(name) + ".json"))) {
+      files.emplace(std::string("profile/") + name, std::move(*value));
+    }
+  }
+  return files;
+}
+
+void WriteFile(const base::FilePath& file, base::Value value) {
+  WriteJson(file, value);
+}
+
+// Where an engine searches: Chromium's own are written with {google:baseURL}, not as an address.
+GURL AddressOf(const TemplateURLService* service, const TemplateURL* engine) {
+  return engine->GenerateSearchURL(service->search_terms_data());
+}
+
+// The engine at this address; of several at one host, the one of this name.
+TemplateURL* FindEngine(TemplateURLService* service,
+                        std::string_view name,
+                        std::string_view host,
+                        std::string_view url) {
+  TemplateURL* same_host = nullptr;
+  for (TemplateURL* engine : service->GetTemplateURLs()) {
+    if (engine->url().empty()) {
+      continue;
+    }
+    if (engine->url() == url) {
+      return engine;
+    }
+    if (!host.empty() && AddressOf(service, engine).host() == host) {
+      if (base::UTF16ToUTF8(engine->short_name()) == name) {
+        return engine;
+      }
+      same_host = same_host ? same_host : engine;
+    }
+  }
+  return same_host;
+}
+
+}  // namespace
+
+SettingsSync::SettingsSync(Profile* profile,
+                           const std::string& id,
+                           scoped_refptr<base::SequencedTaskRunner> files)
+    : profile_(profile), id_(id), files_(std::move(files)) {
+  prefs_.Init(profile_->GetPrefs());
+  prefs_.Add(bookmarks::prefs::kShowBookmarkBar,
+             base::BindRepeating(&SettingsSync::LocalBool, base::Unretained(this), "bookmarks_bar",
+                                 bookmarks::prefs::kShowBookmarkBar));
+  prefs_.Add(prefs::kExtensionsUIDeveloperMode,
+             base::BindRepeating(&SettingsSync::LocalBool, base::Unretained(this), "developer",
+                                 prefs::kExtensionsUIDeveloperMode));
+  prefs_.Add(prefs::kRestoreOnStartup,
+             base::BindRepeating(&SettingsSync::LocalRestore, base::Unretained(this)));
+  if (ChromeZoomLevelPrefs* zoom = profile_->GetZoomLevelPrefs()) {
+    zoom_subscription_ = zoom->RegisterDefaultZoomLevelCallback(
+        base::BindRepeating(&SettingsSync::LocalZoom, base::Unretained(this)));
+  }
+  if (TemplateURLService* search = TemplateURLServiceFactory::GetForProfile(profile_)) {
+    search_observation_.Observe(search);
+    search->Load();
+  }
+  if (ThemeService* theme = ThemeServiceFactory::GetForProfile(profile_)) {
+    theme_observation_.Observe(theme);
+  }
+  Poll();
+}
+
+SettingsSync::~SettingsSync() = default;
+
+void SettingsSync::Poll() {
+  if (reading_) {
+    return;
+  }
+  reading_ = true;
+  files_->PostTaskAndReplyWithResult(FROM_HERE, base::BindOnce(&ReadFiles, id_),
+                                     base::BindOnce(&SettingsSync::OnRead,
+                                                    weak_factory_.GetWeakPtr()));
+}
+
+void SettingsSync::OnRead(Files files) {
+  reading_ = false;
+  base::AutoReset<bool> applying(&applying_, true);
+  PrefService* prefs = profile_->GetPrefs();
+  const auto changed = [this, &files](const std::string& name) -> const base::Value* {
+    const auto it = files.find(name);
+    if (it == files.end()) {
+      return nullptr;
+    }
+    const auto seen = seen_.find(name);
+    return seen != seen_.end() && seen->second == it->second ? nullptr : &it->second;
+  };
+  if (const base::Value* value = changed("zoom"); value && value->is_double()) {
+    if (ChromeZoomLevelPrefs* zoom = profile_->GetZoomLevelPrefs()) {
+      zoom->SetDefaultZoomLevelPref(blink::ZoomFactorToZoomLevel(value->GetDouble()));
+    }
+  } else if (value && value->is_int()) {
+    if (ChromeZoomLevelPrefs* zoom = profile_->GetZoomLevelPrefs()) {
+      zoom->SetDefaultZoomLevelPref(blink::ZoomFactorToZoomLevel(value->GetInt()));
+    }
+  }
+  if (const base::Value* value = changed("restore"); value && value->is_bool()) {
+    SessionStartupPref startup = SessionStartupPref::GetStartupPref(prefs);
+    const SessionStartupPref::Type wanted =
+        value->GetBool() ? SessionStartupPref::LAST : SessionStartupPref::DEFAULT;
+    if (startup.type != wanted) {
+      startup.type = wanted;
+      SessionStartupPref::SetStartupPref(prefs, startup);
+    }
+  }
+  if (const base::Value* value = changed("bookmarks_bar"); value && value->is_bool()) {
+    prefs->SetBoolean(bookmarks::prefs::kShowBookmarkBar, value->GetBool());
+  }
+  if (const base::Value* value = changed("developer"); value && value->is_bool()) {
+    prefs->SetBoolean(prefs::kExtensionsUIDeveloperMode, value->GetBool());
+  }
+  const bool search_changed = changed("search") || changed("custom_search") ||
+                              changed("profile/search") || changed("profile/custom_search");
+  for (auto& [name, value] : files) {
+    seen_[name] = std::move(value);
+  }
+  read_once_ = true;
+  if (search_changed) {
+    ApplySearch();
+  }
+}
+
+void SettingsSync::ApplySearch() {
+  TemplateURLService* service = TemplateURLServiceFactory::GetForProfile(profile_);
+  if (!service || !service->loaded() || !read_once_) {
+    return;
+  }
+  search_applied_ = true;
+  base::AutoReset<bool> applying(&applying_, true);
+  // The profile's own, else what every profile has.
+  const auto text = [this](const std::string& name) -> std::string {
+    const auto it = seen_.find(name);
+    return it != seen_.end() && it->second.is_string() ? it->second.GetString() : std::string();
+  };
+  std::string name = text("profile/search");
+  std::string custom = text("profile/custom_search");
+  if (name.empty()) {
+    name = text("search");
+    custom = text("custom_search");
+  }
+  std::string address;
+  std::string host;
+  if (!custom.empty() && (name == "Custom" || name.empty()) && custom.find("{}") != std::string::npos) {
+    base::ReplaceFirstSubstringAfterOffset(&custom, 0, "{}", "{searchTerms}");
+    address = custom;
+  } else {
+    for (const Engine& engine : kEngines) {
+      if (name == engine.name) {
+        address = engine.url;
+        host = engine.host;
+      }
+    }
+  }
+  if (address.empty()) {
+    return;
+  }
+  TemplateURL* engine = FindEngine(service, name, host, address);
+  if (!engine) {
+    TemplateURLData data;
+    const std::u16string short_name = base::UTF8ToUTF16(name.empty() ? "Custom" : name);
+    data.SetShortName(short_name);
+    data.SetKeyword(base::UTF8ToUTF16(GURL(address).host()));
+    data.SetURL(address);
+    engine = service->Add(std::make_unique<TemplateURL>(data));
+  }
+  if (engine && service->CanMakeDefault(engine) &&
+      service->GetDefaultSearchProvider() != engine) {
+    service->SetUserSelectedDefaultSearchProvider(engine);
+  }
+}
+
+void SettingsSync::OnTemplateURLServiceChanged() {
+  if (applying_ || !read_once_) {
+    return;
+  }
+  TemplateURLService* service = TemplateURLServiceFactory::GetForProfile(profile_);
+  const TemplateURL* engine = service ? service->GetDefaultSearchProvider() : nullptr;
+  if (!service || !service->loaded() || !engine) {
+    return;
+  }
+  // The engines have only just loaded: what is shared comes first, or Chromium's default, which
+  // nobody chose, would be taken for a choice and sent to every machine.
+  if (!search_applied_) {
+    ApplySearch();
+    return;
+  }
+  // Which of the shared names it is, or an address of the wearer's own.
+  const GURL address = AddressOf(service, engine);
+  std::string name = "Custom";
+  for (const Engine& known : kEngines) {
+    if (address.host() == known.host) {
+      name = known.name;
+    }
+  }
+  const auto current = [this](const std::string& key) -> std::string {
+    const auto it = seen_.find(key);
+    return it != seen_.end() && it->second.is_string() ? it->second.GetString() : std::string();
+  };
+  const std::string was =
+      current("profile/search").empty() ? current("search") : current("profile/search");
+  if (was.empty()) {
+    // Chromium's default before anything is known of it is not a choice.
+    return;
+  }
+  if (name == was && name != "Custom") {
+    return;
+  }
+  if (name == "Custom") {
+    std::string custom = engine->url();
+    base::ReplaceFirstSubstringAfterOffset(&custom, 0, "{searchTerms}", "{}");
+    if (current("profile/custom_search") != custom) {
+      WriteProfileSetting("custom_search", base::Value(custom));
+    }
+  }
+  if (current("profile/search") != name) {
+    WriteProfileSetting("search", base::Value(name));
+  }
+}
+
+void SettingsSync::OnThemeChanged() {
+  if (applying_) {
+    return;
+  }
+  ThemeService* theme = ThemeServiceFactory::GetForProfile(profile_);
+  std::optional<SkColor> colour = theme ? theme->GetUserColor() : std::nullopt;
+  if (colour && ProfilesSync::Get()) {
+    ProfilesSync::Get()->LocalColourChanged(profile_->GetPath(), *colour);
+  }
+}
+
+void SettingsSync::WriteSetting(const std::string& name, base::Value value) {
+  seen_[name] = value.Clone();
+  files_->PostTask(FROM_HERE, base::BindOnce(&WriteFile,
+                                             SharedDir().Append("settings").Append(name + ".json"),
+                                             std::move(value)));
+}
+
+void SettingsSync::WriteProfileSetting(const std::string& name, base::Value value) {
+  seen_["profile/" + name] = value.Clone();
+  files_->PostTask(FROM_HERE,
+                   base::BindOnce(&WriteFile,
+                                  SharedProfileDir(id_).Append("settings").Append(name + ".json"),
+                                  std::move(value)));
+}
+
+bool SettingsSync::Seen(const std::string& key, const base::Value& value) {
+  const auto it = seen_.find(key);
+  return it != seen_.end() && it->second == value;
+}
+
+void SettingsSync::LocalBool(const std::string& name, const char* pref) {
+  if (applying_) {
+    return;
+  }
+  base::Value value(profile_->GetPrefs()->GetBoolean(pref));
+  if (!Seen(name, value)) {
+    WriteSetting(name, std::move(value));
+  }
+}
+
+void SettingsSync::LocalRestore() {
+  if (applying_) {
+    return;
+  }
+  base::Value value(SessionStartupPref::GetStartupPref(profile_->GetPrefs()).type ==
+                    SessionStartupPref::LAST);
+  if (!Seen("restore", value)) {
+    WriteSetting("restore", std::move(value));
+  }
+}
+
+void SettingsSync::LocalZoom() {
+  if (applying_) {
+    return;
+  }
+  ChromeZoomLevelPrefs* zoom = profile_->GetZoomLevelPrefs();
+  if (!zoom) {
+    return;
+  }
+  base::Value value(blink::ZoomLevelToZoomFactor(zoom->GetDefaultZoomLevelPref()));
+  if (!Seen("zoom", value)) {
+    WriteSetting("zoom", std::move(value));
+  }
+}
+
+}  // namespace spatiand
