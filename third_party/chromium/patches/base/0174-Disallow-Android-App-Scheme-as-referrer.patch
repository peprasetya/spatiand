Subject: [PATCH 174/310] Disallow Android App Scheme as referrer

FILE:Disallow-Android-App-Scheme-as-referrer.patch
---
 chrome/renderer/chrome_content_renderer_client.cc | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/chrome/renderer/chrome_content_renderer_client.cc b/chrome/renderer/chrome_content_renderer_client.cc
index 6cb52f10750..2eb7c469324 100644
--- a/chrome/renderer/chrome_content_renderer_client.cc
+++ b/chrome/renderer/chrome_content_renderer_client.cc
@@ -614,11 +614,6 @@ void ChromeContentRendererClient::RenderThreadStarted() {
   }
 #endif
 
-#if BUILDFLAG(IS_ANDROID)
-  WebSecurityPolicy::RegisterURLSchemeAsAllowedForReferrer(
-      WebString::FromUtf8(content::kAndroidAppScheme));
-#endif
-
   // chrome-search: pages should not be accessible by bookmarklets
   // or javascript: URLs typed in the omnibox.
   WebSecurityPolicy::RegisterURLSchemeAsNotAllowingJavascriptURLs(
