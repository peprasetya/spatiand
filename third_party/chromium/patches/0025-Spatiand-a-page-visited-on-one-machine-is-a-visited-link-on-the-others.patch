+void HistorySync::OnLinksMade(std::vector<Link> links) {
+  if (!history_) {
+    return;
+  }
+  for (const Link& link : links) {
+    history_->AddPartitionedVisitedLinkForSpatiand(link.url, link.top, link.frame);
+  }
+}
+
+void HistorySync::Record(Visit visit) {
+  if (last_ && last_->url == visit.url && last_->at == visit.at) {
+    last_->top = visit.top;
+    last_->frame = visit.frame;
+  }
+  unsaved_.push_back(std::move(visit));
+  SaveSoon();
+}
+
