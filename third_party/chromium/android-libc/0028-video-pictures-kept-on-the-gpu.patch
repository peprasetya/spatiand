+void SpatiandMediaCodecVideoDecoder::TakeImages() {
+  for (;;) {
+    int fence = -1;
+    AImage* image = reader_->Take(&fence);
+    if (!image) {
+      return;
+    }
+    reader_->Held();
+    int64_t nanoseconds = 0;
+    AImage_getTimestamp(image, &nanoseconds);
+    const int64_t microseconds = nanoseconds / 1000;
+    // In the order drawn; one the codec drew before a reset, or never said it drew, is dropped.
+    auto drawn = std::find(drawn_.begin(), drawn_.end(), microseconds);
+    AHardwareBuffer* buffer = nullptr;
+    ++taken_;
+    if (drawn == drawn_.end() || Images().hardware_buffer(image, &buffer) != AMEDIA_OK ||
+        !buffer) {
+      ++unmatched_;
+      if (fence >= 0) {
+        close(fence);
+      }
+      reader_->Give(image);
+      continue;
+    }
+    drawn_.erase(drawn_.begin(), drawn + 1);
+    idle_pumps_ = 0;
+    drawn_waits_ = 0;
+    DrawNext();
+    int32_t width = 0, height = 0;
+    AImage_getWidth(image, &width);
+    AImage_getHeight(image, &height);
+    AImageCropRect crop = {0, 0, width, height};
+    AImage_getCropRect(image, &crop);
+    gfx::Rect visible(crop.left, crop.top, crop.right - crop.left, crop.bottom - crop.top);
+    visible.Intersect(gfx::Rect(width, height));
+    if (visible.IsEmpty()) {
+      visible = gfx::Rect(width, height);
+    }
