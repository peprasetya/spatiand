diff --git a/media/audio/spatiand/spatiand_input.cc b/media/audio/spatiand/spatiand_input.cc
new file mode 100644
index 0000000000..e602ab2014
--- /dev/null
+++ b/media/audio/spatiand/spatiand_input.cc
@@ -0,0 +1,193 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/audio/spatiand/spatiand_input.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/task/single_thread_task_runner.h"
+#include "media/audio/audio_manager_base.h"
+#include "media/base/audio_bus.h"
+#include "media/base/audio_sample_types.h"
+
+namespace media {
+
+namespace {
+
+// How long before it is read a sample was heard by the microphone: Android's recording, then the
+// room's handing it on. A guess, as Android says nothing of it here.
+constexpr base::TimeDelta kHeardBefore = base::Milliseconds(30);
+
+// The most kept waiting: a page that stops reading for longer loses the oldest.
+constexpr size_t kMostWaiting = 48000 * 2 / 2;  // half a second of 16-bit mono
+
+}  // namespace
+
+SpatiandAudioInputStream::SpatiandAudioInputStream(AudioManagerBase* manager,
+                                                   const AudioParameters& params)
+    : manager_(manager),
+      params_(params),
+      worker_(manager->GetWorkerTaskRunner(), params),
+      bus_(AudioBus::Create(params)) {}
+
+SpatiandAudioInputStream::~SpatiandAudioInputStream() {
+  DCHECK(!callback_);
+}
+
+AudioInputStream::OpenOutcome SpatiandAudioInputStream::Open() {
+  DCHECK(manager_->GetTaskRunner()->BelongsToCurrentThread());
+  if (socket_.is_valid()) {
+    return OpenOutcome::kAlreadyOpen;
+  }
+  // The room sends 48 kHz mono, as AudioManagerSpatiand says its microphone is; asked for two
+  // channels, each has it.
+  if (params_.sample_rate() != 48000 || params_.channels() > 2) {
+    LOG(WARNING) << "Spatiand's microphone is 48 kHz mono, not " << params_.AsHumanReadableString();
+    return OpenOutcome::kFailed;
+  }
+  const char* dir = getenv("XDG_RUNTIME_DIR");
+  if (!dir || !*dir) {
+    return OpenOutcome::kFailed;
+  }
+  const std::string path = std::string(dir) + "/spatiand-mic";
+  sockaddr_un address = {};
+  address.sun_family = AF_UNIX;
+  if (path.size() >= sizeof(address.sun_path)) {
+    return OpenOutcome::kFailed;
+  }
+  memcpy(address.sun_path, path.c_str(), path.size() + 1);
+#if defined(SOCK_CLOEXEC)
+  base::ScopedFD socket(::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0));
+#else
+  // macOS: no SOCK_CLOEXEC; close-on-exec set at once after.
+  base::ScopedFD socket(::socket(AF_UNIX, SOCK_STREAM, 0));
+  if (socket.is_valid()) {
+    fcntl(socket.get(), F_SETFD, FD_CLOEXEC);
+  }
+#endif
+  if (!socket.is_valid() ||
+      HANDLE_EINTR(connect(socket.get(), reinterpret_cast<const sockaddr*>(&address),
+                           sizeof(address))) != 0) {
+    PLOG(WARNING) << "Spatiand's room has no microphone at " << path;
+    return OpenOutcome::kFailedDeviceRemoved;
+  }
+  if (HANDLE_EINTR(write(socket.get(), "SPMC", 4)) != 4 ||
+      fcntl(socket.get(), F_SETFL, O_NONBLOCK) != 0) {
+    PLOG(WARNING) << "Spatiand's room would not give its microphone";
+    return OpenOutcome::kFailed;
+  }
+  socket_ = std::move(socket);
+  return OpenOutcome::kSuccess;
+}
+
+void SpatiandAudioInputStream::Start(AudioInputCallback* callback) {
+  DCHECK(manager_->GetTaskRunner()->BelongsToCurrentThread());
+  callback_ = callback;
+  waiting_.clear();
+  worker_.Start(base::BindRepeating(&SpatiandAudioInputStream::Tick, base::Unretained(this)));
+}
+
+void SpatiandAudioInputStream::Stop() {
+  DCHECK(manager_->GetTaskRunner()->BelongsToCurrentThread());
+  worker_.Stop();
+  callback_ = nullptr;
+}
+
+void SpatiandAudioInputStream::Close() {
+  DCHECK(!callback_);
+  DCHECK(manager_->GetTaskRunner()->BelongsToCurrentThread());
+  // The room stops recording once nobody is connected.
+  socket_.reset();
+  manager_->ReleaseInputStream(this);
+}
+
+double SpatiandAudioInputStream::GetMaxVolume() {
+  return 1.0;
+}
+
+void SpatiandAudioInputStream::SetVolume(double volume) {}
+
+double SpatiandAudioInputStream::GetVolume() {
+  return 1.0;
+}
+
+bool SpatiandAudioInputStream::SetAutomaticGainControl(bool enabled) {
+  return false;
+}
+
+bool SpatiandAudioInputStream::GetAutomaticGainControl() {
+  return false;
+}
+
+bool SpatiandAudioInputStream::IsMuted() {
+  return false;
+}
+
+void SpatiandAudioInputStream::SetOutputDeviceForAec(const std::string& output_device_id) {}
+
+void SpatiandAudioInputStream::Tick(base::TimeTicks ideal_time, base::TimeTicks now) {
+  DCHECK(manager_->GetWorkerTaskRunner()->BelongsToCurrentThread());
+  if (!socket_.is_valid()) {
+    return;
+  }
+  uint8_t chunk[4096];
+  // At most what is kept, a tick: a sender running ahead of the clock does not hold the thread.
+  for (size_t taken = 0; taken < kMostWaiting;) {
+    const ssize_t got = HANDLE_EINTR(read(socket_.get(), chunk, sizeof(chunk)));
+    if (got > 0) {
+      waiting_.insert(waiting_.end(), chunk, chunk + got);
+      taken += static_cast<size_t>(got);
+      continue;
+    }
+    if (got < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+      break;
+    }
+    // The room has gone, or would not record.
+    LOG(WARNING) << "Spatiand's microphone has stopped";
+    socket_.reset();
+    callback_->OnError(AudioInputCallback::Error::kRuntimeError);
+    return;
+  }
+  if (waiting_.size() > kMostWaiting) {
+    // Whole samples only, so what follows is still read in step.
+    const size_t extra = (waiting_.size() - kMostWaiting) & ~size_t{1};
+    waiting_.erase(waiting_.begin(), waiting_.begin() + extra);
+  }
+  const size_t buffer = static_cast<size_t>(params_.frames_per_buffer()) * sizeof(int16_t);
+  size_t given = 0;
+  while (waiting_.size() - given >= buffer) {
+    const auto samples = base::span(reinterpret_cast<const int16_t*>(waiting_.data() + given),
+                                    static_cast<size_t>(params_.frames_per_buffer()));
+    if (params_.channels() == 1) {
+      bus_->FromInterleaved<SignedInt16SampleTypeTraits>(samples);
+    } else {
+      spread_.resize(samples.size() * static_cast<size_t>(params_.channels()));
+      for (size_t i = 0; i < samples.size(); ++i) {
+        for (int c = 0; c < params_.channels(); ++c) {
+          spread_[i * static_cast<size_t>(params_.channels()) + static_cast<size_t>(c)] = samples[i];
+        }
+      }
+      bus_->FromInterleaved<SignedInt16SampleTypeTraits>(spread_);
+    }
+    const base::TimeDelta behind =
+        params_.GetBufferDuration() * ((waiting_.size() - given) / buffer - 1);
+    callback_->OnData(bus_.get(), now - kHeardBefore - behind, 1.0, {});
+    given += buffer;
+  }
+  waiting_.erase(waiting_.begin(), waiting_.begin() + given);
+}
+
+}  // namespace media
