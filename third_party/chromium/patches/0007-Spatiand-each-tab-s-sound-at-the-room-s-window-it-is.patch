diff --git a/content/browser/media/spatiand_window_audio.cc b/content/browser/media/spatiand_window_audio.cc
new file mode 100644
index 0000000000..9bb78a52c5
--- /dev/null
+++ b/content/browser/media/spatiand_window_audio.cc
@@ -0,0 +1,130 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/media/spatiand_window_audio.h"
+
+#include <unistd.h>
+
+#include <map>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/environment.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_split.h"
+#include "base/strings/stringprintf.h"
+#include "base/supports_user_data.h"
+#include "base/task/thread_pool.h"
+#include "base/timer/timer.h"
+#include "content/browser/renderer_host/media/media_stream_manager.h"
+#include "content/browser/renderer_host/media/preferred_audio_output_device_manager.h"
+#include "content/browser/web_contents/web_contents_impl.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/global_routing_id.h"
+#include "content/public/browser/render_frame_host.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_tree_host.h"
+
+namespace content {
+
+namespace {
+
+// How soon a tab's sound follows it into another window (or the room's sink for a new window
+// appears): twice a second, a file read off the UI thread and a walk over the tabs.
+constexpr base::TimeDelta kEvery = base::Milliseconds(500);
+
+const char kRoutedKey[] = "spatiand_window_audio";
+
+// Where a tab's sound was last sent, so it is sent again only when that changes.
+struct Routed : public base::SupportsUserData::Data {
+  GlobalRenderFrameHostToken frame;
+  std::string sink;
+};
+
+using SinkMap = std::map<std::string, std::string>;
+
+// The room's sinks by window key, from `$XDG_RUNTIME_DIR/spatiand-sinks` (`key<TAB>sink` lines,
+// written by the room as windows come and go).
+SinkMap ReadSinkMap() {
+  SinkMap sinks;
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> dir = env->GetVar("XDG_RUNTIME_DIR");
+  std::string text;
+  if (!dir || !base::ReadFileToString(base::FilePath(*dir).Append("spatiand-sinks"), &text)) {
+    return sinks;
+  }
+  for (std::string_view line :
+       base::SplitStringPiece(text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    std::vector<std::string_view> parts =
+        base::SplitStringPiece(line, "\t", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    if (parts.size() == 2) {
+      sinks.emplace(std::string(parts[0]), std::string(parts[1]));
+    }
+  }
+  return sinks;
+}
+
+void SetPreferredSinkOnIO(GlobalRenderFrameHostToken frame, std::string sink) {
+  if (auto* manager = MediaStreamManager::GetPreferredOutputManagerInstance()) {
+    manager->SetPreferredSinkId(frame, sink, base::DoNothing());
+  }
+}
+
+// Each tab's sound to the sink of the window it is in: its window's key is this process and the
+// window's surface, as the room keys the sink it gives every SpatiMesh window.
+void Route(SinkMap sinks) {
+  for (WebContentsImpl* contents : WebContentsImpl::GetAllWebContents()) {
+    gfx::NativeWindow window = contents->GetTopLevelNativeWindow();
+    if (!window || !window->GetHost() || !contents->GetPrimaryMainFrame()) {
+      continue;
+    }
+    std::string sink;
+    if (const uint32_t surface = window->GetHost()->GetSpatiandSurfaceId()) {
+      const auto it = sinks.find(base::StringPrintf("wl:%d:%u", getpid(), surface));
+      if (it != sinks.end()) {
+        sink = it->second;
+      }
+    }
+    const GlobalRenderFrameHostToken frame =
+        contents->GetPrimaryMainFrame()->GetGlobalFrameToken();
+    auto* routed = static_cast<Routed*>(contents->GetUserData(kRoutedKey));
+    if (routed && routed->frame == frame && routed->sink == sink) {
+      continue;
+    }
+    if (!routed) {
+      auto owned = std::make_unique<Routed>();
+      routed = owned.get();
+      contents->SetUserData(kRoutedKey, std::move(owned));
+    }
+    routed->frame = frame;
+    routed->sink = sink;
+    // Streams playing on the default device switch to it as they play; an empty sink is the
+    // default again (the sink SpatiMesh was launched with).
+    GetIOThreadTaskRunner({})->PostTask(FROM_HERE,
+                                        base::BindOnce(&SetPreferredSinkOnIO, frame, sink));
+  }
+}
+
+void Tick() {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadSinkMap), base::BindOnce(&Route));
+}
+
+}  // namespace
+
+// static
+void SpatiandWindowAudio::Start() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  static base::NoDestructor<base::RepeatingTimer> timer;
+  timer->Start(FROM_HERE, kEvery, base::BindRepeating(&Tick));
+}
+
+}  // namespace content
diff --git a/content/browser/media/spatiand_window_audio.h b/content/browser/media/spatiand_window_audio.h
new file mode 100644
index 0000000000..e88fbb636c
--- /dev/null
+++ b/content/browser/media/spatiand_window_audio.h
@@ -0,0 +1,20 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_MEDIA_SPATIAND_WINDOW_AUDIO_H_
+#define CONTENT_BROWSER_MEDIA_SPATIAND_WINDOW_AUDIO_H_
+
+namespace content {
+
+// Each tab's sound placed at the window it is in, in Spatiand's room: the room gives every
+// SpatiMesh window a sink of its own and says where they are; each tab plays to its window's
+// (the page's preferred output device), and follows it to another window as it is dragged there.
+class SpatiandWindowAudio {
+ public:
+  // Begins routing, for the life of the browser. On the UI thread.
+  static void Start();
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_MEDIA_SPATIAND_WINDOW_AUDIO_H_
