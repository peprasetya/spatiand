+++ b/chrome/browser/spatiand/cookie_sync.cc
@@ -0,0 +1,529 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/spatiand/cookie_sync.h"
+
+#include <algorithm>
+#include <cmath>
+#include <set>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/spatiand/shared_folder.h"
+#include "components/browsing_data/core/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/storage_partition.h"
+#include "net/cookies/cookie_access_result.h"
+#include "net/cookies/cookie_change_dispatcher.h"
+#include "net/cookies/cookie_constants.h"
+#include "net/cookies/cookie_inclusion_status.h"
+#include "net/cookies/cookie_options.h"
+#include "net/cookies/cookie_util.h"
+#include "url/gurl.h"
+
+namespace spatiand {
+
+namespace {
+
+constexpr double kDay = 86400.0;
+constexpr base::TimeDelta kAfterChange = base::Seconds(10);
+constexpr base::TimeDelta kEveryMinute = base::Minutes(1);
+
+using Cookie = CookieSync::Cookie;
+using Key = std::tuple<std::string, std::string, std::string>;
+using Jar = std::map<Key, Cookie>;
+
+Key KeyOf(const Cookie& cookie) {
+  return Key(cookie.name, cookie.domain, cookie.path);
+}
+
+std::string SiteOf(const std::string& domain) {
+  return base::ToLowerASCII(base::TrimString(domain, ".", base::TRIM_LEADING));
+}
+
+// A name the synchroniser and every file system take.
+bool SafeSite(const std::string& site) {
+  if (site.empty() || site.starts_with('.')) {
+    return false;
+  }
+  return std::ranges::all_of(site, [](char c) {
+    return base::IsAsciiAlpha(c) || base::IsAsciiDigit(c) || c == '.' || c == '-' || c == '_';
+  });
+}
+
+// So many cookies that losing most of them at once means something went wrong.
+constexpr size_t kManyCookies = 20;
+
+// The same cookie, for syncing: its expiry may have moved, by less than a day, or be months away
+// on both sides: Chromium holds a cookie to 400 days and another engine may not, which is no news.
+bool Same(const Cookie& a, const Cookie& b) {
+  const double far = base::Time::Now().InSecondsFSinceUnixEpoch() + 30 * kDay;
+  const bool expires = a.expires && b.expires
+                           ? std::fabs(*a.expires - *b.expires) < kDay ||
+                                 std::min(*a.expires, *b.expires) > far
+                           : a.expires == b.expires;
+  return expires && a.name == b.name && a.value == b.value && a.domain == b.domain &&
+         a.path == b.path && a.secure == b.secure && a.http_only == b.http_only &&
+         a.same_site == b.same_site;
+}
+
+bool Differs(const Jar& a, const Jar& b) {
+  if (a.size() != b.size()) {
+    return true;
+  }
+  for (const auto& [key, cookie] : a) {
+    const auto it = b.find(key);
+    if (it == b.end() || !Same(cookie, it->second)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The cookies worth syncing, by site: those that outlive the session and are not over.
+std::map<std::string, Jar> BySite(const std::vector<Cookie>& cookies, double now) {
+  std::map<std::string, Jar> sites;
+  for (const Cookie& cookie : cookies) {
+    if (!cookie.expires || *cookie.expires <= now || cookie.name.empty()) {
+      continue;
+    }
+    const std::string site = SiteOf(cookie.domain);
+    if (!SafeSite(site)) {
+      continue;
+    }
+    Cookie rounded = cookie;
+    rounded.expires = std::round(*cookie.expires);
+    sites[site].emplace(KeyOf(rounded), std::move(rounded));
+  }
+  return sites;
+}
+
+base::DictValue CookieToDict(const Cookie& cookie) {
+  base::DictValue dict;
+  dict.Set("name", cookie.name);
+  dict.Set("value", cookie.value);
+  dict.Set("domain", cookie.domain);
+  dict.Set("path", cookie.path);
+  if (cookie.expires) {
+    dict.Set("expires", *cookie.expires);
+  }
+  dict.Set("secure", cookie.secure);
+  dict.Set("http_only", cookie.http_only);
+  if (!cookie.same_site.empty()) {
+    dict.Set("same_site", cookie.same_site);
+  }
+  return dict;
+}
+
+std::optional<Cookie> CookieFromDict(const base::DictValue& dict) {
+  const std::string* name = dict.FindString("name");
+  const std::string* value = dict.FindString("value");
+  const std::string* domain = dict.FindString("domain");
+  const std::string* path = dict.FindString("path");
+  if (!name || !value || !domain || !path) {
+    return std::nullopt;
+  }
+  Cookie cookie;
+  cookie.name = *name;
+  cookie.value = *value;
+  cookie.domain = *domain;
+  cookie.path = *path;
+  cookie.expires = dict.FindDouble("expires");
+  cookie.secure = dict.FindBool("secure").value_or(false);
+  cookie.http_only = dict.FindBool("http_only").value_or(false);
+  if (const std::string* same_site = dict.FindString("same_site")) {
+    cookie.same_site = *same_site;
+  }
+  return cookie;
+}
+
+std::vector<Cookie> CookiesFromList(const base::ListValue& list) {
+  std::vector<Cookie> cookies;
+  for (const base::Value& item : list) {
+    if (item.is_dict()) {
+      if (std::optional<Cookie> cookie = CookieFromDict(item.GetDict())) {
+        cookies.push_back(std::move(*cookie));
+      }
+    }
+  }
+  return cookies;
+}
+
+base::ListValue CookiesToList(const std::vector<Cookie>& cookies) {
+  base::ListValue list;
+  for (const Cookie& cookie : cookies) {
+    list.Append(CookieToDict(cookie));
+  }
+  return list;
+}
+
+std::vector<Cookie> ValuesOf(const Jar& jar) {
+  std::vector<Cookie> cookies;
+  for (const auto& [key, cookie] : jar) {
+    cookies.push_back(cookie);
+  }
+  return cookies;
+}
+
+std::string SameSiteName(net::CookieSameSite same_site) {
+  switch (same_site) {
+    case net::CookieSameSite::NO_RESTRICTION:
+      return "None";
+    case net::CookieSameSite::LAX_MODE:
+      return "Lax";
+    case net::CookieSameSite::STRICT_MODE:
+      return "Strict";
+    default:
+      return std::string();
+  }
+}
+
+net::CookieSameSite SameSiteOf(const std::string& name) {
+  if (name == "None") {
+    return net::CookieSameSite::NO_RESTRICTION;
+  }
+  if (name == "Lax") {
+    return net::CookieSameSite::LAX_MODE;
+  }
+  if (name == "Strict") {
+    return net::CookieSameSite::STRICT_MODE;
+  }
+  return net::CookieSameSite::UNSPECIFIED;
+}
+
+Cookie FromChromium(const net::CanonicalCookie& canonical) {
+  Cookie cookie;
+  cookie.name = canonical.Name();
+  cookie.value = canonical.Value();
+  cookie.domain = canonical.Domain();
+  cookie.path = canonical.Path();
+  if (canonical.IsPersistent()) {
+    cookie.expires = canonical.ExpiryDate().InSecondsFSinceUnixEpoch();
+  }
+  cookie.secure = canonical.SecureAttribute();
+  cookie.http_only = canonical.IsHttpOnly();
+  cookie.same_site = SameSiteName(canonical.SameSite());
+  return cookie;
+}
+
+}  // namespace
+
+CookieSync::Cookie::Cookie() = default;
+CookieSync::Cookie::Cookie(const Cookie&) = default;
+CookieSync::Cookie& CookieSync::Cookie::operator=(const Cookie&) = default;
+CookieSync::Cookie::~Cookie() = default;
+bool CookieSync::Cookie::operator==(const Cookie&) const = default;
+CookieSync::ForChromium::ForChromium() = default;
+CookieSync::ForChromium::ForChromium(ForChromium&&) = default;
+CookieSync::ForChromium& CookieSync::ForChromium::operator=(ForChromium&&) = default;
+CookieSync::ForChromium::~ForChromium() = default;
+
+// The folder's side, on its own sequence, with what was last agreed.
+class CookieSync::Files {
+ public:
+  explicit Files(const std::string& id)
+      : dir_(SharedProfileDir(id).Append("cookies")),
+        agreed_file_(LocalProfileDir(id).Append("cookies.json")) {
+    if (std::optional<base::Value> value = ReadJson(agreed_file_); value && value->is_dict()) {
+      for (const auto [site, cookies] : value->GetDict()) {
+        if (cookies.is_list()) {
+          agreed_[site] = CookiesFromList(cookies.GetList());
+        }
+      }
+    }
+  }
+
+  base::Time FolderChangedTime() { return FolderChanged(dir_); }
+
+  ForChromium Merge(std::vector<Cookie> jar, bool wearer_cleared) {
+    // No folder for this profile at all says nothing about its cookies.
+    if (!base::DirectoryExists(dir_.DirName())) {
+      return ForChromium();
+    }
+    const double now = base::Time::Now().InSecondsFSinceUnixEpoch();
+    const std::map<std::string, Jar> local = BySite(jar, now);
+    // Most of what was agreed gone as the browser starts, or all of it at any time, is no wearer
+    // logging out: that is done in a session, a site at a time, or by clearing browsing data, which
+    // is told apart. It is a store that lost its cookies (the browser killed before it wrote them,
+    // a key it cannot read them with), and it must not take them from every machine: nothing counts
+    // as removed here, and they come back.
+    size_t known = 0;
+    size_t still_here = 0;
+    for (const auto& [site, cookies] : agreed_) {
+      const std::map<std::string, Jar> alive = BySite(cookies, now);
+      const auto here = local.find(site);
+      for (const auto& [alive_site, alive_cookies] : alive) {
+        for (const auto& [key, cookie] : alive_cookies) {
+          ++known;
+          if (here != local.end() && here->second.contains(key)) {
+            ++still_here;
+          }
+        }
+      }
+    }
+    const bool lost = !wearer_cleared && known >= kManyCookies &&
+                      (first_merge_ ? still_here * 2 < known : still_here == 0);
+    first_merge_ = false;
+    if (lost) {
+      LOG(WARNING) << "SpatiMesh: only " << still_here << " of " << known
+                   << " cookies are left in this profile; they are taken back from the shared "
+                      "folder, not removed from it";
+    }
+    const std::vector<std::string> shared_sites = ListJson(dir_);
+    std::set<std::string> sites(shared_sites.begin(), shared_sites.end());
+    for (const auto& [site, cookies] : local) {
+      sites.insert(site);
+    }
+    for (const auto& [site, cookies] : agreed_) {
+      sites.insert(site);
+    }
+
+    ForChromium out;
+    bool changed = false;
+    for (const std::string& site : sites) {
+      Jar base;
+      if (const auto it = agreed_.find(site); !lost && it != agreed_.end()) {
+        std::map<std::string, Jar> by_site = BySite(it->second, now);
+        if (auto found = by_site.find(site); found != by_site.end()) {
+          base = std::move(found->second);
+        }
+      }
+      Jar shared;
+      const base::FilePath file = dir_.Append(site + ".json");
+      if (std::ranges::contains(shared_sites, site)) {
+        if (std::optional<base::Value> value = ReadJson(file); value && value->is_dict()) {
+          if (const base::ListValue* cookies = value->GetDict().FindList("cookies")) {
+            std::map<std::string, Jar> by_site = BySite(CookiesFromList(*cookies), now);
+            if (auto found = by_site.find(site); found != by_site.end()) {
+              shared = std::move(found->second);
+            }
+          }
+        }
+      }
+      Jar mine;
+      if (const auto it = local.find(site); it != local.end()) {
+        mine = it->second;
+      }
+
+      // Three ways: begin from the file; what changed here since the last agreement goes over
+      // it, what was removed here goes from it.
+      Jar result = shared;
+      for (const auto& [key, cookie] : mine) {
+        const auto was = base.find(key);
+        if (was == base.end() || !Same(was->second, cookie)) {
+          result[key] = cookie;
+        }
+      }
+      for (const auto& [key, cookie] : base) {
+        if (!mine.contains(key)) {
+          result.erase(key);
+        }
+      }
+
+      if (Differs(result, shared)) {
+        if (result.empty()) {
+          RemovePath(file);
+        } else {
+          base::DictValue dict;
+          dict.Set("cookies", CookiesToList(ValuesOf(result)));
+          WriteJson(file, base::Value(std::move(dict)));
+        }
+      }
+      for (const auto& [key, cookie] : result) {
+        const auto have = mine.find(key);
+        if (have == mine.end() || !Same(have->second, cookie)) {
+          out.set.push_back(cookie);
+        }
+      }
+      for (const auto& [key, cookie] : mine) {
+        if (!result.contains(key)) {
+          out.remove.push_back(cookie);
+        }
+      }
+      std::vector<Cookie> agreed = ValuesOf(result);
+      const auto old = agreed_.find(site);
+      if (old == agreed_.end() ? !agreed.empty() : old->second != agreed) {
+        changed = true;
+        if (agreed.empty()) {
+          agreed_.erase(site);
+        } else {
+          agreed_[site] = std::move(agreed);
+        }
+      }
+    }
+    if (changed) {
+      SaveAgreed();
+    }
+    return out;
+  }
+
+  // Chromium would not take this one. It is not a cookie removed here, which would remove it on
+  // every machine: it is taken out of what was agreed, and offered again next time.
+  void NotTaken(Cookie cookie) {
+    const auto it = agreed_.find(SiteOf(cookie.domain));
+    if (it != agreed_.end()) {
+      std::erase_if(it->second,
+                    [&cookie](const Cookie& c) { return KeyOf(c) == KeyOf(cookie); });
+      if (it->second.empty()) {
+        agreed_.erase(it);
+      }
+      SaveAgreed();
+    }
+  }
+
+ private:
+  void SaveAgreed() {
+    base::DictValue dict;
+    for (const auto& [site, cookies] : agreed_) {
+      dict.Set(site, CookiesToList(cookies));
+    }
+    WriteJson(agreed_file_, base::Value(std::move(dict)));
+  }
+
+  const base::FilePath dir_;
+  const base::FilePath agreed_file_;
+  std::map<std::string, std::vector<Cookie>> agreed_;
+  bool first_merge_ = true;
+};
+
+CookieSync::CookieSync(Profile* profile,
+                       const std::string& id,
+                       scoped_refptr<base::SequencedTaskRunner> files)
+    : profile_(profile), files_(std::move(files), id) {
+  Connect();
+  MergeSoon();
+  every_minute_.Start(FROM_HERE, kEveryMinute,
+                      base::BindRepeating(&CookieSync::MergeNow, base::Unretained(this)));
+}
+
+CookieSync::~CookieSync() = default;
+
+void CookieSync::Connect() {
+  network::mojom::CookieManager* manager =
+      profile_->GetDefaultStoragePartition()->GetCookieManagerForBrowserProcess();
+  listener_.reset();
+  manager->AddGlobalChangeListener(listener_.BindNewPipeAndPassRemote());
+  // The network service restarting takes the listener with it.
+  listener_.set_disconnect_handler(
+      base::BindOnce(&CookieSync::Connect, base::Unretained(this)));
+}
+
+void CookieSync::OnCookieChange(const net::CookieChangeInfo& change) {
+  if (telling_ == 0 && change.cookie.IsPersistent()) {
+    MergeSoon();
+  }
+}
+
+void CookieSync::MergeSoon() {
+  if (!soon_.IsRunning()) {
+    soon_.Start(FROM_HERE, kAfterChange,
+                base::BindOnce(&CookieSync::MergeNow, base::Unretained(this)));
+  }
+}
+
+void CookieSync::Poll() {
+  files_.AsyncCall(&Files::FolderChangedTime)
+      .Then(base::BindOnce(&CookieSync::OnFolderChanged, weak_factory_.GetWeakPtr()));
+}
+
+void CookieSync::OnFolderChanged(base::Time changed) {
+  if (changed != folder_changed_) {
+    folder_changed_ = changed;
+    MergeNow();
+  }
+}
+
+void CookieSync::MergeNow() {
+  if (merging_) {
+    return;
+  }
+  merging_ = true;
+  profile_->GetDefaultStoragePartition()->GetCookieManagerForBrowserProcess()->GetAllCookies(
+      base::BindOnce(&CookieSync::OnAllCookies, weak_factory_.GetWeakPtr()));
+}
+
+void CookieSync::OnAllCookies(const net::CookieList& cookies) {
+  all_ = cookies;
+  std::vector<Cookie> jar;
+  jar.reserve(cookies.size());
+  for (const net::CanonicalCookie& cookie : cookies) {
+    // A cookie kept per top-level site is that site's alone, here, and has no meaning elsewhere.
+    if (!cookie.IsPartitioned()) {
+      jar.push_back(FromChromium(cookie));
+    }
+  }
+  // "Clear browsing data" was used lately: what it took is meant to be gone.
+  const base::Time cleared = base::Time::FromTimeT(
+      profile_->GetPrefs()->GetInt64(browsing_data::prefs::kLastClearBrowsingDataTime));
+  const bool wearer_cleared = base::Time::Now() - cleared < base::Minutes(10);
+  files_.AsyncCall(&Files::Merge)
+      .WithArgs(std::move(jar), wearer_cleared)
+      .Then(base::BindOnce(&CookieSync::OnMerged, weak_factory_.GetWeakPtr()));
+}
+
+void CookieSync::OnMerged(ForChromium out) {
+  network::mojom::CookieManager* manager =
+      profile_->GetDefaultStoragePartition()->GetCookieManagerForBrowserProcess();
+  for (const Cookie& cookie : out.set) {
+    const base::Time now = base::Time::Now();
+    const GURL url = net::cookie_util::CookieOriginToURL(cookie.domain, cookie.secure);
+    net::CookieInclusionStatus status;
+    std::unique_ptr<net::CanonicalCookie> canonical = net::CanonicalCookie::CreateSanitizedCookie(
+        url, cookie.name, cookie.value,
+        cookie.domain.starts_with('.') ? cookie.domain : std::string(), cookie.path, now,
+        base::Time::FromSecondsSinceUnixEpoch(cookie.expires.value_or(0)), now, cookie.secure,
+        cookie.http_only, SameSiteOf(cookie.same_site), net::COOKIE_PRIORITY_DEFAULT,
+        /*partition_key=*/std::nullopt, &status);
+    if (!canonical) {
+      files_.AsyncCall(&Files::NotTaken).WithArgs(cookie);
+      continue;
+    }
+    ++telling_;
+    manager->SetCanonicalCookie(
+        *canonical, url, net::CookieOptions::MakeAllInclusive(),
+        base::BindOnce(&CookieSync::OnSet, weak_factory_.GetWeakPtr(), cookie));
+  }
+  for (const Cookie& cookie : out.remove) {
+    for (const net::CanonicalCookie& canonical : all_) {
+      if (canonical.Name() == cookie.name && canonical.Domain() == cookie.domain &&
+          canonical.Path() == cookie.path && !canonical.IsPartitioned()) {
+        ++telling_;
+        manager->DeleteCanonicalCookie(canonical,
+                                       base::BindOnce(
+                                           [](base::WeakPtr<CookieSync> self, bool) {
+                                             if (self) {
+                                               self->Merged();
+                                             }
+                                           },
+                                           weak_factory_.GetWeakPtr()));
+        break;
+      }
+    }
+  }
+  // On disk now rather than within half a minute: what was given here is agreed on already, and if
+  // the browser is killed before it is written, the next start would see it as removed here.
+  if (!out.set.empty()) {
+    manager->FlushCookieStore(base::DoNothing());
+  }
+  all_.clear();
+  merging_ = false;
+}
+
+void CookieSync::OnSet(Cookie cookie, net::CookieAccessResult result) {
+  if (!result.status.IsInclude()) {
+    files_.AsyncCall(&Files::NotTaken).WithArgs(std::move(cookie));
+  }
+  Merged();
+}
+
+void CookieSync::Merged() {
+  --telling_;
+}
+
+}  // namespace spatiand
