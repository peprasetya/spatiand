diff --git a/base/apple/foundation_util.mm b/base/apple/foundation_util.mm
index 2c5fd95379..709f93e9a7 100644
--- a/base/apple/foundation_util.mm
+++ b/base/apple/foundation_util.mm
@@ -101,6 +101,15 @@ bool IsBackgroundOnlyProcess() {
   // Info.plist to access its LSUIElement property.
   @autoreleasepool {
     NSDictionary* info_dictionary = [apple::MainBundle() infoDictionary];
+#if BUILDFLAG(IS_MAC_LINUX_UI)
+    // Spatiand: with the Linux UI the browser is an agent to macOS as well
+    // (LSUIElement: no Dock icon; Spatiand alone shows it), so that key no
+    // longer tells the helpers from it: the browser's bundle says which it is
+    // (chrome/app/app-linux-ui-Info.plist).
+    if ([info_dictionary[@"SpatiandBrowserProcess"] boolValue]) {
+      return false;
+    }
+#endif
     return [info_dictionary[@"LSUIElement"] boolValue] != NO;
   }
 }
