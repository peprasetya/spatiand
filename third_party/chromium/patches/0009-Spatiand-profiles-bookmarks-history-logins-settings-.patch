+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SPATIAND_COOKIE_SYNC_H_
+#define CHROME_BROWSER_SPATIAND_COOKIE_SYNC_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <tuple>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/threading/sequence_bound.h"
+#include "base/timer/timer.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "net/cookies/canonical_cookie.h"
+#include "services/network/public/mojom/cookie_manager.mojom.h"
+
+class Profile;
+
+namespace spatiand {
+
+// A profile's logins, the same on every machine: log in on one, be logged in on the others.
+//
+// `apps/spatimesh/profiles/<id>/cookies/<site>.json`, a file per site, merged three ways as
+// `crates/spatimesh/src/cookies.rs` does: what Chromium has, what the file says, and what the two
+// last agreed on (this browser's own file). A cookie changed here since is written out, one changed
+// elsewhere is given to Chromium, one gone from either side is gone from both. Only cookies that
+// outlive the session cross, and an expiry moved by less than a day is not a change.
+class CookieSync : public network::mojom::CookieChangeListener {
+ public:
+  CookieSync(Profile* profile,
+             const std::string& id,
+             scoped_refptr<base::SequencedTaskRunner> files);
+  CookieSync(const CookieSync&) = delete;
+  CookieSync& operator=(const CookieSync&) = delete;
+  ~CookieSync() override;
+
+  // Looks for what the synchroniser brought.
+  void Poll();
+
+  struct Cookie {
+    Cookie();
+    Cookie(const Cookie&);
+    Cookie& operator=(const Cookie&);
+    ~Cookie();
+    bool operator==(const Cookie&) const;
+    std::string name;
+    std::string value;
+    std::string domain;
+    std::string path;
+    std::optional<double> expires;
+    bool secure = false;
+    bool http_only = false;
+    std::string same_site;
+  };
+  struct ForChromium {
+    ForChromium();
+    ForChromium(ForChromium&&);
+    ForChromium& operator=(ForChromium&&);
+    ~ForChromium();
+    std::vector<Cookie> set;
+    std::vector<Cookie> remove;
+  };
+
+  class Files;
+
+ private:
+  void Connect();
+  void MergeNow();
+  void OnAllCookies(const net::CookieList& cookies);
+  void OnMerged(ForChromium out);
+  void OnSet(Cookie cookie, net::CookieAccessResult result);
+  void Merged();
+  void MergeSoon();
+  void OnFolderChanged(base::Time changed);
+
+  // network::mojom::CookieChangeListener:
+  void OnCookieChange(const net::CookieChangeInfo& change) override;
+
+  const raw_ptr<Profile> profile_;
+  base::SequenceBound<Files> files_;
+  mojo::Receiver<network::mojom::CookieChangeListener> listener_{this};
+  base::OneShotTimer soon_;
+  base::RepeatingTimer every_minute_;
+  bool merging_ = false;
+  // What is being told to Chromium: its own change listener hears that too, and it is no news.
+  int telling_ = 0;
+  base::Time folder_changed_;
+  net::CookieList all_;
+  base::WeakPtrFactory<CookieSync> weak_factory_{this};
+};
+
+}  // namespace spatiand
+
+#endif  // CHROME_BROWSER_SPATIAND_COOKIE_SYNC_H_
