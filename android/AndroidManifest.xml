<?xml version="1.0" encoding="utf-8"?>
<!-- Spatiand on the Beam Pro: the glasses' shell in place of XREAL's Nebula. docs/beam-pro.md -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="id.prasetya.spatiand">
    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="34" />
    <uses-feature android:name="android.hardware.usb.host" />
    <!-- "Display over other apps", allowed once in Settings: the glasses' picture is an
         overlay, which sits above XREAL's NebulaOS placeholder where a Presentation does not. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Remote applications: the hosts are reached over QUIC. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The wearer's voice, for a host that asks for it (crates/spatiand/src/remote/microphone.rs). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- A gamepad's motors, for a game's rumble. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The WiFi lock that keeps WiFi out of power saving while the session is in front. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- All of shared storage, for SpatiShelf, SpatiLoupe and SpatiReel (docs/spatiand-apps.md):
         "all files access", granted once by android/setup.sh. No root. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Bluetooth LE for pages that use Web Bluetooth in SpatiMesh (BluetoothBridge.java): asked
         of the wearer the first time a page does; not for finding where the phone is. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- The notification the Wireless debugging pairing code is typed into (AdbStarter). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Turning Wireless debugging on when Spatiand's helper is needed after a restart: granted by
         the helper itself, only when the wearer asks it to (AdbStarter's "Do that by itself"). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-feature android:glEsVersion="0x00030000" />
    <!-- The phone's apps the room's launcher lists (Shell.listApps): what the home screen shows. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:label="Spatiand"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:debuggable="true">
        <!-- The phone's screen: the controller and the status. The glasses are a Presentation
             this activity puts on their display. Opened by plugging the glasses in, once it is
             the app chosen for them. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/glasses" />
        </activity>
        <!-- Opens the activity on plugging in: the attach *intent* goes to Nebula, fixed by
             XREAL's framework, but the attach *broadcast* goes to everyone. -->
        <receiver android:name=".Plugged" android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </receiver>
        <!-- Where Spatiand's shell helper (ShellHelper, run as the shell user) hands the app its
             Binder. Exported so the shell can reach it; it answers no one else. -->
        <!-- The pairing code typed into Spatiand's notification, and its other answers. -->
        <receiver android:name=".AdbStarter$Typed" android:exported="false" />
        <provider
            android:name=".ShellProvider"
            android:authorities="id.prasetya.spatiand.shell"
            android:exported="true" />
    </application>
</manifest>
