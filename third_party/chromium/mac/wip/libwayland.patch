diff -ru a/src/connection.c b/src/connection.c
--- a/src/connection.c	2026-11-13 08:27:51.299728389 +0700
+++ b/src/connection.c	2026-11-13 08:27:51.553169223 +0700
@@ -39,6 +39,11 @@
 #include <unistd.h>
 #include <sys/types.h>
 #include <sys/socket.h>
+
+/* Spatiand: macOS has no MSG_NOSIGNAL; its sockets are made with SO_NOSIGPIPE (wayland-os.c). */
+#ifndef MSG_NOSIGNAL
+#define MSG_NOSIGNAL 0
+#endif
 #include <time.h>
