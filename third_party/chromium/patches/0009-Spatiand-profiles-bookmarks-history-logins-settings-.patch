+
+constexpr char kFirstId[] = "default";
+constexpr char kFirstDir[] = "Default";
+constexpr char kDirPrefix[] = "Spatiand-";
+
+// The colours a new profile is given in turn, as SpatiMesh's other builds give them.
+constexpr std::array<std::array<uint8_t, 3>, 6> kColours = {{{55, 166, 247},
+                                                             {22, 230, 192},
+                                                             {143, 107, 242},
+                                                             {242, 160, 61},
+                                                             {235, 87, 120},
+                                                             {120, 200, 90}}};
