diff --git a/Source/cmake/WebKitCommon.cmake b/Source/cmake/WebKitCommon.cmake
index d96e18503..25d271ed8 100644
--- a/Source/cmake/WebKitCommon.cmake
+++ b/Source/cmake/WebKitCommon.cmake
@@ -6,6 +6,15 @@
 if (NOT HAS_RUN_WEBKIT_COMMON)
     set(HAS_RUN_WEBKIT_COMMON TRUE)
 
+    # Spatiand: Apple's own ports, the Cocoa ones, as against another port built on a Mac (WPE,
+    # for SpatiMesh). APPLE stays the toolchain's (Apple's linker, dylibs, frameworks to link);
+    # what is Apple's port's -- its sources, its frameworks, its headers -- asks this instead.
+    if (APPLE AND NOT PORT STREQUAL "WPE")
+        set(WEBKIT_COCOA ON)
+    else ()
+        set(WEBKIT_COCOA OFF)
+    endif ()
+
     # Preset values are not replayed on auto-reconfigure; if CMake's "compiler
     # changed" path wipes the cache, these silently revert. Stamp them outside
     # the cache and refuse to proceed if any go missing.
