new file mode 100644
index 0000000000..aeda57df2b
--- /dev/null
+++ b/components/spatikey/client.cc
@@ -0,0 +1,206 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/spatikey/client.h"
+
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <array>
+#include <cstring>
+#include <memory>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/containers/span.h"
+#include "base/environment.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_file.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "base/time/time.h"
+
+namespace spatikey {
+
+namespace {
+
+// As the service's own limit: the largest frame it sends or takes.
+constexpr size_t kLongestFrame = 512 * 1024;
+
+// A touch is given up on by the service at two minutes; this is only for a service that went away
+// without closing the socket.
+constexpr base::TimeDelta kLongestWait = base::Seconds(150);
+
+// How long what was heard of the service is good for.
+constexpr base::TimeDelta kUsableFor = base::Seconds(30);
+
+Refusal Unreachable(std::string why) {
+  return Refusal{"unreachable", "SpatiKey could not be asked: " + why};
+}
+
+base::FilePath SocketPath() {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  if (std::optional<std::string> named = env->GetVar("SPATIKEY_SOCKET"); named && !named->empty()) {
+    return base::FilePath(*named);
+  }
+  std::optional<std::string> runtime = env->GetVar("XDG_RUNTIME_DIR");
+  return runtime ? base::FilePath(*runtime).Append("spatikey.sock") : base::FilePath();
+}
+
+// On a thread that may wait. The whole conversation: connect, ask, and read one answer.
+Answer AskOnWorker(std::string request) {
+  // A thread sitting here for minutes is no thread for the pool's other work to wait for.
+  base::ScopedBlockingCall blocking(FROM_HERE, base::BlockingType::WILL_BLOCK);
+  const base::FilePath path = SocketPath();
+  if (path.empty()) {
+    return base::unexpected(Unreachable("there is no runtime folder"));
+  }
+  sockaddr_un address = {};
+  address.sun_family = AF_UNIX;
+  if (path.value().size() >= sizeof(address.sun_path)) {
+    return base::unexpected(Unreachable("its socket's path is too long"));
+  }
+  UNSAFE_BUFFERS(strncpy(address.sun_path, path.value().c_str(), sizeof(address.sun_path) - 1));
+  base::ScopedFD socket_fd(socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0));
+  if (!socket_fd.is_valid()) {
+    return base::unexpected(Unreachable("no socket"));
+  }
+  timeval longest = {};
+  longest.tv_sec = kLongestWait.InSeconds();
+  setsockopt(socket_fd.get(), SOL_SOCKET, SO_RCVTIMEO, &longest, sizeof(longest));
+  if (HANDLE_EINTR(connect(socket_fd.get(), reinterpret_cast<const sockaddr*>(&address),
+                           sizeof(address))) != 0) {
+    return base::unexpected(Unreachable("its service is not running"));
+  }
+  const std::array<uint8_t, 4> sending = base::U32ToBigEndian(static_cast<uint32_t>(request.size()));
+  if (!base::WriteFileDescriptor(socket_fd.get(), base::as_byte_span(sending)) ||
+      !base::WriteFileDescriptor(socket_fd.get(), request)) {
+    return base::unexpected(Unreachable("it stopped listening"));
+  }
+  std::array<uint8_t, 4> length;
+  if (!base::ReadFromFD(socket_fd.get(), base::as_writable_chars(base::span(length)))) {
+    return base::unexpected(Unreachable("it did not answer"));
+  }
+  const uint32_t size = base::U32FromBigEndian(length);
+  if (size == 0 || size > kLongestFrame) {
+    return base::unexpected(Unreachable("it answered nonsense"));
+  }
+  std::string text(size, '\0');
+  if (!base::ReadFromFD(socket_fd.get(), text)) {
+    return base::unexpected(Unreachable("it did not finish answering"));
+  }
+  std::optional<base::DictValue> reply = base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+  if (!reply) {
+    return base::unexpected(Unreachable("it answered nonsense"));
+  }
+  if (base::DictValue* err = reply->FindDict("err")) {
+    const std::string* code = err->FindString("code");
+    const std::string* message = err->FindString("message");
+    return base::unexpected(Refusal{code ? *code : "failed", message ? *message : "SpatiKey refused"});
+  }
+  if (base::DictValue* ok = reply->FindDict("ok")) {
+    return std::move(*ok);
+  }
+  // An answer with nothing to say.
+  return base::DictValue();
+}
+
+struct Heard {
+  bool usable = false;
+  base::TimeTicks when;
+  bool asking = false;
+  std::vector<base::OnceCallback<void(bool)>> waiting;
+};
+
+Heard& HeardOf() {
+  static base::NoDestructor<Heard> heard;
+  return *heard;
+}
+
+void OnStatus(Answer answer) {
+  Heard& heard = HeardOf();
+  heard.asking = false;
+  heard.when = base::TimeTicks::Now();
+  heard.usable = false;
+  if (answer.has_value() && answer->FindBool("vault").value_or(false)) {
+    const base::ListValue* approvers = answer->FindList("approvers");
+    heard.usable = answer->FindBool("opens_here").value_or(false) ||
+                   (approvers && !approvers->empty());
+  }
+  std::vector<base::OnceCallback<void(bool)>> waiting;
+  waiting.swap(heard.waiting);
+  for (auto& callback : waiting) {
+    std::move(callback).Run(heard.usable);
+  }
+}
+
+ProblemReporter& Reporter() {
+  static base::NoDestructor<ProblemReporter> reporter;
+  return *reporter;
+}
+
+}  // namespace
+
+void Ask(std::string_view op, base::DictValue fields, AnswerCallback callback) {
+  fields.Set("id", 1);
+  fields.Set("op", op);
+  std::string request;
+  CHECK(base::JSONWriter::Write(fields, &request));
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&AskOnWorker, std::move(request)), std::move(callback));
+}
+
+bool Usable() {
+  Heard& heard = HeardOf();
+  if (base::TimeTicks::Now() - heard.when > kUsableFor) {
+    CheckUsable();
+  }
+  return heard.usable;
+}
+
+void CheckUsable() {
+  Heard& heard = HeardOf();
+  if (heard.asking) {
+    return;
+  }
+  heard.asking = true;
+  Ask("status", base::DictValue(), base::BindOnce(&OnStatus));
+}
+
+void WhenUsableKnown(base::OnceCallback<void(bool)> callback) {
+  // Once anything has been heard, nothing waits for more (asking may take a second, on a machine
+  // that looks for its Mac): what was heard will do, and hearing again goes on behind it.
+  Heard& heard = HeardOf();
+  if (!heard.when.is_null()) {
+    const bool usable = Usable();
+    std::move(callback).Run(usable);
+    return;
+  }
+  heard.waiting.push_back(std::move(callback));
+  CheckUsable();
+}
+
+void SetProblemReporter(ProblemReporter reporter) {
+  Reporter() = std::move(reporter);
+}
+
+void ReportProblem(const std::u16string& message) {
+  if (Reporter()) {
+    Reporter().Run(message);
+  }
+}
+
+}  // namespace spatikey
diff --git a/components/spatikey/client.h b/components/spatikey/client.h
new file mode 100644
index 0000000000..7aefbb19cd
--- /dev/null
+++ b/components/spatikey/client.h
@@ -0,0 +1,51 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_SPATIKEY_CLIENT_H_
+#define COMPONENTS_SPATIKEY_CLIENT_H_
+
+#include <string>
+#include <string_view>
+
+#include "base/functional/callback.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+
+// SpatiKey is the only place Chromium's passwords and passkeys are kept (docs/spatikey.md): an
+// encrypted vault, opened by a fingerprint, that no program but its service can read. This asks
+// the service: a frame on its socket, a frame back, for each question.
+namespace spatikey {
+
+// Why there is no answer: the service's own reason, in the service's own words.
+struct Refusal {
+  // One of the service's codes ("denied", "no_match", ...), or "unreachable" if it cannot be asked.
+  std::string code;
+  std::string message;
+};
+
+using Answer = base::expected<base::DictValue, Refusal>;
+using AnswerCallback = base::OnceCallback<void(Answer)>;
+
+// Asks `op` with these fields; the answer comes on this sequence. It may take minutes: the service
+// waits for a touch.
+void Ask(std::string_view op, base::DictValue fields, AnswerCallback callback);
+
+// Whether there is a SpatiKey to ask: a vault, that this machine opens or has a Mac to ask. As last
+// heard, so this never waits; hearing again starts by itself when what was heard is getting old.
+bool Usable();
+
+// Starts hearing now, so that the first page to ask is told the truth.
+void CheckUsable();
+
+// Says the same thing, waiting only if nothing has been heard yet.
+void WhenUsableKnown(base::OnceCallback<void(bool)> callback);
+
+// Something the wearer should know about: a login not filled or not saved, and why. Whoever shows
+// messages sets this once; every part reports through it.
+using ProblemReporter = base::RepeatingCallback<void(const std::u16string&)>;
+void SetProblemReporter(ProblemReporter reporter);
+void ReportProblem(const std::u16string& message);
+
+}  // namespace spatikey
+
+#endif  // COMPONENTS_SPATIKEY_CLIENT_H_
diff --git a/components/spatikey/filled.cc b/components/spatikey/filled.cc
new file mode 100644
index 0000000000..2e684cc8e6
--- /dev/null
+++ b/components/spatikey/filled.cc
@@ -0,0 +1,71 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/spatikey/filled.h"
+
+#include <algorithm>
+#include <array>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/no_destructor.h"
+#include "base/rand_util.h"
+#include "base/time/time.h"
+#include "crypto/hash.h"
+
+namespace spatikey {
+
+namespace {
+
+// Long enough to finish a login, a slow second step included.
+constexpr base::TimeDelta kRememberedFor = base::Minutes(30);
+
+using Digest = std::array<uint8_t, crypto::hash::kSha256Size>;
+
+struct Filled {
+  Digest digest;
+  base::TimeTicks when;
+};
+
+std::vector<Filled>& AllFilled() {
+  static base::NoDestructor<std::vector<Filled>> filled;
+  return *filled;
+}
+
+Digest DigestOf(const url::Origin& origin, const std::u16string& password) {
+  // Fresh every time the browser starts; what it hashes never leaves this process.
+  static const std::array<uint8_t, 32> salt = [] {
+    std::array<uint8_t, 32> bytes;
+    base::RandBytes(bytes);
+    return bytes;
+  }();
+  crypto::hash::Hasher hasher(crypto::hash::HashKind::kSha256);
+  hasher.Update(salt);
+  hasher.Update(base::as_byte_span(origin.Serialize()));
+  hasher.Update(base::as_byte_span(std::string_view("\0", 1)));
+  hasher.Update(base::as_byte_span(password));
+  Digest digest;
+  hasher.Finish(digest);
+  return digest;
+}
+
+}  // namespace
+
+void RememberFilled(const url::Origin& origin, const std::u16string& password) {
+  std::vector<Filled>& filled = AllFilled();
+  const base::TimeTicks now = base::TimeTicks::Now();
+  std::erase_if(filled, [now](const Filled& one) { return now - one.when > kRememberedFor; });
+  filled.push_back({DigestOf(origin, password), now});
+}
+
+bool WasFilled(const url::Origin& origin, const std::u16string& password) {
+  const std::vector<Filled>& filled = AllFilled();
+  const Digest digest = DigestOf(origin, password);
+  const base::TimeTicks now = base::TimeTicks::Now();
+  return std::ranges::any_of(filled, [&](const Filled& one) {
+    return one.digest == digest && now - one.when <= kRememberedFor;
+  });
+}
+
+}  // namespace spatikey
