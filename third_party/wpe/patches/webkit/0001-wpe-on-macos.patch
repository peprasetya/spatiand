diff --git a/Source/WebKit/WPEPlatform/wpe/WPEBufferIOSurface.cpp b/Source/WebKit/WPEPlatform/wpe/WPEBufferIOSurface.cpp
new file mode 100644
index 000000000..edd1f6c37
--- /dev/null
+++ b/Source/WebKit/WPEPlatform/wpe/WPEBufferIOSurface.cpp
@@ -0,0 +1,130 @@
+/*
+ * Copyright (C) 2026 Spatiand. See WPEBufferIOSurface.h for the licence.
+ */
+
+#include "config.h"
+#include "WPEBufferIOSurface.h"
+
+#include "WPESurfaces.h"
+
+#include <IOSurface/IOSurfaceRef.h>
+#include <wtf/glib/WTFGType.h>
+
+/**
+ * WPEBufferIOSurface:
+ *
+ * A #WPEBuffer that is an IOSurface: on macOS the GPU memory a web process renders into and the
+ * embedder shows, with nothing copied. The surface is found by its global ID.
+ */
+struct _WPEBufferIOSurfacePrivate {
+    guint32 surfaceID;
+    IOSurfaceRef surface;
+};
+WEBKIT_DEFINE_FINAL_TYPE(WPEBufferIOSurface, wpe_buffer_iosurface, WPE_TYPE_BUFFER, WPEBuffer)
+
+enum {
+    PROP_0,
+    PROP_SURFACE_ID,
+    N_PROPERTIES
+};
+
+static std::array<GParamSpec*, N_PROPERTIES> sObjProperties;
+
+static void wpeBufferIOSurfaceSetProperty(GObject* object, guint propId, const GValue* value, GParamSpec* paramSpec)
+{
+    auto* buffer = WPE_BUFFER_IOSURFACE(object);
+    switch (propId) {
+    case PROP_SURFACE_ID:
+        buffer->priv->surfaceID = g_value_get_uint(value);
+        // Handed over by the web process in private, as its ID (WPESurfaces.h).
+        buffer->priv->surface = wpe_surfaces_open(buffer->priv->surfaceID);
+        break;
+    default:
+        G_OBJECT_WARN_INVALID_PROPERTY_ID(object, propId, paramSpec);
+    }
+}
+
+static void wpeBufferIOSurfaceGetProperty(GObject* object, guint propId, GValue* value, GParamSpec* paramSpec)
+{
+    auto* buffer = WPE_BUFFER_IOSURFACE(object);
+    switch (propId) {
+    case PROP_SURFACE_ID:
+        g_value_set_uint(value, buffer->priv->surfaceID);
+        break;
+    default:
+        G_OBJECT_WARN_INVALID_PROPERTY_ID(object, propId, paramSpec);
+    }
+}
+
+static void wpeBufferIOSurfaceDispose(GObject* object)
+{
+    auto* priv = WPE_BUFFER_IOSURFACE(object)->priv;
+    if (priv->surface) {
+        CFRelease(priv->surface);
+        priv->surface = nullptr;
+    }
+    G_OBJECT_CLASS(wpe_buffer_iosurface_parent_class)->dispose(object);
+}
+
+/* Its pixels read back (BGRA, premultiplied), for a snapshot: not how pictures are shown. */
+static GBytes* wpeBufferIOSurfaceImportToPixels(WPEBuffer* buffer, GError** error)
+{
+    auto* priv = WPE_BUFFER_IOSURFACE(buffer)->priv;
+    if (!priv->surface) {
+        g_set_error_literal(error, WPE_BUFFER_ERROR, WPE_BUFFER_ERROR_IMPORT_FAILED, "IOSurface not found");
+        return nullptr;
+    }
+    IOSurfaceLock(priv->surface, kIOSurfaceLockReadOnly, nullptr);
+    size_t width = IOSurfaceGetWidth(priv->surface);
+    size_t height = IOSurfaceGetHeight(priv->surface);
+    size_t stride = IOSurfaceGetBytesPerRow(priv->surface);
+    auto* base = static_cast<const uint8_t*>(IOSurfaceGetBaseAddress(priv->surface));
+    auto* pixels = static_cast<uint8_t*>(g_malloc(width * height * 4));
+    for (size_t row = 0; row < height; ++row)
+        memcpy(pixels + row * width * 4, base + row * stride, width * 4);
+    IOSurfaceUnlock(priv->surface, kIOSurfaceLockReadOnly, nullptr);
+    GBytes* bytes = g_bytes_new_take(pixels, width * height * 4);
+    g_object_set_data_full(G_OBJECT(buffer), "wpe-buffer-iosurface-pixels", bytes, reinterpret_cast<GDestroyNotify>(g_bytes_unref));
+    return bytes;
+}
+
+static void wpe_buffer_iosurface_class_init(WPEBufferIOSurfaceClass* bufferClass)
+{
+    GObjectClass* objectClass = G_OBJECT_CLASS(bufferClass);
+    objectClass->set_property = wpeBufferIOSurfaceSetProperty;
+    objectClass->get_property = wpeBufferIOSurfaceGetProperty;
+    objectClass->dispose = wpeBufferIOSurfaceDispose;
+
+    WPE_BUFFER_CLASS(bufferClass)->import_to_pixels = wpeBufferIOSurfaceImportToPixels;
+
+    /**
+     * WPEBufferIOSurface:surface-id:
+     *
+     * The IOSurface's global ID.
+     */
+    sObjProperties[PROP_SURFACE_ID] =
+        g_param_spec_uint(
+            "surface-id",
+            nullptr, nullptr,
+            0, G_MAXUINT32, 0,
+            static_cast<GParamFlags>(WEBKIT_PARAM_READWRITE | G_PARAM_CONSTRUCT_ONLY));
+
+    g_object_class_install_properties(objectClass, N_PROPERTIES, sObjProperties.data());
+}
+
+WPEBufferIOSurface* wpe_buffer_iosurface_new(WPEDisplay* display, int width, int height, guint32 surfaceID)
+{
+    g_return_val_if_fail(WPE_IS_DISPLAY(display), nullptr);
+    return WPE_BUFFER_IOSURFACE(g_object_new(WPE_TYPE_BUFFER_IOSURFACE,
+        "display", display,
+        "width", width,
+        "height", height,
+        "surface-id", surfaceID,
+        nullptr));
+}
+
+guint32 wpe_buffer_iosurface_get_id(WPEBufferIOSurface* buffer)
+{
+    g_return_val_if_fail(WPE_IS_BUFFER_IOSURFACE(buffer), 0);
+    return buffer->priv->surfaceID;
+}
