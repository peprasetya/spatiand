+namespace {
+
+// The languages Spatiand's AI settings offer, by their two letters, with their names in English
+// (crates/spatiand-ai: LANGUAGES).
+constexpr std::pair<const char*, const char*> kLanguages[] = {
+    {"en", "English"},  {"id", "Indonesian"}, {"ms", "Malay"},     {"jv", "Javanese"},
+    {"su", "Sundanese"}, {"zh", "Chinese"},   {"ja", "Japanese"},  {"ko", "Korean"},
+    {"th", "Thai"},      {"vi", "Vietnamese"}, {"tl", "Tagalog"},  {"hi", "Hindi"},
+    {"ta", "Tamil"},     {"te", "Telugu"},    {"ar", "Arabic"},    {"tr", "Turkish"},
+    {"ru", "Russian"},   {"el", "Greek"},     {"es", "Spanish"},   {"fr", "French"},
+    {"de", "German"},    {"nl", "Dutch"},     {"pt", "Portuguese"}, {"it", "Italian"},
+};
+
+// A language's name in English, or its code where it has none here.
+std::string LanguageName(const std::string& code) {
+  for (const auto& [known, name] : kLanguages) {
+    if (base::EqualsCaseInsensitiveASCII(code, known)) {
+      return name;
+    }
+  }
+  return code;
+}
+
+// More than this is not sent: a model's window is not a book's.
+constexpr size_t kMostCharacters = 20000;
+
+// Who translates, from the room's AI settings, with the settings' own defaults where they say
+// nothing (crates/spatiand-ai: Models, TextInPictures).
+struct Translator {
+  std::string hemera;
+  std::string model = "neohorse-1:4b";
+  std::string first = "en";
+  std::string second = "id";
+};
+
+// Read off the UI thread: a file.
+std::optional<Translator> LoadTranslator() {
+  std::optional<base::Value> value = ReadJson(SharedDir().DirName().Append("ai.json"));
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& dict = value->GetDict();
+  Translator translator;
+  if (const std::string* hemera = dict.FindString("hemera")) {
+    translator.hemera = *hemera;
+  }
+  while (!translator.hemera.empty() && translator.hemera.back() == '/') {
+    translator.hemera.pop_back();
+  }
+  if (translator.hemera.empty()) {
+    return std::nullopt;
+  }
+  if (const base::DictValue* models = dict.FindDict("models")) {
+    const std::string* everyday = models->FindString("everyday");
+    if (everyday && !everyday->empty()) {
+      translator.model = *everyday;
+    }
+  }
+  if (const base::DictValue* pictures = dict.FindDict("text_in_pictures")) {
+    const std::string* first = pictures->FindString("first_language");
+    if (first && !first->empty()) {
+      translator.first = *first;
+    }
+    const std::string* second = pictures->FindString("second_language");
+    if (second && !second->empty()) {
+      translator.second = *second;
+    }
+  }
+  return translator;
+}
+
+// The language the translation goes into: text in the first language goes into the second,
+// anything else -- the second, or a third -- into the first. `said` is the model's word for the
+// text's language: a code, as asked, or now and then a name ("Indonesian", "Bahasa").
+std::string Target(const std::string& said, const Translator& translator) {
+  std::string written = base::ToLowerASCII(said);
+  size_t begin = 0;
+  while (begin < written.size() && !base::IsAsciiAlpha(written[begin])) {
+    ++begin;
+  }
+  size_t end = written.size();
+  while (end > begin && !base::IsAsciiAlpha(written[end - 1])) {
+    --end;
+  }
+  written = written.substr(begin, end - begin);
+  std::string code;
+  for (const auto& [known, name] : kLanguages) {
+    if (base::EqualsCaseInsensitiveASCII(written, name)) {
+      code = known;
+    }
+  }
+  if (code.empty()) {
+    code = written == "bahasa" ? "id" : written.substr(0, 2);
+  }
+  return base::EqualsCaseInsensitiveASCII(code, translator.first) ? translator.second
+                                                                  : translator.first;
+}
+
+// A text's lines, a line's carriage return taken off.
+std::vector<std::string> Lines(const std::string& text) {
+  std::vector<std::string> lines =
+      base::SplitString(text, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  for (std::string& line : lines) {
+    if (!line.empty() && line.back() == '\r') {
+      line.pop_back();
+    }
+  }
+  return lines;
+}
+
+std::string Trimmed(std::string_view text) {
+  return std::string(base::TrimWhitespaceASCII(text, base::TRIM_ALL));
+}
+
+// The text's lines that have something in them, numbered from 1: "1| first line".
+std::string Numbered(const std::string& text) {
+  std::string numbered;
+  int n = 0;
+  for (const std::string& line : Lines(text)) {
+    std::string trimmed = Trimmed(line);
+    if (trimmed.empty()) {
+      continue;
+    }
+    if (!numbered.empty()) {
+      numbered += "\n";
+    }
+    numbered += base::NumberToString(++n) + "| " + trimmed;
+  }
+  return numbered;
+}
+
+// A chat request, thinking off, as both questions are asked.
+base::DictValue Question(const std::string& model,
+                         const std::string& system,
+                         const std::string& user,
+                         int max_tokens) {
+  return base::DictValue()
+      .Set("model", model)
+      .Set("messages", base::ListValue()
+                           .Append(base::DictValue().Set("role", "system").Set("content", system))
+                           .Append(base::DictValue().Set("role", "user").Set("content", user)))
+      .Set("temperature", 0)
+      .Set("max_tokens", max_tokens)
+      .Set("stream", false)
+      .Set("chat_template_kwargs", base::DictValue().Set("enable_thinking", false));
+}
+
+// The first question: which language the text is in.
+base::DictValue AskedLanguage(const std::string& model, const std::string& text) {
+  return Question(model,
+                  "Which language is the text written in? Answer with its two-letter ISO 639-1 "
+                  "code only (en, id, ja, zh, ar, ...), nothing else.",
+                  text, 8);
+}
+
+// The second question: the text, its lines numbered, into `target`.
+base::DictValue AskedTranslation(const std::string& model,
+                                 const std::string& text,
+                                 const std::string& target) {
+  // Enough for the translation of a page, and a little over what a language that takes more
+  // words than the other needs; never without end.
+  const int most = static_cast<int>(
+      std::min<size_t>(base::UTF8ToUTF16(text).size() * 4 + 256, 8192));
+  return Question(
+      model,
+      "Translate the text into " + LanguageName(target) +
+          ", line by line. Its lines are numbered: answer with the same numbered lines, "
+          "\"<number>| <translation>\", one for each line, nothing else. Translate every word, "
+          "a form's labels and field names too. Never change a digit: numbers, times, dates and "
+          "codes stay exactly as they are written (3 pm stays 3 pm).",
+      Numbered(text), most);
+}
+
+// A model's reply's text, thinking taken off.
+std::optional<std::string> ReplyText(const std::string& answer) {
+  std::optional<base::DictValue> dict = base::JSONReader::ReadDict(answer, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return std::nullopt;
+  }
+  const base::ListValue* choices = dict->FindList("choices");
+  if (!choices || choices->empty() || !(*choices)[0].is_dict()) {
+    return std::nullopt;
+  }
+  const std::string* content = (*choices)[0].GetDict().FindStringByDottedPath("message.content");
+  if (!content) {
+    return std::nullopt;
+  }
+  std::string text = Trimmed(*content);
+  if (base::StartsWith(text, "<think>")) {
+    const size_t close = text.find("</think>");
+    if (close != std::string::npos) {
+      text = Trimmed(std::string_view(text).substr(close + 8));
+    }
+  }
+  return text;
+}
+
+// The translation of `text`, from the numbered lines the model said: each line where its line
+// was, empty lines where there were empty lines; a line it left out, as it was. A reply that is not
+// numbered lines at all is taken as the translation, quotation marks round it taken off.
+std::optional<std::string> TranslationOf(const std::string& said, const std::string& text) {
+  std::map<size_t, std::string> lines;
+  for (const std::string& line : Lines(said)) {
+    const size_t bar = line.find('|');
+    if (bar == std::string::npos) {
+      continue;
+    }
+    size_t n = 0;
+    if (base::StringToSizeT(Trimmed(std::string_view(line).substr(0, bar)), &n)) {
+      lines[n] = Trimmed(std::string_view(line).substr(bar + 1));
+    }
+  }
+  size_t wanted = 0;
+  for (const std::string& line : Lines(text)) {
+    if (!Trimmed(line).empty()) {
+      ++wanted;
+    }
+  }
+  if (wanted > 0 && lines.size() * 2 >= wanted) {
+    std::vector<std::string> back;
+    size_t n = 0;
+    for (const std::string& line : Lines(text)) {
+      std::string trimmed = Trimmed(line);
+      if (trimmed.empty()) {
+        back.emplace_back();
+        continue;
+      }
+      ++n;
+      auto it = lines.find(n);
+      back.push_back(it != lines.end() ? it->second : trimmed);
+    }
+    std::string joined = Trimmed(base::JoinString(back, "\n"));
+    if (joined.empty()) {
+      return std::nullopt;
+    }
+    return joined;
+  }
+  std::string whole = Trimmed(said);
+  // "...", “...”, 「...」
+  constexpr std::pair<std::string_view, std::string_view> kQuotes[] = {
+      {"\"", "\""}, {"\xE2\x80\x9C", "\xE2\x80\x9D"}, {"\xE3\x80\x8C", "\xE3\x80\x8D"}};
+  for (const auto& [open, close] : kQuotes) {
+    if (whole.size() >= open.size() + close.size() && base::StartsWith(whole, open) &&
+        base::EndsWith(whole, close)) {
+      std::string_view inner = std::string_view(whole).substr(
+          open.size(), whole.size() - open.size() - close.size());
+      if (inner.find(open) == std::string_view::npos &&
+          inner.find(close) == std::string_view::npos) {
+        whole = Trimmed(inner);
+        break;
+      }
+    }
+  }
+  if (whole.empty()) {
+    return std::nullopt;
+  }
+  return whole;
+}
+
+constexpr net::NetworkTrafficAnnotationTag kTraffic =
+    net::DefineNetworkTrafficAnnotation("spatiand_translate", R"(
+        semantics {
+          sender: "Spatiand"
+          description:
+            "The text the wearer chose and asked to have translated is sent to the room's own "
+            "translator (hemera, on the wearer's own network), which says which language it is "
+            "in and then translates it into the other of the wearer's two languages."
+          trigger: "The wearer chooses Translate in a page's menu."
+          data: "The text chosen."
+          destination: OTHER
+          destination_other: "The wearer's own hemera, as Spatiand's AI settings name it."
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Only when the wearer asks."
+          policy_exception_justification: "Spatiand's own."
+        })");
+
+// A dialog's client view at its own size, so its window says so and the room offers it that size
+// (as the profile lock's, chrome/browser/spatiand/profile_lock_dialog.cc).
+class TranslationClientView : public views::DialogClientView {
+  METADATA_HEADER(TranslationClientView, views::DialogClientView)
+
+ public:
+  using views::DialogClientView::DialogClientView;
+
+  gfx::Size GetMinimumSize() const override { return GetPreferredSize({}); }
+  gfx::Size GetMaximumSize() const override { return GetPreferredSize({}); }
+};
+
+BEGIN_METADATA(TranslationClientView)
+END_METADATA
+
+// A window in the colours of SpatiMesh's own: light or dark as the Spatiand look is.
+class TranslationWidget : public views::Widget {
+ public:
+  const ui::NativeTheme* GetNativeTheme() const override {
+    return ui::NativeTheme::GetInstanceForNativeUi();
+  }
+};
+
+// The translation, in a window of its own: "Translating…", then the language it went into, the
+// translation (to be chosen from as well), Copy and Done. It owns its window and itself, both gone
+// when the window closes, and what it asked of hemera with them.
+class TranslationWindow : public views::DialogDelegate {
+ public:
+  TranslationWindow(scoped_refptr<network::SharedURLLoaderFactory> factory, std::string text)
+      : factory_(std::move(factory)), text_(std::move(text)) {
+    SetTitle(u"Translate");
+    SetModalType(ui::mojom::ModalType::kNone);
+    SetShowCloseButton(true);
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk));
+    SetButtonLabel(ui::mojom::DialogButton::kOk, u"Done");
+    views::View* contents = SetContentsView(std::make_unique<views::View>());
+    auto* layout = contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(16), 10));
+    // Wide enough for its title beside the room's buttons on its frame, however short the
+    // translation.
+    layout->set_minimum_cross_axis_size(440);
+    heading_ = contents->AddChildView(std::make_unique<views::Label>(u"Translating…"));
+    heading_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    heading_->SetFontList(heading_->font_list().DeriveWithWeight(gfx::Font::Weight::BOLD));
+    auto* scroll = contents->AddChildView(std::make_unique<views::ScrollView>());
+    scroll->SetHorizontalScrollBarMode(views::ScrollView::ScrollBarMode::kDisabled);
+    scroll->ClipHeightTo(0, 420);
+    translation_ = scroll->SetContents(std::make_unique<views::Label>());
+    translation_->SetMultiLine(true);
+    translation_->SetMaximumWidth(520);
+    translation_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    translation_->SetSelectable(true);
+    translation_->SetVisible(false);
+    said_ = contents->AddChildView(std::make_unique<views::Label>());
+    said_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    said_->SetMultiLine(true);
+    said_->SetMaximumWidth(520);
+    said_->SetVisible(false);
+    copy_ = SetExtraView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(&TranslationWindow::Copy, base::Unretained(this)), u"Copy"));
+    copy_->SetEnabled(false);
+  }
+  TranslationWindow(const TranslationWindow&) = delete;
+  TranslationWindow& operator=(const TranslationWindow&) = delete;
+  ~TranslationWindow() override = default;
+
+  // Shows it, and asks.
+  void Start() {
+    SetOwnershipOfNewWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+    window_ = std::make_unique<TranslationWidget>();
+    window_->Init(views::DialogDelegate::GetDialogWidgetInitParams(
+        this, /*context=*/gfx::NativeWindow(), /*parent=*/gfx::NativeView(), gfx::Rect()));
+    window_->MakeCloseSynchronous(
+        base::BindOnce(&TranslationWindow::Closed, base::Unretained(this)));
+    window_->Show();
+    if (base::UTF8ToUTF16(text_).size() > kMostCharacters) {
+      Fail(u"Too much is chosen to translate at once: choose less.");
+      return;
+    }
+    started_ = base::TimeTicks::Now();
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&LoadTranslator),
+        base::BindOnce(&TranslationWindow::Loaded, weak_factory_.GetWeakPtr()));
+  }
+
+  // views::DialogDelegate:
+  views::ClientView* CreateClientView(views::Widget* widget) override {
+    return new TranslationClientView(widget, TransferOwnershipOfContentsView());
+  }
+
+ private:
+  using Loaders = std::list<std::unique_ptr<network::SimpleURLLoader>>;
+  using Then = base::OnceCallback<void(std::string)>;
+
+  void Loaded(std::optional<Translator> translator) {
+    if (!translator) {
+      Fail(u"No translator is set: name hemera in Spatiand's AI settings.");
+      return;
+    }
+    translator_ = std::move(*translator);
+    Ask(AskedLanguage(translator_.model, text_),
+        base::BindOnce(&TranslationWindow::Written, weak_factory_.GetWeakPtr()));
+  }
+
+  void Written(std::string said) {
+    into_ = Target(said, translator_);
+    written_ = said.substr(0, 12);
+    Ask(AskedTranslation(translator_.model, text_, into_),
+        base::BindOnce(&TranslationWindow::Translated, weak_factory_.GetWeakPtr()));
+  }
+
+  void Translated(std::string said) {
+    std::optional<std::string> translation = TranslationOf(said, text_);
+    if (!translation) {
+      Fail(u"hemera's answer had no text in it.");
+      return;
+    }
+    // How much, which way and how long; never what.
+    LOG(INFO) << "Spatiand: translate: " << base::UTF8ToUTF16(text_).size() << " characters in "
+              << std::ranges::count(Numbered(text_), '\n') + 1 << " lines, written in \""
+              << written_ << "\", into " << into_ << ": "
+              << base::UTF8ToUTF16(*translation).size() << " characters, with "
+              << translator_.model << " in " << (base::TimeTicks::Now() - started_).InSecondsF()
+              << " s";
+    done_ = base::UTF8ToUTF16(*translation);
+    heading_->SetText(u"In " + base::UTF8ToUTF16(LanguageName(into_)));
+    translation_->SetText(done_);
+    translation_->SetVisible(true);
+    copy_->SetEnabled(true);
+    Refit();
+  }
+
+  // One question, on a request of its own; a 503 (hemera's model starting) waited out once for
+  // its Retry-After, as the room's other callers do.
+  void Ask(base::DictValue question, Then then, int tries_left = 2) {
+    std::string body;
+    base::JSONWriter::Write(question, &body);
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = GURL(translator_.hemera + "/v1/chat/completions");
+    request->method = "POST";
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    std::unique_ptr<network::SimpleURLLoader> loader =
+        network::SimpleURLLoader::Create(std::move(request), kTraffic);
+    loader->AttachStringForUpload(body, "application/json");
+    loader->SetAllowHttpErrorResults(true);
+    loader->SetTimeoutDuration(base::Seconds(60));
+    loaders_.push_front(std::move(loader));
+    auto it = loaders_.begin();
+    (*it)->DownloadToString(
+        factory_.get(),
+        base::BindOnce(&TranslationWindow::Answered, weak_factory_.GetWeakPtr(), it,
+                       std::move(question), std::move(then), tries_left),
+        /*max_body_size=*/4 * 1024 * 1024);
+  }
+
+  void Answered(Loaders::iterator it,
+                base::DictValue question,
+                Then then,
+                int tries_left,
+                std::optional<std::string> answer) {
+    std::unique_ptr<network::SimpleURLLoader> loader = std::move(*it);
+    loaders_.erase(it);
+    const int status = loader->ResponseInfo() && loader->ResponseInfo()->headers
+                           ? loader->ResponseInfo()->headers->response_code()
+                           : 0;
+    if (status == 503 && tries_left > 1) {
+      int wait = 2;
+      if (std::optional<std::string> after =
+              loader->ResponseInfo()->headers->GetNormalizedHeader("retry-after")) {
+        base::StringToInt(*after, &wait);
+      }
+      base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&TranslationWindow::Ask, weak_factory_.GetWeakPtr(), std::move(question),
+                         std::move(then), tries_left - 1),
+          base::Seconds(std::clamp(wait, 1, 30)));
+      return;
+    }
+    if (status == 0) {
+      Fail(u"hemera could not be reached (" +
+           base::UTF8ToUTF16(net::ErrorToShortString(loader->NetError())) + u").");
+      return;
+    }
+    if (status != 200 || !answer) {
+      Fail(u"hemera did not translate it (status " + base::NumberToString16(status) + u").");
+      return;
+    }
+    std::optional<std::string> said = ReplyText(*answer);
+    if (!said) {
+      Fail(u"hemera's answer was not readable.");
+      return;
+    }
+    std::move(then).Run(std::move(*said));
+  }
+
+  void Fail(const std::u16string& words) {
+    heading_->SetText(u"Not translated");
+    said_->SetText(words);
+    said_->SetVisible(true);
+    Refit();
+  }
+
+  void Copy() {
+    if (done_.empty()) {
+      return;
+    }
+    ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste).WriteText(done_);
+    said_->SetText(u"Copied.");
+    said_->SetVisible(true);
+    Refit();
+  }
+
+  // What it shows has grown or shrunk: the window takes its new size.
+  void Refit() {
+    if (!window_) {
+      return;
+    }
+    window_->OnSizeConstraintsChanged();
+    window_->SetSize(window_->non_client_view()->GetPreferredSize({}));
+  }
+
+  void Closed(views::Widget::ClosedReason) {
+    // Nothing more is asked or heard: the requests go with their loaders.
+    weak_factory_.InvalidateWeakPtrs();
+    loaders_.clear();
+    heading_ = nullptr;
+    translation_ = nullptr;
+    said_ = nullptr;
+    copy_ = nullptr;
+    window_.reset();
+    delete this;
+  }
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  const std::string text_;
+  Translator translator_;
+  std::string into_;
+  std::string written_;
+  std::u16string done_;
+  base::TimeTicks started_;
+  Loaders loaders_;
+  raw_ptr<views::Label> heading_ = nullptr;
+  raw_ptr<views::Label> translation_ = nullptr;
+  raw_ptr<views::Label> said_ = nullptr;
+  raw_ptr<views::MdTextButton> copy_ = nullptr;
+  std::unique_ptr<views::Widget> window_;
+  base::WeakPtrFactory<TranslationWindow> weak_factory_{this};
+};
+
+}  // namespace
+
+void TranslateChosen(content::WebContents* contents, const std::u16string& text) {
+  if (!contents || text.empty()) {
+    return;
+  }
+  // Its own: it deletes itself when its window closes.
+  (new TranslationWindow(contents->GetBrowserContext()
+                             ->GetDefaultStoragePartition()
+                             ->GetURLLoaderFactoryForBrowserProcess(),
+                         base::UTF16ToUTF8(text)))
+      ->Start();
+}
+
+}  // namespace spatiand
