From ea16f45c9dd011eba7bae59e9118cfb9df684cfc Mon Sep 17 00:00:00 2001
From: Spatiand build <claude@prasetya.id>
Date: Tue, 3 Nov 2026 05:51:09 +0700
Subject: [PATCH] Spatiand: bounce tracking no longer deletes all history

Cromite gave its DATA_TYPE_SKIP_SSL_HOST_STATE modifier the value 1 << 28, which is DATA_TYPE_CONTENT_END << 1, and so Chrome's DATA_TYPE_HISTORY. BtmServiceImpl adds the modifier to every clearing of a bounce tracker's state, which ran at most hourly, as soon as there was a site to clear, usually at a browser start. History has no per-site filter, so each one deleted the profile's whole history. The modifier now has a bit above every embedder datatype.
---
 content/public/browser/browsing_data_remover.h | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/content/public/browser/browsing_data_remover.h b/content/public/browser/browsing_data_remover.h
index 1e96933474..7d7745ab81 100644
--- a/content/public/browser/browsing_data_remover.h
+++ b/content/public/browser/browsing_data_remover.h
@@ -169,7 +169,10 @@ class BrowsingDataRemover {
   // Modifier flag used by Chrome to preserve SSL host state during a clear.
   // Keep this outside the content datatype range and distinct from runtime
   // modifiers such as DATA_TYPE_LOGICAL_CLEAR.
-  static constexpr DataType DATA_TYPE_SKIP_SSL_HOST_STATE = 1 << 28;
+  // Spatiand: above every embedder datatype. It was 1 << 28, which is also
+  // DATA_TYPE_CONTENT_END << 1, Chrome's DATA_TYPE_HISTORY, so every clearing of
+  // a bounce tracker's state deleted all history.
+  static constexpr DataType DATA_TYPE_SKIP_SSL_HOST_STATE = uint64_t{1} << 62;
 
   // Data stored by APIs in The Privacy Sandbox (https://privacysandbox.com/).
   static constexpr DataType DATA_TYPE_PRIVACY_SANDBOX =
-- 
