From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Spatiand build <spatiand@localhost>
Date: Fri, 13 Nov 2026 22:54:59 +0700
Subject: [PATCH 1/3] Do not block the build for incompatible profiles

---
 BUILD.gn | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/BUILD.gn b/BUILD.gn
index 8956a3dc..5e178a4f 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -3189,7 +3189,7 @@ template("run_mksnapshot") {
 
         # Replace this with --warn-about-builtin-profile-data to see the full
         # list of builtins with incompatible profiles.
-        "--abort-on-bad-builtin-profile-data",
+        "--warn-about-builtin-profile-data",
       ]
 
       if (!v8_enable_builtins_profiling && v8_enable_builtins_reordering) {
