+
+BluetoothAdapterSpatiand::BluetoothAdapterSpatiand() = default;
+
+BluetoothAdapterSpatiand::~BluetoothAdapterSpatiand() = default;
+
+void BluetoothAdapterSpatiand::Initialize(base::OnceClosure callback) {
+  initialized_callback_ = std::move(callback);
+  base::ScopedFD fd(socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0));
+  struct sockaddr_un where = {};
+  where.sun_family = AF_UNIX;
+  // Abstract: a zero, then the name.
+  memcpy(where.sun_path + 1, kSocket, sizeof(kSocket) - 1);
+  const socklen_t length = static_cast<socklen_t>(
+      offsetof(struct sockaddr_un, sun_path) + 1 + sizeof(kSocket) - 1);
+  if (!fd.is_valid() ||
+      HANDLE_EINTR(connect(fd.get(), reinterpret_cast<struct sockaddr*>(&where),
+                           length)) != 0) {
+    VLOG(1) << "No Bluetooth: the Spatiand app's bridge does not answer";
+    InitializeDone();
+    return;
+  }
+  socket_ = std::move(fd);
+  watch_ = base::FileDescriptorWatcher::WatchReadable(
+      socket_.get(), base::BindRepeating(&BluetoothAdapterSpatiand::OnReadable,
+                                         weak_factory_.GetWeakPtr()));
+  Send(base::DictValue().Set("op", "hello"));
+  // A bridge that says nothing is no adapter: Web Bluetooth is not kept
+  // waiting for it.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&BluetoothAdapterSpatiand::InitializeDone,
+                     weak_factory_.GetWeakPtr()),
+      base::Seconds(3));
+}
+
+void BluetoothAdapterSpatiand::InitializeDone() {
+  if (initialized_) {
+    return;
+  }
+  initialized_ = true;
+  if (initialized_callback_) {
+    std::move(initialized_callback_).Run();
+  }
+}
+
+void BluetoothAdapterSpatiand::Shutdown() {
+  watch_.reset();
+  socket_.reset();
+}
+
+void BluetoothAdapterSpatiand::Send(base::DictValue message) {
+  if (!socket_.is_valid()) {
+    return;
+  }
+  std::string line;
+  base::JSONWriter::Write(message, &line);
+  line += '\n';
+  size_t sent = 0;
+  while (sent < line.size()) {
+    const ssize_t n = HANDLE_EINTR(send(socket_.get(), line.data() + sent,
+                                        line.size() - sent, MSG_NOSIGNAL));
+    if (n > 0) {
+      sent += static_cast<size_t>(n);
+      continue;
+    }
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+      struct pollfd writable = {socket_.get(), POLLOUT, 0};
+      if (HANDLE_EINTR(poll(&writable, 1, 200)) > 0) {
+        continue;
+      }
+    }
+    Lost();
+    return;
+  }
+}
+
+void BluetoothAdapterSpatiand::OnReadable() {
+  char buffer[4096];
+  for (;;) {
+    const ssize_t n = HANDLE_EINTR(read(socket_.get(), buffer, sizeof(buffer)));
+    if (n > 0) {
+      incoming_.append(buffer, static_cast<size_t>(n));
+      continue;
+    }
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+      break;
+    }
+    Lost();
+    return;
+  }
+  size_t start = 0;
+  for (size_t end = incoming_.find('\n'); end != std::string::npos;
+       end = incoming_.find('\n', start)) {
+    std::optional<base::DictValue> message = base::JSONReader::ReadDict(
+        std::string_view(incoming_).substr(start, end - start),
+        base::JSON_PARSE_RFC);
+    start = end + 1;
+    if (message) {
+      Handle(*message);
+    }
+    if (!socket_.is_valid()) {
+      return;
+    }
+  }
+  incoming_.erase(0, start);
+}
+
+void BluetoothAdapterSpatiand::Lost() {
+  watch_.reset();
+  socket_.reset();
+  incoming_.clear();
+  const bool was_present = present_;
+  const bool was_powered = powered_;
+  present_ = false;
+  powered_ = false;
+  discovering_ = false;
+  InitializeDone();
+  for (auto& [address, device] : devices_) {
+    static_cast<BluetoothDeviceSpatiand*>(device.get())
+        ->OnConnection(false, kGattFailure);
+  }
+  if (was_powered) {
+    NotifyAdapterPoweredChanged(false);
+  }
+  if (was_present) {
+    NotifyAdapterPresentChanged(false);
+  }
+  MarkDiscoverySessionsAsInactive();
+}
+
+void BluetoothAdapterSpatiand::Handle(const base::DictValue& message) {
+  const std::string* ev = message.FindString("ev");
+  if (!ev) {
+    return;
+  }
+  if (*ev == "adapter") {
+    if (const std::string* address = message.FindString("address")) {
+      address_ = *address;
+    }
+    if (const std::string* name = message.FindString("name")) {
+      name_ = *name;
+    }
+    const bool was_present = present_;
+    const bool was_powered = powered_;
+    present_ = message.FindBool("present").value_or(false);
+    powered_ = message.FindBool("powered").value_or(false);
+    if (!initialized_) {
+      InitializeDone();
+      return;
+    }
+    if (present_ != was_present) {
+      NotifyAdapterPresentChanged(present_);
+    }
+    if (powered_ != was_powered) {
+      NotifyAdapterPoweredChanged(powered_);
+      if (!powered_) {
+        discovering_ = false;
+        MarkDiscoverySessionsAsInactive();
+      }
+    }
+    return;
+  }
+  if (*ev == "device") {
+    const std::string* address = message.FindString("address");
+    if (!address) {
+      return;
+    }
+    BluetoothDeviceSpatiand* device = DeviceAt(*address);
+    const bool added = !device;
+    if (added) {
+      auto made = std::make_unique<BluetoothDeviceSpatiand>(this, *address);
+      device = made.get();
+      devices_[*address] = std::move(made);
+    }
+    device->OnAdvertisement(message);
+    if (added) {
+      for (auto& observer : observers_) {
+        observer.DeviceAdded(this, device);
+      }
+    } else {
+      NotifyDeviceChanged(device);
+    }
+    return;
+  }
+  if (*ev == "scanFailed") {
+    discovering_ = false;
+    MarkDiscoverySessionsAsInactive();
+    return;
+  }
+  if (*ev == "connection" || *ev == "services") {
+    const std::string* address = message.FindString("address");
+    BluetoothDeviceSpatiand* device = address ? DeviceAt(*address) : nullptr;
+    if (!device) {
+      return;
+    }
+    if (*ev == "connection") {
+      device->OnConnection(message.FindBool("connected").value_or(false),
+                           message.FindInt("status").value_or(kGattFailure));
+    } else if (const base::ListValue* services =
+                   message.FindList("services")) {
+      device->OnServices(*services);
+    }
+    return;
+  }
+  const std::string* id = message.FindString("id");
+  if (!id) {
+    return;
+  }
+  const int status = message.FindInt("status").value_or(kGattFailure);
+  if (*ev == "descriptorRead" || *ev == "descriptorWrote") {
+    BluetoothRemoteGattDescriptorSpatiand* descriptor = DescriptorOf(*id);
+    if (!descriptor) {
+      return;
+    }
+    if (*ev == "descriptorRead") {
+      descriptor->OnRead(status, Unhex(message.FindString("value")));
+    } else {
+      descriptor->OnWrote(status);
+    }
+    return;
+  }
+  BluetoothRemoteGattCharacteristicSpatiand* characteristic =
+      CharacteristicOf(*id);
+  if (!characteristic) {
+    return;
+  }
+  if (*ev == "read") {
+    characteristic->OnRead(status, Unhex(message.FindString("value")));
+  } else if (*ev == "wrote") {
+    characteristic->OnWrote(status);
+  } else if (*ev == "notifying") {
+    characteristic->OnNotifying(status);
+  } else if (*ev == "changed") {
+    characteristic->OnChanged(Unhex(message.FindString("value")));
+  }
+}
+
+BluetoothDeviceSpatiand* BluetoothAdapterSpatiand::DeviceAt(
+    const std::string& address) const {
+  auto it = devices_.find(address);
+  return it == devices_.end()
+             ? nullptr
+             : static_cast<BluetoothDeviceSpatiand*>(it->second.get());
+}
+
+BluetoothRemoteGattCharacteristicSpatiand*
+BluetoothAdapterSpatiand::CharacteristicOf(const std::string& id) const {
+  // Named by the device's address first: "AA:BB:CC:DD:EE:FF/s0/c1".
+  BluetoothDeviceSpatiand* device = DeviceAt(id.substr(0, id.find('/')));
+  return device ? device->CharacteristicOf(id) : nullptr;
+}
