From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Spatiand build <spatiand@localhost>
Date: Fri, 13 Nov 2026 22:54:59 +0700
Subject: [PATCH 3/3] Allows v8 to be build in non-debug mode while Chromium is
 in debug mode

---
 BUILD.gn                                      | 6 ++++++
 src/snapshot/embedded/embedded-file-writer.cc | 2 ++
 src/snapshot/embedded/embedded-file-writer.h  | 2 ++
 3 files changed, 10 insertions(+)

diff --git a/BUILD.gn b/BUILD.gn
index 5e178a4f..06588801 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -8415,6 +8415,12 @@ if (current_toolchain == v8_snapshot_toolchain) {
       ":disable_icf",
     ]
 
+    if (is_debug && !v8_enable_debugging_features) {
+      defines = [
+        "V8_SKIP_DEBUGGING_FEATURES_VALUE",
+      ]
+    }
+
     deps = [
       ":v8_base_without_compiler",
       ":v8_compiler_for_mksnapshot",
diff --git a/src/snapshot/embedded/embedded-file-writer.cc b/src/snapshot/embedded/embedded-file-writer.cc
index a8db1d8e..ca15507b 100644
--- a/src/snapshot/embedded/embedded-file-writer.cc
+++ b/src/snapshot/embedded/embedded-file-writer.cc
@@ -89,8 +89,10 @@ void EmbeddedFileWriter::WriteBuiltin(PlatformEmbeddedFileWriterBase* w,
   v8::internal::SourcePositionTableIterator positions(
       vpos, SourcePositionTableIterator::kExternalOnly);
 
+#ifndef V8_SKIP_DEBUGGING_FEATURES_VALUE
 #ifndef DEBUG
   CHECK(positions.done());  // Release builds must not contain debug infos.
+#endif
 #endif
 
   // Some builtins (InterpreterPushArgsThenFastConstructFunction,
diff --git a/src/snapshot/embedded/embedded-file-writer.h b/src/snapshot/embedded/embedded-file-writer.h
index 99c93940..0e9240c6 100644
--- a/src/snapshot/embedded/embedded-file-writer.h
+++ b/src/snapshot/embedded/embedded-file-writer.h
@@ -104,9 +104,11 @@ class EmbeddedFileWriter : public EmbeddedFileWriterInterface {
   }
 
   void WriteExternalFilenames(PlatformEmbeddedFileWriterBase* w) const {
+#ifndef V8_SKIP_DEBUGGING_FEATURES_VALUE
 #ifndef DEBUG
     // Release builds must not contain debug infos.
     CHECK_EQ(external_filenames_by_index_.size(), 0);
+#endif
 #endif
 
     w->Comment(
