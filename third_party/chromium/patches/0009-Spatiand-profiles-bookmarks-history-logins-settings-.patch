index 0000000000..e9309f81cc
--- /dev/null
+++ b/chrome/browser/spatiand/shared_folder.cc
@@ -0,0 +1,214 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/spatiand/shared_folder.h"
+
+#include <cmath>
+#include <memory>
+
+#include "base/base_paths.h"
+#include "base/environment.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/json/string_escape.h"
+#include "base/process/process_handle.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+
+namespace spatiand {
+
+namespace {
+
+base::FilePath ConfigRoot() {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  if (std::optional<std::string> named = env->GetVar("SPATIAND_APPS_CONFIG");
+      named && !named->empty()) {
+    return base::FilePath(*named);
+  }
+  base::FilePath base;
+  if (std::optional<std::string> config = env->GetVar("XDG_CONFIG_HOME");
+      config && base::FilePath(*config).IsAbsolute()) {
+    base = base::FilePath(*config);
+  } else {
+    base = base::GetHomeDir().Append(".config");
+  }
+  return base.Append("spatiand");
+}
+
+// JSON as SpatiMesh's other builds read it. A time in milliseconds does not fit a base::Value's
+// integer, so it is kept as a double, and base's writer would then put a ".0" on it, which those
+// builds, reading a whole number, refuse: a whole number is written as one here.
+void AppendJson(const base::Value& value, int depth, std::string* out) {
+  const std::string indent(2 * (depth + 1), ' ');
+  const std::string closing(2 * depth, ' ');
+  switch (value.type()) {
+    case base::Value::Type::NONE:
+      out->append("null");
+      break;
+    case base::Value::Type::BOOLEAN:
+      out->append(value.GetBool() ? "true" : "false");
+      break;
+    case base::Value::Type::INTEGER:
+      out->append(base::NumberToString(value.GetInt()));
+      break;
+    case base::Value::Type::DOUBLE: {
+      const double number = value.GetDouble();
+      if (number == std::trunc(number) && std::fabs(number) < 9.0e15) {
+        out->append(base::NumberToString(static_cast<int64_t>(number)));
+      } else {
+        std::string text;
+        base::JSONWriter::Write(value, &text);
+        out->append(text);
+      }
+      break;
+    }
+    case base::Value::Type::STRING:
+      base::EscapeJSONString(value.GetString(), /*put_in_quotes=*/true, out);
+      break;
+    case base::Value::Type::BINARY:
+      out->append("null");
+      break;
+    case base::Value::Type::DICT: {
+      if (value.GetDict().empty()) {
+        out->append("{}");
+        break;
+      }
+      out->append("{\n");
+      bool first = true;
+      for (const auto [key, item] : value.GetDict()) {
+        if (!first) {
+          out->append(",\n");
+        }
+        first = false;
+        out->append(indent);
+        base::EscapeJSONString(key, /*put_in_quotes=*/true, out);
+        out->append(": ");
+        AppendJson(item, depth + 1, out);
+      }
+      out->append("\n" + closing + "}");
+      break;
+    }
+    case base::Value::Type::LIST: {
+      if (value.GetList().empty()) {
+        out->append("[]");
+        break;
+      }
+      out->append("[\n");
+      bool first = true;
+      for (const base::Value& item : value.GetList()) {
+        if (!first) {
+          out->append(",\n");
+        }
+        first = false;
+        out->append(indent);
+        AppendJson(item, depth + 1, out);
+      }
+      out->append("\n" + closing + "]");
+      break;
+    }
+  }
+}
+
+}  // namespace
+
+base::FilePath SharedDir() {
+  return ConfigRoot().Append("apps").Append("spatimesh");
+}
+
+base::FilePath LocalDir() {
+  return ConfigRoot().Append("local").Append("spatimesh-chromium");
+}
+
+base::FilePath SharedProfileDir(const std::string& profile) {
+  return SharedDir().Append("profiles").Append(profile);
+}
+
+base::FilePath LocalProfileDir(const std::string& profile) {
+  return LocalDir().Append("profiles").Append(profile);
+}
+
+std::optional<base::Value> ReadJson(const base::FilePath& path) {
+  std::string text;
+  if (!base::ReadFileToString(path, &text)) {
+    return std::nullopt;
+  }
+  return base::JSONReader::Read(text, base::JSON_PARSE_RFC);
+}
+
+bool WriteJson(const base::FilePath& path, const base::Value& value) {
+  // Unchanged is not written: a write is a change to every machine that syncs it.
+  if (std::optional<base::Value> old = ReadJson(path); old && *old == value) {
+    return true;
+  }
+  const base::FilePath dir = path.DirName();
+  if (!base::CreateDirectory(dir)) {
+    return false;
+  }
+  std::string text;
+  AppendJson(value, 0, &text);
+  const base::FilePath temporary = dir.Append(base::StringPrintf(
+      ".%s.%d.new", path.BaseName().value().c_str(), base::GetCurrentProcId()));
+  if (!base::WriteFile(temporary, text)) {
+    return false;
+  }
+  if (!base::ReplaceFile(temporary, path, nullptr)) {
+    base::DeleteFile(temporary);
+    return false;
+  }
+  return true;
+}
+
+bool WriteJsonAsIfLongAgo(const base::FilePath& path, const base::Value& value) {
+  if (base::PathExists(path)) {
+    return true;
+  }
+  if (!WriteJson(path, value)) {
+    return false;
+  }
+  const base::Time long_ago = base::Time::UnixEpoch() + base::Seconds(1);
+  return base::TouchFile(path, long_ago, long_ago);
+}
+
+void RemovePath(const base::FilePath& path) {
+  base::DeletePathRecursively(path);
+}
+
+std::vector<std::string> ListJson(const base::FilePath& dir) {
+  std::vector<std::string> names;
+  base::FileEnumerator files(dir, /*recursive=*/false, base::FileEnumerator::FILES,
+                             FILE_PATH_LITERAL("*.json"));
+  for (base::FilePath file = files.Next(); !file.empty(); file = files.Next()) {
+    const std::string name = file.BaseName().RemoveFinalExtension().value();
+    if (!name.empty() && !name.starts_with('.')) {
+      names.push_back(name);
+    }
+  }
+  return names;
+}
+
+base::Time FolderChanged(const base::FilePath& dir) {
+  base::File::Info info;
+  return base::GetFileInfo(dir, &info) ? info.last_modified : base::Time();
+}
+
+std::string NewId() {
+  return base::ToLowerASCII(base::HexEncode(base::RandBytesAsVector(8)));
+}
+
+int64_t NowMs() {
+  return base::Time::Now().InMillisecondsSinceUnixEpoch();
+}
+
+base::Time TimeOfMs(double ms) {
+  return base::Time::UnixEpoch() + base::Milliseconds(ms);
+}
+
+double MsOfTime(base::Time time) {
+  return static_cast<double>(time.InMillisecondsSinceUnixEpoch());
+}
+
+}  // namespace spatiand
