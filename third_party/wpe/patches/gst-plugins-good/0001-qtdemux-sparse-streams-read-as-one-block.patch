+  /* Spatiand: a sparse stream's sample comes out of a block of its own data read in one go
+   * (QTDEMUX_SPARSE_BLOCK), not by a seek of its own: subtitles a muxer stored together at the
+   * end of a large file would otherwise send every read there and back, which over the
+   * network is a film that does not play. */
+  if (CUR_STREAM (stream)->sparse && !stream->use_allocator) {
+#define QTDEMUX_SPARSE_BLOCK (1024 * 1024)
+    guint64 at = offset + stream->offset_in_sample;
+    if (!stream->sparse_block || at < stream->sparse_block_offset
+        || at + size > stream->sparse_block_offset +
+        gst_buffer_get_size (stream->sparse_block)) {
+      GstBuffer *block = NULL;
+      gst_clear_buffer (&stream->sparse_block);
+      ret = gst_pad_pull_range (qtdemux->sinkpad, at,
+          MAX (size, QTDEMUX_SPARSE_BLOCK), &block);
+      if (G_UNLIKELY (ret != GST_FLOW_OK))
+        goto beach;
+      stream->sparse_block = block;
+      stream->sparse_block_offset = at;
+      GST_DEBUG_OBJECT (qtdemux, "read a block of %" G_GSIZE_FORMAT
+          " bytes of a sparse stream at %" G_GUINT64_FORMAT,
+          gst_buffer_get_size (block), at);
+    }
+    if (at + size > stream->sparse_block_offset +
+        gst_buffer_get_size (stream->sparse_block)) {
+      ret = GST_FLOW_EOS;
+      goto beach;
+    }
+    if (buf)
+      gst_buffer_unref (buf);
+    buf = gst_buffer_copy_region (stream->sparse_block, GST_BUFFER_COPY_ALL,
+        at - stream->sparse_block_offset, size);
+  } else {
+    ret = gst_qtdemux_pull_atom (qtdemux, offset + stream->offset_in_sample,
+        size, &buf);
+    if (G_UNLIKELY (ret != GST_FLOW_OK))
+      goto beach;
+  }
 
