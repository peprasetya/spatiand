+
+#ifndef DEVICE_FIDO_SPATIKEY_SPATIKEY_DISCOVERY_H_
+#define DEVICE_FIDO_SPATIKEY_SPATIKEY_DISCOVERY_H_
+
+#include <memory>
+
+#include "base/memory/weak_ptr.h"
+#include "device/fido/fido_discovery_base.h"
+
+namespace device {
+
+class SpatikeyAuthenticator;
+
+// Finds SpatiKey's authenticator when there is a SpatiKey to ask.
+class SpatikeyDiscovery : public FidoDiscoveryBase {
+ public:
+  SpatikeyDiscovery();
+  SpatikeyDiscovery(const SpatikeyDiscovery&) = delete;
+  SpatikeyDiscovery& operator=(const SpatikeyDiscovery&) = delete;
+  ~SpatikeyDiscovery() override;
+
+  // FidoDiscoveryBase:
+  void Start() override;
+
+ private:
+  void OnUsableKnown(bool usable);
+
+  std::unique_ptr<SpatikeyAuthenticator> authenticator_;
+  base::WeakPtrFactory<SpatikeyDiscovery> weak_factory_{this};
+};
+
+}  // namespace device
+
+#endif  // DEVICE_FIDO_SPATIKEY_SPATIKEY_DISCOVERY_H_
