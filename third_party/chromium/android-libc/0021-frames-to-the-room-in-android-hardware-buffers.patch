+    CommitWhenDrawn();
+    return;
+  }
+  ReadPixels(next_buffer->shm_mapping_);
+#else
   ReadPixels(next_buffer->shm_mapping_);
+#endif
 
   const auto bounds = gfx::Rect(GetSize());
   constexpr bool enable_blend_for_shadow = true;
@@ -141,6 +222,11 @@ void GLSurfaceEglReadbackWayland::OnSubmission(
   DCHECK(release_fence.is_null());
   --pending_frames_;
 
+#if defined(__TERMUX__)
+  if (in_flight_pixel_buffers_.empty() || completion_callbacks_.empty()) {
+    return;
+  }
+#endif
   if (in_flight_pixel_buffers_.front()) {
     if (displayed_buffer_)
       available_buffers_.push_back(std::move(displayed_buffer_));
@@ -165,17 +251,227 @@ void GLSurfaceEglReadbackWayland::OnPresentation(
 }
 
 void GLSurfaceEglReadbackWayland::DestroyBuffers() {
+#if defined(__TERMUX__)
+  CommitNow();
+  for (const auto& pixel_buffer : available_buffers_)
+    DestroyHardwareBuffer(pixel_buffer.get());
+  if (displayed_buffer_)
+    DestroyHardwareBuffer(displayed_buffer_.get());
+  // Frames still in flight when the window is resized are answered for later
+  // (OnSubmission), so their places are kept, empty, as OnSubmission expects:
+  // emptied, the queue was read past its end and the GPU process died (seen
+  // on the Beam Pro as the room resized a SpatiMesh window).
+  for (auto& pixel_buffer : in_flight_pixel_buffers_) {
+    if (pixel_buffer) {
+      DestroyHardwareBuffer(pixel_buffer.get());
+      buffer_manager_->DestroyBuffer(pixel_buffer->buffer_id_);
+      pixel_buffer.reset();
+    }
+  }
+#endif
   for (const auto& pixel_buffer : available_buffers_)
     buffer_manager_->DestroyBuffer(pixel_buffer->buffer_id_);
+#if !defined(__TERMUX__)
   for (const auto& pixel_buffer : in_flight_pixel_buffers_)
     buffer_manager_->DestroyBuffer(pixel_buffer->buffer_id_);
+#endif
 
   if (displayed_buffer_)
     buffer_manager_->DestroyBuffer(displayed_buffer_->buffer_id_);
 
   available_buffers_.clear();
+#if !defined(__TERMUX__)
   in_flight_pixel_buffers_.clear();
+#endif
   displayed_buffer_.reset();
 }
 
+#if defined(__TERMUX__)
+bool GLSurfaceEglReadbackWayland::CreateHardwareBuffers(const gfx::Size& size) {
+  const HardwareBufferCalls& calls = Calls();
+  const std::vector<uint64_t> modifiers =
+      buffer_manager_->GetModifiersForFormat(viz::SinglePlaneFormat::kRGBA_8888);
+  if (!calls.valid() || !gl::GLContext::GetCurrent() ||
+      std::find(modifiers.begin(), modifiers.end(),
+                kSpatiandHardwareBufferModifier) == modifiers.end()) {
+    return false;
+  }
+  GLint draw_framebuffer = 0;
+  GLint read_framebuffer = 0;
+  GLint texture_binding = 0;
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw_framebuffer);
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_framebuffer);
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture_binding);
+
+  std::vector<std::unique_ptr<PixelBuffer>> made;
+  std::vector<uint32_t> sent;
+  bool ok = true;
+  for (size_t i = 0; ok && i < kMaxHardwareBuffers; ++i) {
+    auto buffer = std::make_unique<PixelBuffer>(
+        base::WritableSharedMemoryMapping(), buffer_manager_->AllocateBufferID());
+    AHardwareBuffer_Desc description = {};
+    description.width = size.width();
+    description.height = size.height();
+    description.layers = 1;
+    description.format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM;
+    description.usage = AHARDWAREBUFFER_USAGE_GPU_FRAMEBUFFER |
+                        AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE;
+    if (calls.allocate(&description, &buffer->hardware_buffer_) != 0) {
+      buffer->hardware_buffer_ = nullptr;
+      ok = false;
+      break;
+    }
+    calls.describe(buffer->hardware_buffer_, &description);
+
+    // ANGLE's image of it, and a framebuffer to copy each frame into it.
+    const EGLint attributes[] = {EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
+    buffer->image_ = eglCreateImageKHR(
+        GetEGLDisplay(), EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
+        reinterpret_cast<EGLClientBuffer>(buffer->hardware_buffer_),
+        attributes);
+    if (buffer->image_ == EGL_NO_IMAGE_KHR) {
+      buffer->image_ = nullptr;
+      made.push_back(std::move(buffer));
+      ok = false;
+      break;
+    }
+    glGenTextures(1, &buffer->texture_);
+    glBindTexture(GL_TEXTURE_2D, buffer->texture_);
+    glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, buffer->image_);
+    glGenFramebuffersEXT(1, &buffer->framebuffer_);
+    glBindFramebufferEXT(GL_FRAMEBUFFER, buffer->framebuffer_);
+    glFramebufferTexture2DEXT(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                              GL_TEXTURE_2D, buffer->texture_, 0);
+    ok = glCheckFramebufferStatusEXT(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+
+    // The room's half: the buffer goes through a socket, which the room's
+    // EGL reads it from when it is given the socket as a dmabuf's file.
+    int sockets[2] = {-1, -1};
+    if (ok && socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0,
+                         sockets) == 0) {
+      base::ScopedFD reader(sockets[0]);
+      base::ScopedFD writer(sockets[1]);
+      ok = calls.send(buffer->hardware_buffer_, writer.get()) == 0;
+      if (ok) {
+        buffer_manager_->CreateDmabufBasedBuffer(
+            std::move(reader), size, {description.stride * 4}, {0},
+            {kSpatiandHardwareBufferModifier}, DRM_FORMAT_ABGR8888, 1,
+            gfx::ColorSpace::CreateSRGB(), gfx::HDRMetadata(),
+            buffer->buffer_id_);
+        sent.push_back(buffer->buffer_id_);
+      }
+    } else {
+      ok = false;
+    }
+    made.push_back(std::move(buffer));
+  }
+
+  glBindFramebufferEXT(GL_DRAW_FRAMEBUFFER, draw_framebuffer);
+  glBindFramebufferEXT(GL_READ_FRAMEBUFFER, read_framebuffer);
+  glBindTexture(GL_TEXTURE_2D, texture_binding);
+
+  if (!ok) {
+    LOG(WARNING) << "Frames go to the room read back into shared memory: no "
+                    "hardware buffer for them";
+    for (auto& buffer : made) {
+      DestroyHardwareBuffer(buffer.get());
+    }
+    for (uint32_t id : sent) {
+      buffer_manager_->DestroyBuffer(id);
+    }
+    return false;
+  }
+  for (auto& buffer : made) {
+    available_buffers_.push_back(std::move(buffer));
+  }
+  return true;
+}
+
+void* GLSurfaceEglReadbackWayland::CopyIntoHardwareBuffer(PixelBuffer* buffer) {
+  const gfx::Size size = GetSize();
+  GLint draw_framebuffer = 0;
+  GLint read_framebuffer = 0;
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw_framebuffer);
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_framebuffer);
+  const bool scissor = glIsEnabled(GL_SCISSOR_TEST);
+  if (scissor) {
+    glDisable(GL_SCISSOR_TEST);
+  }
+  glBindFramebufferEXT(GL_READ_FRAMEBUFFER, 0);
+  glBindFramebufferEXT(GL_DRAW_FRAMEBUFFER, buffer->framebuffer_);
+  glBlitFramebuffer(0, 0, size.width(), size.height(), 0, 0, size.width(),
+                    size.height(), GL_COLOR_BUFFER_BIT, GL_NEAREST);
+  glBindFramebufferEXT(GL_DRAW_FRAMEBUFFER, draw_framebuffer);
+  glBindFramebufferEXT(GL_READ_FRAMEBUFFER, read_framebuffer);
+  if (scissor) {
+    glEnable(GL_SCISSOR_TEST);
+  }
+  EGLSyncKHR fence =
+      eglCreateSyncKHR(GetEGLDisplay(), EGL_SYNC_FENCE_KHR, nullptr);
+  glFlush();
+  return fence;
+}
+
+void GLSurfaceEglReadbackWayland::CommitWhenDrawn() {
+  if (!pending_commit_) {
+    return;
+  }
+  if (pending_commit_->fence &&
+      eglClientWaitSyncKHR(GetEGLDisplay(), pending_commit_->fence, 0, 0) ==
+          EGL_TIMEOUT_EXPIRED_KHR) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&GLSurfaceEglReadbackWayland::CommitWhenDrawn,
+                       base::WrapRefCounted(this)),
+        base::Milliseconds(1));
+    return;
+  }
+  CommitNow();
+}
+
+void GLSurfaceEglReadbackWayland::CommitNow() {
+  if (!pending_commit_) {
+    return;
+  }
+  PendingCommit commit = std::move(*pending_commit_);
+  pending_commit_.reset();
+  if (commit.fence) {
+    // A second at most: a GPU that has not finished by then has lost its way,
+    // and the frame goes as it is.
+    eglClientWaitSyncKHR(GetEGLDisplay(), commit.fence, 0,
+                         base::Seconds(1).InNanoseconds());
+    eglDestroySyncKHR(GetEGLDisplay(), commit.fence);
+  } else {
+    glFinish();
+  }
+  constexpr bool enable_blend_for_shadow = true;
+  buffer_manager_->CommitBuffer(widget_, commit.buffer_id,
+                                /*frame_id*/ commit.buffer_id, commit.data,
+                                commit.bounds, enable_blend_for_shadow,
+                                gfx::RoundedCornersF(), surface_scale_factor_,
+                                commit.bounds);
+}
+
+void GLSurfaceEglReadbackWayland::DestroyHardwareBuffer(PixelBuffer* buffer) {
+  if (gl::GLContext::GetCurrent()) {
+    if (buffer->framebuffer_) {
+      glDeleteFramebuffersEXT(1, &buffer->framebuffer_);
+    }
+    if (buffer->texture_) {
+      glDeleteTextures(1, &buffer->texture_);
+    }
+  }
+  buffer->framebuffer_ = 0;
+  buffer->texture_ = 0;
+  if (buffer->image_) {
+    eglDestroyImageKHR(GetEGLDisplay(), buffer->image_);
+    buffer->image_ = nullptr;
+  }
+  if (buffer->hardware_buffer_) {
+    Calls().release(buffer->hardware_buffer_);
+    buffer->hardware_buffer_ = nullptr;
+  }
+}
+#endif
+
 }  // namespace ui
