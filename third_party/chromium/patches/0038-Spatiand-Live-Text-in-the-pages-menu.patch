+// A tab's reading, with "read text in pictures by itself" off: the page whose pictures were left
+// unread, and the page the wearer asked to have read (Live Text's Read the text), each by the
+// tab's address as it was then -- another page in the tab is another question.
+class TabReading : public content::WebContentsUserData<TabReading> {
+ public:
+  ~TabReading() override = default;
+
+  void LeftUnread(const GURL& page) {
+    if (page != unread_page_) {
+      unread_page_ = page;
+      unread_ = 0;
+    }
+    ++unread_;
+  }
+  bool Unread(const GURL& page) const { return unread_ > 0 && page == unread_page_; }
+  void Asked(const GURL& page) {
+    asked_page_ = page;
+    unread_ = 0;
+  }
+  bool WasAsked(const GURL& page) const { return !asked_page_.is_empty() && page == asked_page_; }
+
+ private:
+  explicit TabReading(content::WebContents* contents)
+      : content::WebContentsUserData<TabReading>(*contents) {}
+  friend class content::WebContentsUserData<TabReading>;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+
+  GURL unread_page_;
+  int unread_ = 0;
+  GURL asked_page_;
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TabReading);
+
+// The tab a frame is in: the outermost, which a menu, a reload and an address are the tab's.
+content::WebContents* TabOf(content::WebContents* contents) {
+  return contents ? contents->GetOutermostWebContents() : nullptr;
+}
