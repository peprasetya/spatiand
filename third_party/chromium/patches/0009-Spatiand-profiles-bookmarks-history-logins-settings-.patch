+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/spatiand/spatikey_window.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/base_paths.h"
+#include "base/command_line.h"
+#include "base/environment.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/process/launch.h"
+#include "base/process/process.h"
+#include "base/path_service.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/infobars/simple_alert_infobar_creator.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "components/infobars/content/content_infobar_manager.h"
+#include "components/infobars/core/infobar_delegate.h"
+#include "components/spatikey/client.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+
+namespace spatiand {
+
+namespace {
+
+// Beside the room's other programs: where it says, else where this install keeps Spatiand's, as
+// this browser's FFmpeg is found.
+base::FilePath FindSpatiKey() {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  if (std::optional<std::string> named = env->GetVar("SPATIAND_APPS_DIR"); named && !named->empty()) {
+    const base::FilePath program = base::FilePath(*named).Append("spatikey");
+    if (base::PathExists(program)) {
+      return program;
+    }
+  }
+  base::FilePath here;
+  base::PathService::Get(base::DIR_EXE, &here);
+  const base::FilePath program = here.DirName().Append("spatiand/target/release/spatikey");
+  return base::PathExists(program) ? program : base::FilePath();
+}
+
+void Launch() {
+  const base::FilePath program = FindSpatiKey();
+  if (program.empty()) {
+    return;
+  }
+  base::LaunchOptions options;
+  options.new_process_group = true;
+  base::Process process = base::LaunchProcess(base::CommandLine(program), options);
+  if (process.IsValid()) {
+    base::EnsureProcessGetsReaped(std::move(process));
+  }
+}
+
+void ShowProblem(const std::u16string& message) {
+  BrowserWindowInterface* browser = GlobalBrowserCollection::GetInstance()->GetLastActiveBrowser();
+  tabs::TabInterface* tab = browser ? browser->GetActiveTabInterface() : nullptr;
+  content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+  infobars::ContentInfoBarManager* infobars =
+      contents ? infobars::ContentInfoBarManager::FromWebContents(contents) : nullptr;
+  if (infobars) {
+    CreateSimpleAlertInfoBar(infobars, infobars::InfoBarDelegate::TEST_INFOBAR,
+                             /*vector_icon=*/nullptr, message, /*auto_expire=*/true,
+                             /*should_animate=*/true);
+  }
+}
+
+void GoBackOrClose(base::WeakPtr<content::WebContents> contents) {
+  if (!contents) {
+    return;
+  }
+  if (contents->GetController().CanGoBack()) {
+    contents->GetController().GoBack();
+  } else {
+    contents->Close();
+  }
+}
+
+}  // namespace
+
+void OpenSpatiKey() {
+  base::ThreadPool::PostTask(FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+                             base::BindOnce(&Launch));
+}
+
+void OpenSpatiKeyInstead(content::WebContents* contents) {
+  OpenSpatiKey();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&GoBackOrClose, contents->GetWeakPtr()));
+}
+
+void ShowSpatiKeyProblems() {
+  spatikey::SetProblemReporter(base::BindRepeating(&ShowProblem));
+}
+
+}  // namespace spatiand
