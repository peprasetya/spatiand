+#include "ui/ozone/platform/wayland/host/wayland_window_manager.h"
+
+namespace ui {
+
+namespace {
+
+// spatiand_proto::handover::MAC_SURFACE_MAGIC: "SPSF".
+constexpr uint32_t kMacSurfaceMagic = 0x46535053;
+
+// Buffer numbers of the placeholders, well above the ones the GPU process gives its own.
+constexpr uint32_t kFirstBufferId = 0x53500000;
+
+void PutLe32(uint8_t* at, uint32_t value) {
+  for (int i = 0; i < 4; ++i) {
+    UNSAFE_BUFFERS(at[i]) = static_cast<uint8_t>(value >> (8 * i));
+  }
+}
+
+}  // namespace
+
+SpatiandIOSurfaceHandover::Placeholder::Placeholder() = default;
+SpatiandIOSurfaceHandover::Placeholder::Placeholder(Placeholder&&) = default;
+SpatiandIOSurfaceHandover::Placeholder&
+SpatiandIOSurfaceHandover::Placeholder::operator=(Placeholder&&) = default;
+SpatiandIOSurfaceHandover::Placeholder::~Placeholder() = default;
+
+SpatiandIOSurfaceHandover::SpatiandIOSurfaceHandover(WaylandConnection* connection)
+    : connection_(connection), next_buffer_id_(kFirstBufferId) {}
+
+SpatiandIOSurfaceHandover::~SpatiandIOSurfaceHandover() = default;
+
+void SpatiandIOSurfaceHandover::Forget(gfx::AcceleratedWidget widget) {
+  auto it = placeholders_.find(widget);
+  if (it == placeholders_.end()) {
+    return;
+  }
+  if (connection_->buffer_manager_host()) {
+    connection_->buffer_manager_host()->DestroyBuffer(it->second.buffer_id);
+  }
+  placeholders_.erase(it);
+}
+
+void SpatiandIOSurfaceHandover::Show(gfx::AcceleratedWidget widget,
+                                     mach_port_t io_surface_port,
+                                     const gfx::Size& pixel_size,
+                                     float scale_factor) {
+  // Windows gone since their last frame take their placeholders with them.
+  for (auto it = placeholders_.begin(); it != placeholders_.end();) {
+    auto next = std::next(it);
+    if (!connection_->window_manager()->GetWindow(it->first)) {
+      Forget(it->first);
+    }
+    it = next;
+  }
+
+  WaylandWindow* window = connection_->window_manager()->GetWindow(widget);
+  WaylandBufferManagerHost* buffers = connection_->buffer_manager_host();
+  if (!window || !buffers || pixel_size.IsEmpty() || io_surface_port == MACH_PORT_NULL) {
+    return;
+  }
+  base::apple::ScopedCFTypeRef<IOSurfaceRef> surface(
+      IOSurfaceLookupFromMachPort(io_surface_port));
+  if (!surface) {
+    LOG(ERROR) << "Spatiand: a frame's IOSurface could not be opened";
+    return;
+  }
+  const uint32_t number = IOSurfaceGetID(surface.get());
+  if (!spatiand_surfaces_post(surface.get(), number)) {
+    static bool said = false;
+    if (!said) {
+      said = true;
+      LOG(ERROR) << "Spatiand: no room to hand frames to (not started by Spatiand?)";
+    }
+    return;
+  }
+
+  auto it = placeholders_.find(widget);
+  const bool fresh = it == placeholders_.end() || it->second.size != pixel_size ||
+                     it->second.scale_factor != scale_factor;
+  if (fresh) {
+    Forget(widget);
+    const size_t bytes = static_cast<size_t>(pixel_size.width()) * pixel_size.height() * 4;
+    base::ScopedFD fd;
+    Placeholder placeholder;
+    placeholder.head = wl::ShmMapping::Create(bytes, &fd);
+    if (!placeholder.head.IsValid()) {
+      LOG(ERROR) << "Spatiand: no shared memory for a window's placeholder";
+      return;
+    }
+    placeholder.buffer_id = next_buffer_id_++;
+    placeholder.size = pixel_size;
+    placeholder.scale_factor = scale_factor;
+    buffers->CreateShmBasedBuffer(mojo::PlatformHandle(std::move(fd)), bytes, pixel_size,
+                                  placeholder.buffer_id);
+    it = placeholders_.emplace(widget, std::move(placeholder)).first;
+  }
+  Placeholder& placeholder = it->second;
+
+  // The name of this frame: the magic, the surface's number, and this window's run.
+  const uint64_t stream =
+      (static_cast<uint64_t>(getpid()) << 32) | static_cast<uint32_t>(widget);
+  uint8_t* head = placeholder.head.data();
+  PutLe32(head, kMacSurfaceMagic);
+  PutLe32(UNSAFE_BUFFERS(head + 4), number);
+  PutLe32(UNSAFE_BUFFERS(head + 8), static_cast<uint32_t>(stream));
+  PutLe32(UNSAFE_BUFFERS(head + 12), static_cast<uint32_t>(stream >> 32));
+
+  if (fresh) {
+    // Attached as any frame's buffer, so the window is configured, scaled and placed as on
+    // Linux. Its memory is never a picture, so only the head is ever damaged.
+    const gfx::Rect bounds(pixel_size);
+    std::vector<wl::WaylandOverlayConfig> overlays;
+    overlays.emplace_back(
+        gfx::OverlayPlaneData(
+            INT32_MIN, gfx::OverlayTransform::OVERLAY_TRANSFORM_NONE,
+            gfx::RectF(bounds), gfx::RectF(1.f, 1.f), /*enable_blend=*/true,
+            bounds, 1.0f, gfx::OverlayPriorityHint::kNone,
+            gfx::RRectF(gfx::RectF(bounds), gfx::RoundedCornersF()), gfx::ColorSpace(),
+            std::nullopt),
+        gfx::GpuFenceHandle(), placeholder.buffer_id, scale_factor);
+    buffers->CommitOverlays(widget, ++placeholder.frame_id, gfx::FrameData(),
+                            std::move(overlays));
+    return;
+  }
+  // The same placeholder, a new name in it: whatever the room asked of the window since is
+  // acknowledged with this frame, and it is committed.
+  window->OnSequencePoint(-1);
+  wl_surface_commit(window->root_surface()->surface());
+  connection_->Flush();
+}
+
+}  // namespace ui
