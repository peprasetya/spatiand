+# Skia is written for C++17/20. Under WebKit's C++23, the Android NDK's libc++ instantiates its
+# destructors and pairs eagerly over types Skia only declares (constexpr unique_ptr and pair), and
+# Skia does not build; its own standard does.
+if (ANDROID)
+    set_target_properties(Skia PROPERTIES CXX_STANDARD 20)
+endif ()
+
 add_library(Skia::Skia ALIAS Skia)
