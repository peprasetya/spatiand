 constexpr int kTriesBeforeWaiting = 5;
 constexpr base::TimeDelta kWait = base::Seconds(30);
 
+const char kPin[] = "pin";
+const char kPassword[] = "password";
+
+// Wrong tries in a row, and what they have earned.
+struct Tries {
+  // Whether another may be made now.
+  bool Allowed() const { return base::Time::Now() >= wait_until; }
+  // What to say about one that was wrong.
+  std::u16string Wrong() {
+    if (++wrong >= kTriesBeforeWaiting) {
+      wrong = 0;
+      wait_until = base::Time::Now() + kWait;
+      return u"Too many wrong tries: wait half a minute.";
+    }
+    return u"That is not it.";
+  }
+
+  int wrong = 0;
+  base::Time wait_until;
+};
+
+views::Textfield* AddSecretField(views::View* contents, const std::u16string& name) {
+  auto* field = contents->AddChildView(std::make_unique<views::Textfield>());
+  field->SetTextInputType(ui::TEXT_INPUT_TYPE_PASSWORD);
+  field->GetViewAccessibility().SetName(name);
+  return field;
+}
+
+views::Label* AddLabel(views::View* contents, const std::u16string& text) {
+  auto* label = contents->AddChildView(std::make_unique<views::Label>(text));
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  return label;
+}
