+
+namespace media {
+
+class AudioBus;
+class AudioManagerBase;
+
+// One stream into Spatiand's room (see AudioManagerSpatiand): it connects to the room's socket and
+// says `SPSN`, its channel count (u16), rate (u32, the room's 48000) and the name it is heard
+// under (u16 length, then the bytes), then writes interleaved little-endian 16-bit samples, a
+// buffer (a hundredth of a second) at a time on the clock, as Spatiand's own players do
+// (crates/spatiand-media/src/sound.rs; the room's side is crates/spatiand/src/own.rs, `sound`).
+class SpatiandAudioOutputStream : public AudioOutputStream {
+ public:
+  SpatiandAudioOutputStream(AudioManagerBase* manager,
+                            const AudioParameters& params,
+                            std::string name);
+  SpatiandAudioOutputStream(const SpatiandAudioOutputStream&) = delete;
+  SpatiandAudioOutputStream& operator=(const SpatiandAudioOutputStream&) = delete;
+  ~SpatiandAudioOutputStream() override;
+
+  // AudioOutputStream:
+  bool Open() override;
+  void Start(AudioSourceCallback* callback) override;
+  void Stop() override;
+  void SetVolume(double volume) override;
+  void GetVolume(double* volume) override;
+  void Close() override;
+  void Flush() override;
+
+ private:
+  // On the manager's worker thread, once a buffer: the next buffer, to the room.
+  void Tick(base::TimeTicks ideal_time, base::TimeTicks now);
+
+  const raw_ptr<AudioManagerBase> manager_;
+  const AudioParameters params_;
+  const std::string name_;
+  base::ScopedFD socket_;
+  raw_ptr<AudioSourceCallback> callback_ = nullptr;
+  FakeAudioWorker worker_;
+  const std::unique_ptr<AudioBus> bus_;
+  std::vector<int16_t> samples_;
+  std::atomic<float> volume_{1.0f};
+};
+
+}  // namespace media
+
+#endif  // MEDIA_AUDIO_SPATIAND_SPATIAND_OUTPUT_H_
