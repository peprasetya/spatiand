+
+ProfileService::ProfileService(Profile* profile)
+    : files_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN})) {
+  ProfilesSync* profiles = ProfilesSync::Get();
+  if (!profiles) {
+    return;
+  }
+  const std::string id = profiles->IdOf(profile->GetPath());
+  bookmarks_ = std::make_unique<BookmarkSync>(profile, id, files_);
+  history_ = std::make_unique<HistorySync>(profile, id, files_);
+  cookies_ = std::make_unique<CookieSync>(profile, id, files_);
+  settings_ = std::make_unique<SettingsSync>(profile, id, files_);
+  extensions_ = std::make_unique<ExtensionSync>(profile, id, files_);
+  timer_.Start(FROM_HERE, kEvery,
+               base::BindRepeating(&ProfileService::Poll, base::Unretained(this)));
+}
+
+ProfileService::~ProfileService() = default;
+
+void ProfileService::Poll() {
+  bookmarks_->Poll();
+  history_->Poll();
+  cookies_->Poll();
+  settings_->Poll();
+  extensions_->Poll();
+}
