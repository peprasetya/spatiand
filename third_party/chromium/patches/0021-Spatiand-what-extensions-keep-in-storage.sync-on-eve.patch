+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SPATIAND_STORAGE_SYNC_H_
+#define CHROME_BROWSER_SPATIAND_STORAGE_SYNC_H_
+
+#include <map>
+#include <set>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "base/values.h"
+
+class Profile;
+
+namespace spatiand {
+
+// What an extension keeps in `chrome.storage.sync`, on every machine: the shared folder's
+// `profiles/<id>/extension-sync/<extension>/<key in hex>.json`, one file per key holding
+// `{"key": ..., "value": ...}` -- the Rust SpatiMesh's format (crates/spatimesh in Spatiand,
+// extensions/storage.rs), so that two machines setting two keys while apart both keep theirs.
+// Without Google's sync, Chrome keeps that area on the machine alone.
+class StorageSync {
+ public:
+  StorageSync(Profile* profile, const std::string& id, scoped_refptr<base::SequencedTaskRunner> files);
+  StorageSync(const StorageSync&) = delete;
+  StorageSync& operator=(const StorageSync&) = delete;
+  ~StorageSync();
+
+  void Poll();
+
+  // A key set or removed here (from extensions::StorageFrontend): into the shared folder.
+  void Changed(const std::string& extension_id, const base::Value& changes);
+
+  // An extension's folder as read: its keys and values, and when the folder last changed.
+  struct Folder {
+    base::Time changed;
+    base::DictValue items;
+  };
+  using Folders = std::map<std::string, Folder>;
+
+ private:
+  void OnRead(Folders folders);
+  void Merge(const std::string& extension_id, base::DictValue remote, base::DictValue local);
+
+  const raw_ptr<Profile> profile_;
+  const base::FilePath dir_;
+  scoped_refptr<base::SequencedTaskRunner> files_;
+  // When each extension's folder was last taken in.
+  std::map<std::string, base::Time> seen_;
+  // The keys each extension's folder had: one gone from it was removed on another machine; one
+  // never in it was set here before this kept it.
+  std::map<std::string, std::set<std::string>> known_;
+  bool reading_ = false;
+  bool first_ = true;
+
+  base::WeakPtrFactory<StorageSync> weak_factory_{this};
+};
+
+}  // namespace spatiand
+
+#endif  // CHROME_BROWSER_SPATIAND_STORAGE_SYNC_H_
