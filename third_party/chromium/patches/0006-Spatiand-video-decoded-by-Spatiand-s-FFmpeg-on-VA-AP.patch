+
+namespace media {
+
+class ScopedVASurface;
+class VaapiWrapper;
+
+// Video decoded by Spatiand's FFmpeg on the GPU (VA-API), in place of Chromium's own VA-API
+// decoders: one decoder for every program of Spatiand's, so a stream plays the same here as in
+// the room's own players.
+//
+// The rest of Chromium's hardware path is kept as it is. The pipeline's frame pool allocates its
+// buffers as VA surfaces through VaapiWrapper (as VaapiVideoDecoder does), FFmpeg decodes each
+// picture straight into one of them (its get_buffer2), and the frame goes on to the compositor
+// with nothing copied.
+class SpatiandVideoDecoder : public VideoDecoderMixin {
+ public:
+  static std::unique_ptr<VideoDecoderMixin> Create(
+      std::unique_ptr<MediaLog> media_log,
+      scoped_refptr<base::SequencedTaskRunner> decoder_task_runner,
+      base::WeakPtr<VideoDecoderMixin::Client> client);
+
+  SpatiandVideoDecoder(const SpatiandVideoDecoder&) = delete;
+  SpatiandVideoDecoder& operator=(const SpatiandVideoDecoder&) = delete;
+  ~SpatiandVideoDecoder() override;
+
+  // VideoDecoderMixin.
+  void Initialize(const VideoDecoderConfig& config,
+                  bool low_delay,
+                  CdmContext* cdm_context,
+                  InitCB init_cb,
+                  const PipelineOutputCB& output_cb,
+                  const WaitingCB& waiting_cb) override;
+  void Decode(scoped_refptr<DecoderBuffer> buffer, DecodeCB decode_cb) override;
+  void Reset(base::OnceClosure reset_cb) override;
+  void ApplyResolutionChange() override;
+  bool NeedsBitstreamConversion() const override;
+  bool CanReadWithoutStalling() const override;
+  int GetMaxDecodeRequests() const override;
+  VideoDecoderType GetDecoderType() const override;
+  bool IsPlatformDecoder() const override;
+
+ private:
+  struct DecodeTask {
+    DecodeTask(scoped_refptr<DecoderBuffer> buffer, DecodeCB decode_cb);
+    DecodeTask(DecodeTask&&);
+    ~DecodeTask();
+    scoped_refptr<DecoderBuffer> buffer;
+    DecodeCB decode_cb;
+  };
+
+  SpatiandVideoDecoder(std::unique_ptr<MediaLog> media_log,
+                       scoped_refptr<base::SequencedTaskRunner> decoder_task_runner,
+                       base::WeakPtr<VideoDecoderMixin::Client> client);
+
+  bool OpenCodec(const VideoDecoderConfig& config);
+  void CloseCodec();
+  void ScheduleNext();
+  void DecodeNext();
+  // Sends the current task's packet (or the end of the stream) and outputs what comes out.
+  // False on a decoding error.
+  bool SendAndReceive(const AVPacket* packet);
+  bool ReceiveFrames();
+  void OutputFrame(AVFrame* frame);
+  void Fail(const char* what);
+
+  // FFmpeg's side (its get_format and get_buffer2): choosing VA-API and sizing the frame pool
+  // for it, and handing it a surface of that pool.
+  int ChooseFormat(const int* formats);
+  int GetBufferForFrame(AVFrame* frame);
+
+  // The frame pool's allocator: a VA surface, exported as the pool's buffer.
+  static base::expected<scoped_refptr<FrameResource>, CroStatus> AllocateFrameProxy(
+      base::WeakPtr<SpatiandVideoDecoder> decoder,
+      VideoPixelFormat format,
+      const gfx::Size& coded_size,
+      const gfx::Rect& visible_rect,
+      const gfx::Size& natural_size,
+      bool use_protected,
+      bool use_linear_buffers,
+      bool needs_detiling,
+      base::TimeDelta timestamp);
+  base::expected<scoped_refptr<FrameResource>, CroStatus> AllocateFrame(VideoPixelFormat format,
+                                                            const gfx::Size& coded_size,
+                                                            const gfx::Rect& visible_rect,
+                                                            const gfx::Size& natural_size,
+                                                            base::TimeDelta timestamp);
+
+  scoped_refptr<VaapiWrapper> vaapi_wrapper_;
+  AVCodecContext* codec_context_ = nullptr;
+  AVBufferRef* device_ = nullptr;
+  AVFrame* av_frame_ = nullptr;
+  // What the pool was last sized for, so it is asked again only when that changes.
+  int pool_format_ = -1;
+  gfx::Size pool_size_;
+
+  // The pool's buffers by tracking token, each with the VA surface it is.
+  std::map<base::UnguessableToken, std::unique_ptr<ScopedVASurface>> surfaces_;
+
+  VideoCodec codec_ = VideoCodec::kUnknown;
+  VideoColorSpace color_space_;
+  gfx::HDRMetadata hdr_metadata_;
+  VideoAspectRatio aspect_ratio_;
+  PipelineOutputCB output_cb_;
+
+  base::queue<DecodeTask> tasks_;
+  std::optional<DecodeTask> current_;
+  bool waiting_for_frames_ = false;
+  bool failed_ = false;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<SpatiandVideoDecoder> weak_this_factory_{this};
+};
+
+}  // namespace media
