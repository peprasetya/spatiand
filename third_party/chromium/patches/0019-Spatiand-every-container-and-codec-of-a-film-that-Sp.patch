From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Spatiand build <claude@prasetya.id>
Date: Tue, 10 Nov 2026 09:33:17 +0700
Subject: [PATCH 299/310] Spatiand: every container and codec of a film that
 Spatiand's FFmpeg plays, and MP3 again

Chromium hands FFmpeg only the containers and codecs of its own build. Spatiand's FFmpeg reads and
decodes far more, as SpatiReel does: AVI, MPEG transport and program streams, Flash video, Windows
Media, AIFF, CAF and bare Dolby and DTS streams are let through the demuxer; MPEG-4 Part 2 (DivX,
Xvid), MPEG-2 and VC-1 video are decoded in software by FFmpegVideoDecoder, and DTS's core and ALAC
audio by FFmpegAudioDecoder.

And MP3 had not played at all since patch 0003: Chromium's FFmpeg has the fixed-point MP3 decoder
alone ("mp3"), and FFmpeg's own build gives its floating-point one ("mp3float") for MP3, which was
not on the allowed list -- an .mp3 refused, an MP4's MP3 sound silent.

Checked headless (2026-11-10): an .mp3, an MP4 with MP3, an AVI of MPEG-4 Part 2 and MP3, MKVs of
H.264 with AAC and with AC-3, an MPEG-2 transport stream's video: all play, frames and sound
decoded. Not yet: H.264 and HEVC in a transport stream (no frame decoded, and a decode error with
StrictFFmpegCodecs), an MPEG program stream (VOB: "PTS is not defined"), MP2 sound, and a film's
own subtitle tracks.
---
 media/base/supported_types.cc         | 10 +++++++---
 media/ffmpeg/ffmpeg_common.cc         | 24 ++++++++++++++++++++----
 media/filters/ffmpeg_glue.cc          | 24 ++++++++++++++++++++++++
 media/filters/ffmpeg_video_decoder.cc | 11 ++++++++---
 4 files changed, 59 insertions(+), 10 deletions(-)

diff --git a/media/base/supported_types.cc b/media/base/supported_types.cc
index f78f093796..0e25f040cd 100644
--- a/media/base/supported_types.cc
+++ b/media/base/supported_types.cc
@@ -452,10 +452,12 @@ bool IsDefaultDecoderSupportedVideoType(const VideoType& type) {
       return IsDecoderHevcProfileSupported(type);
     case VideoCodec::kDolbyVision:
       return IsDecoderDolbyVisionProfileSupported(type);
-    case VideoCodec::kUnknown:
+    // Spatiand: decoded in software by Spatiand's FFmpeg (media/ffmpeg/ffmpeg_common.cc).
     case VideoCodec::kVC1:
     case VideoCodec::kMPEG2:
     case VideoCodec::kMPEG4:
+      return true;
+    case VideoCodec::kUnknown:
       return false;
   }
 }
@@ -485,13 +487,15 @@ bool IsDefaultDecoderSupportedAudioType(const AudioType& type) {
     case AudioCodec::kAMR_NB:
     case AudioCodec::kAMR_WB:
     case AudioCodec::kGSM_MS:
-    case AudioCodec::kALAC:
     case AudioCodec::kMpegHAudio:
     case AudioCodec::kUnknown:
       return false;
+    case AudioCodec::kALAC:  // Spatiand: by Spatiand's FFmpeg.
+      return true;
     case AudioCodec::kIAMF:
       return IsIamfAudioDecodingSupported();
-    case AudioCodec::kDTS:
+    case AudioCodec::kDTS:  // Spatiand: DTS's core, by Spatiand's FFmpeg.
+      return true;
     case AudioCodec::kDTSXP2:
     case AudioCodec::kDTSE:
       return BUILDFLAG(ENABLE_PLATFORM_DTS_AUDIO);
diff --git a/media/ffmpeg/ffmpeg_common.cc b/media/ffmpeg/ffmpeg_common.cc
index b05f744b7a..e196df9689 100644
--- a/media/ffmpeg/ffmpeg_common.cc
+++ b/media/ffmpeg/ffmpeg_common.cc
@@ -65,8 +65,9 @@ VideoColorSpace GetGuessedColorSpace(const VideoColorSpace& color_space) {
 const char* GetAllowedVideoDecoders() {
   // This should match the configured lists in //third_party/ffmpeg.
 #if BUILDFLAG(USE_PROPRIETARY_CODECS) && BUILDFLAG(ENABLE_FFMPEG_VIDEO_DECODERS)
-  // Spatiand: HEVC too, decoded by Spatiand's FFmpeg in software.
-  return "h264,hevc";
+  // Spatiand: HEVC too, decoded by Spatiand's FFmpeg in software; and the older films' codecs,
+  // MPEG-4 Part 2 (DivX, Xvid), MPEG-2 (DVDs, broadcasts) and VC-1 (Blu-ray, Windows Media 9 Advanced).
+  return "h264,hevc,mpeg4,mpeg2video,vc1";
 #else
   return "";
 #endif
@@ -141,6 +142,8 @@ AudioCodec CodecIDToAudioCodec(AVCodecID codec_id) {
     case AV_CODEC_ID_EAC3:
       return AudioCodec::kEAC3;
 #endif
+    case AV_CODEC_ID_DTS:  // Spatiand: DTS, decoded by Spatiand's FFmpeg.
+      return AudioCodec::kDTS;
     case AV_CODEC_ID_MP3:
       return AudioCodec::kMP3;
     case AV_CODEC_ID_VORBIS:
@@ -182,6 +185,8 @@ AVCodecID AudioCodecToCodecID(AudioCodec audio_codec,
       return AV_CODEC_ID_AAC;
     case AudioCodec::kALAC:
       return AV_CODEC_ID_ALAC;
+    case AudioCodec::kDTS:  // Spatiand
+      return AV_CODEC_ID_DTS;
     case AudioCodec::kMP3:
       return AV_CODEC_ID_MP3;
     case AudioCodec::kPCM:
@@ -244,6 +249,11 @@ static VideoCodec CodecIDToVideoCodec(AVCodecID codec_id) {
       return VideoCodec::kTheora;
     case AV_CODEC_ID_MPEG4:
       return VideoCodec::kMPEG4;
+    // Spatiand: decoded by Spatiand's FFmpeg (GetAllowedVideoDecoders).
+    case AV_CODEC_ID_MPEG2VIDEO:
+      return VideoCodec::kMPEG2;
+    case AV_CODEC_ID_VC1:
+      return VideoCodec::kVC1;
     case AV_CODEC_ID_VP8:
       return VideoCodec::kVP8;
     case AV_CODEC_ID_VP9:
@@ -268,6 +278,10 @@ AVCodecID VideoCodecToCodecID(VideoCodec video_codec) {
       return AV_CODEC_ID_THEORA;
     case VideoCodec::kMPEG4:
       return AV_CODEC_ID_MPEG4;
+    case VideoCodec::kMPEG2:  // Spatiand
+      return AV_CODEC_ID_MPEG2VIDEO;
+    case VideoCodec::kVC1:
+      return AV_CODEC_ID_VC1;
     case VideoCodec::kVP8:
       return AV_CODEC_ID_VP8;
     case VideoCodec::kVP9:
@@ -1128,8 +1142,10 @@ const char* GetAllowedAudioDecoders() {
   static constexpr std::string_view kAllowedAudioCodecs =
       "vorbis,libopus,flac,pcm_u8,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le,"
       "mp3,pcm_s16be,pcm_s24be,pcm_mulaw,pcm_alaw"
-      // Spatiand: Dolby Digital and Dolby Digital Plus, by Spatiand's FFmpeg.
-      ",ac3,eac3" EXTRA_CODECS;
+      // Spatiand: Dolby Digital and Dolby Digital Plus, and DTS, by Spatiand's FFmpeg; and
+      // FFmpeg's own MP3 decoder, which is the one it gives for MP3 (Chromium's FFmpeg is built
+      // with the fixed-point one alone): without it no MP3 played at all.
+      ",ac3,eac3,dca,alac,mp3float" EXTRA_CODECS;
 #undef EXTRA_CODECS
 
   return kAllowedAudioCodecs.data();
diff --git a/media/filters/ffmpeg_glue.cc b/media/filters/ffmpeg_glue.cc
index 73aeffcacd..3514b3511c 100644
--- a/media/filters/ffmpeg_glue.cc
+++ b/media/filters/ffmpeg_glue.cc
@@ -90,6 +90,12 @@ static const char* GetAllowedDemuxers() {
                                                  "flac", "mp3",      "mov"};
 #if BUILDFLAG(USE_PROPRIETARY_CODECS)
     allowed_demuxers.push_back("aac");
+    // Spatiand: every container Spatiand's FFmpeg reads that a film or a recording comes in, as
+    // its own player (SpatiReel) reads them: AVI, MPEG transport and program streams (broadcasts,
+    // DVDs), Flash video, Windows Media, AIFF and CAF, and bare Dolby and DTS streams.
+    for (const char* name : {"avi", "mpegts", "mpeg", "flv", "asf", "aiff", "caf", "ac3", "eac3", "dts"}) {
+      allowed_demuxers.push_back(name);
+    }
 #endif
     return base::JoinString(allowed_demuxers, ",");
   }());
@@ -217,6 +223,24 @@ bool FFmpegGlue::OpenContext(bool is_local_file) {
     container_ = container_names::MediaContainerName::kContainerAMR;
   } else if (format_name == "avi") {
     container_ = container_names::MediaContainerName::kContainerAVI;
+  } else if (format_name == "mpegts") {  // Spatiand: the containers its FFmpeg is let read.
+    container_ = container_names::MediaContainerName::kContainerMPEG2TS;
+  } else if (format_name == "mpeg") {
+    container_ = container_names::MediaContainerName::kContainerMPEG2PS;
+  } else if (format_name == "flv") {
+    container_ = container_names::MediaContainerName::kContainerFLV;
+  } else if (format_name == "asf") {
+    container_ = container_names::MediaContainerName::kContainerASF;
+  } else if (format_name == "aiff") {
+    container_ = container_names::MediaContainerName::kContainerAIFF;
+  } else if (format_name == "caf") {
+    container_ = container_names::MediaContainerName::kContainerCAF;
+  } else if (format_name == "ac3") {
+    container_ = container_names::MediaContainerName::kContainerAC3;
+  } else if (format_name == "eac3") {
+    container_ = container_names::MediaContainerName::kContainerEAC3;
+  } else if (format_name == "dts") {
+    container_ = container_names::MediaContainerName::kContainerDTS;
   }
 
   // For a successfully opened file, we will get a container we've compiled in.
diff --git a/media/filters/ffmpeg_video_decoder.cc b/media/filters/ffmpeg_video_decoder.cc
index f754854f55..1c5db2fb2d 100644
--- a/media/filters/ffmpeg_video_decoder.cc
+++ b/media/filters/ffmpeg_video_decoder.cc
@@ -72,17 +72,18 @@ static int GetFFmpegVideoDecoderThreadCount(const VideoDecoderConfig& config) {
   // Only add more threads for those codecs that we know will benefit.
   switch (config.codec()) {
     case VideoCodec::kUnknown:
-    case VideoCodec::kVC1:
-    case VideoCodec::kMPEG2:
     case VideoCodec::kVP9:
     case VideoCodec::kAV1:
     case VideoCodec::kDolbyVision:
     case VideoCodec::kTheora:
-    case VideoCodec::kMPEG4:
     case VideoCodec::kVP8:
       // We do not compile ffmpeg with support for any of these codecs.
       NOTREACHED();
 
+    // Spatiand: decoded by Spatiand's FFmpeg (IsCodecSupported).
+    case VideoCodec::kVC1:
+    case VideoCodec::kMPEG2:
+    case VideoCodec::kMPEG4:
     case VideoCodec::kHEVC:
     case VideoCodec::kH264:
       // Normalize to three threads for 1080p content, then scale linearly
@@ -128,6 +129,10 @@ bool FFmpegVideoDecoder::IsCodecSupported(VideoCodec codec) {
   if (codec == VideoCodec::kHEVC) {
     return true;
   }
+  // And the older films' codecs, which no GPU decoder here takes (GetAllowedVideoDecoders).
+  if (codec == VideoCodec::kMPEG4 || codec == VideoCodec::kMPEG2 || codec == VideoCodec::kVC1) {
+    return true;
+  }
   // We only build support for H.264.
   return codec == VideoCodec::kH264 && IsDecoderBuiltInVideoCodec(codec);
 }
