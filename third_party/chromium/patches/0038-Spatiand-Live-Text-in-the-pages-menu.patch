-void BindOcrAnnotator(
-    content::BrowserContext* context,
-    mojo::PendingReceiver<screen_ai::mojom::ScreenAIAnnotator> receiver) {
+void BindOcrAnnotator(content::RenderFrameHost* frame,
+                      mojo::PendingReceiver<screen_ai::mojom::ScreenAIAnnotator> receiver) {
+  content::WebContents* tab = TabOf(content::WebContents::FromRenderFrameHost(frame));
   mojo::MakeSelfOwnedReceiver(
-      std::make_unique<Annotator>(
-          context->GetDefaultStoragePartition()->GetURLLoaderFactoryForBrowserProcess()),
+      std::make_unique<Annotator>(frame->GetProcess()
+                                      ->GetBrowserContext()
+                                      ->GetDefaultStoragePartition()
+                                      ->GetURLLoaderFactoryForBrowserProcess(),
+                                  tab ? tab->GetWeakPtr() : base::WeakPtr<content::WebContents>()),
       std::move(receiver));
 }
 
+bool TextLeftUnread(content::WebContents* contents) {
+  content::WebContents* tab = TabOf(contents);
+  if (!tab) {
+    return false;
+  }
+  TabReading* reading = TabReading::FromWebContents(tab);
+  return reading && reading->Unread(tab->GetLastCommittedURL());
+}
+
+void ReadTextNow(content::WebContents* contents) {
+  content::WebContents* tab = TabOf(contents);
+  if (!tab) {
+    return;
+  }
+  TabReading::GetOrCreateForWebContents(tab)->Asked(tab->GetLastCommittedURL());
+  // A page's pictures are asked about once, as it is loaded: loaded again, they are asked again.
+  tab->GetController().Reload(content::ReloadType::NORMAL, /*check_for_repost=*/false);
+}
+
 }  // namespace spatiand
