From: csagan5 <32685696+csagan5@users.noreply.github.com>
Date: Thu, 19 Dec 2019 22:52:53 +0100
Subject: [PATCH 072/310] Disable feeds support by default

License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
FILE:Disable-feeds-support-by-default.patch
---
 components/feed/core/shared_prefs/pref_names.cc | 2 +-
 components/feed/feed_feature_list.cc            | 3 +++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/components/feed/core/shared_prefs/pref_names.cc b/components/feed/core/shared_prefs/pref_names.cc
index b91658fc384..c80632a001c 100644
--- a/components/feed/core/shared_prefs/pref_names.cc
+++ b/components/feed/core/shared_prefs/pref_names.cc
@@ -26,7 +26,7 @@ const char kEnableSnippetsByDse[] = "ntp_snippets_by_dse.enable";
 void RegisterFeedSharedProfilePrefs(PrefRegistrySimple* registry) {
   registry->RegisterBooleanPref(kEnableSnippets, false);
   registry->RegisterBooleanPref(kArticlesListVisible, false);
-  registry->RegisterBooleanPref(kEnableSnippetsByDse, true);
+  registry->RegisterBooleanPref(kEnableSnippetsByDse, false);
 }
 
 }  // namespace prefs
diff --git a/components/feed/feed_feature_list.cc b/components/feed/feed_feature_list.cc
index 1a91713c7ef..719f4433a10 100644
--- a/components/feed/feed_feature_list.cc
+++ b/components/feed/feed_feature_list.cc
@@ -69,4 +69,7 @@ BASE_FEATURE(kFeedNullItemAnimatorOnScrollRestore,
 
 BASE_FEATURE_PARAM(base::TimeDelta, kFeedCloseRefreshDelay, &kInterestFeedV2,
                     "feed_close_refresh_delay", base::Minutes(30));
+
+SET_CROMITE_FEATURE_DISABLED(kInterestFeedV2);
+
 }  // namespace feed
