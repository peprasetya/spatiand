+
+class Profile;
+class ThemeService;
+
+namespace spatiand {
+
+// A profile as `apps/spatimesh/profiles/<id>/profile.json` has it.
+struct ProfileRecord {
+  ProfileRecord();
+  ProfileRecord(const ProfileRecord&);
+  ProfileRecord& operator=(const ProfileRecord&);
+  ~ProfileRecord();
+  bool operator==(const ProfileRecord&) const;
+
+  std::string name;
+  SkColor colour = SK_ColorTRANSPARENT;
+  double created = 0;
+  std::optional<int> position;
+  // What opens its windows: a PIN or a password, kept only as a salted hash. Empty for nothing.
+  std::string lock_kind;
+  std::string lock_salt;
+  std::string lock_hash;
+};
+
+// Chromium's profiles are Spatiand's: the profile menu, the picker and Chromium's own dialogs stay
+// as they are, and what they show and change is the list every Spatiand machine shares.
+//
+// `Default` is the first profile (`default`, the same on every machine); another is the folder
+// `Spatiand-<id>`, or a folder Chromium named itself, remembered in this browser's own file. A
+// profile from the shared list is only listed until it is opened, so four profiles cost nothing
+// until they are used.
+class ProfilesSync : public ProfileAttributesStorage::Observer,
+                     public ProfileManagerObserver,
+                     public BrowserCollectionObserver {
+ public:
+  // On the UI thread, once, before any profile is opened.
+  static void Start();
+  // Null before Start().
+  static ProfilesSync* Get();
+
+  ProfilesSync(const ProfilesSync&) = delete;
+  ProfilesSync& operator=(const ProfilesSync&) = delete;
+
+  // The shared list's id of the profile at `profile_path`, given one if it has none yet.
+  std::string IdOf(const base::FilePath& profile_path);
+
+  // Chromium's own theme changed to `colour`: the profile's colour, on every machine.
+  void LocalColourChanged(const base::FilePath& profile_path, SkColor colour);
+
+  // A window of a locked profile is not shown until its PIN or password is given: true when this
+  // one has to wait, `show` then being run if it is opened. A window of the profile shown first
+  // opens it for the next, until the last of them closes.
+  bool DeferShow(Profile* profile, base::OnceClosure show);
+
+ private:
+  ProfilesSync();
+  ~ProfilesSync() override;
+
+  void Poll();
+  void OnRead(std::map<std::string, ProfileRecord> records);
+  void Apply(const std::string& id, const ProfileRecord& record, bool changed);
+  void Remove(const std::string& id);
+  void ApplyOrder(const std::map<std::string, ProfileRecord>& records);
+  void ApplyTheme(Profile* profile, const ProfileRecord& record);
+
+  base::FilePath PathOf(const std::string& id) const;
+  std::string KnownIdOf(const base::FilePath& profile_path) const;
+  void SaveDirs();
+  void WriteRecord(const std::string& id, const ProfileRecord& record);
+
+  void AskToUnlock(const std::string& id, const std::u16string& name, const ProfileRecord& record);
+  void Unlocked(const std::string& id, bool opened);
+
+  // ProfileAttributesStorage::Observer:
+  void OnProfileAdded(const base::FilePath& profile_path) override;
+  void OnProfileWasRemoved(const base::FilePath& profile_path,
+                           const std::u16string& profile_name) override;
+  void OnProfileNameChanged(const base::FilePath& profile_path,
+                            const std::u16string& old_profile_name) override;
+
+  // ProfileManagerObserver:
+  void OnProfileAdded(Profile* profile) override;
+
+  // BrowserCollectionObserver:
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+
+  scoped_refptr<base::SequencedTaskRunner> files_;
+  base::RepeatingTimer timer_;
+  bool reading_ = false;
+  bool applying_ = false;
+
+  // The list as last read, and what each folder Chromium named itself is called there.
+  std::map<std::string, ProfileRecord> records_;
+  std::map<std::string, std::string> dirs_;
+  // Ids once seen in the list: one gone from it was removed on another machine; a profile only
+  // this browser has yet is not that.
+  std::set<std::string> known_;
+  // Being removed because another machine removed them: not to be listed again meanwhile.
+  std::set<std::string> removing_;
+
+  std::set<std::string> unlocked_;
+  std::map<std::string, std::vector<base::OnceClosure>> waiting_;
+
+  base::ScopedObservation<ProfileAttributesStorage, ProfileAttributesStorage::Observer>
+      storage_observation_{this};
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver> browsers_observation_{
+      this};
+  base::WeakPtrFactory<ProfilesSync> weak_factory_{this};
+};
+
+// The hash a profile's lock keeps, as SpatiMesh's other builds make it. Many rounds: blocks.
+std::string LockHash(const std::string& salt, const std::string& secret);
+
+}  // namespace spatiand
+
+#endif  // CHROME_BROWSER_SPATIAND_PROFILES_SYNC_H_
