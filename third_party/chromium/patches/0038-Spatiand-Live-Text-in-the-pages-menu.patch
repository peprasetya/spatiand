       return;
     }
+    // Reading by itself off: nothing is sent, unless the wearer asked for this page; else the
+    // tab remembers it left a picture unread, and its menu offers Read the text.
+    if (!reader->by_itself) {
+      content::WebContents* tab = tab_.get();
+      const GURL page = tab ? tab->GetLastCommittedURL() : GURL();
+      TabReading* reading = tab ? TabReading::GetOrCreateForWebContents(tab) : nullptr;
+      if (!reading || !reading->WasAsked(page)) {
+        if (reading) {
+          reading->LeftUnread(page);
+        }
+        std::move(callback).Run(screen_ai::mojom::VisualAnnotation::New());
+        return;
+      }
+    }
     std::optional<std::vector<uint8_t>> png =
         gfx::PNGCodec::EncodeBGRASkBitmap(image, /*discard_transparency=*/true);
     if (!png) {
@@ -362,19 +422,43 @@ class Annotator : public screen_ai::mojom::ScreenAIAnnotator {
   }
 
   scoped_refptr<network::SharedURLLoaderFactory> factory_;
