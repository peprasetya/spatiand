 namespace base {
 
 CheckedObserver::CheckedObserver() = default;
 CheckedObserver::~CheckedObserver() = default;
+  // If weak_ptr was invalidated then this attempt to iterate over the
+  // pointer is a UAF. Tip: If it's unclear where the `delete` occurred, try
