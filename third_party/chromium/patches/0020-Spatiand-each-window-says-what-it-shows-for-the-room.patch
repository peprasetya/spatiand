diff --git a/chrome/browser/spatiand/describe.cc b/chrome/browser/spatiand/describe.cc
new file mode 100644
index 0000000000..a4dcc14b09
--- /dev/null
+++ b/chrome/browser/spatiand/describe.cc
@@ -0,0 +1,219 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/spatiand/describe.h"
+
+#include <algorithm>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_file.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/memory/ref_counted.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/thread_pool.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/icu/source/common/unicode/uchar.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/platform_window/platform_window.h"
+
+namespace spatiand {
+
+namespace {
+
+// The Rust SpatiMesh's PAGE_DESCRIPTION, word for word: the focus followed into frames of the same
+// origin; a password or one-time-code field's value never read.
+constexpr char kPageDescription[] =
+    "(function(){function secret(e){return e.tagName==='INPUT'&&(e.type==='password'||"
+    "/password|one-time-code/i.test(e.autocomplete||''))}"
+    "function go(d){var e=d.activeElement;"
+    "if(e&&(e.tagName==='IFRAME'||e.tagName==='FRAME')){try{if(e.contentDocument)return go(e.contentDocument)}catch(x){}}"
+    "var f='',l='';if(e&&(e.tagName==='INPUT'||e.tagName==='TEXTAREA')){f=secret(e)?'':(e.value||'');"
+    "l=e.getAttribute('aria-label')||e.placeholder||e.name||''}"
+    "else if(e&&e.isContentEditable){f=e.innerText||'';l=e.getAttribute('aria-label')||''}return{f:f.slice(-2000),l:l}}"
+    "var a=go(document);var h=[].slice.call(document.querySelectorAll('h1,h2,h3')).slice(0,40)"
+    ".map(function(x){return(x.innerText||'').trim()}).filter(Boolean);"
+    "var b=document.body?document.body.innerText:'';"
+    "return JSON.stringify({title:document.title,url:location.href,field:a.f,label:a.l,heads:h,text:b.slice(0,8000)})})()";
+
+// What the room waits for is a second; an answer by then, even without the page's part.
+constexpr base::TimeDelta kPatience = base::Milliseconds(800);
+
+bool IsNameChar(UChar32 c) {
+  return u_isalnum(c) || c == '.' || c == '-' || c == '_';
+}
+
+// The words of `text` that look like names -- capitalised, or with a capital or a digit inside
+// (`SpatiQuill`, `v2.3`, `iPhone`) -- most frequent first, at most `n` (the Rust `name_like_words`).
+std::vector<std::string> NameLikeWords(const std::u16string& text, size_t n) {
+  std::map<std::u16string, int> counts;
+  size_t i = 0;
+  while (i < text.size()) {
+    while (i < text.size() && !IsNameChar(text[i])) {
+      ++i;
+    }
+    size_t start = i;
+    while (i < text.size() && IsNameChar(text[i])) {
+      ++i;
+    }
+    std::u16string word = text.substr(start, i - start);
+    base::TrimString(word, u".-_", &word);
+    if (word.size() < 4) {
+      continue;
+    }
+    bool inner_capital = false, digit = false, alpha = false;
+    for (size_t k = 0; k < word.size(); ++k) {
+      inner_capital |= k > 0 && u_isupper(word[k]);
+      digit |= word[k] >= '0' && word[k] <= '9';
+      alpha |= u_isalpha(word[k]);
+    }
+    if (u_isupper(word[0]) || inner_capital || (digit && alpha)) {
+      ++counts[word];
+    }
+  }
+  std::vector<std::pair<std::u16string, int>> words(counts.begin(), counts.end());
+  std::stable_sort(words.begin(), words.end(),
+                   [](const auto& a, const auto& b) { return a.second > b.second; });
+  std::vector<std::string> out;
+  for (size_t k = 0; k < words.size() && k < n; ++k) {
+    out.push_back(base::UTF16ToUTF8(words[k].first));
+  }
+  return out;
+}
+
+// The page's account as the room reads it (the Rust `page_description`): the field typed in at
+// the end of the text, and for vocabulary the headings and the words that look like names.
+std::string Description(const std::string& said, const std::string& title, const std::string& url) {
+  base::DictValue out;
+  out.Set("kind", "web");
+  out.Set("app", "SpatiMesh");
+  out.Set("title", title);
+  out.Set("directory", url);
+  std::optional<base::DictValue> page = base::JSONReader::ReadDict(said, base::JSON_PARSE_RFC);
+  if (page) {
+    auto get = [&page](const char* key) {
+      const std::string* value = page->FindString(key);
+      return value ? *value : std::string();
+    };
+    if (!get("title").empty()) {
+      out.Set("title", get("title"));
+    }
+    if (!get("url").empty()) {
+      out.Set("directory", get("url"));
+    }
+    std::u16string text16 = base::UTF8ToUTF16(get("text"));
+    const std::u16string field = base::UTF8ToUTF16(get("field"));
+    const std::u16string label = base::UTF8ToUTF16(get("label"));
+    std::u16string shown = text16.substr(0, 3000);
+    if (!field.empty() || !label.empty()) {
+      shown += u"\n" + label + u": " + field;
+    }
+    out.Set("text", base::UTF16ToUTF8(shown));
+    base::ListValue vocabulary;
+    if (const base::ListValue* heads = page->FindList("heads")) {
+      for (const base::Value& head : *heads) {
+        if (head.is_string()) {
+          vocabulary.Append(head.GetString());
+        }
+      }
+    }
+    for (std::string& word : NameLikeWords(text16 + u" " + field, 60)) {
+      vocabulary.Append(std::move(word));
+    }
+    out.Set("vocabulary", std::move(vocabulary));
+  }
+  return base::WriteJson(out).value_or("{}");
+}
+
+void WriteAndClose(base::ScopedFD fd, std::string json) {
+  base::WriteFileDescriptor(fd.get(), json);
+}
+
+// One question, answered once: by the page, or by the clock with what is known without it.
+class Asked : public base::RefCounted<Asked> {
+ public:
+  Asked(base::ScopedFD fd, std::string title, std::string url)
+      : fd_(std::move(fd)), title_(std::move(title)), url_(std::move(url)) {}
+
+  void Answer(const std::string& said) {
+    if (!fd_.is_valid()) {
+      return;
+    }
+    timer_.Stop();
+    base::ThreadPool::PostTask(FROM_HERE, {base::MayBlock()},
+                               base::BindOnce(&WriteAndClose, std::move(fd_),
+                                              Description(said, title_, url_)));
+  }
+
+  void Wait() {
+    timer_.Start(FROM_HERE, kPatience,
+                 base::BindOnce(&Asked::Answer, base::WrapRefCounted(this), std::string()));
+  }
+
+ private:
+  friend class base::RefCounted<Asked>;
+  ~Asked() = default;
+
+  base::ScopedFD fd_;
+  const std::string title_;
+  const std::string url_;
+  base::OneShotTimer timer_;
+};
+
+content::WebContents* ShownIn(uint32_t surface_id) {
+  content::WebContents* found = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [surface_id, &found](BrowserWindowInterface* browser) {
+        TabStripModel* tabs = browser->GetTabStripModel();
+        content::WebContents* contents = tabs ? tabs->GetActiveWebContents() : nullptr;
+        gfx::NativeWindow window = contents ? contents->GetTopLevelNativeWindow() : nullptr;
+        if (window && window->GetHost() && window->GetHost()->GetSpatiandSurfaceId() == surface_id) {
+          found = contents;
+          return false;
+        }
+        return true;
+      });
+  return found;
+}
+
+void Describe(uint32_t surface_id, base::ScopedFD fd) {
+  content::WebContents* contents = surface_id ? ShownIn(surface_id) : nullptr;
+  if (!contents || !contents->GetPrimaryMainFrame()) {
+    // A window with no page in it: a dialog of the browser's own, the profile lock.
+    WriteAndClose(std::move(fd), Description(std::string(), std::string(), std::string()));
+    return;
+  }
+  auto asked = base::MakeRefCounted<Asked>(std::move(fd), base::UTF16ToUTF8(contents->GetTitle()),
+                                           contents->GetLastCommittedURL().spec());
+  asked->Wait();
+  contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(std::string_view(kPageDescription)),
+      base::BindOnce(
+          [](scoped_refptr<Asked> asked, base::Value value) {
+            asked->Answer(value.is_string() ? value.GetString() : std::string());
+          },
+          asked),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+}  // namespace
+
+void StartDescribe() {
+  ui::SetSpatiandDescribe(base::BindRepeating(&Describe));
+}
+
+}  // namespace spatiand
