@@ -0,0 +1,194 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "gpu/command_buffer/service/shared_image/spatiand_hardware_buffer_image_backing.h"
+
+#include <android/hardware_buffer.h>
+#include <dlfcn.h>
+#include <poll.h>
+
+#include <utility>
+
+#include "base/logging.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/no_destructor.h"
+#include "gpu/command_buffer/service/shared_context_state.h"
+#include "gpu/command_buffer/service/shared_image/shared_image_representation.h"
+#include "gpu/command_buffer/service/shared_image/skia_gl_image_representation.h"
+#include "gpu/command_buffer/service/texture_manager.h"
+#include "ui/gl/gl_bindings.h"
+#include "ui/gl/gl_fence_egl.h"
+#include "ui/gl/scoped_binders.h"
+#include "ui/gl/scoped_egl_image.h"
+
+namespace gpu {
+
+namespace {
+
+// Android's buffer calls, from libnativewindow (API 26), which this program is not linked with
+// (it is built for 24).
+struct HardwareBufferCalls {
+  void (*acquire)(AHardwareBuffer*) = nullptr;
+  void (*release)(AHardwareBuffer*) = nullptr;
+  void (*describe)(const AHardwareBuffer*, AHardwareBuffer_Desc*) = nullptr;
+  bool valid() const { return acquire && release && describe; }
+};
+
+const HardwareBufferCalls& Calls() {
+  static const HardwareBufferCalls calls = [] {
+    HardwareBufferCalls found;
+    if (void* library = dlopen("libnativewindow.so", RTLD_NOW)) {
+      found.acquire =
+          reinterpret_cast<decltype(found.acquire)>(dlsym(library, "AHardwareBuffer_acquire"));
+      found.release =
+          reinterpret_cast<decltype(found.release)>(dlsym(library, "AHardwareBuffer_release"));
+      found.describe =
+          reinterpret_cast<decltype(found.describe)>(dlsym(library, "AHardwareBuffer_describe"));
+    }
+    return found;
+  }();
+  return calls;
+}
+
+}  // namespace
+
+// One GL_TEXTURE_EXTERNAL_OES bound to an EGLImage of the buffer, made for each representation
+// (as Chromium on Android makes one for each of a decoder's pictures it draws): the compositor
+// produces one for each video frame it draws, in the context it draws with.
+class SpatiandHardwareBufferImageBacking::GLTexturePassthroughRepresentation
+    : public GLTexturePassthroughImageRepresentation {
+ public:
+  GLTexturePassthroughRepresentation(SharedImageManager* manager,
+                                     SharedImageBacking* backing,
+                                     MemoryTypeTracker* tracker,
+                                     gl::ScopedEGLImage egl_image,
+                                     scoped_refptr<gles2::TexturePassthrough> texture)
+      : GLTexturePassthroughImageRepresentation(manager, backing, tracker),
+        egl_image_(std::move(egl_image)),
+        texture_(std::move(texture)) {}
+
+  ~GLTexturePassthroughRepresentation() override {
+    if (!has_context()) {
+      texture_->MarkContextLost();
+    }
+  }
+
+  const scoped_refptr<gles2::TexturePassthrough>& GetTexturePassthrough(
+      size_t plane_index) override {
+    DCHECK_EQ(plane_index, 0u);
+    return texture_;
+  }
+
+  bool BeginAccess(GLenum mode) override {
+    // Read only: the decoder wrote the picture; nothing writes it after.
+    if (mode != GL_SHARED_IMAGE_ACCESS_MODE_READ_CHROMIUM) {
+      return false;
+    }
+    static_cast<SpatiandHardwareBufferImageBacking*>(backing())->WaitForDecoder();
+    return true;
+  }
+  void EndAccess() override {}
+  bool SupportsMultipleConcurrentReadAccess() override { return true; }
+
+ private:
+  gl::ScopedEGLImage egl_image_;
+  scoped_refptr<gles2::TexturePassthrough> texture_;
+};
+
+SpatiandHardwareBufferImageBacking::SpatiandHardwareBufferImageBacking(
+    const Mailbox& mailbox,
+    const SharedImageInfo& si_info,
+    AHardwareBuffer* buffer,
+    base::ScopedFD decoded)
+    : ClearTrackingSharedImageBacking(mailbox,
+                                      si_info,
+                                      si_info.format.EstimatedSizeInBytes(si_info.size),
+                                      /*is_thread_safe=*/false),
+      buffer_(buffer),
+      decoded_(std::move(decoded)) {
+  Calls().acquire(buffer_);
+  SetCleared();
+}
+
+SpatiandHardwareBufferImageBacking::~SpatiandHardwareBufferImageBacking() {
+  Calls().release(buffer_);
+}
+
+void SpatiandHardwareBufferImageBacking::WaitForDecoder() {
+  if (!decoded_.is_valid()) {
+    return;
+  }
+  // The GPU waits, not this thread (EGL_ANDROID_native_fence_sync); the sync takes the file.
+  EGLint attributes[] = {EGL_SYNC_NATIVE_FENCE_FD_ANDROID, decoded_.get(), EGL_NONE};
+  std::unique_ptr<gl::GLFenceEGL> fence =
+      gl::GLFenceEGL::Create(EGL_SYNC_NATIVE_FENCE_ANDROID, attributes);
+  if (fence) {
+    std::ignore = decoded_.release();
+    fence->ServerWait();
+  } else {
+    // No such syncs: this thread waits.
+    struct pollfd poll_fd = {decoded_.get(), POLLIN, 0};
+    HANDLE_EINTR(poll(&poll_fd, 1, 100));
+    decoded_.reset();
+  }
+}
+
+// static
+bool SpatiandHardwareBufferImageBacking::IsSupported() {
+  return Calls().valid();
+}
+
+SharedImageBackingType SpatiandHardwareBufferImageBacking::GetType() const {
+  return SharedImageBackingType::kAHardwareBuffer;
+}
+
+std::unique_ptr<GLTexturePassthroughImageRepresentation>
+SpatiandHardwareBufferImageBacking::ProduceGLTexturePassthrough(SharedImageManager* manager,
+                                                                MemoryTypeTracker* tracker) {
+  // ANGLE takes the buffer itself as the client buffer (AHardwareBufferImageSiblingVkSpatiand).
+  const EGLint attributes[] = {EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
+  gl::ScopedEGLImage egl_image =
+      gl::MakeScopedEGLImage(EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
+                             reinterpret_cast<EGLClientBuffer>(buffer_), attributes);
+  if (!egl_image.is_valid()) {
+    LOG(ERROR) << "Spatiand: no EGLImage of a decoder's picture (" << std::hex << eglGetError()
+               << ")";
+    return nullptr;
+  }
+  constexpr GLenum kTarget = GL_TEXTURE_EXTERNAL_OES;
+  gl::GLApi* api = gl::g_current_gl_context;
+  GLuint service_id = 0;
+  api->glGenTexturesFn(1, &service_id);
+  {
+    gl::ScopedTextureBinder binder(kTarget, service_id);
+    api->glTexParameteriFn(kTarget, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    api->glTexParameteriFn(kTarget, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    api->glTexParameteriFn(kTarget, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    api->glTexParameteriFn(kTarget, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    api->glEGLImageTargetTexture2DOESFn(kTarget, egl_image.get());
+  }
+  auto texture = base::MakeRefCounted<gles2::TexturePassthrough>(service_id, kTarget);
+  texture->SetEstimatedSize(GetEstimatedSize());
+  return std::make_unique<GLTexturePassthroughRepresentation>(manager, this, tracker,
+                                                              std::move(egl_image),
+                                                              std::move(texture));
+}
+
+std::unique_ptr<SkiaGaneshImageRepresentation>
+SpatiandHardwareBufferImageBacking::ProduceSkiaGanesh(
+    SharedImageManager* manager,
+    MemoryTypeTracker* tracker,
+    scoped_refptr<SharedContextState> context_state) {
+  if (!context_state->GrContextIsGL()) {
+    LOG(ERROR) << "Spatiand: a decoder's picture is drawn only by Skia on GL";
+    return nullptr;
+  }
+  auto gl_representation = ProduceGLTexturePassthrough(manager, tracker);
+  if (!gl_representation) {
+    return nullptr;
+  }
+  return SkiaGLImageRepresentation::Create(std::move(gl_representation), std::move(context_state),
+                                           manager, this, tracker);
+}
+
+}  // namespace gpu
