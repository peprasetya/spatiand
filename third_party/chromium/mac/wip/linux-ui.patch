@@ -0,0 +1,72 @@
+// Copyright 2026 Spatiand
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_OZONE_PLATFORM_WAYLAND_HOST_SPATIAND_IOSURFACE_HANDOVER_H_
+#define UI_OZONE_PLATFORM_WAYLAND_HOST_SPATIAND_IOSURFACE_HANDOVER_H_
+
+#include <IOSurface/IOSurfaceRef.h>
+#include <mach/mach.h>
+
+#include <cstdint>
+#include <map>
+
+#include "base/memory/raw_ptr.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/native_ui_types.h"
+#include "ui/ozone/platform/wayland/common/wayland_shm_mapping.h"
+
+namespace ui {
+
+class WaylandConnection;
+
+// Spatiand, on the Mac: a window's frames as the GPU drew them, each an IOSurface, shown in the
+// room with nothing copied -- the way every Spatiand application on the Mac shows a picture
+// drawn on the GPU (spatiand-app's gl/mac.rs; spatiand_proto::handover). The surface goes to
+// the room in private (spatiand_surfaces_post: a Mach message to the room that started this
+// program), and the window's buffer is a placeholder of the picture's size, in shared memory,
+// whose first sixteen bytes name it: "SPSF", the surface's number, and this window's own run
+// of them. The placeholder is attached once per size, through Ozone's frames as any buffer
+// (so the window's configure, scale and geometry go as on Linux); after that, each frame
+// rewrites the number and commits. The room holds the surface it shows, raising its use count,
+// which is what the GPU's buffer queue looks at before drawing into one again.
+//
+// The Beam Pro does the same with Android hardware buffers (android-libc/0021).
+class SpatiandIOSurfaceHandover {
+ public:
+  explicit SpatiandIOSurfaceHandover(WaylandConnection* connection);
+  SpatiandIOSurfaceHandover(const SpatiandIOSurfaceHandover&) = delete;
+  SpatiandIOSurfaceHandover& operator=(const SpatiandIOSurfaceHandover&) = delete;
+  ~SpatiandIOSurfaceHandover();
+
+  // The newest frame of the window `widget`: an IOSurface by its Mach port, `pixel_size` big,
+  // drawn for `scale_factor`.
+  void Show(gfx::AcceleratedWidget widget,
+            mach_port_t io_surface_port,
+            const gfx::Size& pixel_size,
+            float scale_factor);
+
+ private:
+  struct Placeholder {
+    Placeholder();
+    Placeholder(Placeholder&&);
+    Placeholder& operator=(Placeholder&&);
+    ~Placeholder();
+
+    uint32_t buffer_id = 0;
+    gfx::Size size;
+    float scale_factor = 1.f;
+    wl::ShmMapping head;
+    uint32_t frame_id = 0;
+  };
+
+  void Forget(gfx::AcceleratedWidget widget);
+
+  const raw_ptr<WaylandConnection> connection_;
+  std::map<gfx::AcceleratedWidget, Placeholder> placeholders_;
+  uint32_t next_buffer_id_;
+};
+
+}  // namespace ui
+
+#endif  // UI_OZONE_PLATFORM_WAYLAND_HOST_SPATIAND_IOSURFACE_HANDOVER_H_
