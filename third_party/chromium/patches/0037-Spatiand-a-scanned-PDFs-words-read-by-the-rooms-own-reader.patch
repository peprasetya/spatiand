+namespace spatiand {
+
+// The text in a picture, read by the room's own reader -- hemera, as Spatiand's AI settings name
+// it (apps/ai.json) -- for what asks Chromium's OCR service: above all the PDF viewer, which
+// gives a page that is only a picture (a scan) the words read in it, to be chosen and found as a
+// page's own (searchify). In place of Google's Screen AI library, which the room has not got.
+void BindOcrAnnotator(
+    content::BrowserContext* context,
+    mojo::PendingReceiver<screen_ai::mojom::ScreenAIAnnotator> receiver);
+
+}  // namespace spatiand
+
+#endif  // CHROME_BROWSER_SPATIAND_OCR_H_
