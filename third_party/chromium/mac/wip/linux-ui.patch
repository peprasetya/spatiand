+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_OZONE_PLATFORM_WAYLAND_COMMON_WAYLAND_SHM_MAPPING_H_
+#define UI_OZONE_PLATFORM_WAYLAND_COMMON_WAYLAND_SHM_MAPPING_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "base/containers/span.h"
+#include "base/files/scoped_file.h"
+#include "base/memory/raw_ptr_exclusion.h"
+#include "build/build_config.h"
+
+#if !BUILDFLAG(IS_APPLE)
+#include "base/memory/shared_memory_mapping.h"
+#endif
+
+namespace wl {
+
+// Spatiand: writable shared memory with an fd that a Wayland compositor maps
+// (wl_shm). On Linux it is base's shared memory, as Chromium has always made
+// it here; on macOS, whose base shared memory is a Mach memory object with no
+// fd, it is POSIX shared memory (shm_open, unlinked at once) mapped here.
+class ShmMapping {
+ public:
+  ShmMapping();
+  ShmMapping(ShmMapping&& other);
+  ShmMapping& operator=(ShmMapping&& other);
+  ShmMapping(const ShmMapping&) = delete;
+  ShmMapping& operator=(const ShmMapping&) = delete;
+  ~ShmMapping();
+
+  // |size| bytes, and the fd of them in |fd|. Not valid if that failed.
+  static ShmMapping Create(size_t size, base::ScopedFD* fd);
+
+  bool IsValid() const { return !span_.empty(); }
+  void* memory() const { return span_.data(); }
+  uint8_t* data() const { return span_.data(); }
+  size_t size() const { return span_.size(); }
+  base::span<uint8_t>::iterator begin() const { return span_.begin(); }
+  base::span<uint8_t>::iterator end() const { return span_.end(); }
+  template <typename T>
+  T* GetMemoryAs() const {
+    return reinterpret_cast<T*>(span_.data());
+  }
+
+ private:
+  void Reset();
+
+  // The mapping's memory: owned by |mapping_| on Linux, by this on macOS.
+  RAW_PTR_EXCLUSION base::span<uint8_t> span_;
+#if !BUILDFLAG(IS_APPLE)
+  base::WritableSharedMemoryMapping mapping_;
+#endif
+};
+
+}  // namespace wl
+
+#endif  // UI_OZONE_PLATFORM_WAYLAND_COMMON_WAYLAND_SHM_MAPPING_H_
