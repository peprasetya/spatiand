From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Spatiand build <claude@prasetya.id>
Date: Mon, 9 Nov 2026 12:15:00 +0700
Subject: [PATCH] Spatiand: light or dark with no toolkit, and the UI's type at
 a toolkit's size

Patch 0014 hands Spatiand's look to the toolkits' settings providers, and a build with no
toolkit -- Chromium's Linux browser built for Android's libc, SpatiMesh on the Beam Pro -- has
none: the look was read every second and went nowhere, so SpatiMesh was light there, and its
profile's colour beige, whatever Spatiand was set to. Where no toolkit is loaded the look is now
the system's settings itself, a settings provider of its own. With a toolkit, as on the Deck,
nothing changes. And the toolkit-less UI's type is 13 pixels, the size KDE's toolkit gives it on
the Deck, where Chromium's own default is 12.
---
 ui/linux/dark_mode_manager_linux.cc | 41 ++++++++++++++++++++++++++++++++++++-
 ui/linux/dark_mode_manager_linux.h  |  4 ++++
 ui/linux/fallback_linux_ui.cc       |  5 ++++-
 3 files changed, 48 insertions(+), 2 deletions(-)

diff --git a/ui/linux/dark_mode_manager_linux.cc b/ui/linux/dark_mode_manager_linux.cc
index 868fda4bf8..9be7b7c912 100644
--- a/ui/linux/dark_mode_manager_linux.cc
+++ b/ui/linux/dark_mode_manager_linux.cc
@@ -35,6 +35,7 @@
 #include "ui/linux/linux_ui.h"
 #include "ui/linux/linux_ui_factory.h"
 #include "ui/native_theme/native_theme.h"
+#include "ui/native_theme/os_settings_provider.h"
 
 namespace ui {
 
@@ -85,6 +86,37 @@ bool ReadSpatiandDark() {
 
 }  // namespace
 
+// Spatiand's look as the system's settings, for a build with no toolkit to carry it: SpatiMesh on
+// the Beam Pro, Chromium's Linux browser built for Android's libc with neither GTK nor Qt.
+// `SetColorScheme()` reaches the toolkits' settings providers, and with none the look was read
+// every second and went nowhere -- SpatiMesh was light, and its profile's colour beige, whatever
+// Spatiand was set to (owner, 2026-11-09). The newest provider is the one asked, so this stands
+// in front of the default one, and is made only where there is no toolkit's to stand in front of.
+class DarkModeManagerLinux::SpatiandLook : public OsSettingsProvider {
+ public:
+  SpatiandLook() = default;
+  SpatiandLook(const SpatiandLook&) = delete;
+  SpatiandLook& operator=(const SpatiandLook&) = delete;
+  ~SpatiandLook() override = default;
+
+  void Set(bool dark) {
+    if (dark_ != dark) {
+      dark_ = dark;
+      NotifyOnSettingsChanged();
+    }
+  }
+
+  NativeTheme::PreferredColorScheme PreferredColorScheme() const override {
+    return dark_ ? NativeTheme::PreferredColorScheme::kDark
+                 : NativeTheme::PreferredColorScheme::kLight;
+  }
+
+ private:
+  // Dark until the setting is read, as Spatiand's own look is: a light window opening in a dark
+  // room would flash.
+  bool dark_ = true;
+};
+
 DarkModeManagerLinux::DarkModeManagerLinux()
     : DarkModeManagerLinux(dbus_thread_linux::GetSharedSessionBus(),
                            &ui::GetLinuxUiThemes()) {}
@@ -99,7 +131,11 @@ DarkModeManagerLinux::DarkModeManagerLinux(
           kFreedesktopSettingsService,
           dbus::ObjectPath(kFreedesktopSettingsObjectPath))) {
   // Not the portal: Spatiand's own setting, which outranks the desktop's, and is read as often as
-  // its other applications read it.
+  // its other applications read it. Where no toolkit is loaded, the setting is the system's
+  // settings itself (`SpatiandLook`).
+  if (linux_ui_themes_->empty()) {
+    spatiand_look_ = std::make_unique<SpatiandLook>();
+  }
   CheckSpatiandLook();
   spatiand_look_timer_.Start(FROM_HERE, base::Seconds(1), this,
                              &DarkModeManagerLinux::CheckSpatiandLook);
@@ -121,6 +157,9 @@ void DarkModeManagerLinux::CheckSpatiandLook() {
 void DarkModeManagerLinux::OnSpatiandLook(bool dark) {
   if (spatiand_dark_ != dark) {
     spatiand_dark_ = dark;
+    if (spatiand_look_) {
+      spatiand_look_->Set(dark);
+    }
     SetColorScheme(dark ? NativeTheme::PreferredColorScheme::kDark
                         : NativeTheme::PreferredColorScheme::kLight);
   }
diff --git a/ui/linux/dark_mode_manager_linux.h b/ui/linux/dark_mode_manager_linux.h
index 4d665e2265..7e4af475fe 100644
--- a/ui/linux/dark_mode_manager_linux.h
+++ b/ui/linux/dark_mode_manager_linux.h
@@ -5,6 +5,7 @@
 #ifndef UI_LINUX_DARK_MODE_MANAGER_LINUX_H_
 #define UI_LINUX_DARK_MODE_MANAGER_LINUX_H_
 
+#include <memory>
 #include <optional>
 #include <string>
 #include <vector>
@@ -95,6 +96,9 @@ class DarkModeManagerLinux {
   void OnSpatiandLook(bool dark);
   std::optional<bool> spatiand_dark_;
   base::RepeatingTimer spatiand_look_timer_;
+  // The look as the system's settings, where no toolkit is loaded to carry it. See the .cc.
+  class SpatiandLook;
+  std::unique_ptr<SpatiandLook> spatiand_look_;
 
   raw_ptr<const std::vector<raw_ptr<LinuxUiTheme, VectorExperimental>>>
       linux_ui_themes_;
diff --git a/ui/linux/fallback_linux_ui.cc b/ui/linux/fallback_linux_ui.cc
index e9f8975c82..d88a4b7b46 100644
--- a/ui/linux/fallback_linux_ui.cc
+++ b/ui/linux/fallback_linux_ui.cc
@@ -53,7 +53,10 @@ bool FallbackLinuxUi::Initialize() {
 
 void FallbackLinuxUi::InitializeFontSettings() {
   gfx::FontRenderParamsQuery query;
-  query.pixel_size = gfx::PlatformFont::kDefaultBaseFontSize;
+  // Spatiand: 13 pixels, the size a toolkit gives Chromium's UI on the Deck (KDE's Noto Sans at 10
+  // points and 96 dots an inch), so that SpatiMesh's own UI is the same size on the Beam Pro, which
+  // has no toolkit, as there. Chromium's own default is 12.
+  query.pixel_size = 13;
   query.style = gfx::Font::NORMAL;
   query.weight = gfx::Font::Weight::NORMAL;
   query.device_scale_factor = display_config().primary_scale;
-- 
