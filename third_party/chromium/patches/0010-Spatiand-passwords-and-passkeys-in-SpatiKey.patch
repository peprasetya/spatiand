diff --git a/components/password_manager/core/browser/password_store/spatikey_password_store_backend.cc b/components/password_manager/core/browser/password_store/spatikey_password_store_backend.cc
new file mode 100644
index 0000000000..39d18056dc
--- /dev/null
+++ b/components/password_manager/core/browser/password_store/spatikey_password_store_backend.cc
@@ -0,0 +1,204 @@
+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/password_manager/core/browser/password_store/spatikey_password_store_backend.h"
+
+#include <string>
+#include <utility>
+#include <variant>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "components/password_manager/core/browser/password_form.h"
+#include "components/password_manager/core/browser/password_form_digest.h"
+#include "components/password_manager/core/browser/password_store/password_store_change.h"
+#include "components/password_manager/core/browser/password_store/stored_credential.h"
+#include "components/sync/model/data_type_controller_delegate.h"
+#include "components/spatikey/client.h"
+#include "components/spatikey/filled.h"
+#include "url/origin.h"
+
+namespace password_manager {
+
+namespace {
+
+// The credential a login form is told about: the one line SpatiKey shows in it.
+StoredCredential AnyLoginFor(const PasswordFormDigest& digest) {
+  StoredCredential any;
+  any.scheme = PasswordForm::Scheme::kHtml;
+  any.signon_realm = digest.signon_realm;
+  any.url = digest.url;
+  any.username_value = spatikey::kAnyLogin;
+  any.password_value = PasswordString(std::u16string(spatikey::kPlaceholder));
+  any.match_type = PasswordForm::MatchType::kExact;
+  any.in_store = PasswordForm::Store::kProfileStore;
+  // Never handed to a page unasked.
+  any.skip_zero_click = true;
+  any.date_created = any.date_last_used = base::Time::Now();
+  return any;
+}
+
+// What belongs in the vault: a page's password, and nothing that merely mentions one.
+bool ForTheVault(const StoredCredential& cred) {
+  return cred.scheme == PasswordForm::Scheme::kHtml && !cred.blocked_by_user &&
+         !cred.federation_origin.IsValid() && !cred.password_value.empty() &&
+         !(cred.password_value == std::u16string(spatikey::kPlaceholder));
+}
+
+void OnSaved(const std::u16string& site, PasswordChangesOrErrorReply callback, spatikey::Answer answer) {
+  if (!answer.has_value()) {
+    spatikey::ReportProblem(u"Not kept in SpatiKey, the password for " + site + u": " +
+                            base::UTF8ToUTF16(answer.error().message));
+  }
+  // Nothing has changed here, either way: the vault is not this store.
+  std::move(callback).Run(PasswordChanges(PasswordStoreChangeList()));
+}
+
+void Save(const StoredCredential& cred, PasswordChangesOrErrorReply callback) {
+  const url::Origin origin = url::Origin::Create(cred.url);
+  base::DictValue fields;
+  fields.Set("origin", origin.Serialize());
+  fields.Set("title", std::string());
+  fields.Set("username", base::UTF16ToUTF8(cred.username_value));
+  fields.Set("password", base::UTF16ToUTF8(cred.password_value.value()));
+  spatikey::Ask("save", std::move(fields),
+                base::BindOnce(&OnSaved, base::UTF8ToUTF16(origin.host()), std::move(callback)));
+}
+
+void OnMatchesAndUsable(PasswordFormDigest digest,
+                        BackendLoginsOrErrorReply callback,
+                        BackendLoginsResultOrError result,
+                        bool usable) {
+  if (auto* logins = std::get_if<BackendLoginsResult>(&result);
+      logins && usable && digest.scheme == PasswordForm::Scheme::kHtml) {
+    logins->push_back(AnyLoginFor(digest));
+  }
+  std::move(callback).Run(std::move(result));
+}
+
+void OnMatches(PasswordFormDigest digest,
+               BackendLoginsOrErrorReply callback,
+               BackendLoginsResultOrError result) {
+  spatikey::WhenUsableKnown(base::BindOnce(&OnMatchesAndUsable, std::move(digest),
+                                           std::move(callback), std::move(result)));
+}
+
+}  // namespace
+
+SpatikeyPasswordStoreBackend::SpatikeyPasswordStoreBackend(
+    std::unique_ptr<PasswordStoreBackend> local)
+    : local_(std::move(local)) {}
+
+SpatikeyPasswordStoreBackend::~SpatikeyPasswordStoreBackend() = default;
+
+void SpatikeyPasswordStoreBackend::InitBackend(RemoteChangesReceived remote_form_changes_received,
+                                               base::RepeatingClosure sync_enabled_or_disabled_cb,
+                                               base::OnceCallback<void(bool)> completion) {
+  spatikey::CheckUsable();
+  local_->InitBackend(std::move(remote_form_changes_received),
+                      std::move(sync_enabled_or_disabled_cb), std::move(completion));
+}
+
+void SpatikeyPasswordStoreBackend::Shutdown(base::OnceClosure shutdown_completed) {
+  local_->Shutdown(std::move(shutdown_completed));
+}
+
+ActionableError SpatikeyPasswordStoreBackend::GetError() {
+  return local_->GetError();
+}
+
+void SpatikeyPasswordStoreBackend::GetAllLoginsAsync(BackendLoginsOrErrorReply callback) {
+  local_->GetAllLoginsAsync(std::move(callback));
+}
+
+void SpatikeyPasswordStoreBackend::GetAllLoginsWithAffiliationAndBrandingAsync(
+    BackendLoginsOrErrorReply callback) {
+  local_->GetAllLoginsWithAffiliationAndBrandingAsync(std::move(callback));
+}
+
+void SpatikeyPasswordStoreBackend::GetAutofillableLoginsAsync(BackendLoginsOrErrorReply callback) {
+  local_->GetAutofillableLoginsAsync(std::move(callback));
+}
+
+void SpatikeyPasswordStoreBackend::FillMatchingLoginsAsync(
+    BackendLoginsOrErrorReply callback,
+    bool include_psl,
+    const std::vector<PasswordFormDigest>& forms) {
+  local_->FillMatchingLoginsAsync(std::move(callback), include_psl, forms);
+}
+
+void SpatikeyPasswordStoreBackend::GetGroupedMatchingLoginsAsync(
+    const PasswordFormDigest& form_digest,
+    BackendLoginsOrErrorReply callback) {
+  local_->GetGroupedMatchingLoginsAsync(
+      form_digest, base::BindOnce(&OnMatches, form_digest, std::move(callback)));
+}
+
+void SpatikeyPasswordStoreBackend::AddLoginAsync(StoredCredential cred,
+                                                 PasswordChangesOrErrorReply callback) {
+  if (ForTheVault(cred)) {
+    Save(cred, std::move(callback));
+    return;
+  }
+  local_->AddLoginAsync(std::move(cred), std::move(callback));
+}
+
+void SpatikeyPasswordStoreBackend::UpdateLoginAsync(StoredCredential cred,
+                                                    PasswordChangesOrErrorReply callback) {
+  if (cred.password_value == std::u16string(spatikey::kPlaceholder)) {
+    // What was last used and when: nothing is kept of a login's use here.
+    std::move(callback).Run(PasswordChanges(PasswordStoreChangeList()));
+    return;
+  }
+  if (ForTheVault(cred)) {
+    // Told again what it just gave: no reason to ask for a touch.
+    if (spatikey::WasFilled(url::Origin::Create(cred.url), cred.password_value.value())) {
+      std::move(callback).Run(PasswordChanges(PasswordStoreChangeList()));
+      return;
+    }
+    Save(cred, std::move(callback));
+    return;
+  }
+  local_->UpdateLoginAsync(std::move(cred), std::move(callback));
+}
+
+void SpatikeyPasswordStoreBackend::RemoveLoginAsync(const base::Location& location,
+                                                    StoredCredential cred,
+                                                    PasswordChangesOrErrorReply callback) {
+  local_->RemoveLoginAsync(location, std::move(cred), std::move(callback));
+}
+
+void SpatikeyPasswordStoreBackend::RemoveLoginsCreatedBetweenAsync(
+    const base::Location& location,
+    base::Time delete_begin,
+    base::Time delete_end,
+    PasswordChangesOrErrorReply callback) {
+  local_->RemoveLoginsCreatedBetweenAsync(location, delete_begin, delete_end, std::move(callback));
+}
+
+void SpatikeyPasswordStoreBackend::DisableAutoSignInForOriginsAsync(
+    const base::RepeatingCallback<bool(const GURL&)>& origin_filter,
+    base::OnceClosure completion) {
+  local_->DisableAutoSignInForOriginsAsync(origin_filter, std::move(completion));
+}
+
+SmartBubbleStatsStore* SpatikeyPasswordStoreBackend::GetSmartBubbleStatsStore() {
+  return local_->GetSmartBubbleStatsStore();
+}
+
+std::unique_ptr<syncer::DataTypeControllerDelegate>
+SpatikeyPasswordStoreBackend::CreateSyncControllerDelegate() {
+  return local_->CreateSyncControllerDelegate();
+}
+
+void SpatikeyPasswordStoreBackend::OnSyncServiceInitialized(syncer::SyncService* sync_service) {
+  local_->OnSyncServiceInitialized(sync_service);
+}
+
+base::WeakPtr<PasswordStoreBackend> SpatikeyPasswordStoreBackend::AsWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+}  // namespace password_manager
