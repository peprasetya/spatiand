+// Copyright 2026 Spatiand. Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SPATIAND_SHARED_FOLDER_H_
+#define CHROME_BROWSER_SPATIAND_SHARED_FOLDER_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+#include "base/values.h"
+
+// SpatiMesh's data as every Spatiand machine keeps it (docs/spatimesh.md, "Settings"), read and
+// written here in the same files as SpatiMesh's other builds:
+//
+//   ~/.config/spatiand/apps/spatimesh/         shared: spatiand-sync copies it between every two
+//                                              linked Spatiands and spatiand-hosts, the newest
+//                                              file winning, deletions remembered
+//   ~/.config/spatiand/local/spatimesh-chromium/  this browser's own, on this machine
+//
+// A file is written whole (to a hidden file, then renamed over), so a machine syncing at the wrong
+// moment never takes half of one, and only when it changed, since a write is a change to every
+// machine. Everything here blocks: for the sequences that may.
+namespace spatiand {
+
+base::FilePath SharedDir();
+base::FilePath LocalDir();
+
+// One profile's folders.
+base::FilePath SharedProfileDir(const std::string& profile);
+base::FilePath LocalProfileDir(const std::string& profile);
+
+std::optional<base::Value> ReadJson(const base::FilePath& path);
+bool WriteJson(const base::FilePath& path, const base::Value& value);
+// A file made because there was none: written as if long ago, so that any version of it from
+// another machine wins over this one. Left alone if it is there.
+bool WriteJsonAsIfLongAgo(const base::FilePath& path, const base::Value& value);
+void RemovePath(const base::FilePath& path);
+
+// The names of a folder's `.json` files, without it, hidden ones left out.
+std::vector<std::string> ListJson(const base::FilePath& dir);
+// When a folder last had a file come or go: every file arrives by a rename.
+base::Time FolderChanged(const base::FilePath& dir);
+
+// Sixteen hex digits from the system's randomness.
+std::string NewId();
+// Milliseconds since 1970: the times in SpatiMesh's files.
+int64_t NowMs();
+base::Time TimeOfMs(double ms);
+double MsOfTime(base::Time time);
+
+}  // namespace spatiand
+
+#endif  // CHROME_BROWSER_SPATIAND_SHARED_FOLDER_H_
